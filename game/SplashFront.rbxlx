Weapons.ById = {}
for _, w in ipairs(Weapons.List) do
	Weapons.ById[w.Id] = w
end

Weapons.Default = "Pistol"

function Weapons.Get(id)
	return Weapons.ById[id] or Weapons.ById[Weapons.Default]
end

return Weapons
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX28"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">AdminService</string><ProtectedString name="Source"><![CDATA[-- 클로즈 테스트 입장 제한 + 테스터용 관리자 패널(F2) 명령
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Weapons = require(ReplicatedStorage.Shared.Weapons)
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
local DataService = require(script.Parent.DataService)
local CrateService = require(script.Parent.CrateService)
local MatchService = require(script.Parent.MatchService)
local Combatants = require(script.Parent.Combatants)
local Telemetry = require(script.Parent.TelemetryService)

local AdminService = {}

local function inList(list, userId)
	for _, id in ipairs(list) do
		if id == userId then
			return true
		end
	end
	return false
end

function AdminService.IsAdmin(player)
	return RunService:IsStudio() or inList(Config.CBT.Admins, player.UserId)
end

-- 이 명령을 지금 서버에서 쓸 수 있는지 (정식 서버에서는 치트 차단)
function AdminService.CommandAllowed(action)
	return RunService:IsStudio() or Config.DevTools or Config.OpsCommands[action] == true
end

function AdminService.CanJoin(player)
	if not Config.CBT.Enabled or RunService:IsStudio() then
		return true
	end
	if inList(Config.CBT.Testers, player.UserId) or inList(Config.CBT.Admins, player.UserId) then
		return true
	end
	if Config.CBT.GroupId ~= 0 then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(Config.CBT.GroupId)
		end)
		if ok and rank >= Config.CBT.GroupMinRank then
			return true
		end
	end
	return false
end

local missionDefaults = { First = Config.MissionFirstDelay, Interval = Config.MissionInterval }

local ACTIONS = {}

ACTIONS.time = function(player, n)
	n = tonumber(n) or 30
	if MatchService.SetTimeLeft(n) then
		return "남은 시간 " .. n .. "초로 변경"
	end
	return "경기/카운트다운 중에만 가능"
end

ACTIONS.endMatch = function()
	if MatchService.SetTimeLeft(0) then
		return "경기를 종료합니다"
	end
	return "진행 중인 경기 없음"
end

ACTIONS.coins = function(player, n)
	local p = DataService.Get(player)
	n = math.clamp(tonumber(n) or 5000, -1000000, 1000000)
	p.Coins = math.max(0, p.Coins + n)
	DataService.Publish(player)
	return string.format("코인 %+d -> %d", n, p.Coins)
end

ACTIONS.unlockAll = function(player)
	local p = DataService.Get(player)
	for _, w in ipairs(Weapons.List) do
		p.Owned[w.Id] = true
	end
	DataService.Publish(player)
	return "모든 무기 해금"
end

ACTIONS.crate = function(player, n)
	n = math.clamp(math.floor(tonumber(n) or 1), 1, 50)
	local counts = {}
	local last = nil
	for _ = 1, n do
		last = CrateService.Open(player)
		if last then
			counts[last.RarityName] = (counts[last.RarityName] or 0) + 1
		end
	end
	local parts = {}
	for _, r in ipairs(Cosmetics.Rarities) do
		table.insert(parts, string.format("%s %d", r.Name, counts[r.Name] or 0))
	end
	return string.format("무료 개봉 %d회: %s", n, table.concat(parts, " · "))
end

ACTIONS.bots = function()
	Config.FillWithBots = not Config.FillWithBots
	return "봇 채우기: " .. (Config.FillWithBots and "켜짐" or "꺼짐") .. " (다음 경기부터)"
end

ACTIONS.rankedBots = function()
	Config.RankedAllowBots = not Config.RankedAllowBots
	return "봇 포함 랭크 반영: " .. (Config.RankedAllowBots and "켜짐" or "꺼짐")
end

ACTIONS.fastMissions = function()
	if Config.MissionInterval == missionDefaults.Interval then
		Config.MissionFirstDelay = 3
		Config.MissionInterval = 27
		return "빠른 미션: 켜짐 (다음 경기부터 3초 후 시작, 27초 간격)"
	end
	Config.MissionFirstDelay = missionDefaults.First
	Config.MissionInterval = missionDefaults.Interval
	return "빠른 미션: 꺼짐"
end

ACTIONS.special = function(player)
	local e = Combatants.FromPlayer(player)
	if not e then
		return "경기 중에만 가능"
	end
	e.Special = Config.SpecialCells
	Combatants.Sync(e)
	return "스페셜 게이지 100%"
end

ACTIONS.rating = function(player, n)
	local p = DataService.Get(player)
	p.Rating = math.max(0, math.floor(tonumber(n) or Config.Rating.Start))
	DataService.Publish(player)
	return "레이팅 " .. p.Rating .. " (" .. Config.GetTier(p.Rating).Name .. ")"
end

ACTIONS.resetProfile = function(player)
	DataService.Reset(player)
	player:SetAttribute("FirstMatch", true)
	return "내 데이터 초기화 (첫 접속 상태)"
end

ACTIONS.nextMap = function(player, arg)
	return "다음 경기 맵: " .. MatchService.SetNextMap(arg)
end

ACTIONS.balance = function()
	return Telemetry.BalanceReport()
end

ACTIONS.feedback = function()
	return Telemetry.FeedbackList()
end

function AdminService.Init(remotes)
	remotes.Admin.OnServerInvoke = function(player, action, arg)
		if not AdminService.IsAdmin(player) then
			return { ok = false, msg = "관리자 권한 없음" }
		end
		local fn = ACTIONS[action]
		if not fn then
			return { ok = false, msg = "알 수 없는 명령" }
		end
		if not AdminService.CommandAllowed(action) then
			return { ok = false, msg = "정식 서버에서는 사용할 수 없는 개발자 명령" }
		end
		local ok, result = pcall(fn, player, arg)
		print(string.format("[SplashFront][관리자] %s -> %s(%s): %s", player.Name, tostring(action), tostring(arg), tostring(result)))
		if not ok then
			return { ok = false, msg = "오류: " .. tostring(result) }
		end
		return { ok = true, msg = result }
	end
end

-- 입장 시 호출: 허용되지 않으면 내보냄
function AdminService.Gate(player)
	if not AdminService.CanJoin(player) then
		player:Kick(Config.CBT.KickMessage)
		return false
	end
	player:SetAttribute("IsAdmin", AdminService.IsAdmin(player))
	player:SetAttribute("DevTools", RunService:IsStudio() or Config.DevTools)
	return true
end

return AdminService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">BotService</string><ProtectedString name="Source"><![CDATA[-- 인원이 부족할 때 자리를 채우는 간단한 AI 봇
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Weapons = require(ReplicatedStorage.Shared.Weapons)
local Combatants = require(script.Parent.Combatants)
local CombatService = require(script.Parent.CombatService)

local BotService = {}

local BOT_NAMES = { "Splatty", "NeonNinja", "DripKing", "PaintPanda", "Chromo", "Spritz", "Gloopy", "Blotto",
	"Inkredible", "Hue_Jack", "Smudge", "PrismPop", "Dribble", "Tagger", "Vandal_V", "Swatch" }
local nameIndex = 0
local goalProvider = nil
local cellsFolder = nil
local running = false
local state = {} -- entity -> { Goal, GoalTime, LastPos, StuckTime, Strafe }

function BotService.NextName()
	nameIndex = nameIndex % #BOT_NAMES + 1
	return "[BOT] " .. BOT_NAMES[nameIndex]
end

function BotService.RandomWeapon()
	local pool = { "Pistol", "Rifle", "SMG", "Shotgun", "Launcher", "Rifle" }
	return pool[math.random(1, #pool)]
end

function BotService.SetGoalProvider(fn)
	goalProvider = fn
end

function BotService.SetCells(folder)
	cellsFolder = folder
end

function BotService.CreateModel(e, cframe, color)
	local folder = workspace:FindFirstChild("Bots")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Bots"
		folder.Parent = workspace
	end
	local desc = Instance.new("HumanoidDescription")
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = e.Name
	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.MaxHealth = Config.MaxHealth
	hum.Health = Config.MaxHealth
	hum.WalkSpeed = Config.WalkSpeed
	hum.DisplayName = e.Name
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Name == "UpperTorso" or d.Name == "LowerTorso" then
				d.Color = color
			elseif d.Name ~= "HumanoidRootPart" then
				d.Color = color:Lerp(Color3.new(1, 1, 1), 0.55)
			end
		end
	end
	-- 총·헬멧·백팩은 MatchService가 플레이어와 똑같이 붙임 (ModelKit)
	model:PivotTo(cframe)
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		root:SetNetworkOwner(nil)
	end
	state[e] = { Goal = nil, GoalTime = 0, LastPos = cframe.Position, StuckTime = 0, Strafe = 1 }
	return model
end

local function canSee(e, fromPos, target)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { e.Model, workspace:FindFirstChild("FX") }
	local dir = target.Position - fromPos
	local hit = workspace:Raycast(fromPos, dir, params)
	return hit and hit.Instance:IsDescendantOf(target.Parent)
end

local function randomEnemyCell(e)
	if not cellsFolder then
		return nil
	end
	local cells = cellsFolder:GetChildren()
	if #cells == 0 then
		return nil
	end
	local root = e.Model.HumanoidRootPart
	local best, bestScore = nil, math.huge
	for _ = 1, 14 do
		local c = cells[math.random(1, #cells)]
		if c:GetAttribute("Owner") ~= e.OwnerId then
			local score = (c.Position - root.Position).Magnitude + math.random() * 25
			if score < bestScore then
				best, bestScore = c, score
			end
		end
	end
	return best and best.Position or cells[math.random(1, #cells)].Position
end

local function spreadDir(dir, degrees)
	if degrees <= 0 then
		return dir.Unit
	end
	local r = math.rad(degrees)
	local cf = CFrame.lookAt(Vector3.zero, dir)
	local a = math.random() * math.pi * 2
	local m = math.random() * r
	return (cf * CFrame.Angles(math.cos(a) * m, math.sin(a) * m, 0)).LookVector
end

local function fireAt(e, head, targetPos, extraSpread)
	local w = Weapons.Get(e.WeaponId)
	local dirs = {}
	local base = targetPos - head.Position
	for i = 1, w.Pellets do
		dirs[i] = spreadDir(base, w.Spread + (extraSpread or 0))
	end
	CombatService.Fire(e, head.Position, dirs)
	-- 다른 플레이어 화면에서 봇 상체·팔이 표적 쪽으로 기울도록
	if e.Model and base.Magnitude > 0.1 then
		local pitch = math.floor(math.deg(math.asin(math.clamp(base.Unit.Y, -1, 1))) + 0.5)
		if math.abs((e.Model:GetAttribute("AimPitch") or 0) - pitch) >= 3 then
			e.Model:SetAttribute("AimPitch", pitch)
		end
	end
end

local function think(e)
	local model = e.Model
	local hum = model and model:FindFirstChildOfClass("Humanoid")
	local root = model and model:FindFirstChild("HumanoidRootPart")
	local head = model and model:FindFirstChild("Head")
	if not hum or not root or not head or hum.Health <= 0 then
		return
	end
	local s = state[e]
	if not s then
		s = { Goal = nil, GoalTime = 0, LastPos = root.Position, StuckTime = 0, Strafe = 1 }
		state[e] = s
	end
	local w = Weapons.Get(e.WeaponId)
	local now = os.clock()

	-- 1) 보이는 가장 가까운 적
	local target, targetDist = nil, w.Range * 0.85
	for _, other in ipairs(Combatants.All()) do
		if other.Alive and Combatants.IsEnemy(e, other) and other.Model then
			local tr = other.Model:FindFirstChild("UpperTorso") or other.Model:FindFirstChild("HumanoidRootPart")
			if tr then
				local d = (tr.Position - head.Position).Magnitude
				if d < targetDist and canSee(e, head.Position, tr) then
					target, targetDist = tr, d
				end
			end
		end
	end

	if target then
		-- 교전: 좌우로 흔들며 사격
		if math.random() < 0.15 then
			s.Strafe = -s.Strafe
		end
		local side = (target.Position - root.Position):Cross(Vector3.yAxis)
		if side.Magnitude > 0.1 then
			hum:MoveTo(root.Position + side.Unit * 6 * s.Strafe)
		end
		root.CFrame = CFrame.lookAt(root.Position, Vector3.new(target.Position.X, root.Position.Y, target.Position.Z))
		if e.Ink >= w.InkCost then
			local aimErr = 1.5 + targetDist * 0.04
			fireAt(e, head, target.Position + Vector3.new(0, math.random() * 0.8, 0), aimErr)
		end
		if e.Special >= Config.SpecialCells and math.random() < 0.3 then
			CombatService.UseSpecial(e, target.Position)
		end
		return
	end

	-- 2) 목표 지점으로 이동하며 바닥 칠하기
	local goalNeeded = (not s.Goal) or (now - s.GoalTime > 6) or ((s.Goal - root.Position) * Vector3.new(1, 0, 1)).Magnitude < 4
	if goalNeeded then
		local g = nil
		if goalProvider and math.random() < 0.55 then
			g = goalProvider(e)
		end
		s.Goal = g or randomEnemyCell(e)
		s.GoalTime = now
	end
	if s.Goal then
		hum:MoveTo(s.Goal)
		if e.Ink > 25 then
			local flat = (s.Goal - root.Position) * Vector3.new(1, 0, 1)
			if flat.Magnitude > 0.1 then
				local aimPoint = root.Position + flat.Unit * math.min(w.Range * 0.6, 14) - Vector3.new(0, 3, 0)
				fireAt(e, head, aimPoint, 3)
			end
		end
		if e.Special >= Config.SpecialCells and math.random() < 0.05 then
			CombatService.UseSpecial(e, s.Goal)
		end
	end

	-- 3) 끼임 탈출
	if (root.Position - s.LastPos).Magnitude < 0.5 then
		s.StuckTime = s.StuckTime + 0.2
		if s.StuckTime > 1.2 then
			-- 앞이 낭떠러지(스카이 루프탑 빌딩 사이)면 뛰지 않고 목표만 바꿈
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { model }
			local ahead = root.Position + root.CFrame.LookVector * 5 + Vector3.new(0, 2, 0)
			if workspace:Raycast(ahead, Vector3.new(0, -25, 0), params) then
				hum.Jump = true
			end
			s.Goal = nil
			s.StuckTime = 0
		end
	else
		s.StuckTime = 0
	end
	s.LastPos = root.Position
end

function BotService.Start()
	if running then
		return
	end
	running = true
	task.spawn(function()
		while running do
			for _, e in ipairs(Combatants.All()) do
				if e.IsBot and e.Alive then
					local ok, err = pcall(think, e)
					if not ok then
						warn("[SplashFront] bot error:", err)
					end
				end
			end
			task.wait(0.2)
		end
	end)
end

function BotService.Stop()
	running = false
	state = {}
	local folder = workspace:FindFirstChild("Bots")
	if folder then
		folder:ClearAllChildren()
	end
end

return BotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">CityMap</string><ProtectedString name="Source"><![CDATA[-- 맵 3: 시가전 (Big City)
-- Studio 인벤토리에서 넣은 "BigCity" 모델(ServerStorage 또는 ServerStorage.Maps 안)을 복제해 전장으로 씀.
-- 모델 안의 스크립트는 안전을 위해 모두 지우고, 도로·광장처럼 평평한 바닥을 위에서 쏘아 찾아 페인트 셀을 깐다.
-- 카툰 외곽선·흰색 팔레트·표면 텍스처는 적용하지 않음 (원본 질감 + 사실적인 흐린 오후 조명)
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local CityMap = {}

local CELL = Config.CellSize
local ORIGIN = Vector3.new(2800, 0, 0) -- 다른 맵과 겹치지 않는 곳
local MAX_X, MAX_Z = 380, 260          -- 전투 구역 최대 크기 (도시가 더 크면 가운데만 사용)
local WALL_H = 160

local function findSource()
	local names = { "BigCity", "Big City", "Big_City" }
	for _, holder in ipairs({ ServerStorage:FindFirstChild("Maps"), ServerStorage, workspace }) do
		if holder then
			for _, n in ipairs(names) do
				local m = holder:FindFirstChild(n)
				if m and (m:IsA("Model") or m:IsA("Folder")) then
					return m
				end
			end
		end
	end
	return nil
end

local function wall(parent, size, pos)
	local p = Instance.new("Part")
	p.Name = "CityBoundary"
	p.Anchored = true
	p.Size = size
	p.Position = pos
	p.Transparency = 1
	p.CanQuery = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

local function cell(parent, pos)
	local c = Instance.new("Part")
	c.Name = "Cell"
	c.Anchored = true
	c.Size = Vector3.new(CELL - 0.08, 0.2, CELL - 0.08)
	c.Position = pos + Vector3.new(0, 0.1, 0)
	c.Color = Config.NeutralColor
	c.Material = Enum.Material.SmoothPlastic
	c.CanCollide = false
	c.CanTouch = false
	c.CastShadow = false
	c.Transparency = 1 -- 판정용 격자, 화면의 페인트는 클라이언트 PaintVisual이 그림
	c:SetAttribute("Owner", 0)
	c.Parent = parent
	return c
end

function CityMap.Build()
	local src = findSource()
	if not src then
		warn("[SplashFront] 시가전 맵: ServerStorage에 'BigCity' 모델이 없어 건너뜀")
		return nil
	end
	local old = workspace:FindFirstChild("Arena_City")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "Arena_City"
	root.Parent = workspace
	local cells = Instance.new("Folder")
	cells.Name = "Cells"
	cells.Parent = root

	local geo = src:Clone()
	geo.Name = "Geometry"
	-- 무료 모델 안의 스크립트(바이러스·지연 로딩 등)는 실행되지 않게 제거
	for _, d in ipairs(geo:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") then
			d:Destroy()
		end
	end
	local model = geo
	if not geo:IsA("Model") then
		model = Instance.new("Model")
		model.Name = "Geometry"
		for _, c in ipairs(geo:GetChildren()) do
			c.Parent = model
		end
		geo:Destroy()
	end
	model.Parent = root
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		elseif d:IsA("Sound") then
			d:Stop()
		end
	end
	-- 모델 중심을 ORIGIN으로
	local bcf, bsize = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() + (ORIGIN - bcf.Position) + Vector3.new(0, bsize.Y / 2, 0))
	bcf, bsize = model:GetBoundingBox()
	local top = bcf.Position.Y + bsize.Y / 2 + 5
	local bottom = bcf.Position.Y - bsize.Y / 2

	-- 바닥 높이 = 위에서 쏜 광선이 가장 많이 닿은 높이 (도로)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { model }
	local hx = math.min(bsize.X / 2 - 6, MAX_X / 2)
	local hz = math.min(bsize.Z / 2 - 6, MAX_Z / 2)
	-- 긴 쪽을 X(팀 진영 방향)로
	local swap = hz > hx
	local hist = {}
	local samples = {}
	local x = -hx + CELL / 2
	while x < hx do
		local z = -hz + CELL / 2
		while z < hz do
			local p = ORIGIN + Vector3.new(x, 0, z)
			local hit = workspace:Raycast(Vector3.new(p.X, top, p.Z), Vector3.new(0, bottom - top - 5, 0), params)
			if hit and hit.Normal.Y > 0.9 then
				local key = math.floor(hit.Position.Y + 0.5)
				hist[key] = (hist[key] or 0) + 1
				table.insert(samples, { X = p.X, Z = p.Z, Y = hit.Position.Y })
			end
			z = z + CELL
		end
		x = x + CELL
	end
	local groundY, best = bottom, 0
	for k, n in pairs(hist) do
		if n > best then
			groundY, best = k, n
		end
	end

	-- 바닥 셀: 도로 높이 ±3 이내의 평평한 곳만 (건물 지붕 아래·내부는 제외)
	local list = {}
	for _, s in ipairs(samples) do
		if math.abs(s.Y - groundY) <= 3 then
			local c = cell(cells, Vector3.new(s.X, s.Y, s.Z))
			table.insert(list, c)
		end
	end

	-- 전투 구역 경계 (투명 벽 + 천장)
	local cx, cz = ORIGIN.X, ORIGIN.Z
	local midY = groundY + WALL_H / 2
	wall(root, Vector3.new(hx * 2 + 4, WALL_H, 2), Vector3.new(cx, midY, cz - hz - 1))
	wall(root, Vector3.new(hx * 2 + 4, WALL_H, 2), Vector3.new(cx, midY, cz + hz + 1))
	wall(root, Vector3.new(2, WALL_H, hz * 2 + 4), Vector3.new(cx - hx - 1, midY, cz))
	wall(root, Vector3.new(2, WALL_H, hz * 2 + 4), Vector3.new(cx + hx + 1, midY, cz))
	wall(root, Vector3.new(hx * 2 + 4, 2, hz * 2 + 4), Vector3.new(cx, groundY + WALL_H, cz))
	-- 바닥 아래 안전판 (모델 바닥에 구멍이 있어도 떨어지지 않게)
	local floor = wall(root, Vector3.new(hx * 2 + 4, 2, hz * 2 + 4), Vector3.new(cx, groundY - 1.2, cz))
	floor.Name = "CitySafetyFloor"

	-- 먼 배경: 도시 둘레의 낮은 산 능선 (대기 안개에 실루엣으로 보이도록 어두운 녹갈색, 충돌·판정 없음)
	local backdrop = Instance.new("Folder")
	backdrop.Name = "Backdrop"
	backdrop.Parent = root
	local rng = Random.new(1957)
	local ringR = math.max(bsize.X, bsize.Z) / 2 + 260
	local count = 28
	for i = 1, count do
		local ang = (i / count) * math.pi * 2 + rng:NextNumber(-0.06, 0.06)
		local h = rng:NextNumber(90, 210)
		local w = rng:NextNumber(220, 360)
		local r = ringR + rng:NextNumber(-40, 80)
		local pos = Vector3.new(cx + math.cos(ang) * r, groundY + h / 2 - 6, cz + math.sin(ang) * r)
		local face = CFrame.lookAt(pos, Vector3.new(cx, pos.Y, cz))
		for k = -1, 1, 2 do
			local wdg = Instance.new("WedgePart")
			wdg.Name = "Ridge"
			wdg.Anchored = true
			wdg.CanCollide = false
			wdg.CanQuery = false
			wdg.CanTouch = false
			wdg.CastShadow = false
			wdg.Material = Enum.Material.Ground
			wdg.Color = Color3.fromRGB(62 + rng:NextInteger(-8, 8), 66 + rng:NextInteger(-8, 8), 52)
			wdg.Size = Vector3.new(w * 0.9, h, w / 2)
			-- 쐐기 두 개를 등지게 붙여 삼각 능선
			wdg.CFrame = face * CFrame.new(0, 0, -k * w / 4) * CFrame.Angles(0, k == 1 and 0 or math.pi, 0)
			wdg.Parent = backdrop
		end
	end
	local base = Instance.new("Part")
	base.Name = "OuterGround"
	base.Anchored = true
	base.CanCollide = false
	base.CanQuery = false
	base.CastShadow = false
	base.Material = Enum.Material.Ground
	base.Color = Color3.fromRGB(72, 70, 58)
	base.Size = Vector3.new(ringR * 2.4, 1, ringR * 2.4)
	base.Position = Vector3.new(cx, groundY - 3, cz)
	base.Parent = backdrop

	-- 진영 축: 긴 쪽
	local function axisPos(a, b) -- a = 진영 축 좌표, b = 옆 축 좌표
		if swap then
			return Vector3.new(cx + b, groundY, cz + a)
		end
		return Vector3.new(cx + a, groundY, cz + b)
	end
	local along = swap and hz or hx
	local function axisOf(c)
		local d = c.Position - ORIGIN
		return swap and d.Z or d.X, swap and d.X or d.Z
	end

	-- 스폰: 양 끝 거리 18 이내의 바닥 셀 중 옆으로 흩어진 5곳
	local function pickEnd(sign)
		local cand = {}
		for _, c in ipairs(list) do
			local a = axisOf(c)
			if a * sign > along - 22 then
				table.insert(cand, c)
			end
		end
		table.sort(cand, function(p, q)
			local _, bp = axisOf(p)
			local _, bq = axisOf(q)
			return bp < bq
		end)
		local out = {}
		local n = #cand
		for i = 1, 5 do
			local c = cand[math.max(1, math.floor(n * (i - 0.5) / 5 + 0.5))]
			if c then
				local pos = c.Position + Vector3.new(0, 3.5, 0)
				table.insert(out, CFrame.lookAt(pos, Vector3.new(cx, pos.Y, cz)))
			end
		end
		if #out == 0 then
			local pos = axisPos(sign * (along - 10), 0) + Vector3.new(0, 4, 0)
			table.insert(out, CFrame.lookAt(pos, Vector3.new(cx, pos.Y, cz)))
		end
		return out
	end
	local spawns = { [1] = pickEnd(-1), [2] = pickEnd(1) }

	-- 셀 중 목표 지점에 가장 가까운 바닥
	local function nearestGround(target)
		local bestC, bestD = nil, math.huge
		for _, c in ipairs(list) do
			local d = (Vector3.new(c.Position.X, 0, c.Position.Z) - Vector3.new(target.X, 0, target.Z)).Magnitude
			if d < bestD then
				bestC, bestD = c, d
			end
		end
		return bestC and (bestC.Position + Vector3.new(0, 0.2, 0)) or target
	end
	local side = swap and hx or hz
	local solo = {}
	for _, p in ipairs({ { -0.9, 0 }, { 0.9, 0 }, { 0, 0.8 }, { 0, -0.8 }, { -0.5, 0.7 }, { 0.5, -0.7 }, { 0.5, 0.7 }, { -0.5, -0.7 } }) do
		local g = nearestGround(axisPos(p[1] * along, p[2] * side)) + Vector3.new(0, 3.5, 0)
		table.insert(solo, CFrame.lookAt(g, Vector3.new(cx, g.Y, cz)))
	end
	local missionSpots = {}
	for _, p in ipairs({ { 0, 0 }, { -0.35, 0.5 }, { 0.35, -0.5 }, { -0.35, -0.5 }, { 0.35, 0.5 }, { 0, 0.6 }, { 0, -0.6 }, { -0.5, 0 }, { 0.5, 0 } }) do
		table.insert(missionSpots, nearestGround(axisPos(p[1] * along, p[2] * side)))
	end

	print(string.format("[SplashFront] 시가전 맵 준비: 바닥 셀 %d개, 도로 높이 %.1f, 전투 구역 %dx%d", #list, groundY, hx * 2, hz * 2))
	return {
		Id = "BigCity",
		Name = "시가전",
		Folder = root,
		Geometry = model,
		Cells = cells,
		Spawns = spawns,
		SoloSpawns = solo,
		FlagPoints = {
			{ Name = "A", Position = nearestGround(axisPos(0, -0.55 * side)) },
			{ Name = "C", Position = nearestGround(axisPos(0, 0)) },
			{ Name = "B", Position = nearestGround(axisPos(0, 0.55 * side)) },
		},
		MissionSpots = missionSpots,
		BaseCenters = { [1] = axisPos(-(along - 10), 0), [2] = axisPos(along - 10, 0) },
		KillY = groundY - 40,
		Lighting = "City",
		NoTextures = true,
		Realistic = true,
		TeamBanners = {},
	}
end

return CityMap
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[-- 사격·피해·스페셜·잉크/체력 회복 (서버 권한 판정)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Weapons = require(ReplicatedStorage.Shared.Weapons)
local Combatants = require(script.Parent.Combatants)
local PaintService = require(script.Parent.PaintService)

local CombatService = {}

local remotes = nil
local colorOf = function()
	return Config.NeutralColor
end
local active = false

function CombatService.Init(remoteFolder)
	remotes = remoteFolder
	remotes.Fire.OnServerEvent:Connect(CombatService.OnPlayerFire)
	remotes.Special.OnServerEvent:Connect(CombatService.OnPlayerSpecial)
end

function CombatService.SetActive(on)
	active = on
end

function CombatService.SetColorResolver(fn)
	colorOf = fn
end

local function rootOf(e)
	local m = e.Model
	return m and m:FindFirstChild("HumanoidRootPart")
end

local function humanoidOf(e)
	local m = e.Model
	return m and m:FindFirstChildOfClass("Humanoid")
end

local function headOf(e)
	local m = e.Model
	return m and m:FindFirstChild("Head")
end

local function fxFolder()
	local f = workspace:FindFirstChild("FX")
	if not f then
		f = Instance.new("Folder")
		f.Name = "FX"
		f.Parent = workspace
	end
	return f
end

------------------------------------------------------------------------
-- 피해
------------------------------------------------------------------------
function CombatService.Damage(attacker, victim, amount, headshot, hitPos)
	if not victim.Alive then
		return false
	end
	if os.clock() < victim.ProtectedUntil then
		return false
	end
	local hum = humanoidOf(victim)
	if not hum or hum.Health <= 0 then
		return false
	end
	victim.LastDamaged = os.clock()
	victim.LastAttacker = attacker
	victim.LastHeadshot = headshot
	local newHealth = math.max(0, hum.Health - amount)
	hum.Health = newHealth
	local killed = newHealth <= 0

	if attacker and attacker.Player then
		remotes.HitConfirm:FireClient(attacker.Player, {
			Damage = math.floor(amount + 0.5), Head = headshot, Pos = hitPos, Kill = killed,
		})
	end
	if victim.Player then
		local from = rootOf(attacker or victim)
		local color = attacker and colorOf(attacker.OwnerId) or nil
		remotes.Damaged:FireClient(victim.Player, from and from.Position or hitPos, amount, color)
	end
	return killed
end

local function splashDamage(attacker, center, radius, maxDamage)
	for _, e in ipairs(Combatants.All()) do
		if e.Alive and Combatants.IsEnemy(attacker, e) then
			local r = rootOf(e)
			if r then
				local d = (r.Position - center).Magnitude
				if d <= radius then
					local dmg = maxDamage * (1 - 0.5 * (d / radius))
					CombatService.Damage(attacker, e, dmg, false, r.Position)
				end
			end
		end
	end
end

------------------------------------------------------------------------
-- 명중 보정 (지연 보상): 서버에서 보는 적 위치는 쏜 사람 화면보다 조금 늦으므로
-- 레이가 적 머리·몸통 가까이(허용 거리 안) 지나가면 명중으로 인정. 벽 뒤는 인정 안 함
------------------------------------------------------------------------
local BODY_PARTS = { "UpperTorso", "LowerTorso", "Torso", "HumanoidRootPart" }
local function assistHit(e, origin, dir, maxDist, params)
	local A = Config.HitAssist
	if not A then
		return nil
	end
	local best, bestT, bestHead = nil, math.huge, false
	for _, v in ipairs(Combatants.All()) do
		if v.Alive and v.Model and Combatants.IsEnemy(e, v) then
			local function perpOf(part)
				local rel = part.Position - origin
				local t = rel:Dot(dir)
				if t <= 0 or t > maxDist then
					return math.huge, t
				end
				return (rel - dir * t).Magnitude, t
			end
			local head = v.Model:FindFirstChild("Head")
			local hp, ht = math.huge, 0
			if head then
				hp, ht = perpOf(head)
			end
			local bp, bt = math.huge, 0
			for _, n in ipairs(BODY_PARTS) do
				local part = v.Model:FindFirstChild(n)
				if part then
					local p2, t2 = perpOf(part)
					if p2 < bp then
						bp, bt = p2, t2
					end
				end
			end
			local isHead, t = nil, nil
			if hp <= A.Head + ht * A.PerStud then
				isHead, t = true, ht
			elseif bp <= A.Body + bt * A.PerStud then
				isHead, t = false, bt
			end
			if t and t < bestT then
				-- 시야 확인: 맞힌 지점까지 벽이 없어야 함
				local p = origin + dir * t
				local block = workspace:Raycast(origin, p - origin, params)
				if not block or Combatants.FromPart(block.Instance) == v or (block.Position - origin).Magnitude >= t - 1.5 then
					best, bestT, bestHead = v, t, isHead
				end
			end
		end
	end
	if best then
		return best, bestHead, origin + dir * bestT
	end
	return nil
end

------------------------------------------------------------------------
-- 사격 (플레이어·봇 공용)
------------------------------------------------------------------------
-- 쏜 사람 화면에서 맞힌 지점(claim)을 검증: 그 캐릭터가 서버에서도 근처에 있고, 탄도 위에 있고, 벽에 막히지 않았으면 인정
local function verifyClaim(e, origin, dir, range, claim)
	local K = Config.HitClaim
	if not K or type(claim) ~= "table" or typeof(claim.Part) ~= "Instance" or typeof(claim.Pos) ~= "Vector3" then
		return nil
	end
	if not claim.Part:IsA("BasePart") then
		return nil
	end
	local v = Combatants.FromPart(claim.Part)
	if not v or not v.Alive or not Combatants.IsEnemy(e, v) then
		return nil
	end
	local rel = claim.Pos - origin
	local t = rel:Dot(dir)
	if t <= 0 or t > range or (rel - dir * t).Magnitude > K.MaxPerp then
		return nil
	end
	if (claim.Part.Position - claim.Pos).Magnitude > K.MaxMove + claim.Part.Size.Magnitude / 2 then
		return nil
	end
	-- 시야: 캐릭터들을 빼고 지형만으로 막히는지
	local ignore = { e.Model, fxFolder(), workspace:FindFirstChild("Lobby"), workspace:FindFirstChild("Bots") }
	for _, o in ipairs(Combatants.All()) do
		if o.Model then
			table.insert(ignore, o.Model)
		end
	end
	local mp = RaycastParams.new()
	mp.FilterType = Enum.RaycastFilterType.Exclude
	mp.FilterDescendantsInstances = ignore
	if workspace:Raycast(origin, rel * 0.98, mp) then
		return nil
	end
	local part = claim.Part
	local isHead = part.Name == "Head"
	if not isHead and part.Parent and part.Parent:IsA("Accessory") then
		for _, a in ipairs(part:GetChildren()) do
			if a:IsA("Attachment") and (string.find(a.Name, "Hat") or string.find(a.Name, "Hair") or string.find(a.Name, "Face")) then
				isHead = true
			end
		end
	end
	local target = isHead and (v.Model:FindFirstChild("Head") or part) or part
	return { Instance = target, Position = claim.Pos, Normal = -dir }
end

function CombatService.Fire(e, origin, directions, claims)
	if not active or not e.Alive then
		return false
	end
	local w = Weapons.Get(e.WeaponId)
	local now = os.clock()
	if now - e.LastFire < w.FireInterval * 0.75 then
		return false
	end
	-- 황금총: 잉크 없이 1발, 맞으면 무조건 처치, 쏘면 사라짐
	local golden = e.Golden == true
	if not golden and e.Ink < w.InkCost then
		return false
	end
	local head = headOf(e)
	if not head or (head.Position - origin).Magnitude > 10 then
		return false
	end
	e.LastFire = now
	local range = w.Range
	if golden then
		e.Golden = false
		if e.Player then
			e.Player:SetAttribute("Golden", false)
		end
		range = Config.GoldenRange
	else
		e.Ink = e.Ink - w.InkCost
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { e.Model, fxFolder(), workspace:FindFirstChild("Lobby") }

	local endpoints = {}
	local count = golden and math.min(#directions, 1) or math.min(#directions, w.Pellets)
	for i = 1, count do
		local dir = directions[i]
		if typeof(dir) == "Vector3" and dir.Magnitude > 0.5 then
			dir = dir.Unit
			e.Shots = (e.Shots or 0) + 1
			local result = workspace:Raycast(origin, dir * range, params)
			local endPos
			-- 서버 레이가 빗나갔으면(지연 때문에 적이 서버에서 조금 옆에 있음) 플레이어 사격에 한해
			-- 1) 쏜 사람 화면의 명중 판정을 검증해 인정  2) 그래도 없으면 탄도 근처 적 보정
			local directVictim = result and Combatants.FromPart(result.Instance)
			if e.Player and not (directVictim and Combatants.IsEnemy(e, directVictim)) then
				local claimed = verifyClaim(e, origin, dir, range, type(claims) == "table" and claims[i] or nil)
				if claimed then
					result = claimed
				else
					local maxDist = result and ((result.Position - origin).Magnitude + 1) or range
					local v, isHead, pos = assistHit(e, origin, dir, maxDist, params)
					if v then
						local part = v.Model:FindFirstChild(isHead and "Head" or "UpperTorso") or v.Model:FindFirstChild("HumanoidRootPart")
						result = { Instance = part, Position = pos, Normal = -dir }
					end
				end
			end
			if result then
				endPos = result.Position
				local victim = Combatants.FromPart(result.Instance)
				if victim then
					if Combatants.IsEnemy(e, victim) then
						local isHead = result.Instance.Name == "Head"
						e.Hits = (e.Hits or 0) + 1
						if isHead then
							e.Headshots = (e.Headshots or 0) + 1
						end
						local dmg = golden and 9999 or (w.Damage * (isHead and w.HeadMul or 1))
						CombatService.Damage(e, victim, dmg, isHead, endPos)
						PaintService.PaintBelow(endPos, 2.5, e.OwnerId, e)
					end
				elseif result.Normal.Y > 0.5 then
					PaintService.PaintAt(endPos, w.PaintRadius, e.OwnerId, e)
				else
					-- 벽에 맞으면 아래로 흘러내림
					PaintService.PaintBelow(endPos + result.Normal * 1.5, w.PaintRadius * 0.7, e.OwnerId, e)
				end
				if w.Splash > 0 then
					splashDamage(e, endPos, w.Splash, w.Damage)
					PaintService.PaintBelow(endPos + Vector3.new(0, 2, 0), w.PaintRadius, e.OwnerId, e)
				end
			else
				endPos = origin + dir * range
				PaintService.PaintBelow(endPos, w.PaintRadius * 0.7, e.OwnerId, e)
			end
			if w.PathPaint then
				local dist = math.min((endPos - origin).Magnitude, w.PathMax or 240)
				local step = w.PathStep or 7
				local d = step
				while d < dist do
					PaintService.PaintBelow(origin + dir * d, w.PathRadius or 2.5, e.OwnerId, e)
					d = d + step
				end
			end
			table.insert(endpoints, endPos)
		end
	end

	remotes.FX:FireAllClients("Tracer", {
		Shooter = e.Player, From = origin, To = endpoints, Color = golden and Color3.fromRGB(255, 205, 40) or colorOf(e.OwnerId), Weapon = w.Id,
		Model = e.Model, Golden = golden,
	})
	Combatants.Sync(e)
	return true
end

function CombatService.OnPlayerFire(player, weaponId, origin, directions, claims)
	local e = Combatants.FromPlayer(player)
	if not e or typeof(origin) ~= "Vector3" or type(directions) ~= "table" then
		return
	end
	if weaponId ~= e.WeaponId then
		return
	end
	CombatService.Fire(e, origin, directions, claims)
end

------------------------------------------------------------------------
-- 스페셜: 크로마 봄
------------------------------------------------------------------------
-- 투척물: 포물선으로 날아가다 바닥·벽·캐릭터에 닿는 순간 onLand(위치) 호출
-- 클라이언트는 같은 초기값(From·Vel·G)으로 공을 그리고 ProjEnd에서 터뜨림
local projCount = 0
function CombatService.Throw(e, target, kind, color, onLand)
	local head = headOf(e)
	if not head or typeof(target) ~= "Vector3" then
		return false
	end
	local T = Config.Throw
	local from = head.Position + Vector3.new(0, 0.6, 0)
	local offset = target - from
	if offset.Magnitude > 75 then
		target = from + offset.Unit * 75
		offset = target - from
	end
	local g = Vector3.new(0, -T.Gravity, 0)
	local flight = math.clamp(offset.Magnitude / T.Speed, 0.25, 1.4)
	local vel = offset / flight - g * (0.5 * flight)
	projCount = projCount + 1
	local id = projCount
	remotes.FX:FireAllClients("Proj", { Id = id, From = from, Vel = vel, G = g, Color = color, Kind = kind })
	task.spawn(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { e.Model, fxFolder(), workspace:FindFirstChild("Lobby") }
		local pos, v, t = from, vel, 0
		local hitPos = nil
		local last = os.clock()
		while t < T.MaxTime and active do
			task.wait()
			local step = math.min(os.clock() - last, 0.1)
			last = os.clock()
			local nv = v + g * step
			local np = pos + (v + nv) * (0.5 * step)
			local r = workspace:Raycast(pos, np - pos, params)
			if r then
				hitPos = r.Position + r.Normal * 0.3
				break
			end
			-- 몸에 스치듯 지나가도 터지게 (근접 신관)
			for _, o in ipairs(Combatants.All()) do
				if o ~= e and o.Alive then
					local root = rootOf(o)
					if root and (root.Position - np).Magnitude < 2.6 then
						hitPos = np
					end
				end
			end
			if hitPos then
				break
			end
			pos, v, t = np, nv, t + step
		end
		hitPos = hitPos or pos
		remotes.FX:FireAllClients("ProjEnd", { Id = id, Pos = hitPos, Kind = kind, Color = color, Radius = Config.SpecialRadius })
		if onLand then
			onLand(hitPos)
		end
	end)
	return true
end

function CombatService.UseSpecial(e, target)
	if not active or not e.Alive or e.Special < Config.SpecialCells then
		return false
	end
	if not headOf(e) or typeof(target) ~= "Vector3" then
		return false
	end
	e.Special = 0
	Combatants.Sync(e)
	local color = colorOf(e.OwnerId)
	if CombatService.OnSpecialUsed and e.Player then
		CombatService.OnSpecialUsed(e.Player)
	end
	CombatService.Throw(e, target, "Bomb", color, function(pos)
		if not active then
			return
		end
		PaintService.PaintBelow(pos + Vector3.new(0, 3, 0), Config.SpecialRadius, e.OwnerId, e)
		PaintService.PaintAt(pos, Config.SpecialRadius * 0.6, e.OwnerId, e)
		splashDamage(e, pos, Config.SpecialRadius, Config.SpecialDamage)
	end)
	return true
end

function CombatService.OnPlayerSpecial(player, target)
	local e = Combatants.FromPlayer(player)
	if e then
		CombatService.UseSpecial(e, target)
	end
end

------------------------------------------------------------------------
-- 잉크 충전·체력 회복 (Main 루프에서 0.1초마다 호출)
------------------------------------------------------------------------
function CombatService.Tick(dt)
	if not active then
		return
	end
	local now = os.clock()
	for _, e in ipairs(Combatants.All()) do
		if e.Alive then
			local root = rootOf(e)
			if root then
				if now - e.LastFire > Config.InkRefillDelay and e.Ink < Config.InkMax then
					local own = PaintService.OwnerBelow(root.Position) == e.OwnerId
					local rate = own and Config.InkRefillOwnColor or Config.InkRefill
					e.Ink = math.min(Config.InkMax, e.Ink + rate * dt)
				end
				local hum = humanoidOf(e)
				if hum and hum.Health > 0 and hum.Health < hum.MaxHealth and now - e.LastDamaged > Config.RegenDelay then
					hum.Health = math.min(hum.MaxHealth, hum.Health + Config.RegenPerSecond * dt)
				end
			end
			Combatants.Sync(e)
		end
	end
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Combatants</string><ProtectedString name="Source"><![CDATA[-- 매치 참가자(플레이어 + 봇) 레지스트리
-- entity = { Id, Name, IsBot, Player, Model, OwnerId, TeamId, WeaponId,
--            Ink, Special, Kills, Deaths, Cells, LastFire, LastDamaged,
--            ProtectedUntil, Spread, Alive }
local Signal = require(script.Parent.Signal)
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local Combatants = {}
Combatants.Painted = Signal.new()   -- (entity, cellsChanged)
Combatants.Killed = Signal.new()    -- (killerEntity|nil, victimEntity, headshot)

local byId = {}
local byModel = {}

function Combatants.New(fields)
	local e = {
		Id = fields.Id,
		Name = fields.Name,
		IsBot = fields.IsBot or false,
		Player = fields.Player,
		Model = nil,
		OwnerId = fields.OwnerId,
		TeamId = fields.TeamId,
		WeaponId = fields.WeaponId or "Pistol",
		Ink = Config.InkMax,
		Special = 0,
		Kills = 0,
		Deaths = 0,
		Cells = 0,
		MissionWins = 0,
		LastFire = 0,
		LastDamaged = 0,
		ProtectedUntil = 0,
		Spread = 0,
		Alive = false,
		Coins = 0,
	}
	byId[e.Id] = e
	return e
end

function Combatants.SetModel(e, model)
	if e.Model then
		byModel[e.Model] = nil
	end
	e.Model = model
	if model then
		byModel[model] = e
	end
end

function Combatants.Remove(e)
	if e.Model then
		byModel[e.Model] = nil
	end
	byId[e.Id] = nil
end

function Combatants.Clear()
	byId = {}
	byModel = {}
end

function Combatants.FromModel(model)
	return byModel[model]
end

function Combatants.FromPart(part)
	local node = part
	while node and node ~= workspace do
		local e = byModel[node]
		if e then
			return e
		end
		node = node.Parent
	end
	return nil
end

function Combatants.FromPlayer(player)
	return byId["P" .. player.UserId]
end

function Combatants.All()
	local list = {}
	for _, e in pairs(byId) do
		table.insert(list, e)
	end
	return list
end

function Combatants.IsEnemy(a, b)
	return a ~= b and a.TeamId ~= b.TeamId
end

-- 플레이어 HUD 동기화용 (속성은 자동 복제됨)
function Combatants.Sync(e)
	if e.Player then
		e.Player:SetAttribute("Ink", math.floor(e.Ink + 0.5))
		e.Player:SetAttribute("Special", math.min(1, e.Special / Config.SpecialCells))
		e.Player:SetAttribute("MatchKills", e.Kills)
		e.Player:SetAttribute("MatchCells", e.Cells)
	end
end

return Combatants
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">CrateService</string><ProtectedString name="Source"><![CDATA[-- 크로마 크레이트(랜덤 상자) 개봉 + 외형 장착
-- 실제 판매: Creator Hub에서 79 R$ 개발자 상품을 만들고 Config.Monetization.CrateProductId에 ID 입력
-- Studio에서는 상품 ID 없이 "테스트 개봉" 버튼으로 확률·연출 확인 가능
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
local DataService = require(script.Parent.DataService)
local Telemetry = require(script.Parent.TelemetryService)

local CrateService = {}

local rng = Random.new()
local remotes = nil

-- 상자 하나 개봉. 결과 테이블 반환 (구매 처리 성공 후에만 호출)
function CrateService.Open(player)
	local p = DataService.Get(player)
	if not p then
		return nil
	end
	p.CratePity = (p.CratePity or 0) + 1
	p.CratesOpened = (p.CratesOpened or 0) + 1
	local pityHit = p.CratePity >= Cosmetics.PityCount
	local item, rarity = Cosmetics.Roll(rng, pityHit)
	if rarity.Id == "Legendary" then
		p.CratePity = 0
	end
	local duplicate = p.Cosmetics[item.Id] == true
	local refund = 0
	if duplicate then
		refund = rarity.Refund
		p.Coins = p.Coins + refund
	else
		p.Cosmetics[item.Id] = true
	end
	DataService.Publish(player)
	DataService.Save(player)
	Telemetry.Custom(player, "CrateOpen", 1, rarity.Id, item.Id, duplicate and "dup" or "new")
	if refund > 0 then
		Telemetry.Economy(player, true, refund, p.Coins, "Gameplay", "CrateRefund")
	end
	local result = {
		ItemId = item.Id, Name = item.Name, Kind = item.Kind, Rarity = rarity.Id, RarityName = rarity.Name,
		Color = rarity.Color, Duplicate = duplicate, Refund = refund, Pity = p.CratePity, Pitied = pityHit,
	}
	remotes.CrateResult:FireClient(player, result)
	return result
end

function CrateService.Equip(player, itemId)
	local p = DataService.Get(player)
	local item = Cosmetics.ById[itemId]
	if not p then
		return { ok = false, msg = "데이터 없음" }
	end
	if itemId == nil then
		return { ok = false, msg = "잘못된 요청" }
	end
	if not item or not p.Cosmetics[itemId] then
		return { ok = false, msg = "보유하지 않은 아이템" }
	end
	local slot = (item.Kind == "Skin" and "EquippedSkin") or (item.Kind == "Pattern" and "EquippedPattern") or "EquippedEffect"
	if p[slot] == itemId then
		p[slot] = nil -- 다시 누르면 해제
		DataService.Publish(player)
		return { ok = true, msg = item.Name .. " 해제" }
	end
	p[slot] = itemId
	DataService.Publish(player)
	return { ok = true, msg = item.Name .. " 장착" }
end

-- Studio 전용 무료 테스트 개봉
function CrateService.TestOpen(player)
	if not RunService:IsStudio() then
		return { ok = false, msg = "테스트 개봉은 Studio에서만 가능해요" }
	end
	CrateService.Open(player)
	return { ok = true, msg = "테스트 개봉" }
end

function CrateService.Init(remoteFolder)
	remotes = remoteFolder
end

return CrateService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- 플레이어 저장 데이터 (코인, 보유 무기, 장착 무기, 레이팅, 통계)
-- Studio에서 저장하려면: 게임 설정 > 보안 > "Studio의 API 서비스 액세스 사용" 켜기
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Weapons = require(ReplicatedStorage.Shared.Weapons)

local DataService = {}

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore("SplashFront_Profile_" .. Config.DataVersion)
end)

local profiles = {}

local function defaultProfile()
	return {
		Coins = 300,
		Owned = { [Weapons.Default] = true },
		Equipped = Weapons.Default,
		Rating = Config.Rating.Start,
		Wins = 0,
		Matches = 0,
		Kills = 0,
		Cells = 0,
		Cosmetics = {},          -- [아이템 Id] = true
		EquippedSkin = nil,
		EquippedPattern = nil,
		EquippedEffect = nil,
		CratePity = 0,           -- 마지막 레전더리 이후 개봉 수
		CratesOpened = 0,
		Level = 1,
		XP = 0,
		Quests = {},             -- QuestService가 관리 (기간 키 + 진행도)
	}
end

local function ownedString(owned)
	local list = {}
	for id, v in pairs(owned) do
		if v then
			table.insert(list, id)
		end
	end
	table.sort(list)
	return table.concat(list, ",")
end

function DataService.Publish(player)
	local p = profiles[player]
	if not p then
		return
	end
	player:SetAttribute("Coins", p.Coins)
	player:SetAttribute("Rating", p.Rating)
	player:SetAttribute("Tier", Config.GetTier(p.Rating).Name)
	player:SetAttribute("Weapon", p.Equipped)
	player:SetAttribute("Owned", ownedString(p.Owned))
	player:SetAttribute("Wins", p.Wins)
	player:SetAttribute("Skin", p.EquippedSkin)
	player:SetAttribute("Pattern", p.EquippedPattern)
	player:SetAttribute("KillEffect", p.EquippedEffect)
	player:SetAttribute("OwnedCosmetics", ownedString(p.Cosmetics or {}))
	player:SetAttribute("CratePity", p.CratePity or 0)
	player:SetAttribute("Level", p.Level or 1)
	player:SetAttribute("XP", p.XP or 0)
	player:SetAttribute("XPNeed", Config.XPNeed(p.Level or 1))
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		ls.Rating.Value = p.Rating
		ls.Wins.Value = p.Wins
	end
end

function DataService.Load(player)
	local data = nil
	local failed = false
	if store then
		-- 일시적 오류는 몇 번 다시 시도. 끝내 실패하면 이번 접속은 저장하지 않음 (빈 데이터로 덮어써 구매품을 잃지 않게)
		failed = true
		for attempt = 1, 4 do
			local ok, result = pcall(function()
				return store:GetAsync("u" .. player.UserId)
			end)
			if ok then
				data = result
				failed = false
				break
			end
			warn("[SplashFront] 데이터 불러오기 실패(" .. attempt .. "/4):", result)
			task.wait(attempt * 1.5)
		end
	end
	local p = defaultProfile()
	if type(data) == "table" then
		for k, v in pairs(data) do
			p[k] = v
		end
		if type(p.Owned) ~= "table" then
			p.Owned = { [Weapons.Default] = true }
		end
		p.Owned[Weapons.Default] = true
		if type(p.Cosmetics) ~= "table" then
			p.Cosmetics = {}
		end
	end
	p.LoadFailed = failed or nil
	profiles[player] = p
	if failed then
		player:SetAttribute("DataWarning", "저장 데이터를 불러오지 못했어요. 이번 접속의 구매·진행은 저장되지 않으니 잠시 후 다시 접속해 주세요")
	end

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local r = Instance.new("IntValue")
	r.Name = "Rating"
	r.Parent = ls
	local w = Instance.new("IntValue")
	w.Name = "Wins"
	w.Parent = ls
	ls.Parent = player

	-- VIP 게임패스
	local vip = false
	if Config.Monetization.VipGamePassId ~= 0 then
		pcall(function()
			vip = MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.Monetization.VipGamePassId)
		end)
	end
	player:SetAttribute("Vip", vip)

	player:SetAttribute("FirstMatch", (p.Matches or 0) == 0)
	DataService.Publish(player)
	return p
end

-- 경험치: 레벨업하면 코인 보너스. 반환: 이번에 오른 레벨 수
function DataService.AddXP(player, amount)
	local p = profiles[player]
	if not p or amount <= 0 then
		return 0
	end
	p.Level = p.Level or 1
	p.XP = (p.XP or 0) + math.floor(amount)
	local ups = 0
	while p.XP >= Config.XPNeed(p.Level) do
		p.XP = p.XP - Config.XPNeed(p.Level)
		p.Level = p.Level + 1
		ups = ups + 1
		p.Coins = p.Coins + Config.LevelReward(p.Level)
		player:SetAttribute("LevelUp", p.Level .. ":" .. Config.LevelReward(p.Level) .. ":" .. os.clock())
	end
	DataService.Publish(player)
	return ups
end

function DataService.Reset(player)
	local p = defaultProfile()
	p.ForceReset = true -- 관리자 초기화: 이번 저장은 합치지 않고 덮어씀
	profiles[player] = p
	DataService.Publish(player)
	DataService.Save(player)
end

-- 보유 목록은 합집합으로 저장: 다른 서버가 먼저 저장한 구매품이 있어도 절대 지워지지 않음
local function union(a, b)
	local out = {}
	for k, v in pairs(type(a) == "table" and a or {}) do
		if v then
			out[k] = true
		end
	end
	for k, v in pairs(type(b) == "table" and b or {}) do
		if v then
			out[k] = true
		end
	end
	return out
end

function DataService.Save(player)
	local p = profiles[player]
	if not p or not store or p.LoadFailed then
		return false
	end
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync("u" .. player.UserId, function(old)
				if type(old) == "table" and not p.ForceReset then
					p.Owned = union(old.Owned, p.Owned)
					p.Cosmetics = union(old.Cosmetics, p.Cosmetics)
				end
				p.SavedAt = os.time()
				local copy = table.clone(p)
				copy.LoadFailed = nil
				copy.ForceReset = nil
				return copy
			end)
		end)
		if ok then
			p.ForceReset = nil
			return true
		end
		warn("[SplashFront] 저장 실패(" .. attempt .. "/3):", err)
		task.wait(attempt)
	end
	return false
end

function DataService.IsSafe(player)
	local p = profiles[player]
	return p ~= nil and not p.LoadFailed
end

function DataService.Get(player)
	return profiles[player]
end

function DataService.AddCoins(player, amount)
	local p = profiles[player]
	if not p then
		return 0
	end
	if player:GetAttribute("Vip") then
		amount = math.floor(amount * Config.VipCoinMul + 0.5)
	end
	p.Coins = p.Coins + amount
	DataService.Publish(player)
	return amount
end

function DataService.Unload(player)
	DataService.Save(player)
	profiles[player] = nil
end

function DataService.Start()
	Players.PlayerRemoving:Connect(DataService.Unload)
	game:BindToClose(function()
		-- 서버 종료: 모두 동시에 저장하고 끝날 때까지 기다림
		local pending = 0
		for _, pl in ipairs(Players:GetPlayers()) do
			pending = pending + 1
			task.spawn(function()
				DataService.Save(pl)
				pending = pending - 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for _, pl in ipairs(Players:GetPlayers()) do
				DataService.Save(pl)
			end
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">ImageService</string><ProtectedString name="Source"><![CDATA[-- 업로드한 이미지(데칼)를 게임에 적용
-- 1) 데칼 ID → 실제 이미지 주소 (InsertService로 데칼을 불러와 Texture 속성을 읽음)
-- 2) ReplicatedStorage.Images 폴더 속성으로 공유 (클라이언트 HUD 아이콘: "icon_coin" 등)
-- 3) 맵 표면에 Texture(타일 반복) 입히기 — 판정용 모양은 그대로
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AssetIds = require(ReplicatedStorage.Shared.AssetIds)

local ImageService = {}

local folder = Instance.new("Folder")
folder.Name = "Images"
folder.Parent = ReplicatedStorage
local urls = {}  -- "tex_floor_tile" -> "http://www.roblox.com/asset/?id=..."

local function resolve(decalId)
	local ok, asset = pcall(function()
		return InsertService:LoadAsset(decalId)
	end)
	if not ok or not asset then
		warn("[SplashFront] 이미지 불러오기 실패:", decalId, asset)
		return nil
	end
	local d = asset:FindFirstChildWhichIsA("Decal", true) or asset:FindFirstChildWhichIsA("Texture", true)
	local url = d and d.Texture
	asset:Destroy()
	if url and url ~= "" then
		return url
	end
	return nil
end

function ImageService.Load()
	local n = 0
	for group, list in pairs({ tex = AssetIds.Textures or {}, icon = AssetIds.Icons or {} }) do
		for name, id in pairs(list) do
			if id ~= 0 then
				local url = resolve(id)
				if url then
					urls[group .. "_" .. name] = url
					folder:SetAttribute(group .. "_" .. name, url)
					n = n + 1
				end
			end
		end
	end
	print("[SplashFront] 이미지", n, "개 준비 (없는 이미지는 단색·이모지로 대체)")
end

function ImageService.Url(key)
	return urls[key]
end

------------------------------------------------------------------------
-- 맵 표면 텍스처
------------------------------------------------------------------------
local F = Enum.NormalId
local SIDES = { F.Front, F.Back, F.Left, F.Right }
local ALL = { F.Top, F.Bottom, F.Front, F.Back, F.Left, F.Right }

-- 이름 → { 텍스처, 면 목록, 타일 크기(U, V), 색 입히기 여부 }
local RULES = {
	Floor = { "floor_tile", { F.Top }, 8, 8 },
	Platform = { { "floor_tile", { F.Top }, 8, 8 }, { "wall_panel", SIDES, 8, 8 } },
	MidTower = { { "floor_tile", { F.Top }, 8, 8 }, { "wall_panel", SIDES, 24, 24 } },
	SpawnTower = { { "floor_tile", { F.Top }, 8, 8 }, { "wall_panel", SIDES, 24, 24 } },
	WarehouseRoof = { "floor_tile", { F.Top }, 8, 8 },
	Wall = { "wall_panel", { F.Top, F.Front, F.Back, F.Left, F.Right }, 8, 8 },
	WarehouseWall = { "wall_panel", { F.Top, F.Front, F.Back, F.Left, F.Right }, 8, 8 },
	Boundary = { "wall_panel", SIDES, 8, 8 },
	SpawnWall = { "wall_panel", SIDES, 8, 8 },
	Parapet = { "wall_panel", { F.Top, F.Front, F.Back, F.Left, F.Right }, 6, 6 },
	Lintel = { "wall_panel", SIDES, 8, 8 },
	WallSill = { "hazard", { F.Top, F.Front, F.Back }, 3, 3 },
	Crate = { "crate_wood", ALL, 8, 3 },
	Container = { "container_rib", SIDES, 12.8, 7, true },
	Ramp = { "ramp_plate", { F.Top }, 6, 6 },
	Stage = { "ramp_plate", { F.Top }, 8, 8, true },
}

local function apply(part, texName, faces, u, v, tint)
	local url = urls["tex_" .. texName]
	if not url then
		return
	end
	for _, face in ipairs(faces) do
		local t = Instance.new("Texture")
		t.Name = "SF_Tex"
		t.Texture = url
		t.Face = face
		t.StudsPerTileU = u
		t.StudsPerTileV = v
		if tint then
			t.Color3 = part.Color
		end
		t.Parent = part
	end
end

function ImageService.ApplyTextures(root, overrides)
	if not next(urls) then
		return
	end
	for _, p in ipairs(root:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "Cell" and p.Transparency < 0.5 then
			local rule = (overrides and overrides[p.Name]) or RULES[p.Name]
			if rule then
				if type(rule[1]) == "table" then
					for _, r in ipairs(rule) do
						apply(p, r[1], r[2], r[3], r[4], r[5])
					end
				else
					apply(p, rule[1], rule[2], rule[3], rule[4], rule[5])
				end
			end
		end
	end
end

-- 로비: 어두운 바닥에 타일 무늬를 보라빛으로 물들여 깔기
ImageService.LobbyRules = {
	Floor = { "floor_tile", { F.Top }, 10, 10, true },
	Stage = { "ramp_plate", { F.Top }, 6, 6, true },
}

return ImageService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">ItemService</string><ProtectedString name="Source"><![CDATA[-- 미션 보상 아이템: 보관(최대 3개) · 사용(F) · 순서 바꾸기(G) · 효과 시간 관리
-- 보관함은 플레이어 속성 "Items"(쉼표 목록)로 클라이언트에 보임
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local ModelKit = require(ReplicatedStorage.Shared.ModelKit)
local Combatants = require(script.Parent.Combatants)
local CombatService = require(script.Parent.CombatService)

local ItemService = {}

local remotes = nil
local inv = {}   -- player -> { itemId, ... }
local ById = {}
for _, it in ipairs(Config.Items) do
	ById[it.Id] = it
end
ItemService.ById = ById

local function now()
	return workspace:GetServerTimeNow()
end

local function publish(player)
	player:SetAttribute("Items", table.concat(inv[player] or {}, ","))
end

local function notify(player, text, color)
	if remotes then
		remotes.Notify:FireClient(player, text, color or Color3.fromRGB(255, 230, 120))
	end
end

function ItemService.Grant(player, id)
	if not ById[id] then
		return
	end
	local list = inv[player] or {}
	inv[player] = list
	table.insert(list, id)
	while #list > Config.ItemSlots do
		table.remove(list, 1) -- 가득 차면 가장 오래된 것부터 버림
	end
	publish(player)
	player:SetAttribute("LastItem", id .. ":" .. tostring(os.clock()))
end

function ItemService.GrantRandom(player)
	local total = 0
	for _, it in ipairs(Config.Items) do
		total = total + (it.Weight or 1)
	end
	local r = math.random() * total
	for _, it in ipairs(Config.Items) do
		r = r - (it.Weight or 1)
		if r <= 0 then
			ItemService.Grant(player, it.Id)
			return it
		end
	end
end

function ItemService.Clear(player)
	inv[player] = {}
	publish(player)
	for _, a in ipairs({ "JetpackUntil", "ShieldUntil", "ZoomBuff", "ZoomUntil", "Golden" }) do
		player:SetAttribute(a, nil)
	end
end

------------------------------------------------------------------------
-- 효과
------------------------------------------------------------------------
local function torsoOf(model)
	return model and (model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso"))
end

local function attachJetpack(e, color)
	local model = e.Model
	local torso = torsoOf(model)
	if not torso then
		return
	end
	local old = model:FindFirstChild("SF_Jetpack")
	if old then
		old:Destroy()
	end
	local pack = model:FindFirstChild("SF_Backpack")
	if pack then
		pack:Destroy() -- 잉크 탱크 대신 제트팩을 멤
	end
	local jp = ModelKit.Item("Jetpack", color)
	jp.Name = "SF_Jetpack"
	for _, p in ipairs(jp:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Massless = true
		end
	end
	jp:PivotTo(torso.CFrame * CFrame.new(0, 0.1, torso.Size.Z / 2 + 0.2))
	for _, p in ipairs(jp:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = false
			local w = Instance.new("WeldConstraint")
			w.Part0 = torso
			w.Part1 = p
			w.Parent = p
		end
	end
	-- 노즐 불꽃 (모두에게 보임)
	for _, a in ipairs(jp:GetDescendants()) do
		if a:IsA("Attachment") and a.Name == "Flame" then
			local pe = Instance.new("ParticleEmitter")
			pe.Color = ColorSequence.new(Color3.fromRGB(255, 240, 160), Color3.fromRGB(255, 90, 30))
			pe.LightEmission = 1
			pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 0) })
			pe.Lifetime = NumberRange.new(0.18, 0.3)
			pe.Speed = NumberRange.new(10, 14)
			pe.Rate = 60
			pe.EmissionDirection = Enum.NormalId.Left -- 원기둥을 세웠으므로 로컬 -X = 아래
			pe.SpreadAngle = Vector2.new(8, 8)
			pe.Parent = a
			local l = Instance.new("PointLight")
			l.Color = Color3.fromRGB(255, 170, 60)
			l.Range = 8
			l.Brightness = 2
			l.Parent = a
		end
	end
	jp.Parent = model
end

local function spawnSmoke(pos, duration)
	local fx = workspace:FindFirstChild("FX") or workspace
	local cloud = Instance.new("Model")
	cloud.Name = "SmokeCloud"
	local R = Config.SmokeRadius
	local rng = Random.new()
	for i = 1, 9 do
		local a = rng:NextNumber() * math.pi * 2
		local d = rng:NextNumber(0, R * 0.55)
		local size = rng:NextNumber(R * 0.75, R * 1.1)
		local p = Instance.new("Part")
		p.Name = "Puff"
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.one * 2
		p.Position = pos + Vector3.new(math.cos(a) * d, rng:NextNumber(2, 6), math.sin(a) * d)
		p.Color = Color3.fromRGB(rng:NextInteger(205, 230), rng:NextInteger(208, 232), rng:NextInteger(215, 238))
		p.Material = Enum.Material.SmoothPlastic
		p.Transparency = 0.6
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false -- 총알은 통과(시야만 가림)
		p.CanTouch = false
		p.CastShadow = false
		p.Parent = cloud
		TweenService:Create(p, TweenInfo.new(0.6 + i * 0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = Vector3.one * size, Transparency = 0.04 }):Play()
		task.delay(duration - 1.5, function()
			if p.Parent then
				TweenService:Create(p, TweenInfo.new(1.4), { Transparency = 1 }):Play()
			end
		end)
	end
	local core = cloud:FindFirstChild("Puff")
	if core then
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(Color3.fromRGB(230, 232, 240))
		pe.Size = NumberSequence.new(4, 9)
		pe.Transparency = NumberSequence.new(0.3, 1)
		pe.Lifetime = NumberRange.new(2, 3)
		pe.Speed = NumberRange.new(1, 3)
		pe.Rate = 12
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Parent = core
		task.delay(duration - 2, function()
			pe.Enabled = false
		end)
	end
	cloud.Parent = fx
	Debris:AddItem(cloud, duration + 0.5)
end

local function use(player, target)
	local list = inv[player]
	local e = Combatants.FromPlayer(player)
	if not list or #list == 0 then
		return
	end
	if not e or not e.Alive or not player:GetAttribute("InMatch") then
		notify(player, "아이템은 경기 중에 쓸 수 있어요", Color3.fromRGB(255, 180, 120))
		return
	end
	local id = list[1]
	local def = ById[id]
	local color = player:GetAttribute("TeamColor") or Color3.new(1, 1, 1)
	if id == "Jetpack" then
		player:SetAttribute("JetpackUntil", now() + def.Duration)
		attachJetpack(e, color)
	elseif id == "Shield" then
		e.ProtectedUntil = os.clock() + def.Duration
		player:SetAttribute("ShieldUntil", now() + def.Duration)
		if e.Model then
			local ff = Instance.new("ForceField")
			ff.Name = "SF_Shield"
			ff.Visible = true
			ff.Parent = e.Model
			Debris:AddItem(ff, def.Duration)
		end
	elseif id == "Smoke" then
		if typeof(target) ~= "Vector3" then
			return
		end
		CombatService.Throw(e, target, "Smoke", Color3.fromRGB(220, 224, 232), function(pos)
			spawnSmoke(pos, def.Duration)
		end)
	elseif id == "Golden" then
		e.Golden = true
		player:SetAttribute("Golden", true)
		local gun = e.Model and e.Model:FindFirstChild("SF_Gun")
		if gun then
			ModelKit.SetGolden(gun, true)
		end
	elseif id == "Zoom3" or id == "Zoom6" then
		player:SetAttribute("ZoomBuff", def.Zoom)
		player:SetAttribute("ZoomUntil", now() + def.Duration)
	end
	table.remove(list, 1)
	publish(player)
	notify(player, def.Name .. " 사용!", Color3.fromRGB(140, 255, 200))
	if ItemService.OnUsed then
		ItemService.OnUsed(player, id)
	end
end

local function cycle(player)
	local list = inv[player]
	if list and #list > 1 then
		table.insert(list, table.remove(list, 1))
		publish(player)
	end
end

function ItemService.Init(remoteFolder)
	remotes = remoteFolder
	remotes.UseItem.OnServerEvent:Connect(function(player, action, target)
		if action == "use" then
			use(player, target)
		elseif action == "cycle" then
			cycle(player)
		end
	end)
	Players.PlayerRemoving:Connect(function(pl)
		inv[pl] = nil
	end)
	-- 효과 시간 만료 처리
	task.spawn(function()
		while true do
			task.wait(0.25)
			local t = now()
			for _, pl in ipairs(Players:GetPlayers()) do
				local ju = pl:GetAttribute("JetpackUntil")
				if ju and t > ju then
					pl:SetAttribute("JetpackUntil", nil)
					local jp = pl.Character and pl.Character:FindFirstChild("SF_Jetpack")
					if jp then
						jp:Destroy()
					end
				end
				local su = pl:GetAttribute("ShieldUntil")
				if su and t > su then
					pl:SetAttribute("ShieldUntil", nil)
				end
				local zu = pl:GetAttribute("ZoomUntil")
				if zu and t > zu then
					pl:SetAttribute("ZoomUntil", nil)
					pl:SetAttribute("ZoomBuff", nil)
				end
			end
		end
	end)
	-- 황금총을 쏘면(서버가 Golden=false) 총 색을 되돌림
	local function watch(pl)
		pl:GetAttributeChangedSignal("Golden"):Connect(function()
			if not pl:GetAttribute("Golden") then
				local gun = pl.Character and pl.Character:FindFirstChild("SF_Gun")
				if gun then
					ModelKit.SetGolden(gun, false, pl:GetAttribute("TeamColor"))
				end
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, pl in ipairs(Players:GetPlayers()) do
		watch(pl)
	end
end

-- 부활할 때 황금총이 남아 있으면 새 총도 금색으로
function ItemService.OnSpawn(e)
	if e.Player and e.Golden and e.Model then
		local gun = e.Model:FindFirstChild("SF_Gun")
		if gun then
			ModelKit.SetGolden(gun, true)
		end
	end
end

return ItemService
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX17"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- SPLASH FRONT 서버 진입점
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Services = script.Parent
local MapBuilder = require(Services.MapBuilder)
local PaintService = require(Services.PaintService)
local CombatService = require(Services.CombatService)
local DataService = require(Services.DataService)
local ShopService = require(Services.ShopService)
local RankService = require(Services.RankService)
local MatchService = require(Services.MatchService)
local Telemetry = require(Services.TelemetryService)
local AdminService = require(Services.AdminService)
local Config = require(ReplicatedStorage.Shared.Config)
local ModelService = require(Services.ModelService)
local ItemService = require(Services.ItemService)
local ImageService = require(Services.ImageService)
local QuestService = require(Services.QuestService)

-- 원격 이벤트
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
for _, name in ipairs({ "Fire", "Special", "FX", "HitConfirm", "Damaged", "State", "Results", "Notify", "Queue", "CrateResult", "Telemetry", "SwitchWeapon", "UseItem" }) do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
end
-- 조준 각도·자세 공유 (자주 보내므로 신뢰성 없는 이벤트)
do
	local pose = Instance.new("UnreliableRemoteEvent")
	pose.Name = "Pose"
	pose.Parent = remotes
	local STANCES = { Normal = true, Run = true, Walk = true, Crouch = true }
	pose.OnServerEvent:Connect(function(pl, pitch, stance)
		if type(pitch) == "number" and pitch == pitch then
			local p = math.clamp(math.floor(pitch + 0.5), -70, 70)
			if math.abs((pl:GetAttribute("AimPitch") or 0) - p) >= 2 then
				pl:SetAttribute("AimPitch", p)
			end
		end
		if STANCES[stance] and pl:GetAttribute("Stance") ~= stance then
			pl:SetAttribute("Stance", stance)
		end
	end)
end
for _, name in ipairs({ "Shop", "Admin", "Feedback", "Leaderboard" }) do
	local f = Instance.new("RemoteFunction")
	f.Name = name
	f.Parent = remotes
end
remotes.Parent = ReplicatedStorage

local fx = Instance.new("Folder")
fx.Name = "FX"
fx.Parent = workspace

-- 업로드된 Blender 모델 불러오기 (없으면 내장 대체 모델)
ModelService.Load()

-- 맵
MapBuilder.SetupLighting()
local lobby = MapBuilder.BuildLobby()
local maps = {
	MapBuilder.BuildArena(),      -- 크로마 스퀘어
	MapBuilder.BuildSkyRooftop(), -- 스카이 루프탑
}
-- 시가전: ServerStorage에 BigCity 모델이 있을 때만 추가
do
	local ok, city = pcall(require(script.Parent.CityMap).Build)
	if ok and city then
		table.insert(maps, city)
	elseif not ok then
		warn("[SplashFront] 시가전 맵 생성 실패: " .. tostring(city))
	end
end

-- 업로드한 표면 텍스처·HUD 아이콘 (없으면 단색·이모지로 대체)
ImageService.Load()
ImageService.ApplyTextures(lobby.Folder, ImageService.LobbyRules)
for _, m in ipairs(maps) do
	if not m.NoTextures then
		ImageService.ApplyTextures(m.Folder)
	end
end
local activeCells = Instance.new("ObjectValue")
activeCells.Name = "ActiveCells" -- 클라이언트가 현재 맵의 바닥 셀을 찾는 용도
activeCells.Value = maps[1].Cells
activeCells.Parent = ReplicatedStorage
PaintService.Init(maps[1].Cells)

-- 서비스
Players.CharacterAutoLoads = false
DataService.Start()
CombatService.Init(remotes)
ShopService.Init(remotes)
MatchService.Init(remotes, maps, lobby)
Telemetry.Init(remotes)
AdminService.Init(remotes)
RankService.StartBoard(lobby.Leaderboard)
RankService.Init(remotes)
ItemService.Init(remotes)
QuestService.Init(remotes)
CombatService.OnSpecialUsed = function(pl)
	QuestService.Add(pl, "Specials", 1)
end
ItemService.OnUsed = function(pl)
	QuestService.Add(pl, "Items", 1)
end

-- 전투 틱 (잉크 충전·체력 회복)
task.spawn(function()
	local last = os.clock()
	while true do
		task.wait(0.1)
		local t = os.clock()
		CombatService.Tick(t - last)
		last = t
	end
end)

local function onPlayer(player)
	if not AdminService.Gate(player) then
		return
	end
	player.DevEnableMouseLock = false -- Shift는 달리기 (기본 시프트락 끔)
	DataService.Load(player)
	QuestService.Publish(player)
	player.CharacterAdded:Connect(function(character)
		local hum = character:WaitForChild("Humanoid")
		hum.Died:Connect(function()
			if not player:GetAttribute("InMatch") then
				task.delay(2, function()
					if player.Parent and not player:GetAttribute("InMatch") then
						player:LoadCharacter()
					end
				end)
			end
		end)
	end)
	player:LoadCharacter()
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayer, p)
end

MatchService.Run()
print("[SplashFront] 서버 준비 완료 (빌드 " .. Config.Build .. ") — 로비의 발판을 밟아 매치에 참가하세요")
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- 로비와 아레나(크로마 스퀘어)를 코드로 생성
-- 새 맵은 BuildXXX 함수를 추가하고 같은 형태의 info 테이블을 돌려주면 됨
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {}

local CELL = Config.CellSize
local MS = Config.MapScale or 1 -- 맵 가로·세로 배율 (높이는 그대로)

local function part(props)
	local p = Instance.new(props.Wedge and "WedgePart" or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Color = props.Color or Color3.fromRGB(80, 84, 96)
	p.Size = props.Size
	if props.CFrame then
		p.CFrame = props.CFrame
	else
		p.Position = props.Position
	end
	p.Name = props.Name or "Part"
	if props.Transparency then
		p.Transparency = props.Transparency
	end
	if props.CanCollide == false then
		p.CanCollide = false
	end
	if props.CanQuery == false then
		p.CanQuery = false
	end
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end

local function label(parentPart, text, face, textSize)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = parentPart
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = text
	t.Name = "Label"
	t.Parent = gui
	return t
end

local function billboard(adornee, text, height)
	local b = Instance.new("BillboardGui")
	b.Size = UDim2.fromOffset(260, 70)
	b.StudsOffset = Vector3.new(0, height or 4, 0)
	b.AlwaysOnTop = false
	b.MaxDistance = 120
	b.Adornee = adornee
	b.Parent = adornee
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.3
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = text
	t.Name = "Label"
	t.Parent = b
	return t
end

-- 경사로: x1(낮은 쪽)에서 x2(높은 쪽)으로 height만큼 오르는 판
local function ramp(parent, x1, x2, z, width, baseY, height)
	local len = math.abs(x2 - x1)
	local slope = math.sqrt(len * len + height * height)
	local angle = math.atan(height / len)
	if x2 < x1 then
		angle = -angle
	end
	local mid = Vector3.new((x1 + x2) / 2, baseY + height / 2 - 0.5, z)
	return part({
		Name = "Ramp", Parent = parent, Size = Vector3.new(slope, 1, width),
		CFrame = CFrame.new(mid) * CFrame.Angles(0, 0, angle),
		Color = Color3.fromRGB(120, 126, 140), Material = Enum.Material.DiamondPlate,
	})
end

-- 맵별 조명 (레퍼런스: 낮게 뜬 해 + 눈부심, 햇살 줄기, 따뜻한 대기 안개, 입체 구름, 먼 곳 살짝 흐림)
-- Day(크로마 스퀘어·로비) / Sunset(스카이 루프탑 노을 네온) / City(시가전 골든 아워)
local PRESETS = {
	Day = { Clock = 14.6, Lat = 35, Bright = 3, Amb = Color3.fromRGB(140, 146, 165), Out = Color3.fromRGB(165, 172, 192), Spec = 0.6,
		AtmDensity = 0.3, AtmOffset = 0.2, AtmColor = Color3.fromRGB(205, 225, 255), AtmDecay = Color3.fromRGB(110, 150, 215), Haze = 1.4, Glare = 0.5,
		Sat = 0.2, Con = 0.08, Tint = Color3.fromRGB(255, 252, 246), Bloom = 0.4, Thresh = 1.6,
		Rays = 0.08, RaySpread = 0.7, Dof = 0.12, Clouds = { Cover = 0.55, Density = 0.65, Color = Color3.fromRGB(255, 255, 255) }, Sun = 16 },
	Sunset = { Clock = 17.6, Lat = 35, Bright = 2.2, Amb = Color3.fromRGB(90, 90, 110), Out = Color3.fromRGB(140, 140, 160), Spec = 1,
		AtmDensity = 0.27, AtmOffset = 0.15, AtmColor = Color3.fromRGB(225, 200, 255), AtmDecay = Color3.fromRGB(120, 80, 160), Haze = 0.8, Glare = 0.6,
		Sat = 0.18, Con = 0.1, Tint = Color3.fromRGB(255, 242, 248), Bloom = 0.6, Thresh = 1.4,
		Rays = 0.1, RaySpread = 0.8, Dof = 0.12, Clouds = { Cover = 0.5, Density = 0.55, Color = Color3.fromRGB(255, 214, 236) }, Sun = 18 },
	-- 시가전: 레퍼런스 1번처럼 지평선 가까운 해, 주황빛 먼지 안개, 햇살 번짐, 먼 건물은 실루엣
	City = { Clock = 17.75, Lat = 25, Bright = 2.6, Amb = Color3.fromRGB(110, 86, 78), Out = Color3.fromRGB(150, 118, 100), Spec = 1,
		AtmDensity = 0.42, AtmOffset = 0.25, AtmColor = Color3.fromRGB(255, 196, 150), AtmDecay = Color3.fromRGB(176, 104, 74), Haze = 2.6, Glare = 1.6,
		Sat = 0.06, Con = 0.14, Tint = Color3.fromRGB(255, 232, 208), Bloom = 0.7, Thresh = 1.15,
		Rays = 0.16, RaySpread = 0.85, Dof = 0.28, Clouds = { Cover = 0.62, Density = 0.7, Color = Color3.fromRGB(255, 196, 160) }, Sun = 22 },
}
local function ensure(class, parent)
	local o = parent:FindFirstChildOfClass(class)
	if not o then
		o = Instance.new(class)
		o.Parent = parent
	end
	return o
end

function MapBuilder.ApplyLighting(name)
	local p = PRESETS[name] or PRESETS.Day
	Lighting.ClockTime = p.Clock
	Lighting.GeographicLatitude = p.Lat or 35
	Lighting.Brightness = p.Bright
	Lighting.Ambient = p.Amb
	Lighting.OutdoorAmbient = p.Out
	Lighting.EnvironmentSpecularScale = p.Spec
	local a = ensure("Atmosphere", Lighting)
	a.Density, a.Offset, a.Color, a.Decay, a.Haze, a.Glare = p.AtmDensity, p.AtmOffset or 0.15, p.AtmColor, p.AtmDecay, p.Haze, p.Glare
	local cc = ensure("ColorCorrectionEffect", Lighting)
	cc.Saturation, cc.Contrast, cc.TintColor = p.Sat, p.Con, p.Tint
	local b = ensure("BloomEffect", Lighting)
	b.Intensity, b.Threshold, b.Size = p.Bloom, p.Thresh, 28
	local rays = ensure("SunRaysEffect", Lighting)
	rays.Intensity, rays.Spread = p.Rays or 0.06, p.RaySpread or 0.6
	local dof = ensure("DepthOfFieldEffect", Lighting)
	dof.FarIntensity = p.Dof or 0.1
	dof.NearIntensity = 0
	dof.FocusDistance = 40
	dof.InFocusRadius = 90
	local sky = ensure("Sky", Lighting)
	sky.SunAngularSize = p.Sun or 14
	local clouds = ensure("Clouds", workspace.Terrain)
	if p.Clouds then
		clouds.Enabled = true
		clouds.Cover, clouds.Density, clouds.Color = p.Clouds.Cover, p.Clouds.Density, p.Clouds.Color
	else
		clouds.Enabled = false
	end
end

function MapBuilder.SetupLighting()
	-- 0.6: 밝은 한낮 카툰 톤 (흰 구조물 위에 진한 팀 페인트가 또렷하게)
	Lighting.ClockTime = 14.2
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(140, 146, 165)
	Lighting.OutdoorAmbient = Color3.fromRGB(165, 172, 192)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.ShadowSoftness = 0.25
	Lighting.GlobalShadows = true
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local a = Instance.new("Atmosphere")
		a.Density = 0.27
		a.Offset = 0.15
		a.Color = Color3.fromRGB(199, 222, 255)
		a.Decay = Color3.fromRGB(110, 150, 215)
		a.Glare = 0.2
		a.Haze = 1.1
		a.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.SunAngularSize = 14
		sky.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("ColorCorrectionEffect") then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Saturation = 0.22
		cc.Contrast = 0.06
		cc.Brightness = 0.02
		cc.TintColor = Color3.fromRGB(255, 252, 248)
		cc.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("SunRaysEffect") then
		local rays = Instance.new("SunRaysEffect")
		rays.Intensity = 0.06
		rays.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local b = Instance.new("BloomEffect")
		b.Intensity = 0.35
		b.Threshold = 1.7
		b.Parent = Lighting
	end	Lighting.ShadowSoftness = 0.18
	MapBuilder.ApplyLighting("Day")
end

-- 기획서 3장: 엄폐물은 어두운 외곽선으로 바닥과 구분
local OUTLINED = { Crate = true, Wall = true, WarehouseWall = true, Container = true, Parapet = true, WallSill = true, Platform = true,
	Ramp = true, Boundary = true, SpawnWall = true, Lintel = true, WarehouseRoof = true }

------------------------------------------------------------------------
-- 0.6 아트 패스: 밝은 카툰 팔레트 + 엄폐물 디테일(모서리 프레임·받침·캡)
-- 판정용 모양은 그대로 두고 장식 파트만 덧붙임 (CanCollide·CanQuery 끔)
------------------------------------------------------------------------
local PALETTE = {
	Floor = { Color3.fromRGB(238, 240, 247), Enum.Material.SmoothPlastic },
	Boundary = { Color3.fromRGB(214, 220, 234), Enum.Material.SmoothPlastic },
	Wall = { Color3.fromRGB(226, 230, 240), Enum.Material.SmoothPlastic },
	WarehouseWall = { Color3.fromRGB(226, 230, 240), Enum.Material.SmoothPlastic },
	Lintel = { Color3.fromRGB(214, 218, 230), Enum.Material.SmoothPlastic },
	WallSill = { Color3.fromRGB(214, 218, 230), Enum.Material.SmoothPlastic },
	Parapet = { Color3.fromRGB(230, 234, 244), Enum.Material.SmoothPlastic },
	SpawnWall = { Color3.fromRGB(210, 216, 230), Enum.Material.SmoothPlastic },
	Platform = { Color3.fromRGB(206, 212, 228), Enum.Material.SmoothPlastic },
	MidTower = { Color3.fromRGB(196, 204, 222), Enum.Material.SmoothPlastic },
	SpawnTower = { Color3.fromRGB(188, 196, 216), Enum.Material.SmoothPlastic },
	Ramp = { Color3.fromRGB(186, 192, 210), Enum.Material.DiamondPlate },
	Crate = { Color3.fromRGB(236, 176, 100), Enum.Material.WoodPlanks },
	WarehouseRoof = { Color3.fromRGB(222, 218, 206), Enum.Material.SmoothPlastic },
	CityGround = { Color3.fromRGB(150, 160, 178), Enum.Material.SmoothPlastic },
	Street = { Color3.fromRGB(150, 160, 178), Enum.Material.SmoothPlastic },
}
local PASTEL = Color3.fromRGB(190, 210, 238)

local function deco(parent, size, cf, color, mat)
	local p = Instance.new("Part")
	p.Name = "Detail"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function stylize(folder)
	local detail = Instance.new("Folder")
	detail.Name = "Detail"
	detail.Parent = folder
	for _, p in ipairs(folder:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "Cell" and p.Parent ~= detail then
			local pal = PALETTE[p.Name]
			if pal then
				p.Color = pal[1]
				p.Material = pal[2]
			elseif p.Name == "Building" or p.Name == "CityBuilding" then
				p.Color = p.Color:Lerp(PASTEL, 0.75)
				p.Material = Enum.Material.SmoothPlastic
			elseif p.Name == "Container" then
				p.Color = p.Color:Lerp(Color3.new(1, 1, 1), 0.25)
				p.Material = Enum.Material.SmoothPlastic
			end
			local sz, cf = p.Size, p.CFrame
			if p.Name == "Crate" then
				-- 모서리 각재 4개 + 윗테 4개 + 가운데 X 대신 가로대
				local dark = Color3.fromRGB(170, 108, 56)
				for _, sx in ipairs({ -1, 1 }) do
					for _, sz2 in ipairs({ -1, 1 }) do
						deco(detail, Vector3.new(0.5, sz.Y + 0.04, 0.5), cf * CFrame.new(sx * (sz.X / 2 - 0.2), 0, sz2 * (sz.Z / 2 - 0.2)), dark, Enum.Material.Wood)
					end
				end
				for _, sx in ipairs({ -1, 1 }) do
					deco(detail, Vector3.new(0.4, 0.4, sz.Z + 0.06), cf * CFrame.new(sx * (sz.X / 2 - 0.15), sz.Y / 2 - 0.15, 0), dark, Enum.Material.Wood)
					deco(detail, Vector3.new(sz.X + 0.06, 0.4, 0.4), cf * CFrame.new(0, sz.Y / 2 - 0.15, sx * (sz.Z / 2 - 0.15)), dark, Enum.Material.Wood)
					deco(detail, Vector3.new(sz.X + 0.06, 0.35, 0.36), cf * CFrame.new(0, -0.1, sx * (sz.Z / 2 - 0.12)), dark, Enum.Material.Wood)
				end
			elseif p.Name == "Wall" or p.Name == "WarehouseWall" or p.Name == "Boundary" or p.Name == "SpawnWall" then
				-- 아래 걸레받이 + 위 캡(살짝 넓게) + 일정 간격 패널 이음새
				local long = (sz.X >= sz.Z) and "X" or "Z"
				deco(detail, Vector3.new(sz.X + 0.12, 0.6, sz.Z + 0.12), cf * CFrame.new(0, -sz.Y / 2 + 0.3, 0), Color3.fromRGB(150, 158, 180))
				deco(detail, Vector3.new(sz.X + 0.3, 0.35, sz.Z + 0.3), cf * CFrame.new(0, sz.Y / 2 + 0.17, 0), Color3.fromRGB(245, 247, 252))
				local len = (long == "X") and sz.X or sz.Z
				local n = math.floor(len / 8)
				for k = 1, n - 1 do
					local o = -len / 2 + k * (len / n)
					local off = (long == "X") and CFrame.new(o, 0, 0) or CFrame.new(0, 0, o)
					local s2 = (long == "X") and Vector3.new(0.18, sz.Y - 0.8, sz.Z + 0.06) or Vector3.new(sz.X + 0.06, sz.Y - 0.8, 0.18)
					deco(detail, s2, cf * off, Color3.fromRGB(190, 196, 214))
				end
			elseif p.Name == "Platform" or p.Name == "Parapet" then
				-- 윗면 가장자리 띠
				deco(detail, Vector3.new(sz.X + 0.16, 0.3, sz.Z + 0.16), cf * CFrame.new(0, sz.Y / 2 - 0.12, 0), Color3.fromRGB(250, 250, 255))
			elseif p.Name == "Container" then
				-- 골판 무늬(세로 리브) + 문 손잡이
				local long = (sz.X >= sz.Z) and "X" or "Z"
				local len = (long == "X") and sz.X or sz.Z
				local shade = p.Color:Lerp(Color3.new(0, 0, 0), 0.18)
				for k = 1, math.floor(len / 1.6) do
					local o = -len / 2 + (k - 0.5) * 1.6
					local off = (long == "X") and CFrame.new(o, 0, 0) or CFrame.new(0, 0, o)
					local s2 = (long == "X") and Vector3.new(0.35, sz.Y - 0.6, sz.Z + 0.1) or Vector3.new(sz.X + 0.1, sz.Y - 0.6, 0.35)
					deco(detail, s2, cf * off, shade)
				end
				deco(detail, Vector3.new(sz.X + 0.14, 0.3, sz.Z + 0.14), cf * CFrame.new(0, sz.Y / 2 - 0.15, 0), shade)
				deco(detail, Vector3.new(sz.X + 0.14, 0.3, sz.Z + 0.14), cf * CFrame.new(0, -sz.Y / 2 + 0.15, 0), shade)
			end
		end
	end
end

local function addOutlines(folder, keepOriginal)
	if not keepOriginal then
		stylize(folder)
	end
	for _, p in ipairs(folder:GetDescendants()) do
		if p:IsA("BasePart") and OUTLINED[p.Name] then
			local sb = Instance.new("SelectionBox")
			sb.Adornee = p
			sb.Color3 = Color3.fromRGB(40, 44, 70)
			sb.LineThickness = 0.05
			sb.SurfaceTransparency = 1
			sb.Parent = p
		end
	end
end

------------------------------------------------------------------------
-- 로비
------------------------------------------------------------------------
-- 로비: 광장(페인트 스플랫 바닥) + 로고 타이틀 + 매치 발판 무대 + 랭킹 보드 + 상점 부스
local LOBBY_COLORS = {
	Color3.fromRGB(255, 46, 170), Color3.fromRGB(0, 200, 255), Color3.fromRGB(255, 214, 0),
	Color3.fromRGB(70, 220, 80), Color3.fromRGB(175, 80, 255), Color3.fromRGB(255, 140, 30),
}

local function cyl(props)
	-- 세로로 선 원기둥/원판 (Roblox 원기둥은 X축이 길이 방향이라 90도 돌림)
	local h, d = props.Height, props.Diameter
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(h, d, d)
	props.CFrame = CFrame.new(props.Position) * CFrame.Angles(0, 0, math.rad(90))
	props.Position = nil
	props.Height, props.Diameter = nil, nil
	return part(props)
end

local function titleText(gui, text, pos, size, c1, c2)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Position = pos
	t.Size = size
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Parent = gui
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = 90
	g.Parent = t
	local st = Instance.new("UIStroke")
	st.Thickness = 10
	st.Color = Color3.fromRGB(16, 12, 30)
	st.Parent = t
	return t
end

function MapBuilder.BuildLobby()
	local old = workspace:FindFirstChild("Lobby")
	if old then
		old:Destroy()
	end
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = workspace
	local deco = Instance.new("Folder")
	deco.Name = "Decoration"
	deco.Parent = lobby
	local rng = Random.new(77)

	local Y = 400
	local W, D = 170, 130
	------------------------------------------------------------------
	-- SF 격납고 로비: 짙은 남색 강철 벽 + 노랑/자홍 네온 칸, 유리 천장과 네온 갈비대,
	-- 무지개 네온 통로, 떠 있는 육각 무기 진열대 (레퍼런스: 사이파이 하이퍼 FPS 로비)
	------------------------------------------------------------------
	local STEEL = Color3.fromRGB(30, 38, 62)
	local STEEL2 = Color3.fromRGB(42, 52, 84)
	local STEEL3 = Color3.fromRGB(22, 28, 46)
	local NEON_Y = Color3.fromRGB(240, 255, 40)
	local NEON_M = Color3.fromRGB(255, 40, 200)
	local NEON_P = Color3.fromRGB(150, 70, 255)
	local NEON_C = Color3.fromRGB(0, 230, 255)
	local H = 46 -- 천장 높이

	-- 바닥: 진한 강철판 + 10스터드 이음새
	part({ Name = "Floor", Parent = lobby, Size = Vector3.new(W, 2, D), Position = Vector3.new(0, Y - 1, 0),
		Color = STEEL3, Material = Enum.Material.DiamondPlate })
	for x = -W / 2 + 10, W / 2 - 10, 10 do
		part({ Name = "Seam", Parent = deco, Size = Vector3.new(0.18, 0.04, D), Position = Vector3.new(x, Y + 0.02, 0),
			Color = Color3.fromRGB(12, 14, 24), CanCollide = false, CanQuery = false })
	end
	for z = -D / 2 + 10, D / 2 - 10, 10 do
		part({ Name = "Seam", Parent = deco, Size = Vector3.new(W, 0.04, 0.18), Position = Vector3.new(0, Y + 0.02, z),
			Color = Color3.fromRGB(12, 14, 24), CanCollide = false, CanQuery = false })
	end
	-- 중앙 통로 (스폰 → 발판 무대): 밝은 패널 + 양옆 무지개 네온 줄
	local pathZ1, pathZ2 = -12, D / 2 - 4
	part({ Name = "Walkway", Parent = deco, Size = Vector3.new(26, 0.1, pathZ2 - pathZ1), Position = Vector3.new(0, Y + 0.05, (pathZ1 + pathZ2) / 2),
		Color = STEEL2, Material = Enum.Material.Metal, CanCollide = false, CanQuery = false })
	local segs = 24
	for i = 0, segs - 1 do
		local z1 = pathZ1 + (pathZ2 - pathZ1) * i / segs
		local len = (pathZ2 - pathZ1) / segs
		local c = Color3.fromHSV((i / segs) * 0.85, 0.85, 1)
		for _, sx in ipairs({ -1, 1 }) do
			part({ Name = "RainbowLine", Parent = deco, Size = Vector3.new(0.7, 0.12, len + 0.02), Position = Vector3.new(sx * 13.4, Y + 0.08, z1 + len / 2),
				Color = c, Material = Enum.Material.Neon, CanCollide = false, CanQuery = false })
		end
	end
	-- 통로 가운데 화살표 표시
	for z = pathZ2 - 12, pathZ1 + 8, -10 do
		for _, sx in ipairs({ -1, 1 }) do
			local w = part({ Name = "Chevron", Parent = deco, Size = Vector3.new(0.6, 0.06, 4), CFrame = CFrame.new(sx * 1.4, Y + 0.12, z)
				* CFrame.Angles(0, math.rad(sx * 40), 0), Color = Color3.fromRGB(160, 175, 210), Material = Enum.Material.Neon, CanCollide = false, CanQuery = false })
			w.Transparency = 0.45
		end
	end

	-- 벽: 14스터드 칸마다 안쪽 패널 + 칸 경계 기둥(노랑/자홍 네온) + 아래·위 시안 띠
	local function wallSide(axis, sgn)
		local len = axis == "X" and W or D
		local function at(t, y, inset)
			if axis == "X" then
				return Vector3.new(t, y, sgn * (D / 2 - inset))
			end
			return Vector3.new(sgn * (W / 2 - inset), y, t)
		end
		local function size(along, h, thick)
			if axis == "X" then
				return Vector3.new(along, h, thick)
			end
			return Vector3.new(thick, h, along)
		end
		part({ Name = "HangarWall", Parent = lobby, Size = size(len, H, 2), Position = at(0, Y + H / 2, -1), Color = STEEL, Material = Enum.Material.Metal })
		part({ Name = "WallSkirt", Parent = deco, Size = size(len, 0.5, 0.4), Position = at(0, Y + 4, 0.2), Color = NEON_C, Material = Enum.Material.Neon,
			CanQuery = false, CanCollide = false })
		part({ Name = "WallCrown", Parent = deco, Size = size(len, 0.5, 0.4), Position = at(0, Y + H - 8, 0.2), Color = NEON_P, Material = Enum.Material.Neon,
			CanQuery = false, CanCollide = false })
		local k = 0
		for t = -len / 2 + 7, len / 2 - 7, 14 do
			k = k + 1
			-- 들어간 패널 (가운데 조금 밝게)
			part({ Name = "WallPanel", Parent = deco, Size = size(11, H - 16, 0.6), Position = at(t, Y + 4 + (H - 12) / 2, 0.3), Color = STEEL2,
				Material = Enum.Material.Metal, CanQuery = false })
			part({ Name = "PanelSlit", Parent = deco, Size = size(8, 0.25, 0.7), Position = at(t, Y + 14, 0.35), Color = STEEL3, CanQuery = false })
			part({ Name = "PanelSlit", Parent = deco, Size = size(8, 0.25, 0.7), Position = at(t, Y + 26, 0.35), Color = STEEL3, CanQuery = false })
			-- 칸 경계 기둥 + 세로 네온
			local edge = t + 7
			if edge < len / 2 - 1 then
				part({ Name = "WallRib", Parent = deco, Size = size(2.2, H, 1.6), Position = at(edge, Y + H / 2, 0.6), Color = STEEL3,
					Material = Enum.Material.Metal, CanQuery = false })
				local nc = (k % 2 == 0) and NEON_M or NEON_Y
				local bar = part({ Name = "WallNeon", Parent = deco, Size = size(0.7, 14, 0.5), Position = at(edge, Y + 13, 1.5), Color = nc,
					Material = Enum.Material.Neon, CanQuery = false, CanCollide = false })
				if k % 2 == 1 then
					local l = Instance.new("PointLight")
					l.Color = nc
					l.Range = 18
					l.Brightness = 1.4
					l.Parent = bar
				end
			end
		end
	end
	wallSide("X", -1)
	wallSide("X", 1)
	wallSide("Z", -1)
	wallSide("Z", 1)

	-- 유리 천장 + 자홍/보라 네온 갈비대 (하늘과 구름이 비침)
	part({ Name = "CeilingGlass", Parent = deco, Size = Vector3.new(W, 0.4, D), Position = Vector3.new(0, Y + H, 0), Color = Color3.fromRGB(150, 200, 255),
		Material = Enum.Material.Glass, Transparency = 0.6, CanQuery = false })
	local ri = 0
	for x = -W / 2, W / 2, 14 do
		ri = ri + 1
		part({ Name = "CeilingRib", Parent = deco, Size = Vector3.new(2, 2.4, D), Position = Vector3.new(x, Y + H - 1, 0), Color = STEEL3,
			Material = Enum.Material.Metal, CanQuery = false })
		part({ Name = "RibNeon", Parent = deco, Size = Vector3.new(0.6, 0.3, D - 2), Position = Vector3.new(x, Y + H - 2.3, 0),
			Color = (ri % 2 == 0) and NEON_M or NEON_P, Material = Enum.Material.Neon, CanQuery = false, CanCollide = false })
	end
	for z = -D / 2, D / 2, 26 do
		part({ Name = "CeilingBeam", Parent = deco, Size = Vector3.new(W, 1.6, 1.6), Position = Vector3.new(0, Y + H - 1.2, z), Color = STEEL3,
			Material = Enum.Material.Metal, CanQuery = false })
	end
	-- 천장에 매단 조명 (흰 사각 등)
	for x = -56, 56, 28 do
		for z = -30, 40, 35 do
			local lamp = part({ Name = "CeilingLamp", Parent = deco, Size = Vector3.new(6, 0.4, 2), Position = Vector3.new(x, Y + H - 2.6, z),
				Color = Color3.fromRGB(235, 245, 255), Material = Enum.Material.Neon, CanQuery = false, CanCollide = false })
			local sl = Instance.new("SurfaceLight")
			sl.Face = Enum.NormalId.Bottom
			sl.Range = 40
			sl.Angle = 90
			sl.Brightness = 1.2
			sl.Color = Color3.fromRGB(210, 225, 255)
			sl.Parent = lamp
		end
	end

	-- 떠 있는 육각 무기 진열대 (총은 클라이언트에서 천천히 회전: Spin 속성)
	local displays = { { -42, 30, "Sniper" }, { 42, 30, "Rifle" }, { -42, 4, "Launcher" }, { 42, 4, "Shotgun" } }
	for i, dsp in ipairs(displays) do
		local base = Vector3.new(dsp[1], Y + 3.2, dsp[2])
		for k = 0, 2 do
			part({ Name = "HexDeck", Parent = lobby, Size = Vector3.new(9.2, 1.2, 16), CFrame = CFrame.new(base) * CFrame.Angles(0, math.rad(60 * k), 0),
				Color = Color3.fromRGB(225, 232, 245), Material = Enum.Material.SmoothPlastic })
			part({ Name = "HexRim", Parent = deco, Size = Vector3.new(9.4, 0.3, 16.2), CFrame = CFrame.new(base + Vector3.new(0, -0.7, 0))
				* CFrame.Angles(0, math.rad(60 * k), 0), Color = (i % 2 == 0) and NEON_C or NEON_M, Material = Enum.Material.Neon, CanQuery = false,
				CanCollide = false })
		end
		-- 아래로 좁아지는 받침 (떠 있는 느낌)
		part({ Name = "HexUnder", Parent = deco, Shape = Enum.PartType.Ball, Size = Vector3.new(8, 3, 8), Position = base + Vector3.new(0, -1.6, 0),
			Color = Color3.fromRGB(70, 80, 110), Material = Enum.Material.Metal, CanQuery = false })
		local glow = part({ Name = "HexGlow", Parent = deco, Size = Vector3.new(1, 1, 1), Position = base + Vector3.new(0, -3, 0), Transparency = 1,
			CanQuery = false, CanCollide = false })
		local gl = Instance.new("PointLight")
		gl.Color = (i % 2 == 0) and NEON_C or NEON_M
		gl.Range = 14
		gl.Brightness = 2.5
		gl.Parent = glow
		local ok, gun = pcall(function()
			local ModelKit = require(ReplicatedStorage.Shared.ModelKit)
			local m = ModelKit.Gun(dsp[3], (i % 2 == 0) and NEON_C or NEON_M)
			m:ScaleTo(m:GetScale() * 2.2)
			return m
		end)
		if ok and gun then
			gun.Name = "DisplayGun"
			gun:PivotTo(CFrame.new(base + Vector3.new(0, 4.2, 0)) * CFrame.Angles(0, math.rad(90), 0))
			gun:SetAttribute("Spin", 30)
			gun.Parent = deco
		end
		-- 진열대 위 홀로 이름판
		local board = part({ Name = "HoloSign", Parent = deco, Size = Vector3.new(7, 2, 0.2), Position = base + Vector3.new(0, 8.5, 0), Transparency = 1,
			CanCollide = false, CanQuery = false })
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.new(7, 0, 1.6, 0)
		bb.LightInfluence = 0
		bb.MaxDistance = 90
		bb.Parent = board
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundColor3 = Color3.fromRGB(14, 18, 34)
		t.BackgroundTransparency = 0.2
		t.TextScaled = true
		t.TextColor3 = Color3.new(1, 1, 1)
		t.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Black, Enum.FontStyle.Italic)
		local w = require(ReplicatedStorage.Shared.Weapons).Get(dsp[3])
		t.Text = string.upper(w.Class) .. "  ·  " .. w.Name
		t.Parent = bb
		local st = Instance.new("UIStroke")
		st.Color = (i % 2 == 0) and NEON_C or NEON_M
		st.Thickness = 2
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Parent = t
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 0.6, 14)
	spawn.Position = Vector3.new(0, Y + 0.3, 44)
	spawn.Color = Color3.fromRGB(240, 240, 255)
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.2
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = lobby

	------------------------------------------------------------------
	-- 타이틀 로고 (북쪽 벽, 스폰을 바라봄)
	------------------------------------------------------------------
	local TZ = -D / 2 + 3
	local TY = Y + 22
	local board = part({ Name = "TitleBoard", Parent = lobby, Size = Vector3.new(70, 24, 1.5), Position = Vector3.new(0, TY, TZ),
		Color = Color3.fromRGB(22, 18, 38), Material = Enum.Material.SmoothPlastic })
	-- 네온 테두리
	for _, e in ipairs({ { 0, 12.4, 71.6, 0.8 }, { 0, -12.4, 71.6, 0.8 }, { -35.4, 0, 0.8, 25.6 }, { 35.4, 0, 0.8, 25.6 } }) do
		part({ Name = "TitleFrame", Parent = deco, Size = Vector3.new(e[3], e[4], 1.8), Position = Vector3.new(e[1], TY + e[2], TZ),
			Color = (e[2] ~= 0) and Color3.fromRGB(255, 40, 200) or Color3.fromRGB(240, 255, 40), Material = Enum.Material.Neon, CanQuery = false })
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Logo"
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = board
	titleText(gui, "SPLASH", UDim2.fromScale(0.04, 0.03), UDim2.fromScale(0.92, 0.47), Color3.fromRGB(255, 130, 215), Color3.fromRGB(255, 30, 140))
	titleText(gui, "FRONT", UDim2.fromScale(0.14, 0.47), UDim2.fromScale(0.72, 0.37), Color3.fromRGB(130, 245, 255), Color3.fromRGB(0, 150, 255))
	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromScale(0.1, 0.85)
	sub.Size = UDim2.fromScale(0.8, 0.12)
	sub.Font = Enum.Font.GothamBlack
	sub.TextScaled = true
	sub.Text = "PAINT  ·  SHOOT  ·  CONQUER"
	sub.TextColor3 = Color3.fromRGB(255, 220, 90)
	sub.Parent = gui
	-- 로고 아래로 흘러내리는 페인트
	for i = 1, 14 do
		local x = -31 + (i - 1) * (62 / 13) + rng:NextNumber(-1, 1)
		local len = rng:NextNumber(1.5, 6)
		local c = LOBBY_COLORS[(i % #LOBBY_COLORS) + 1]
		local w = rng:NextNumber(0.8, 1.6)
		part({ Name = "Drip", Parent = deco, Size = Vector3.new(w, len, 0.5), Position = Vector3.new(x, TY - 12.8 - len / 2, TZ + 0.9),
			Color = c, Material = Enum.Material.Neon, CanCollide = false, CanQuery = false })
		part({ Name = "DripTip", Parent = deco, Shape = Enum.PartType.Ball, Size = Vector3.new(w * 1.3, w * 1.3, w * 1.3),
			Position = Vector3.new(x, TY - 12.8 - len, TZ + 0.9), Color = c, Material = Enum.Material.Neon, CanCollide = false, CanQuery = false })
	end
	-- 양옆 스피커 타워 + 무대 조명
	for _, s in ipairs({ -1, 1 }) do
		local tx = s * 46
		part({ Name = "Speaker", Parent = deco, Size = Vector3.new(8, 20, 6), Position = Vector3.new(tx, Y + 10, TZ + 2),
			Color = Color3.fromRGB(26, 24, 36), Material = Enum.Material.Metal })
		for k, yy in ipairs({ 5, 11, 16.5 }) do
			local d = (k == 3) and 3 or 5.4
			part({ Name = "Woofer", Parent = deco, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, d, d),
				CFrame = CFrame.new(tx, Y + yy, TZ + 5.1) * CFrame.Angles(0, math.rad(90), 0),
				Color = LOBBY_COLORS[s == -1 and 1 or 2], Material = Enum.Material.Neon, CanQuery = false })
		end
		local lamp = part({ Name = "StageLight", Parent = deco, Size = Vector3.new(2, 2, 2), Position = Vector3.new(tx, Y + 21, TZ + 10),
			Color = Color3.fromRGB(255, 250, 235), Material = Enum.Material.Neon, CanQuery = false })
		lamp.CFrame = CFrame.lookAt(lamp.Position, Vector3.new(0, TY, TZ))
		local sp = Instance.new("SpotLight")
		sp.Face = Enum.NormalId.Front
		sp.Range = 50
		sp.Angle = 60
		sp.Brightness = 3
		sp.Parent = lamp
	end

	------------------------------------------------------------------
	-- 매치 대기 발판 무대 (부채꼴 배치)
	------------------------------------------------------------------
	part({ Name = "Stage", Parent = lobby, Size = Vector3.new(146, 0.6, 30), Position = Vector3.new(0, Y + 0.3, -28),
		Color = Color3.fromRGB(28, 26, 42), Material = Enum.Material.DiamondPlate })
	part({ Name = "StageEdge", Parent = deco, Size = Vector3.new(146, 0.25, 0.6), Position = Vector3.new(0, Y + 0.65, -13),
		Color = LOBBY_COLORS[3], Material = Enum.Material.Neon, CanQuery = false })
	-- 팀전은 A존 / B존 발판 두 개: 같은 존에 선 사람끼리 한 팀으로 시작
	local ZONE_COLORS = { Color3.fromRGB(0, 170, 255), Color3.fromRGB(255, 120, 40) }
	local ZONE_NAMES = { "A", "B" }
	local pads, labels, padList = {}, {}, {}
	local n = #Config.Queues
	local PAD_COLORS = { LOBBY_COLORS[2], LOBBY_COLORS[4], LOBBY_COLORS[1], LOBBY_COLORS[6], LOBBY_COLORS[5] }

	local function makePad(q, side, base, diameter, c)
		cyl({ Name = "PadRim", Parent = deco, Height = 0.5, Diameter = diameter + 1.2, Position = base + Vector3.new(0, 0.25, 0), Color = c,
			Material = Enum.Material.Neon, CanQuery = false }).Transparency = 0.15
		cyl({ Name = "PadBase", Parent = lobby, Height = 0.9, Diameter = diameter + 0.4, Position = base + Vector3.new(0, 0.45, 0),
			Color = Color3.fromRGB(36, 34, 52), Material = Enum.Material.Metal })
		local pad = cyl({ Name = "QueuePad_" .. q.Id .. (side > 0 and ("_" .. ZONE_NAMES[side]) or ""), Parent = lobby, Height = 0.2,
			Diameter = diameter - 1.6, Position = base + Vector3.new(0, 1.0, 0), Color = c, Material = Enum.Material.Neon })
		pad.Transparency = 0.3
		pad:SetAttribute("QueueId", q.Id)
		pad:SetAttribute("Side", side)
		local beam = cyl({ Name = "Holo", Parent = deco, Height = 10, Diameter = diameter - 1.2, Position = base + Vector3.new(0, 6, 0), Color = c,
			Material = Enum.Material.ForceField, CanCollide = false, CanQuery = false })
		beam.CanTouch = false
		beam.Transparency = 0.2
		local att = Instance.new("Attachment")
		att.Parent = pad
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(c)
		pe.LightEmission = 0.8
		pe.Size = NumberSequence.new(0.3, 0)
		pe.Lifetime = NumberRange.new(1.4, 2.2)
		pe.Speed = NumberRange.new(3, 6)
		pe.Rate = 8
		pe.SpreadAngle = Vector2.new(20, 20)
		pe.EmissionDirection = Enum.NormalId.Right -- 원기둥을 눕혔으므로 Right = 위쪽
		pe.Shape = Enum.ParticleEmitterShape.Disc
		pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		pe.Parent = att
		local light = Instance.new("PointLight")
		light.Color = c
		light.Range = 14
		light.Brightness = 2
		light.Parent = pad
		if side > 0 then
			-- 발판 바로 위 작은 존 표시 (A / B + 인원)
			local zb = Instance.new("BillboardGui")
			zb.Name = "ZoneTag"
			zb.Size = UDim2.new(4.2, 0, 1.5, 0)
			zb.StudsOffset = Vector3.new(0, 3.2, 0)
			zb.MaxDistance = 90
			zb.LightInfluence = 0
			zb.Adornee = pad
			zb.Parent = pad
			local zt = Instance.new("TextLabel")
			zt.Name = "Text"
			zt.Size = UDim2.fromScale(1, 1)
			zt.BackgroundColor3 = c
			zt.BackgroundTransparency = 0.1
			zt.Font = Enum.Font.GothamBlack
			zt.TextScaled = true
			zt.TextColor3 = Color3.new(1, 1, 1)
			zt.Text = ZONE_NAMES[side] .. "존 0/" .. q.TeamSize
			zt.Parent = zb
			local zc = Instance.new("UICorner")
			zc.CornerRadius = UDim.new(0.3, 0)
			zc.Parent = zt
			pad:SetAttribute("ZoneLabel", true)
		end
		table.insert(padList, { Pad = pad, Queue = q.Id, Side = side })
		return pad
	end

	for i, q in ipairs(Config.Queues) do
		local t = (i - (n + 1) / 2)
		local x = t * 28
		local z = -26 - (2 - math.abs(t)) * 2.5
		local c = PAD_COLORS[((i - 1) % #PAD_COLORS) + 1]
		local base = Vector3.new(x, Y + 0.6, z)
		local anchor
		if q.Mode == "Solo" then
			anchor = makePad(q, 0, base, 13, c)
		else
			-- 두 존 사이 칸막이 + 존 발판
			part({ Name = "ZoneDivider", Parent = deco, Size = Vector3.new(0.4, 0.5, 11), Position = base + Vector3.new(0, 0.6, 0),
				Color = c, Material = Enum.Material.Neon, CanQuery = false })
			makePad(q, 1, base + Vector3.new(-6.1, 0, 0), 11.4, ZONE_COLORS[1])
			makePad(q, 2, base + Vector3.new(6.1, 0, 0), 11.4, ZONE_COLORS[2])
			anchor = part({ Name = "QueueBoardAnchor_" .. q.Id, Parent = deco, Size = Vector3.new(1, 1, 1), Position = base + Vector3.new(0, 1, 0),
				Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
		end
		local mode = Config.Modes[q.Mode]
		local title2 = q.Mode == "Solo" and "솔로 8인" or (mode.Name .. "  " .. q.TeamSize .. "vs" .. q.TeamSize)
		-- 안내판: 스터드 단위 크기라 멀리서 봐도 옆 발판 글씨와 겹치지 않음 (제목 크게 + 상태 작게)
		local bb = Instance.new("BillboardGui")
		bb.Name = "QueueBoard"
		bb.Size = UDim2.new(10, 0, 3, 0)
		bb.StudsOffset = Vector3.new(0, 8.5, 0)
		bb.MaxDistance = 140
		bb.LightInfluence = 0
		bb.Adornee = anchor
		bb.Parent = anchor
		local plate = Instance.new("Frame")
		plate.Size = UDim2.fromScale(1, 1)
		plate.BackgroundColor3 = Color3.fromRGB(16, 14, 28)
		plate.BackgroundTransparency = 0.25
		plate.Parent = bb
		local pc = Instance.new("UICorner")
		pc.CornerRadius = UDim.new(0.2, 0)
		pc.Parent = plate
		local ps = Instance.new("UIStroke")
		ps.Color = c
		ps.Thickness = 2
		ps.Parent = plate
		local tl = Instance.new("TextLabel")
		tl.Name = "Title"
		tl.BackgroundTransparency = 1
		tl.Size = UDim2.new(0.92, 0, 0.56, 0)
		tl.Position = UDim2.new(0.04, 0, 0.06, 0)
		tl.Font = Enum.Font.GothamBlack
		tl.TextScaled = true
		tl.TextColor3 = Color3.new(1, 1, 1)
		tl.Text = title2
		tl.Parent = plate
		local sub = Instance.new("TextLabel")
		sub.Name = "Sub"
		sub.BackgroundTransparency = 1
		sub.Size = UDim2.new(0.86, 0, 0.3, 0)
		sub.Position = UDim2.new(0.07, 0, 0.64, 0)
		sub.Font = Enum.Font.GothamBold
		sub.TextScaled = true
		sub.RichText = true
		sub.TextColor3 = Color3.fromRGB(200, 200, 220)
		sub.Text = q.Mode == "Solo" and "발판을 밟아 참가" or "A존 / B존 중 골라 서기"
		sub.Parent = plate
		pads[q.Id] = anchor
		labels[q.Id] = { Label = sub, Title = title2, Ranked = q.Ranked }
	end

	------------------------------------------------------------------
	-- 랭킹 보드 (서쪽, 클릭하면 TOP 50 창)
	------------------------------------------------------------------
	local bx = -W / 2 + 3
	local lb = part({ Name = "Leaderboard", Parent = lobby, Size = Vector3.new(30, 20, 1), Position = Vector3.new(bx, Y + 12, 10),
		Color = Color3.fromRGB(16, 14, 28) })
	lb.CFrame = CFrame.new(lb.Position) * CFrame.Angles(0, math.rad(90), 0)
	for _, e in ipairs({ { 0, 10.3, 31, 0.6 }, { 0, -10.3, 31, 0.6 }, { -15.3, 0, 0.6, 21 }, { 15.3, 0, 0.6, 21 } }) do
		part({ Name = "BoardFrame", Parent = deco, Size = Vector3.new(e[3], e[4], 1.2), CFrame = lb.CFrame * CFrame.new(e[1], e[2], 0),
			Color = LOBBY_COLORS[3], Material = Enum.Material.Neon, CanQuery = false })
	end
	local bgui = Instance.new("SurfaceGui")
	bgui.Name = "BoardGui"
	bgui.Face = Enum.NormalId.Front
	bgui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	bgui.PixelsPerStud = 30
	bgui.LightInfluence = 0
	bgui.Parent = lb
	local list = Instance.new("TextLabel")
	list.Name = "List"
	list.Size = UDim2.new(1, 0, 0.88, 0)
	list.BackgroundTransparency = 1
	list.TextColor3 = Color3.new(1, 1, 1)
	list.Font = Enum.Font.GothamBold
	list.TextSize = 34
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.Text = "랭킹 불러오는 중..."
	list.Parent = bgui
	local hint = Instance.new("TextLabel")
	hint.Size = UDim2.new(1, 0, 0.1, 0)
	hint.Position = UDim2.fromScale(0, 0.89)
	hint.BackgroundColor3 = LOBBY_COLORS[3]
	hint.TextColor3 = Color3.fromRGB(30, 20, 0)
	hint.Font = Enum.Font.GothamBlack
	hint.TextScaled = true
	hint.Text = "클릭해서 TOP 50 보기"
	hint.Parent = bgui
	local cd = Instance.new("ClickDetector")
	cd.Name = "OpenBoard"
	cd.MaxActivationDistance = 80
	cd.Parent = lb

	------------------------------------------------------------------
	-- 상점 부스 (동쪽, E로 열기)
	------------------------------------------------------------------
	local sx = W / 2 - 10
	part({ Name = "ShopCounter", Parent = lobby, Size = Vector3.new(6, 3.5, 18), Position = Vector3.new(sx, Y + 1.75, 10),
		Color = Color3.fromRGB(46, 40, 70), Material = Enum.Material.Wood })
	part({ Name = "ShopTop", Parent = deco, Size = Vector3.new(6.4, 0.4, 18.4), Position = Vector3.new(sx, Y + 3.7, 10),
		Color = LOBBY_COLORS[1], Material = Enum.Material.Neon, CanQuery = false })
	for k = 0, 5 do
		part({ Name = "Awning", Parent = deco, Size = Vector3.new(8, 0.4, 3), Position = Vector3.new(sx + 1, Y + 11, 2.5 + k * 3),
			Color = (k % 2 == 0) and LOBBY_COLORS[1] or Color3.fromRGB(250, 250, 255), Material = Enum.Material.SmoothPlastic, CanQuery = false })
	end
	for _, zz in ipairs({ 1, 19 }) do
		part({ Name = "ShopPole", Parent = deco, Size = Vector3.new(0.6, 11, 0.6), Position = Vector3.new(sx + 3.5, Y + 5.5, zz),
			Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Metal })
	end
	local sign = part({ Name = "ShopSign", Parent = deco, Size = Vector3.new(1, 3.4, 16), Position = Vector3.new(sx + 3.2, Y + 13.2, 10),
		Color = Color3.fromRGB(20, 18, 32), CanQuery = false })
	label(sign, "SHOP · CRATE", Enum.NormalId.Left).TextColor3 = LOBBY_COLORS[3]
	-- 진열대 위 페인트 통
	for k = 0, 4 do
		cyl({ Name = "Bucket", Parent = deco, Height = 1.6, Diameter = 1.6, Position = Vector3.new(sx - 1, Y + 4.7, 3.5 + k * 3.2),
			Color = LOBBY_COLORS[(k % #LOBBY_COLORS) + 1], Material = Enum.Material.SmoothPlastic, CanQuery = false })
	end
	local promptHost = part({ Name = "ShopPromptHost", Parent = lobby, Size = Vector3.new(1, 1, 1), Position = Vector3.new(sx - 4, Y + 3, 10),
		Transparency = 1, CanCollide = false, CanQuery = false })
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SF_ShopPrompt"
	prompt.ActionText = "상점 열기"
	prompt.ObjectText = "SPLASH SHOP"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = promptHost

	return {
		Folder = lobby,
		Spawn = spawn,
		SpawnCFrame = CFrame.new(0, Y + 4, 44),
		QueuePads = pads, -- 큐별 대표 위치(안내판 기준)
		QueuePadList = padList, -- { Pad, Queue, Side(0=솔로, 1=A존, 2=B존) }
		QueueLabels = labels,
		PadRadius = 5.6,
		Leaderboard = list,
	}
end

------------------------------------------------------------------------
-- 아레나 : 크로마 스퀘어 (기획서 8장 배치도와 동일)
------------------------------------------------------------------------
local HALF_X, HALF_Z = 80 * MS, 56 * MS

-- {중심x, 중심z, 크기x, 크기z, 높이, 종류}  종류: wall / crate / block
-- 왼쪽(A팀) 절반만 정의하고 x를 뒤집어 오른쪽을 만듦. 가운데(x=0) 요소는 mirror=false
local OBSTACLES = {
	{ 0, 22, 36, 2, 8, "wall", false },
	{ 0, -22, 36, 2, 8, "wall", false },
	{ -34, 12, 2, 12, 8, "wall" },
	{ -34, -12, 2, 12, 8, "wall" },
	{ -79, 0, 2, 32, 10, "wall" },
	{ -46, 0, 4, 4, 3, "crate" },
	{ -50, 22, 4, 4, 3, "crate" },
	{ -50, -22, 4, 4, 3, "crate" },
	{ -28, 32, 4, 4, 3, "crate" },
	{ -28, -32, 4, 4, 3, "crate" },
	{ -22, 0, 4, 4, 3, "crate" },
	{ -8, 38, 4, 4, 3, "crate" },
	{ -8, -38, 4, 4, 3, "crate" },
	{ -64, 30, 6, 2, 3, "crate" },
	{ -64, -30, 6, 2, 3, "crate" },
	-- 0.5: 맵 2배 확장에 맞춘 추가 엄폐물
	{ -40, 10, 4, 4, 3, "crate" },
	{ -40, -10, 4, 4, 3, "crate" },
	{ -16, 28, 4, 4, 3, "crate" },
	{ -16, -28, 4, 4, 3, "crate" },
	{ -60, 14, 4, 4, 3, "crate" },
	{ -60, -14, 4, 4, 3, "crate" },
	{ -30, 46, 4, 4, 3, "crate" },
	{ -30, -46, 4, 4, 3, "crate" },
	{ -46, 32, 4, 4, 3, "crate" },
	{ -46, -32, 4, 4, 3, "crate" },
	{ -20, 14, 6, 2, 5, "wall" },
	{ -20, -14, 6, 2, 5, "wall" },
}

-- 높은 지형 (위에 셀이 깔림): {중심x, 중심z, 크기x, 크기z, 높이}
local PLATFORMS = {
	{ 0, 0, 20, 20, 3, false },         -- 중앙 고지대
	{ -56, 40, 8, 8, 7 },               -- 저격 타워
	{ -56, -40, 8, 8, 7 },
	{ -73, 0, 10, 28, 1 },              -- 베이스
}

local function mirrored(list)
	local out = {}
	for _, o in ipairs(list) do
		table.insert(out, o)
		local mirror = o[7]
		if #o == 6 then
			mirror = o[6]
		end
		if o[1] ~= 0 and mirror ~= false then
			local copy = {}
			for i, v in ipairs(o) do
				copy[i] = v
			end
			copy[1] = -o[1]
			copy.Mirror = true
			table.insert(out, copy)
		end
	end
	return out
end

------------------------------------------------------------------------
-- 아트 패스: 도시 배경, 가로등, 베이스 배너, 전광판 (게임플레이 영향 없음)
------------------------------------------------------------------------
local function decorate(geo)
	local deco = Instance.new("Folder")
	deco.Name = "Decoration"
	deco.Parent = geo
	local rng = Random.new(2026) -- 항상 같은 도시가 나오도록 고정 시드
	local neon = { Config.Teams[1].Color, Config.Teams[2].Color, Color3.fromRGB(255, 196, 0), Color3.fromRGB(140, 90, 255) }

	-- 1) 경기장 밖 빌딩 숲
	local function building(x, z, w, d)
		local h = rng:NextInteger(26, 70)
		local b = part({ Name = "Building", Parent = deco, Size = Vector3.new(w, h, d), Position = Vector3.new(x, h / 2, z),
			Color = Color3.fromRGB(rng:NextInteger(26, 44), rng:NextInteger(26, 40), rng:NextInteger(40, 60)), Material = Enum.Material.Concrete })
		b.CanQuery = false
		local c = neon[rng:NextInteger(1, #neon)]
		-- 창문 띠
		local y = 6
		while y < h - 4 do
			if rng:NextNumber() < 0.55 then
				part({ Name = "Window", Parent = deco, Size = Vector3.new(w + 0.2, 0.6, d + 0.2), Position = Vector3.new(x, y, z),
					Color = c, Material = Enum.Material.Neon, CanCollide = false, CanQuery = false }).Transparency = 0.35
			end
			y = y + rng:NextInteger(4, 7)
		end
		-- 옥상 네온 간판
		if rng:NextNumber() < 0.35 then
			part({ Name = "RoofSign", Parent = deco, Size = Vector3.new(w * 0.7, 3, 0.6), Position = Vector3.new(x, h + 2, z),
				Color = c, Material = Enum.Material.Neon, CanCollide = false, CanQuery = false })
		end
	end
	for x = -110 * MS, 110 * MS, 24 do
		building(x + rng:NextInteger(-3, 3), -86 * MS - rng:NextInteger(0, 12), rng:NextInteger(14, 22), rng:NextInteger(14, 22))
		building(x + rng:NextInteger(-3, 3), 86 * MS + rng:NextInteger(0, 12), rng:NextInteger(14, 22), rng:NextInteger(14, 22))
	end
	for z = -66 * MS, 66 * MS, 24 do
		building(-118 * MS - rng:NextInteger(0, 10), z, rng:NextInteger(14, 22), rng:NextInteger(14, 22))
		building(118 * MS + rng:NextInteger(0, 10), z, rng:NextInteger(14, 22), rng:NextInteger(14, 22))
	end
	part({ Name = "CityGround", Parent = deco, Size = Vector3.new(320 * MS, 1, 260 * MS), Position = Vector3.new(0, -2.5, 0),
		Color = Color3.fromRGB(30, 30, 38), Material = Enum.Material.Asphalt, CanQuery = false })

	-- 2) 외벽 위 가로등 (조명)
	for _, x0 in ipairs({ -70, -50, -30, -10, 10, 30, 50, 70 }) do
		local x = x0 * MS
		for _, s in ipairs({ -1, 1 }) do
			local pole = part({ Name = "LampPole", Parent = deco, Size = Vector3.new(0.6, 8, 0.6), Position = Vector3.new(x, 20, s * (HALF_Z + 1)),
				Color = Color3.fromRGB(40, 40, 50), Material = Enum.Material.Metal, CanQuery = false })
			pole.CanCollide = false
			local head = part({ Name = "Lamp", Parent = deco, Size = Vector3.new(3, 0.6, 1.4), Position = Vector3.new(x, 24.2, s * HALF_Z),
				Color = Color3.fromRGB(255, 240, 220), Material = Enum.Material.Neon, CanCollide = false, CanQuery = false })
			local light = Instance.new("SpotLight")
			light.Face = Enum.NormalId.Bottom
			light.Range = 48
			light.Angle = 80
			light.Brightness = 2.2
			light.Color = Color3.fromRGB(255, 235, 215)
			light.Parent = head
		end
	end

	-- 3) 베이스 위 팀 배너 (경기마다 팀 색·이름으로 다시 칠함)
	local banners = {}
	for i, t in ipairs(Config.Teams) do
		local x = (i == 1) and -79 * MS or 79 * MS
		local banner = part({ Name = "TeamBanner", Parent = deco, Size = Vector3.new(1, 8, 26 * MS), Position = Vector3.new(x, 16, 0),
			Color = t.Color, Material = Enum.Material.Neon, CanQuery = false })
		banner.CanCollide = false
		banner.Transparency = 0.1
		local l = label(banner, t.Name, i == 1 and Enum.NormalId.Right or Enum.NormalId.Left)
		l.TextColor3 = Color3.fromRGB(20, 20, 30)
		banners[i] = { Part = banner, Label = l }
	end

	-- 4) 중앙 상공 전광판 (점수·시간 실시간 표시, 양면)
	local screen = part({ Name = "Jumbotron", Parent = deco, Size = Vector3.new(1, 13, 34), Position = Vector3.new(0, 30, 0),
		Color = Color3.fromRGB(10, 10, 16), Material = Enum.Material.SmoothPlastic, CanQuery = false })
	screen.CanCollide = false
	local labels = {}
	for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
		local t = label(screen, "SPLASH FRONT", face)
		t.Font = Enum.Font.GothamBlack
		table.insert(labels, t)
	end
	part({ Name = "JumboFrame", Parent = deco, Size = Vector3.new(0.8, 13.6, 34.6), Position = Vector3.new(0, 30, 0),
		Color = Config.Teams[1].Color, Material = Enum.Material.Neon, CanCollide = false, CanQuery = false }).Transparency = 0.6
	return labels, banners
end

function MapBuilder.BuildArena()
	local old = workspace:FindFirstChild("Arena")
	if old then
		old:Destroy()
	end
	local arena = Instance.new("Folder")
	arena.Name = "Arena"
	arena.Parent = workspace
	local geo = Instance.new("Folder")
	geo.Name = "Geometry"
	geo.Parent = arena
	local cells = Instance.new("Folder")
	cells.Name = "Cells"
	cells.Parent = arena

	-- 바닥
	part({ Name = "Floor", Parent = geo, Size = Vector3.new(HALF_X * 2 + 8, 2, HALF_Z * 2 + 8), Position = Vector3.new(0, -1, 0),
		Color = Color3.fromRGB(70, 72, 82), Material = Enum.Material.Concrete })
	-- 외벽 + 네온 라인
	for _, s in ipairs({ -1, 1 }) do
		part({ Name = "Boundary", Parent = geo, Size = Vector3.new(HALF_X * 2 + 8, 16, 2), Position = Vector3.new(0, 8, s * (HALF_Z + 1)),
			Color = Color3.fromRGB(44, 46, 58), Material = Enum.Material.Metal })
		part({ Name = "Boundary", Parent = geo, Size = Vector3.new(2, 16, HALF_Z * 2 + 8), Position = Vector3.new(s * (HALF_X + 1), 8, 0),
			Color = Color3.fromRGB(44, 46, 58), Material = Enum.Material.Metal })
		part({ Name = "NeonLine", Parent = geo, Size = Vector3.new(HALF_X * 2 + 8, 0.5, 0.3), Position = Vector3.new(0, 15.5, s * HALF_Z),
			Color = Config.Teams[s == -1 and 1 or 2].Color, Material = Enum.Material.Neon, CanCollide = false, CanQuery = false })
	end
	-- 투명 천장(지붕 위로 나가지 않게)
	part({ Name = "Ceiling", Parent = geo, Size = Vector3.new(HALF_X * 2 + 8, 2, HALF_Z * 2 + 8), Position = Vector3.new(0, 40, 0),
		Transparency = 1, CanQuery = false })

	local blocked = {} -- 셀을 깔지 않을 바닥 영역
	local function block(cx, cz, sx, sz)
		table.insert(blocked, { cx - sx / 2, cx + sx / 2, cz - sz / 2, cz + sz / 2 })
	end

	-- 장애물
	for _, o in ipairs(mirrored(OBSTACLES)) do
		local cx, cz, sx, sz, h, kind = o[1] * MS, o[2] * MS, o[3] * MS, o[4] * MS, o[5], o[6]
		local color, mat
		if kind == "wall" then
			color, mat = Color3.fromRGB(52, 54, 70), Enum.Material.Metal
		else
			color, mat = Color3.fromRGB(160, 120, 70), Enum.Material.WoodPlanks
		end
		local p = part({ Name = kind == "wall" and "Wall" or "Crate", Parent = geo, Size = Vector3.new(sx, h, sz),
			Position = Vector3.new(cx, h / 2, cz), Color = color, Material = mat })
		p:SetAttribute("Cover", kind)
		if kind == "wall" then
			-- 벽 윗선 네온
			part({ Name = "WallTrim", Parent = geo, Size = Vector3.new(sx + 0.1, 0.3, sz + 0.1), Position = Vector3.new(cx, h + 0.15, cz),
				Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.Neon, CanQuery = false })
		end
		block(cx, cz, sx, sz)
	end

	-- 플랫폼 + 그 위 셀
	local function addCells(x1, x2, z1, z2, y)
		local x = x1 + CELL / 2
		while x < x2 do
			local z = z1 + CELL / 2
			while z < z2 do
				local free = true
				if y < 0.5 then
					for _, b in ipairs(blocked) do
						if x > b[1] - 0.5 and x < b[2] + 0.5 and z > b[3] - 0.5 and z < b[4] + 0.5 then
							free = false
							break
						end
					end
				end
				if free then
					local c = part({ Name = "Cell", Parent = cells, Size = Vector3.new(CELL - 0.08, 0.2, CELL - 0.08),
						Position = Vector3.new(x, y + 0.1, z), Color = Config.NeutralColor, Material = Enum.Material.SmoothPlastic,
						CanCollide = false })
					c.CanTouch = false
					c.CastShadow = false
					c.Transparency = 1 -- 판정용 격자는 숨기고, 화면의 페인트는 클라이언트 PaintVisual이 그림
					c:SetAttribute("Owner", 0)
				end
				z = z + CELL
			end
			x = x + CELL
		end
	end

	for _, pl in ipairs(mirrored(PLATFORMS)) do
		local cx, cz, sx, sz, h = pl[1] * MS, pl[2] * MS, pl[3] * MS, pl[4] * MS, pl[5]
		part({ Name = "Platform", Parent = geo, Size = Vector3.new(sx, h, sz), Position = Vector3.new(cx, h / 2, cz),
			Color = Color3.fromRGB(96, 100, 116), Material = Enum.Material.Concrete })
		block(cx, cz, sx, sz)
		addCells(cx - sx / 2, cx + sx / 2, cz - sz / 2, cz + sz / 2, h)
	end

	-- 경사로
	ramp(geo, -16 * MS, -10 * MS, 0, 8 * MS, 0, 3)
	ramp(geo, 16 * MS, 10 * MS, 0, 8 * MS, 0, 3)
	for _, s in ipairs({ 1, -1 }) do
		ramp(geo, -74 * MS, -60 * MS, 40 * MS * s, 4 * MS, 0, 7)
		ramp(geo, 74 * MS, 60 * MS, 40 * MS * s, 4 * MS, 0, 7)
		-- 타워 앞쪽 흉벽(앉으면 숨는 높이)
		part({ Name = "Parapet", Parent = geo, Size = Vector3.new(1, 2.6, 8 * MS), Position = Vector3.new(-52.5 * MS, 8.3, 40 * MS * s),
			Color = Config.Teams[1].Color, Material = Enum.Material.Glass, })
		part({ Name = "Parapet", Parent = geo, Size = Vector3.new(1, 2.6, 8 * MS), Position = Vector3.new(52.5 * MS, 8.3, 40 * MS * s),
			Color = Config.Teams[2].Color, Material = Enum.Material.Glass })
	end

	block(-13 * MS, 0, 6 * MS, 8 * MS)
	block(13 * MS, 0, 6 * MS, 8 * MS)
	for _, s in ipairs({ 1, -1 }) do
		block(-67 * MS, 40 * MS * s, 14 * MS, 4 * MS)
		block(67 * MS, 40 * MS * s, 14 * MS, 4 * MS)
	end

	local jumbotron, banners = decorate(geo)

	-- 바닥 셀
	addCells(-HALF_X, HALF_X, -HALF_Z, HALF_Z, 0)

	-- 스폰 위치 (베이스 위)
	local spawns = { [1] = {}, [2] = {} }
	for i = 0, 4 do
		local z = (-10 + i * 5) * MS
		table.insert(spawns[1], CFrame.lookAt(Vector3.new(-73 * MS, 4, z), Vector3.new(0, 4, z)))
		table.insert(spawns[2], CFrame.lookAt(Vector3.new(73 * MS, 4, z), Vector3.new(0, 4, z)))
	end
	-- 솔로 모드: 맵 가장자리 8곳
	local solo = {}
	local soloPts = { { -73, 0 }, { 73, 0 }, { 0, 48 }, { 0, -48 }, { -40, 48 }, { 40, -48 }, { 40, 48 }, { -40, -48 } }
	for _, p in ipairs(soloPts) do
		local y = (math.abs(p[1]) > 68) and 4 or 3
		table.insert(solo, CFrame.lookAt(Vector3.new(p[1] * MS, y, p[2] * MS), Vector3.new(0, y, 0)))
	end

	local flags = {
		{ Name = "A", Position = Vector3.new(0, 0, -40 * MS) },
		{ Name = "C", Position = Vector3.new(0, 3, 0) },
		{ Name = "B", Position = Vector3.new(0, 0, 40 * MS) },
	}

	local missionSpots = {}
	for _, m in ipairs({ { 0, 3, 0 }, { -30, 0, 44 }, { 30, 0, -44 }, { -30, 0, -44 }, { 30, 0, 44 }, { 0, 0, 40 }, { 0, 0, -40 },
		{ -40, 0, 0 }, { 40, 0, 0 }, { -50, 0, 22 }, { 50, 0, -22 } }) do
		table.insert(missionSpots, Vector3.new(m[1] * MS, m[2], m[3] * MS))
	end

	addOutlines(geo)
	return {
		Id = "ChromaSquare",
		Name = "크로마 스퀘어",
		KillY = -40,
		Folder = arena,
		Geometry = geo,
		Cells = cells,
		Spawns = spawns,
		SoloSpawns = solo,
		FlagPoints = flags,
		MissionSpots = missionSpots,
		BaseCenters = { [1] = Vector3.new(-73 * MS, 1, 0), [2] = Vector3.new(73 * MS, 1, 0) },
		Jumbotron = jumbotron,
		TeamBanners = banners,
	}
end

------------------------------------------------------------------------
-- 맵 2: 스카이 루프탑
-- 고층 빌딩 옥상 3동(가운데 + 양 팀 스폰 빌딩) 사이를 경사로·점프패드·집라인으로 잇는 수직 맵.
-- 중앙에는 컨테이너·박스로 가득한 창고(1층 실내전 + 지붕 고지대)와 벽 아래 '저격 구멍'.
-- 빌딩 사이로 떨어지면 탈락(KillY). 좌표는 옥상 기준 상대좌표 → skyPos로 변환
------------------------------------------------------------------------
local SKY_Y = 150                         -- 가운데 옥상 바닥 높이
local SKY_O = Vector3.new(0, 0, 1400)     -- 크로마 스퀘어와 겹치지 않게 떨어진 위치 (맵 2배에 맞춰 더 멀리)

-- 설계 좌표(1배) → 월드 좌표. 가로·세로만 MS배, 높이는 그대로라
-- 점프패드(수평 속도도 MS배)·집라인의 궤적과 난간 사이 여유가 그대로 유지됨
local function skyPos(x, y, z)
	return Vector3.new(SKY_O.X + x * MS, SKY_Y + y, SKY_O.Z + z * MS)
end

function MapBuilder.BuildSkyRooftop()
	local old = workspace:FindFirstChild("SkyRooftop")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "SkyRooftop"
	root.Parent = workspace
	local geo = Instance.new("Folder")
	geo.Name = "Geometry"
	geo.Parent = root
	local cells = Instance.new("Folder")
	cells.Name = "Cells"
	cells.Parent = root
	local deco = Instance.new("Folder")
	deco.Name = "Decoration"
	deco.Parent = root

	local CONCRETE = Color3.fromRGB(78, 80, 92)
	local skyBanners = {}
	local METAL = Color3.fromRGB(118, 108, 92)
	local blocked = {}

	local function block(level, cx, cz, sx, sz)
		table.insert(blocked, { level, (cx - sx / 2) * MS, (cx + sx / 2) * MS, (cz - sz / 2) * MS, (cz + sz / 2) * MS })
	end

	-- 상대좌표 상자: 바닥 y1에서 높이 h (가로·세로 MS배)
	local function box(name, cx, y1, cz, sx, h, sz, color, mat, parent)
		return part({ Name = name, Parent = parent or geo, Size = Vector3.new(sx * MS, h, sz * MS), Position = skyPos(cx, y1 + h / 2, cz),
			Color = color or CONCRETE, Material = mat or Enum.Material.Concrete })
	end

	-- 바닥 셀 깔기 (같은 높이의 장애물 자리는 제외)
	local function cellsOn(x1, x2, z1, z2, y)
		x1, x2, z1, z2 = x1 * MS, x2 * MS, z1 * MS, z2 * MS
		local x = x1 + CELL / 2
		while x < x2 do
			local z = z1 + CELL / 2
			while z < z2 do
				local free = true
				for _, b in ipairs(blocked) do
					if math.abs(b[1] - y) < 0.5 and x > b[2] - 0.5 and x < b[3] + 0.5 and z > b[4] - 0.5 and z < b[5] + 0.5 then
						free = false
						break
					end
				end
				if free then
					local c = part({ Name = "Cell", Parent = cells, Size = Vector3.new(CELL - 0.08, 0.2, CELL - 0.08),
						Position = Vector3.new(SKY_O.X + x, SKY_Y + y + 0.1, SKY_O.Z + z), Color = Config.NeutralColor, CanCollide = false })
					c.CanTouch = false
					c.CastShadow = false
					c.Transparency = 1 -- 판정용 격자는 숨기고, 화면의 페인트는 클라이언트 PaintVisual이 그림
					c:SetAttribute("Owner", 0)
				end
				z = z + CELL
			end
			x = x + CELL
		end
	end

	-- 경사로 + 난간 (xLow 높이 y0 → xHigh 높이 y0+h)
	local function skyRamp(xLow, xHigh, z, width, y0, h)
		width = width * MS
		local len = math.abs(xHigh - xLow) * MS
		local slope = math.sqrt(len * len + h * h)
		local angle = math.atan(h / len)
		if xHigh < xLow then
			angle = -angle
		end
		local cf = CFrame.new(skyPos((xLow + xHigh) / 2, y0 + h / 2 - 0.5, z)) * CFrame.Angles(0, 0, angle)
		part({ Name = "Ramp", Parent = geo, Size = Vector3.new(slope, 1, width), CFrame = cf,
			Color = Color3.fromRGB(150, 150, 160), Material = Enum.Material.DiamondPlate })
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "Rail", Parent = geo, Size = Vector3.new(slope, 2.4, 0.4), CFrame = cf * CFrame.new(0, 1.7, side * (width / 2 + 0.2)),
				Color = Color3.fromRGB(255, 196, 0), Material = Enum.Material.Metal })
		end
	end

	-- 점프패드: 밟으면 launch 속도로 발사 (플레이어는 클라이언트, 봇은 서버가 처리)
	local function jumpPad(x, y, z, launch)
		launch = Vector3.new(launch.X * MS, launch.Y, launch.Z * MS) -- 비행 시간은 같고 수평 거리만 MS배
		local pad = part({ Name = "JumpPad", Parent = geo, Size = Vector3.new(6, 0.6, 6), Position = skyPos(x, y + 0.3, z),
			Color = Color3.fromRGB(0, 255, 220), Material = Enum.Material.Neon })
		pad:SetAttribute("Launch", launch)
		CollectionService:AddTag(pad, "SF_JumpPad")
		local ring = part({ Name = "PadRing", Parent = deco, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 7.5, 7.5),
			CFrame = CFrame.new(skyPos(x, y + 0.65, z)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 255, 255),
			Material = Enum.Material.Neon, CanCollide = false, CanQuery = false })
		ring.Transparency = 0.5
		local light = Instance.new("PointLight")
		light.Color = pad.Color
		light.Range = 12
		light.Brightness = 2
		light.Parent = pad
		local cooldown = {}
		pad.Touched:Connect(function(hit)
			local model = hit:FindFirstAncestorOfClass("Model")
			local bots = workspace:FindFirstChild("Bots")
			if not model or not bots or not model:IsDescendantOf(bots) then
				return
			end
			if cooldown[model] and os.clock() - cooldown[model] < 0.8 then
				return
			end
			cooldown[model] = os.clock()
			local r = model:FindFirstChild("HumanoidRootPart")
			if r then
				r.AssemblyLinearVelocity = launch
			end
		end)
		block(y, x, z, 6 / MS, 6 / MS)
		return pad
	end

	-- 집라인: 시작 기둥의 E 프롬프트로 탑승, from → to 로 미끄러져 내려감
	local function zipline(from, to, fromBase, toBase)
		local h1, h2 = from.Y - (SKY_Y + fromBase), to.Y - (SKY_Y + toBase)
		local startPole = part({ Name = "ZipStart", Parent = geo, Size = Vector3.new(0.8, h1, 0.8), Position = from - Vector3.new(0, h1 / 2, 0),
			Color = Color3.fromRGB(255, 196, 0), Material = Enum.Material.Metal })
		part({ Name = "ZipEnd", Parent = geo, Size = Vector3.new(0.8, h2, 0.8), Position = to - Vector3.new(0, h2 / 2, 0),
			Color = Color3.fromRGB(255, 196, 0), Material = Enum.Material.Metal })
		local len = (to - from).Magnitude
		part({ Name = "ZipCable", Parent = deco, Size = Vector3.new(0.25, 0.25, len), CFrame = CFrame.lookAt((from + to) / 2, to),
			Color = Color3.fromRGB(30, 30, 30), Material = Enum.Material.Metal, CanCollide = false, CanQuery = false })
		startPole:SetAttribute("ZipFrom", from)
		startPole:SetAttribute("ZipTo", to)
		CollectionService:AddTag(startPole, "SF_Zipline")
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "집라인 타기"
		prompt.ObjectText = "집라인"
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = startPole
	end

	--------------------------------------------------------------------
	-- 빌딩 3동
	--------------------------------------------------------------------
	box("MidTower", 0, -SKY_Y, 0, 100, SKY_Y, 104, Color3.fromRGB(46, 48, 62))
	for _, s in ipairs({ -1, 1 }) do
		box("SpawnTower", 76 * s, -SKY_Y, 0, 20, SKY_Y + 8, 60, Color3.fromRGB(40, 42, 56))
	end
	-- 빌딩 외벽 네온 창문 띠
	local y = -12
	local band = 0
	while y > -SKY_Y + 10 do
		band = band + 1
		local c = (band % 2 == 0) and Config.Teams[1].Color or Config.Teams[2].Color
		part({ Name = "WindowBand", Parent = deco, Size = Vector3.new(100 * MS + 0.4, 0.8, 104 * MS + 0.4), Position = skyPos(0, y, 0), Color = c,
			Material = Enum.Material.Neon, CanCollide = false, CanQuery = false }).Transparency = 0.45
		for _, s in ipairs({ -1, 1 }) do
			part({ Name = "WindowBand", Parent = deco, Size = Vector3.new(20 * MS + 0.4, 0.8, 60 * MS + 0.4), Position = skyPos(76 * s, y + 6, 0),
				Color = Config.Teams[s == -1 and 1 or 2].Color, Material = Enum.Material.Neon, CanCollide = false, CanQuery = false }).Transparency = 0.45
		end
		y = y - 12
	end

	--------------------------------------------------------------------
	-- 옥상 가장자리 난간(앉으면 숨는 높이)
	--------------------------------------------------------------------
	for _, t in ipairs({ -1, 1 }) do
		box("Parapet", 0, 0, 51.5 * t, 100, 2.5, 1, CONCRETE)
		block(0, 0, 51.5 * t, 100, 1)
	end
	for _, s in ipairs({ -1, 1 }) do
		for _, seg in ipairs({ { -52, -25 }, { -19, 19 }, { 25, 52 } }) do
			local cz, len = (seg[1] + seg[2]) / 2, seg[2] - seg[1]
			box("Parapet", 49.5 * s, 0, cz, 1, 2.5, len, CONCRETE)
			block(0, 49.5 * s, cz, 1, len)
		end
		-- 스폰 빌딩 옥상: 뒤 벽(높음), 옆 난간, 앞 난간(경사로 자리 비움)
		local back = box("SpawnWall", 85.5 * s, 8, 0, 1, 6, 60, Color3.fromRGB(36, 36, 48))
		block(8, 85.5 * s, 0, 1, 60)
		local bl = label(back, "SKY ROOFTOP", s == -1 and Enum.NormalId.Right or Enum.NormalId.Left)
		bl.TextColor3 = Config.Teams[s == -1 and 1 or 2].Color
		skyBanners[s == -1 and 1 or 2] = { Label = bl }
		for _, t in ipairs({ -1, 1 }) do
			box("Parapet", 76 * s, 8, 29.5 * t, 20, 2.5, 1, CONCRETE)
			block(8, 76 * s, 29.5 * t, 20, 1)
		end
		for _, seg in ipairs({ { -30, -25 }, { -19, 19 }, { 25, 30 } }) do
			local cz, len = (seg[1] + seg[2]) / 2, seg[2] - seg[1]
			box("Parapet", 66.5 * s, 8, cz, 1, 2.5, len, CONCRETE)
			block(8, 66.5 * s, cz, 1, len)
		end
		-- 빌딩 사이 경사로 2개 (허공 위 다리)
		for _, t in ipairs({ -1, 1 }) do
			skyRamp(50 * s, 66 * s, 22 * t, 6, 0, 8)
		end
		-- 스폰 옥상 엄폐 박스
		for _, t in ipairs({ -1, 1 }) do
			box("Crate", 70 * s, 8, 12 * t, 4, 3, 4, Color3.fromRGB(160, 120, 70), Enum.Material.WoodPlanks)
			block(8, 70 * s, 12 * t, 4, 4)
		end
	end

	--------------------------------------------------------------------
	-- 중앙 창고 (1층 실내전 + 지붕 고지대, 벽 아래 저격 구멍)
	--------------------------------------------------------------------
	local W_H = 10
	local function wallX(z, x1, x2)    -- z 고정, x 방향 벽
		local cx, len = (x1 + x2) / 2, x2 - x1
		box("WarehouseWall", cx, 0, z, len, W_H, 1, METAL, Enum.Material.CorrodedMetal)
		block(0, cx, z, len, 1)
	end
	local function wallZ(x, z1, z2)    -- x 고정, z 방향 벽
		local cz, len = (z1 + z2) / 2, z2 - z1
		box("WarehouseWall", x, 0, cz, 1, W_H, len, METAL, Enum.Material.CorrodedMetal)
		block(0, x, cz, 1, len)
	end
	local function lintelX(z, x1, x2)
		box("Lintel", (x1 + x2) / 2, 7, z, x2 - x1, W_H - 7, 1, METAL, Enum.Material.CorrodedMetal)
	end
	local function lintelZ(x, z1, z2)
		box("Lintel", x, 7, (z1 + z2) / 2, 1, W_H - 7, z2 - z1, METAL, Enum.Material.CorrodedMetal)
	end
	for _, t in ipairs({ -1, 1 }) do
		local z = 13.5 * t
		-- 양 끝 구간은 바닥 1~2.4 높이가 뚫린 '저격 구멍' (앉아서 쏘는 낮은 틈)
		for _, seg in ipairs({ { -20, -12 }, { 12, 20 } }) do
			local cx, len = (seg[1] + seg[2]) / 2, seg[2] - seg[1]
			box("WallSill", cx, 0, z, len, 1, 1, METAL, Enum.Material.CorrodedMetal)
			box("WarehouseWall", cx, 2.4, z, len, W_H - 2.4, 1, METAL, Enum.Material.CorrodedMetal)
			block(0, cx, z, len, 1)
		end
		wallX(z, -6, 6)
		lintelX(z, -12, -6)
		lintelX(z, 6, 12)
	end
	for _, s in ipairs({ -1, 1 }) do
		local x = 19.5 * s
		wallZ(x, -14, -4)
		wallZ(x, 4, 14)
		lintelZ(x, -4, 4)
	end
	-- 지붕 (가운데 길쭉한 채광창 구멍)
	local roofParts = { { -20, -3, -14, 14 }, { 3, 20, -14, 14 }, { -3, 3, 10, 14 }, { -3, 3, -14, -10 } }
	for _, r in ipairs(roofParts) do
		box("WarehouseRoof", (r[1] + r[2]) / 2, W_H, (r[3] + r[4]) / 2, r[2] - r[1], 1, r[4] - r[3], Color3.fromRGB(96, 90, 80), Enum.Material.Metal)
	end
	-- 지붕 난간
	for _, t in ipairs({ -1, 1 }) do
		box("RoofRail", 0, W_H + 1, 13.75 * t, 40, 1.6, 0.5, Color3.fromRGB(255, 196, 0), Enum.Material.Metal)
		block(W_H + 1, 0, 13.75 * t, 40, 0.5)
		box("RoofRail", 19.75 * t, W_H + 1, 0, 0.5, 1.6, 28, Color3.fromRGB(255, 196, 0), Enum.Material.Metal)
		block(W_H + 1, 19.75 * t, 0, 0.5, 28)
	end
	-- 실내 박스 + 조명
	for _, s in ipairs({ -1, 1 }) do
		for _, t in ipairs({ -1, 1 }) do
			box("Crate", 12 * s, 0, 7 * t, 4, 3, 4, Color3.fromRGB(160, 120, 70), Enum.Material.WoodPlanks)
			block(0, 12 * s, 7 * t, 4, 4)
		end
		local lamp = part({ Name = "CeilingLamp", Parent = deco, Size = Vector3.new(4, 0.3, 1), Position = skyPos(10 * s, W_H - 0.4, 0),
			Color = Color3.fromRGB(255, 240, 210), Material = Enum.Material.Neon, CanCollide = false, CanQuery = false })
		local l = Instance.new("PointLight")
		l.Range = 22
		l.Brightness = 1.6
		l.Parent = lamp
	end

	--------------------------------------------------------------------
	-- 컨테이너 레인 + 컨테이너 2단 탑(깃발 A/B 고지대)
	--------------------------------------------------------------------
	local CONTAINER = { Color3.fromRGB(200, 90, 40), Color3.fromRGB(40, 110, 170), Color3.fromRGB(60, 140, 80), Color3.fromRGB(170, 40, 60) }
	for _, s in ipairs({ -1, 1 }) do
		for i, t in ipairs({ -1, 1 }) do
			box("Container", 34 * s, 0, 33 * t, 14, 7, 6, CONTAINER[i + (s == 1 and 2 or 0)], Enum.Material.CorrodedMetal)
			block(0, 34 * s, 33 * t, 14, 6)
		end
	end
	for i, t in ipairs({ -1, 1 }) do
		box("Container", 0, 0, 42 * t, 16, 6, 6, CONTAINER[i], Enum.Material.CorrodedMetal)
		box("Container", 0, 6, 42 * t, 16, 6, 6, CONTAINER[i + 2], Enum.Material.CorrodedMetal)
		block(0, 0, 42 * t, 16, 6)
	end

	-- 옥상 박스(절반 엄폐)
	for _, s in ipairs({ -1, 1 }) do
		for _, c in ipairs({ { -37, 0 }, { -40, 26 }, { -40, -26 }, { -28, 8 }, { -28, -8 }, { -12, 26 }, { -12, -26 },
			{ -44, 44 }, { -44, -44 }, { -14, 46 }, { -14, -46 } }) do
			box("Crate", c[1] * s, 0, c[2], 4, 3, 4, Color3.fromRGB(160, 120, 70), Enum.Material.WoodPlanks)
			block(0, c[1] * s, c[2], 4, 4)
		end
	end

	--------------------------------------------------------------------
	-- 점프패드
	--------------------------------------------------------------------
	for _, t in ipairs({ -1, 1 }) do
		jumpPad(0, 0, 7 * t, Vector3.new(0, 75, 8 * t))          -- 창고 안 → 채광창 위 지붕
		jumpPad(0, 0, 30 * t, Vector3.new(0, 80, 18 * t))        -- 레인 → 컨테이너 탑(깃발 A/B)
	end
	for _, s in ipairs({ -1, 1 }) do
		jumpPad(26 * s, 0, 0, Vector3.new(-14 * s, 75, 0))       -- 창고 정문 앞 → 창고 지붕
		jumpPad(45 * s, 0, 0, Vector3.new(42 * s, 78, 0))        -- 옥상 끝 → 허공 건너 스폰 빌딩 (스폰 난간 위로 넘김)
	end

	--------------------------------------------------------------------
	-- 집라인 (높은 곳 → 낮은 곳)
	--------------------------------------------------------------------
	for _, s in ipairs({ -1, 1 }) do
		for _, t in ipairs({ -1, 1 }) do
			-- 시뮬레이션으로 난간·경사로 난간·컨테이너와 안 부딪히는 높이/경로 확인
			zipline(skyPos(72 * s, 19, 20 * t), skyPos(26 * s, 7, 46 * t), 8, 0)    -- 스폰 옥상(경사로 입구 위) → 사이드 레인
			zipline(skyPos(6 * s, 20, 42 * t), skyPos(44 * s, 7, 16 * t), 12, 0)   -- 컨테이너 탑 → 옥상 가장자리
		end
	end

	--------------------------------------------------------------------
	-- 페인트 셀 (각 층)
	--------------------------------------------------------------------
	cellsOn(-50, 50, -52, 52, 0)                       -- 가운데 옥상 + 창고 1층
	for _, s in ipairs({ -1, 1 }) do
		local x1 = (s == -1) and -86 or 66
		cellsOn(x1, x1 + 20, -30, 30, 8)               -- 스폰 옥상
	end
	for _, r in ipairs(roofParts) do
		cellsOn(r[1], r[2], r[3], r[4], W_H + 1)       -- 창고 지붕
	end
	for _, t in ipairs({ -1, 1 }) do
		cellsOn(-8, 8, 42 * t - 3, 42 * t + 3, 12)     -- 컨테이너 탑 위
	end

	--------------------------------------------------------------------
	-- 배경: 발아래 도시 + 먼 스카이라인, 전광판, 옥상 조명
	--------------------------------------------------------------------
	local rng = Random.new(1750)
	local neon = { Config.Teams[1].Color, Config.Teams[2].Color, Color3.fromRGB(255, 196, 0), Color3.fromRGB(140, 90, 255) }
	part({ Name = "Street", Parent = deco, Size = Vector3.new(700 * MS, 1, 700 * MS), Position = Vector3.new(SKY_O.X, -0.5, SKY_O.Z),
		Color = Color3.fromRGB(24, 24, 32), Material = Enum.Material.Asphalt, CanQuery = false })
	for i = 1, 70 do
		local a = rng:NextNumber() * math.pi * 2
		local dist = rng:NextNumber(115, 300) * MS
		local far = dist > 220 * MS
		local h = far and rng:NextInteger(160, 240) or rng:NextInteger(50, 135)
		local w = rng:NextInteger(16, 30) * (MS > 1 and 1.5 or 1)
		local pos = Vector3.new(SKY_O.X + math.cos(a) * dist, h / 2, SKY_O.Z + math.sin(a) * dist)
		part({ Name = "CityBuilding", Parent = deco, Size = Vector3.new(w, h, w), Position = pos,
			Color = Color3.fromRGB(rng:NextInteger(24, 40), rng:NextInteger(24, 36), rng:NextInteger(38, 58)), Material = Enum.Material.Concrete,
			CanQuery = false })
		local c = neon[rng:NextInteger(1, #neon)]
		local wy = 8
		while wy < h - 4 do
			if rng:NextNumber() < 0.5 then
				part({ Name = "Window", Parent = deco, Size = Vector3.new(w + 0.2, 0.6, w + 0.2), Position = Vector3.new(pos.X, wy, pos.Z),
					Color = c, Material = Enum.Material.Neon, CanCollide = false, CanQuery = false }).Transparency = 0.4
			end
			wy = wy + rng:NextInteger(5, 9)
		end
	end
	-- 옥상 투광등
	for _, s in ipairs({ -1, 1 }) do
		for _, t in ipairs({ -1, 1 }) do
			local lamp = part({ Name = "Floodlight", Parent = deco, Size = Vector3.new(2, 1, 2), Position = skyPos(48 * s, 9, 50 * t),
				Color = Color3.fromRGB(255, 245, 225), Material = Enum.Material.Neon, CanCollide = false, CanQuery = false })
			local spot = Instance.new("SpotLight")
			spot.Face = Enum.NormalId.Bottom
			spot.Range = 45
			spot.Angle = 90
			spot.Brightness = 2
			spot.Parent = lamp
			box("LightPole", 48 * s, 0, 50.6 * t, 0.5, 8.5, 0.5, Color3.fromRGB(40, 40, 50), Enum.Material.Metal, deco).CanQuery = false
		end
	end
	-- 전광판
	local screen = part({ Name = "Jumbotron", Parent = deco, Size = Vector3.new(1, 9, 24), Position = skyPos(0, 30, 0),
		Color = Color3.fromRGB(10, 10, 16), CanQuery = false })
	screen.CanCollide = false
	local jumbotron = {}
	for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
		table.insert(jumbotron, label(screen, "SKY ROOFTOP", face))
	end

	--------------------------------------------------------------------
	-- 스폰·깃발·미션 지점
	--------------------------------------------------------------------
	local spawns = { [1] = {}, [2] = {} }
	for _, z in ipairs({ -16, -8, 0, 8, 16 }) do
		table.insert(spawns[1], CFrame.lookAt(skyPos(-79, 11, z), skyPos(0, 11, z)))
		table.insert(spawns[2], CFrame.lookAt(skyPos(79, 11, z), skyPos(0, 11, z)))
	end
	local solo = {}
	for _, p3 in ipairs({ { -79, 11, 0 }, { 79, 11, 0 }, { 0, 3, 49 }, { 0, 3, -49 }, { -30, 3, 48 }, { 30, 3, -48 }, { 30, 3, 48 }, { 8, 14, 0 } }) do
		table.insert(solo, CFrame.lookAt(skyPos(p3[1], p3[2], p3[3]), skyPos(0, p3[2], 0)))
	end

	-- 스카이 루프탑은 처음의 어두운 네온 도시 + 노을 분위기 그대로 (흰색 팔레트·표면 텍스처 적용 안 함)
	addOutlines(geo, true)
	return {
		Id = "SkyRooftop",
		Name = "스카이 루프탑",
		Folder = root,
		Geometry = geo,
		Cells = cells,
		Spawns = spawns,
		SoloSpawns = solo,
		FlagPoints = {
			{ Name = "A", Position = skyPos(0, 12, -42) },
			{ Name = "C", Position = skyPos(0, 0, 0) },
			{ Name = "B", Position = skyPos(0, 12, 42) },
		},
		MissionSpots = {
			skyPos(0, 0, 0), skyPos(0, 12, 42), skyPos(0, 12, -42), skyPos(30, 0, 42), skyPos(-30, 0, -42),
			skyPos(-30, 0, 42), skyPos(30, 0, -42), skyPos(40, 0, 0), skyPos(-40, 0, 0), skyPos(10, 11, 0),
		},
		KillY = SKY_Y - 30,
		Lighting = "Sunset",
		NoTextures = true,
		Jumbotron = jumbotron,
		TeamBanners = skyBanners,
	}
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">MatchService</string><ProtectedString name="Source"><![CDATA[-- 매치 흐름: 로비 대기 → 카운트다운 → 경기(터프/플래그/솔로) → 결과·보상·랭크 → 로비
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Weapons = require(ReplicatedStorage.Shared.Weapons)
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
local ModelKit = require(ReplicatedStorage.Shared.ModelKit)
local Combatants = require(script.Parent.Combatants)
local PaintService = require(script.Parent.PaintService)
local CombatService = require(script.Parent.CombatService)
local MissionService = require(script.Parent.MissionService)
local BotService = require(script.Parent.BotService)
local DataService = require(script.Parent.DataService)
local RankService = require(script.Parent.RankService)
local Telemetry = require(script.Parent.TelemetryService)
local ItemService = require(script.Parent.ItemService)
local QuestService = require(script.Parent.QuestService)
local MapBuilder = require(script.Parent.MapBuilder)

local MatchService = {}

local remotes, arena, lobby
local maps = {}
local nextMapIndex = 1
local queueMap = {}    -- queueId -> 방장이 고른 맵 Id ("random" 포함)
local joinAt = {}      -- player -> 대기열 참가 시각 (발판 이탈 검사 유예)
local S = {
	Phase = "Lobby",
	QueueId = nil,
	Mode = nil,
	EndsAt = 0,
	Owners = {},     -- 경기 참가 ownerId 목록 { {OwnerId, Name, Color} }
	Bonus = {},      -- ownerId -> 미션 보너스
	FlagScore = {},  -- ownerId -> 점수 (플래그 모드)
	Flags = {},      -- { Name, Position, Owner, Progress = {ownerId -> 0~1}, Model }
	Mission = nil,
	FinalSplash = false,
}

local function now()
	return workspace:GetServerTimeNow()
end

local function queueDef(id)
	for _, q in ipairs(Config.Queues) do
		if q.Id == id then
			return q
		end
	end
	return nil
end

local function ownerInfo(ownerId)
	for _, o in ipairs(S.Owners) do
		if o.OwnerId == ownerId then
			return o
		end
	end
	return nil
end

function MatchService.ColorOf(ownerId)
	local o = ownerInfo(ownerId)
	return o and o.Color or Config.NeutralColor
end

local function announce(text, color)
	remotes.Notify:FireAllClients(text, color or Color3.new(1, 1, 1))
end

------------------------------------------------------------------------
-- 미션이 쓰는 API
------------------------------------------------------------------------
local missionApi = {
	AddBonus = function(ownerId, pts)
		S.Bonus[ownerId] = (S.Bonus[ownerId] or 0) + pts
		if S.Mode == "Flag" then
			S.FlagScore[ownerId] = (S.FlagScore[ownerId] or 0) + pts * 5
		end
	end,
	RewardOwner = function(ownerId, coins)
		for _, e in ipairs(Combatants.All()) do
			if e.OwnerId == ownerId then
				e.Coins = e.Coins + coins
			end
		end
	end,
	-- 미션 성공 팀원(플레이어) 전원에게 무작위 아이템 1개
	RewardItems = function(ownerId)
		for _, e in ipairs(Combatants.All()) do
			if e.OwnerId == ownerId and e.Player and e.Player.Parent then
				QuestService.Add(e.Player, "Missions", 1)
				DataService.AddXP(e.Player, Config.XP.Mission)
				local it = ItemService.GrantRandom(e.Player)
				if it then
					remotes.Notify:FireClient(e.Player, "미션 보상: " .. it.Name .. " 획득! [F] 사용", Color3.fromRGB(255, 220, 90))
				end
			end
		end
	end,
	SetMission = function(m)
		S.Mission = m
	end,
	Announce = announce,
	Cue = function(name, owner, pos)
		remotes.FX:FireAllClients("Cue", { Name = name, Owner = owner, Pos = pos })
	end,
	OwnerName = function(ownerId)
		local o = ownerInfo(ownerId)
		return o and o.Name or "?"
	end,
	ColorOf = function(ownerId)
		return MatchService.ColorOf(ownerId)
	end,
}

------------------------------------------------------------------------
-- 점수
------------------------------------------------------------------------
local function scores()
	local coverage = PaintService.GetCoverage()
	local kills = {}
	for _, e in ipairs(Combatants.All()) do
		kills[e.OwnerId] = (kills[e.OwnerId] or 0) + e.Kills
	end
	-- 전체 합계 (몫 계산용)
	local sumCov, sumCombat = 0, 0
	for _, o in ipairs(S.Owners) do
		sumCov = sumCov + (coverage[o.OwnerId] or 0)
		sumCombat = sumCombat + (kills[o.OwnerId] or 0) + (S.Bonus[o.OwnerId] or 0) * Config.MissionKillValue
	end
	local W = Config.WinWeights
	local list = {}
	for _, o in ipairs(S.Owners) do
		local cov = coverage[o.OwnerId] or 0
		local bonus = S.Bonus[o.OwnerId] or 0
		local combat = (kills[o.OwnerId] or 0) + bonus * Config.MissionKillValue
		local score
		if S.Mode == "Flag" then
			score = S.FlagScore[o.OwnerId] or 0
		else
			-- 페인트 몫 80% + 전투(처치·미션) 몫 20% → 0~100점
			local paintShare = (sumCov > 0) and (cov / sumCov) or 0
			local combatShare = (sumCombat > 0) and (combat / sumCombat) or 0
			score = 100 * (W.Paint * paintShare + W.Combat * combatShare)
		end
		table.insert(list, {
			OwnerId = o.OwnerId, Name = o.Name, Color = o.Color, Kills = kills[o.OwnerId] or 0,
			Coverage = math.floor(cov * 10 + 0.5) / 10, Bonus = bonus, Score = math.floor(score * 10 + 0.5) / 10,
		})
	end
	return list
end

local function queueCounts()
	local counts = {}
	for _, q in ipairs(Config.Queues) do
		counts[q.Id] = 0
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		local q = pl:GetAttribute("Queue")
		if q and counts[q] and not pl:GetAttribute("InMatch") then
			counts[q] = counts[q] + 1
		end
	end
	return counts
end

-- 팀전 존(A=1/B=2)별 대기 인원
local function sideCounts(queueId)
	local c = { 0, 0 }
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl:GetAttribute("Queue") == queueId and not pl:GetAttribute("InMatch") then
			local sd = pl:GetAttribute("QueueSide")
			if sd == 1 or sd == 2 then
				c[sd] = c[sd] + 1
			end
		end
	end
	return c
end

local function broadcast()
	local flags = {}
	for _, f in ipairs(S.Flags) do
		local best = 0
		for _, v in pairs(f.Progress) do
			best = math.max(best, v)
		end
		table.insert(flags, { Name = f.Name, Owner = f.Owner, Progress = best })
	end
	local modeDef = S.Mode and Config.Modes[S.Mode]
	if arena.Jumbotron then
		local text = Config.GameName
		if S.Phase == "Playing" then
			local parts = {}
			for _, t in ipairs(scores()) do
				table.insert(parts, string.format("%.0f", t.Score))
			end
			local left = math.max(0, math.floor(S.EndsAt - now()))
			text = string.format("%d:%02d\n%s", math.floor(left / 60), left % 60, table.concat(parts, "  :  "))
		elseif S.Phase == "Results" then
			text = "RESULTS"
		end
		for _, l in ipairs(arena.Jumbotron) do
			l.Text = text
		end
	end
	-- 대기열별 방장(먼저 들어온 사람)·선택 맵
	local queueInfo = {}
	local counts = queueCounts()
	for _, q in ipairs(Config.Queues) do
		local host = MatchService.QueueHost(q.Id)
		if counts[q.Id] == 0 then
			queueMap[q.Id] = nil
		end
		local choice = queueMap[q.Id]
		local mapName = "순환 (" .. (maps[nextMapIndex] and maps[nextMapIndex].Name or "") .. ")"
		if choice == "random" then
			mapName = "랜덤"
		elseif choice then
			for _, m in ipairs(maps) do
				if m.Id == choice then
					mapName = m.Name
				end
			end
		end
		local cap = (q.Mode == "Solo") and 8 or q.TeamSize * 2
		local sides = q.Mode ~= "Solo" and sideCounts(q.Id) or nil
		queueInfo[q.Id] = { Host = host and host.DisplayName or nil, HostId = host and host.UserId or nil, Map = mapName, MapId = choice,
			Capacity = cap, Full = counts[q.Id] >= cap, Sides = sides, TeamSize = q.TeamSize }
		if sides and lobby and lobby.QueuePadList then
			for _, ent in ipairs(lobby.QueuePadList) do
				if ent.Queue == q.Id and ent.Side > 0 then
					local tag = ent.Pad:FindFirstChild("ZoneTag")
					local tx = tag and tag:FindFirstChild("Text")
					local want = (ent.Side == 1 and "A" or "B") .. "존 " .. sides[ent.Side] .. "/" .. q.TeamSize
					if tx and tx.Text ~= want then
						tx.Text = want
					end
				end
			end
		end
		-- 로비 발판 위 안내판
		local pl = lobby and lobby.QueueLabels and lobby.QueueLabels[q.Id]
		if pl then
			local n = counts[q.Id]
			local line2 = (n > 0) and string.format('<font color="#FFE060">대기 %d명</font>', n)
				or (q.Mode == "Solo" and '<font color="#B0B0C8">발판을 밟아 참가</font>' or '<font color="#B0B0C8">A존 / B존 중 골라 서기</font>')
			local txt = line2 .. (pl.Ranked and '  <font color="#FFC840">랭크</font>' or "")
			if pl.Label.Text ~= txt then
				pl.Label.Text = txt
			end
		end
	end
	-- 상단 TOP 5 (처치 → 칠한 셀 순)
	local board = {}
	if S.Phase == "Playing" or S.Phase == "Results" then
		local all = {}
		for _, e in ipairs(Combatants.All()) do
			table.insert(all, e)
		end
		table.sort(all, function(a, b)
			if a.Kills ~= b.Kills then
				return a.Kills > b.Kills
			end
			return a.Cells > b.Cells
		end)
		for i = 1, math.min(5, #all) do
			local e = all[i]
			table.insert(board, { Name = e.Name, UserId = e.Player and e.Player.UserId or nil, Kills = e.Kills, Streak = e.Streak or 0,
				Color = MatchService.ColorOf(e.OwnerId), OwnerId = e.OwnerId })
		end
	end
	local mapList = {}
	for _, m in ipairs(maps) do
		table.insert(mapList, { Id = m.Id, Name = m.Name })
	end
	remotes.State:FireAllClients({
		Phase = S.Phase,
		QueueId = S.QueueId,
		Mode = S.Mode,
		ModeName = modeDef and modeDef.Name or "",
		MapName = arena.Name,
		MapId = arena.Id,
		NextMapName = maps[nextMapIndex] and maps[nextMapIndex].Name or "",
		EndsAt = S.EndsAt,
		Teams = scores(),
		Mission = S.Mission,
		Flags = flags,
		QueueCounts = counts,
		QueueInfo = queueInfo,
		Board = board,
		Maps = mapList,
		FinalSplash = S.FinalSplash,
	})
end

------------------------------------------------------------------------
-- 스폰
------------------------------------------------------------------------
-- 팀 보호구: 가슴·등 플레이트, 어깨 패드, 무릎 패드, 탄약 벨트 (ModelKit.Armor)
local function teamVest(character, color)
	local old = character:FindFirstChild("SF_Armor")
	if old then
		old:Destroy()
	end
	ModelKit.Armor(character, color)
end

-- 총(오른손) + 크루 헬멧 + 잉크 탱크 백팩 (Blender 모델, 업로드 전에는 내장 대체 모델)
-- 손에 든 총: 팔을 앞으로 든 자세(클라이언트 CharacterPose)에서 총구가 정면을 향하도록
-- 손의 -Y(손끝 방향)를 총의 앞(-Z)으로 맞춤
local GUN_GRIP = CFrame.new(0, -0.35, -0.05) * CFrame.Angles(math.rad(-90), 0, 0)
local function attachGun(e, model)
	local old = model:FindFirstChild("SF_Gun")
	if old then
		old:Destroy()
	end
	local color = MatchService.ColorOf(e.OwnerId)
	local hand = model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm")
	if hand then
		local skin = e.Player and Cosmetics.ById[e.Player:GetAttribute("Skin") or ""] or nil
		local gun = ModelKit.Gun(e.WeaponId, color, skin, skin and Cosmetics.MaterialOf(skin.Material) or nil)
		gun.Name = "SF_Gun"
		ModelKit.WeldTo(gun, hand, GUN_GRIP)
	end
end

local function attachGear(e, model)
	for _, n in ipairs({ "SF_Helmet", "SF_Backpack" }) do
		local old = model:FindFirstChild(n)
		if old then
			old:Destroy()
		end
	end
	local color = MatchService.ColorOf(e.OwnerId)
	attachGun(e, model)
	local head = model:FindFirstChild("Head")
	if head then
		-- 모자 액세서리는 헬멧과 겹치므로 경기 중에만 숨김 (머리카락은 그대로)
		for _, acc in ipairs(model:GetChildren()) do
			local handle = acc:IsA("Accessory") and acc:FindFirstChild("Handle")
			if handle and handle:FindFirstChild("HatAttachment") then
				handle.Transparency = 1
			end
		end
		local helmet = ModelKit.Helmet(color)
		helmet.Name = "SF_Helmet"
		ModelKit.WeldTo(helmet, head, CFrame.new(0, 0.1, 0))
	end
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if torso then
		local pack = ModelKit.Backpack(color)
		pack.Name = "SF_Backpack"
		ModelKit.WeldTo(pack, torso, CFrame.new(0, 0.05, torso.Size.Z / 2))
	end
end

local function spawnCFrame(e)
	if S.Mode == "Solo" then
		return arena.SoloSpawns[((e.OwnerId - 1) % #arena.SoloSpawns) + 1]
	end
	local list = arena.Spawns[e.TeamId]
	return list[math.random(1, #list)]
end

local onDied

local function activate(e, model)
	Combatants.SetModel(e, model)
	e.Alive = true
	e.Ink = Config.InkMax
	e.ProtectedUntil = os.clock() + Config.SpawnProtection
	e.SpawnedAt = os.clock()
	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.MaxHealth = Config.MaxHealth
	hum.Health = Config.MaxHealth
	hum.BreakJointsOnDeath = false
	local ff = Instance.new("ForceField")
	ff.Visible = true
	ff.Parent = model
	task.delay(Config.SpawnProtection, function()
		if ff.Parent then
			ff:Destroy()
		end
	end)
	teamVest(model, MatchService.ColorOf(e.OwnerId))
	local okGear, gearErr = pcall(attachGear, e, model)
	if not okGear then
		warn("[SplashFront] 장비 부착 실패:", gearErr)
	end
	ItemService.OnSpawn(e)
	-- 기획서 4장: 적 색 위에 서 있으면 발밑에서 페인트가 튀어 위치가 드러남
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		local att = Instance.new("Attachment")
		att.Name = "FeetAttachment"
		att.Position = Vector3.new(0, -2.8, 0)
		att.Parent = root
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "EnemyInkReveal"
		pe.Enabled = false
		pe.Rate = 18
		pe.Lifetime = NumberRange.new(0.4, 0.7)
		pe.Speed = NumberRange.new(4, 8)
		pe.SpreadAngle = Vector2.new(60, 60)
		pe.Acceleration = Vector3.new(0, -30, 0)
		pe.Size = NumberSequence.new(0.35, 0.05)
		pe.LightEmission = 0.4
		pe.Parent = att
	end
	hum.Died:Connect(function()
		onDied(e, model)
	end)
	Combatants.Sync(e)
end

local function spawnEntity(e)
	if S.Phase ~= "Playing" then
		return
	end
	local cf = spawnCFrame(e)
	if e.IsBot then
		local model = BotService.CreateModel(e, cf, MatchService.ColorOf(e.OwnerId))
		activate(e, model)
	else
		local player = e.Player
		if not player or not player.Parent then
			return
		end
		player:LoadCharacter()
		local character = player.Character
		if not character then
			return
		end
		local root = character:WaitForChild("HumanoidRootPart", 5)
		if root then
			character:PivotTo(cf)
		end
		activate(e, character)
	end
end

onDied = function(e, model)
	if not e.Alive or e.Model ~= model then
		return
	end
	e.Alive = false
	e.Deaths = e.Deaths + 1
	e.Streak = 0
	local killer = e.LastAttacker
	local root = model:FindFirstChild("HumanoidRootPart")
	if killer and killer ~= e then
		killer.Kills = killer.Kills + 1
		killer.Streak = (killer.Streak or 0) + 1
		local t = os.clock()
		if t - (killer.LastKillAt or -99) <= Config.MultiKillWindow then
			killer.Multi = (killer.Multi or 1) + 1
		else
			killer.Multi = 1
		end
		killer.LastKillAt = t
		if killer.Player then
			local head = e.LastHeadshot == true
			local coins = Config.Rewards.Kill + (head and Config.Rewards.Headshot or 0)
			local xp = Config.XP.Kill + (head and Config.XP.Headshot or 0)
			DataService.AddXP(killer.Player, xp)
			QuestService.Add(killer.Player, "Kills", 1)
			if head then
				QuestService.Add(killer.Player, "Headshots", 1)
			end
			remotes.FX:FireClient(killer.Player, "Elim", {
				Victim = e.Name, VictimColor = MatchService.ColorOf(e.OwnerId), Head = head, Multi = killer.Multi,
				Streak = killer.Streak, Coins = coins, XP = xp,
			})
		end
		Combatants.Killed:Fire(killer, e, e.LastHeadshot)
		if root then
			PaintService.PaintBelow(root.Position, 6, killer.OwnerId, killer)
		end
	end
	remotes.FX:FireAllClients("Kill", {
		Killer = killer and killer.Name or nil,
		KillerColor = killer and MatchService.ColorOf(killer.OwnerId) or nil,
		Victim = e.Name,
		VictimColor = MatchService.ColorOf(e.OwnerId),
		Head = e.LastHeadshot,
		Effect = killer and killer.KillEffect or nil,
		Weapon = killer and Weapons.Get(killer.WeaponId).Name or nil,
		WeaponId = killer and killer.WeaponId or nil,
		KillerStreak = killer and killer.Streak or 0,
		WeaponClass = killer and Weapons.Get(killer.WeaponId).Class or nil,
		Pos = root and root.Position or nil,
		KillerPlayer = killer and killer.Player or nil,
		VictimPlayer = e.Player,
	})
	e.LastAttacker = nil
	e.LastHeadshot = false
	task.delay(Config.RespawnTime, function()
		if S.Phase == "Playing" and Combatants.FromModel(model) == e then
			if e.IsBot and model.Parent then
				model:Destroy()
			end
			spawnEntity(e)
		end
	end)
end

------------------------------------------------------------------------
-- 깃발 (플래그 러시)
------------------------------------------------------------------------
local function buildFlags()
	local fx = workspace:FindFirstChild("FX")
	for _, def in ipairs(arena.FlagPoints) do
		local model = Instance.new("Model")
		model.Name = "Flag_" .. def.Name
		local base = Instance.new("Part")
		base.Name = "Base"
		base.Shape = Enum.PartType.Cylinder
		base.Anchored = true
		base.CanCollide = false
		base.Material = Enum.Material.Neon
		base.Color = Color3.fromRGB(255, 255, 255)
		base.Transparency = 0.5
		base.Size = Vector3.new(0.3, Config.Flag.Radius * 2, Config.Flag.Radius * 2)
		base.CFrame = CFrame.new(def.Position + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
		base.Parent = model
		local pole = Instance.new("Part")
		pole.Name = "Pole"
		pole.Anchored = true
		pole.Size = Vector3.new(0.5, 12, 0.5)
		pole.Position = def.Position + Vector3.new(0, 6, 0)
		pole.Color = Color3.fromRGB(230, 230, 230)
		pole.Material = Enum.Material.Metal
		pole.Parent = model
		local cloth = Instance.new("Part")
		cloth.Name = "Cloth"
		cloth.Anchored = true
		cloth.CanCollide = false
		cloth.Size = Vector3.new(0.2, 3, 5)
		cloth.Position = def.Position + Vector3.new(0, 10.5, 2.6)
		cloth.Color = Config.NeutralColor
		cloth.Material = Enum.Material.Fabric
		cloth.Parent = model
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(120, 50)
		bb.StudsOffset = Vector3.new(0, 14, 0)
		bb.AlwaysOnTop = true
		bb.Adornee = pole
		bb.Parent = model
		local t = Instance.new("TextLabel")
		t.Name = "Label"
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextColor3 = Color3.new(1, 1, 1)
		t.TextStrokeTransparency = 0.2
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.Text = "깃발 " .. def.Name
		t.Parent = bb
		model.Parent = fx
		table.insert(S.Flags, { Name = def.Name, Position = def.Position, Owner = 0, Progress = {}, Model = model })
	end
end

local function flagTick(dt)
	for _, f in ipairs(S.Flags) do
		local present = {}
		local nPresent = 0
		for _, e in ipairs(Combatants.All()) do
			if e.Alive and e.Model then
				local r = e.Model:FindFirstChild("HumanoidRootPart")
				if r then
					local d = r.Position - f.Position
					if Vector3.new(d.X, 0, d.Z).Magnitude <= Config.Flag.Radius and math.abs(d.Y) < 7 then
						if not present[e.TeamId] then
							present[e.TeamId] = true
							nPresent = nPresent + 1
						end
					end
				end
			end
		end
		if nPresent == 1 then
			local team = next(present)
			if team ~= f.Owner then
				local ground = PaintService.OwnerBelow(f.Position + Vector3.new(0, 2, 0))
				local t = Config.Flag.PlantTime
				if ground ~= 0 and ground ~= team then
					t = Config.Flag.PlantTimeEnemyGround
				end
				f.Progress[team] = (f.Progress[team] or 0) + dt / t
				if f.Progress[team] >= 1 then
					f.Owner = team
					f.Progress = {}
					local color = MatchService.ColorOf(team)
					f.Model.Cloth.Color = color
					f.Model.Base.Color = color
					PaintService.PaintAt(f.Position + Vector3.new(0, 1, 0), Config.Flag.Radius, team, nil)
					announce(string.format("%s 팀이 깃발 %s를 꽂았다!", missionApi.OwnerName(team), f.Name), color)
					remotes.FX:FireAllClients("Cue", { Name = "flag", Owner = team })
				end
			end
		elseif nPresent == 0 then
			for k, v in pairs(f.Progress) do
				f.Progress[k] = math.max(0, v - dt * 0.25)
			end
		end
	end
end

------------------------------------------------------------------------
-- 경기 시작 / 종료
------------------------------------------------------------------------
-- 색상환에서 충분히 떨어진 두 팀 색을 무작위로 고름
local function pickTeams()
	local pal = Config.TeamPalette or Config.Teams
	for _ = 1, 60 do
		local a = pal[math.random(1, #pal)]
		local b = pal[math.random(1, #pal)]
		if a ~= b then
			local h1 = a.Color:ToHSV()
			local h2 = b.Color:ToHSV()
			local d = math.abs(h1 - h2)
			d = math.min(d, 1 - d)
			if d >= (Config.TeamMinHueGap or 0.2) then
				return { { Id = 1, Name = a.Name, Color = a.Color }, { Id = 2, Name = b.Name, Color = b.Color } }
			end
		end
	end
	return Config.Teams
end

local function mapIndexFor(q)
	local choice = queueMap[q.Id]
	queueMap[q.Id] = nil
	if choice == "random" then
		return math.random(1, #maps), false
	end
	for i, m in ipairs(maps) do
		if m.Id == choice then
			return i, false
		end
	end
	return nextMapIndex, true
end

local function startMatch(q)
	local mode = q.Mode
	local capacity = (mode == "Solo") and 8 or q.TeamSize * 2

	-- 참가자 선정
	local humans = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl:GetAttribute("Queue") == q.Id and not pl:GetAttribute("InMatch") and #humans < capacity then
			table.insert(humans, pl)
		end
	end
	if #humans == 0 then
		return false
	end

	Combatants.Clear()
	local mapIndex, rotate = mapIndexFor(q)
	MatchService.ApplyMap(maps[mapIndex])
	if rotate then
		nextMapIndex = nextMapIndex % #maps + 1
	end
	PaintService.SetRadiusMultiplier(1)
	S.QueueId = q.Id
	S.Mode = mode
	S.Bonus = {}
	S.FlagScore = {}
	S.Flags = {}
	S.Mission = nil
	S.FinalSplash = false
	S.Owners = {}
	S.HasBots = false
	local fx = workspace:FindFirstChild("FX")
	if fx then
		fx:ClearAllChildren()
	end

	local slots = {}
	if mode == "Solo" then
		for i = 1, capacity do
			table.insert(S.Owners, { OwnerId = i, Name = "", Color = Config.SoloColors[i] })
			slots[i] = { OwnerId = i, TeamId = i }
		end
	else
		local teams = pickTeams()
		for _, t in ipairs(teams) do
			table.insert(S.Owners, { OwnerId = t.Id, Name = t.Name, Color = t.Color })
		end
		-- 경기장 팀 배너를 이번 판 색·이름으로
		for i, b in pairs(arena.TeamBanners or {}) do
			local t = teams[i]
			if t then
				if b.Part then
					b.Part.Color = t.Color
				else
					b.Label.TextColor3 = t.Color
				end
				b.Label.Text = t.Name
			end
		end
		-- 로비에서 선 존(A=1팀, B=2팀) 그대로 팀 구성. 존 정보가 없으면 인원이 적은 쪽으로 → 남는 자리는 봇
		local per = { 0, 0 }
		for i, pl in ipairs(humans) do
			local team = pl:GetAttribute("QueueSide")
			if team ~= 1 and team ~= 2 or per[team] >= q.TeamSize then
				team = (per[1] <= per[2]) and 1 or 2
			end
			per[team] = per[team] + 1
			slots[i] = { OwnerId = team, TeamId = team }
		end
		local i = #humans
		for team = 1, 2 do
			while per[team] < q.TeamSize do
				per[team] = per[team] + 1
				i = i + 1
				slots[i] = { OwnerId = team, TeamId = team }
			end
		end
	end
	local palette = {}
	for _, o in ipairs(S.Owners) do
		palette[o.OwnerId] = o.Color
	end
	PaintService.SetPalette(palette)
	CombatService.SetColorResolver(MatchService.ColorOf)

	local entities = {}
	for i, pl in ipairs(humans) do
		local profile = DataService.Get(pl)
		local e = Combatants.New({
			Id = "P" .. pl.UserId, Name = pl.DisplayName, Player = pl,
			OwnerId = slots[i].OwnerId, TeamId = slots[i].TeamId,
			WeaponId = profile and profile.Equipped or Weapons.Default,
		})
		if profile and profile.EquippedPattern and Cosmetics.ById[profile.EquippedPattern] then
			e.PatternMaterial = Cosmetics.MaterialOf(Cosmetics.ById[profile.EquippedPattern].Material)
		end
		e.KillEffect = profile and profile.EquippedEffect or nil
		local played = pl:GetAttribute("SessionMatches") or 0
		Telemetry.Funnel(pl, played == 0 and "MatchStarted" or "SecondMatch")
		pl:SetAttribute("SessionMatches", played + 1)
		pl:SetAttribute("InMatch", true)
		pl:SetAttribute("OwnerId", e.OwnerId)
		pl:SetAttribute("TeamId", e.TeamId)
		pl:SetAttribute("TeamColor", MatchService.ColorOf(e.OwnerId))
		pl:SetAttribute("Weapon", e.WeaponId)
		table.insert(entities, e)
		if mode == "Solo" then
			S.Owners[i].Name = pl.DisplayName
		end
	end
	local filled = #humans
	if Config.FillWithBots then
		for i = filled + 1, capacity do
			local e = Combatants.New({
				Id = "B" .. i, Name = BotService.NextName(), IsBot = true,
				OwnerId = slots[i].OwnerId, TeamId = slots[i].TeamId, WeaponId = BotService.RandomWeapon(),
			})
			S.HasBots = true
			table.insert(entities, e)
			if mode == "Solo" then
				S.Owners[i].Name = e.Name
			end
		end
	end
	if mode == "Solo" then
		-- 빈 슬롯(봇 미사용 시)은 점수판에서 제외
		local used = {}
		for _, e in ipairs(entities) do
			used[e.OwnerId] = true
		end
		local trimmed = {}
		for _, o in ipairs(S.Owners) do
			if used[o.OwnerId] then
				table.insert(trimmed, o)
			end
		end
		S.Owners = trimmed
	end

	if mode == "Flag" then
		buildFlags()
	end

	S.Phase = "Playing"
	S.StartedAt = now()
	S.EndsAt = now() + Config.MatchLength
	CombatService.SetActive(true)
	for _, e in ipairs(entities) do
		task.spawn(spawnEntity, e)
	end
	BotService.Start()
	MissionService.Start()
	for _, pl in ipairs(humans) do
		remotes.FX:FireClient(pl, "Cue", { Name = "countdown_go" })
	end
	announce(Config.Modes[mode].Name .. " 시작! " .. Config.Modes[mode].Desc, Color3.fromRGB(255, 255, 255))
	return true
end

local function endMatch()
	S.Phase = "Results"
	CombatService.SetActive(false)
	MissionService.Stop()
	local final = scores()
	table.sort(final, function(a, b)
		return a.Score > b.Score
	end)
	local winner = nil
	if #final >= 2 and final[1].Score > final[2].Score then
		winner = final[1].OwnerId
	elseif #final == 1 then
		winner = final[1].OwnerId
	end

	local q = queueDef(S.QueueId)
	local ranked = q and q.Ranked and (not S.HasBots or Config.RankedAllowBots)

	-- 팀 내 기여 순위
	local all = Combatants.All()
	local byOwner = {}
	for _, e in ipairs(all) do
		byOwner[e.OwnerId] = byOwner[e.OwnerId] or {}
		table.insert(byOwner[e.OwnerId], e)
	end
	local perf = {}
	for _, list in pairs(byOwner) do
		table.sort(list, function(a, b)
			return (a.Cells + a.Kills * 30) > (b.Cells + b.Kills * 30)
		end)
		for i, e in ipairs(list) do
			perf[e] = (#list > 1) and (1 - (i - 1) / (#list - 1)) or 1
		end
	end

	local rows = {}
	local statRows = {}
	local seconds = math.max(1, now() - (S.StartedAt or now()))
	for _, e in ipairs(all) do
		local won = (winner ~= nil and e.OwnerId == winner)
		local coins = (won and Config.Rewards.Win or Config.Rewards.Lose)
			+ e.Kills * Config.Rewards.Kill
			+ math.floor(e.Cells / 100) * Config.Rewards.Per100Cells
			+ (e.Headshots or 0) * Config.Rewards.Headshot
			+ e.Coins
		local ratingDelta = nil
		if e.Player and e.Player.Parent then
			coins = DataService.AddCoins(e.Player, coins)
			local p = DataService.Get(e.Player)
			if p then
				p.Matches = p.Matches + 1
				p.Kills = p.Kills + e.Kills
				p.Cells = p.Cells + e.Cells
				if won then
					p.Wins = p.Wins + 1
				end
			end
			if ranked then
				ratingDelta = RankService.Apply(e.Player, won, perf[e])
			end
			RankService.RecordMeta(e.Player)
			DataService.AddXP(e.Player, (won and Config.XP.Win or Config.XP.Lose) + math.floor(e.Cells / Config.XP.PerCells))
			QuestService.Add(e.Player, "Matches", 1)
			QuestService.Add(e.Player, "Cells", e.Cells)
			if won then
				QuestService.Add(e.Player, "Wins", 1)
			end
			Telemetry.Funnel(e.Player, "MatchFinished")
			Telemetry.Economy(e.Player, true, coins, p and p.Coins or 0, "Gameplay", "MatchReward")
			Telemetry.Custom(e.Player, "MatchEnd", e.Cells, S.Mode .. "/" .. tostring(S.QueueId), e.WeaponId, won and "win" or "lose")
			e.Player:SetAttribute("FirstMatch", false)
			table.insert(statRows, {
				WeaponId = e.WeaponId, Won = won, Kills = e.Kills, Deaths = e.Deaths, Shots = e.Shots or 0,
				Hits = e.Hits or 0, Headshots = e.Headshots or 0, Cells = e.Cells, Seconds = seconds,
			})
			DataService.Publish(e.Player)
		end
		table.insert(rows, {
			Name = e.Name, IsBot = e.IsBot, Player = e.Player, OwnerId = e.OwnerId,
			Score = e.Cells + e.Kills * 30, Weapon = Weapons.Get(e.WeaponId).Name,
			Color = MatchService.ColorOf(e.OwnerId), Kills = e.Kills, Deaths = e.Deaths,
			Cells = e.Cells, Coins = e.IsBot and 0 or coins, RatingDelta = ratingDelta, Won = won,
		})
	end
	table.sort(rows, function(a, b)
		return (a.Cells + a.Kills * 30) > (b.Cells + b.Kills * 30)
	end)
	Telemetry.RecordMatch(statRows)

	local winnerInfo = winner and ownerInfo(winner)
	remotes.Results:FireAllClients({
		Mode = S.Mode,
		Teams = final,
		WinnerName = winnerInfo and winnerInfo.Name or nil,
		WinnerColor = winnerInfo and winnerInfo.Color or nil,
		Rows = rows,
		Ranked = ranked,
	})
	broadcast()
	task.wait(Config.ResultsTime)

	-- 정리 후 로비로
	BotService.Stop()
	local fx = workspace:FindFirstChild("FX")
	if fx then
		fx:ClearAllChildren()
	end
	S.Flags = {}
	for _, e in ipairs(all) do
		if e.Player and e.Player.Parent then
			e.Player:SetAttribute("InMatch", false)
			e.Player:SetAttribute("Queue", nil)
			e.Player:SetAttribute("QueueSide", nil)
			e.Player:SetAttribute("OwnerId", nil)
			e.Player:SetAttribute("TeamColor", nil)
			e.Player:SetAttribute("SpawnZone", false)
			ItemService.Clear(e.Player)
			e.Player:LoadCharacter()
			DataService.Save(e.Player)
		end
	end
	Combatants.Clear()
	MapBuilder.ApplyLighting("Day") -- 로비로 돌아오면 낮 조명
	S.Phase = "Lobby"
	S.Mode = nil
	S.QueueId = nil
	S.Mission = nil
	S.Owners = {}
	broadcast()
end

------------------------------------------------------------------------
-- 루프
------------------------------------------------------------------------
local function pickQueue()
	local counts = queueCounts()
	local best, bestN = nil, 0
	for _, q in ipairs(Config.Queues) do
		if counts[q.Id] > bestN then
			best, bestN = q, counts[q.Id]
		end
	end
	return best
end

-- 대기열의 방장 = 가장 먼저 들어온 사람
function MatchService.QueueHost(queueId)
	local best, bestT = nil, math.huge
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl:GetAttribute("Queue") == queueId and not pl:GetAttribute("InMatch") then
			local t = pl:GetAttribute("QueueTime") or 0
			if t < bestT then
				best, bestT = pl, t
			end
		end
	end
	return best
end

-- 큐 + 존에 해당하는 발판 (솔로는 side 0)
local function padOf(queueId, side)
	for _, ent in ipairs(lobby and lobby.QueuePadList or {}) do
		if ent.Queue == queueId and ent.Side == (side or 0) then
			return ent.Pad
		end
	end
	return nil
end

local function setQueue(player, queueId, viaPad, side)
	if player:GetAttribute("InMatch") then
		return
	end
	local q = queueId ~= nil and queueDef(queueId)
	if queueId ~= nil and not q then
		return
	end
	if q and q.Mode ~= "Solo" then
		local c = sideCounts(queueId)
		if player:GetAttribute("Queue") == queueId then
			local cur = player:GetAttribute("QueueSide")
			if cur == 1 or cur == 2 then
				c[cur] = c[cur] - 1
			end
		end
		if side ~= 1 and side ~= 2 then
			side = (c[1] <= c[2]) and 1 or 2
		end
		if c[side] >= q.TeamSize then
			local other = 3 - side
			if viaPad or c[other] >= q.TeamSize then
				remotes.Notify:FireClient(player, (side == 1 and "A" or "B") .. "존이 꽉 찼어요" .. (c[other] < q.TeamSize and " — 반대쪽 존에 서 주세요" or ""),
					Color3.fromRGB(255, 180, 120))
				return
			end
			side = other
		end
	else
		side = nil
	end
	if player:GetAttribute("Queue") == queueId and player:GetAttribute("QueueSide") == side then
		return
	end
	player:SetAttribute("Queue", queueId)
	player:SetAttribute("QueueSide", side)
	if queueId then
		player:SetAttribute("QueueTime", os.clock())
		joinAt[player] = os.clock()
		Telemetry.Funnel(player, "Queued")
		-- UI로 참가하면 해당 발판 위로 이동 (발판을 벗어나면 취소되는 규칙과 맞춤)
		local pad = padOf(queueId, side)
		local char = player.Character
		if not viaPad and pad and char and char:FindFirstChild("HumanoidRootPart") then
			local a = math.random() * math.pi * 2
			char:PivotTo(CFrame.new(pad.Position + Vector3.new(math.cos(a) * 2, 3.5, math.sin(a) * 2)))
		end
	else
		player:SetAttribute("QueueTime", nil)
		player:SetAttribute("QueueSide", nil)
		joinAt[player] = nil
	end
end

-- 방장만 맵을 고를 수 있음 (mapId = 맵 Id 또는 "random", nil이면 순환)
local function setHostMap(player, mapId)
	local qid = player:GetAttribute("Queue")
	if not qid or player:GetAttribute("InMatch") or MatchService.QueueHost(qid) ~= player then
		return
	end
	if mapId ~= nil and mapId ~= "random" then
		local ok = false
		for _, m in ipairs(maps) do
			if m.Id == mapId then
				ok = true
			end
		end
		if not ok then
			return
		end
	end
	queueMap[qid] = mapId
end

-- 방장: 발판에 정원이 모두 모였으면 카운트다운을 건너뛰고 바로 시작
local function startNow(player)
	local qid = player:GetAttribute("Queue")
	local q = qid and queueDef(qid)
	if not q or MatchService.QueueHost(qid) ~= player then
		return
	end
	local cap = (q.Mode == "Solo") and 8 or q.TeamSize * 2
	if queueCounts()[qid] < cap then
		remotes.Notify:FireClient(player, "정원이 모두 모여야 바로 시작할 수 있어요", Color3.fromRGB(255, 200, 90))
		return
	end
	if S.Phase == "Countdown" and S.QueueId == qid then
		S.EndsAt = math.min(S.EndsAt, now() + 1)
		announce("방장이 바로 시작을 눌렀어요!", Color3.fromRGB(140, 255, 200))
	end
end

-- 경기 도중 로비로 나가기 (보상 없음, 자리는 남은 인원으로 계속)
function MatchService.LeaveMatch(player)
	if not player:GetAttribute("InMatch") then
		return
	end
	-- 어떤 단계(경기·결과)에서든 확실히 로비로: 각 정리 단계가 실패해도 다음 단계는 계속
	local e = Combatants.FromPlayer(player)
	pcall(function()
		if e then
			e.Alive = false
			Combatants.Remove(e)
		end
	end)
	for _, a in ipairs({ "Queue", "QueueTime", "QueueSide", "OwnerId", "TeamId", "TeamColor" }) do
		player:SetAttribute(a, nil)
	end
	player:SetAttribute("SpawnZone", false)
	player:SetAttribute("InMatch", false)
	pcall(ItemService.Clear, player)
	pcall(function()
		if player.Character then
			player.Character:Destroy()
		end
	end)
	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	if not ok then
		warn("[SplashFront] 로비 부활 실패:", err)
		task.delay(1, function()
			if player.Parent then
				pcall(function()
					player:LoadCharacter()
				end)
			end
		end)
	end
	Telemetry.Custom(player, "LeftMatch", 1, S.Mode or "", tostring(S.QueueId), "")
	remotes.Notify:FireClient(player, "경기에서 나와 로비로 돌아왔어요", Color3.fromRGB(200, 220, 255))
end

-- 경기 중 무기 교체: 부활 직후이거나 우리 스폰 근처일 때만
local function nearOwnSpawn(e)
	local r = e.Model and e.Model:FindFirstChild("HumanoidRootPart")
	if not r then
		return false
	end
	local list = (S.Mode == "Solo") and arena.SoloSpawns or arena.Spawns[e.TeamId]
	for _, cf in ipairs(list or {}) do
		if (cf.Position - r.Position).Magnitude <= Config.WeaponSwitchRadius then
			return true
		end
	end
	return false
end

local function canSwitch(e)
	if not e.Alive or S.Phase ~= "Playing" then
		return false
	end
	return (os.clock() - (e.SpawnedAt or 0)) <= Config.WeaponSwitchGrace or nearOwnSpawn(e)
end

local function switchWeapon(player, weaponId)
	local e = Combatants.FromPlayer(player)
	local w = Weapons.ById[weaponId]
	local p = DataService.Get(player)
	if not e or not w or not p or e.WeaponId == w.Id then
		return
	end
	if not p.Owned[w.Id] then
		remotes.Notify:FireClient(player, "보유하지 않은 무기예요 — 로비 상점에서 구매", Color3.fromRGB(255, 140, 140))
		return
	end
	if not canSwitch(e) then
		remotes.Notify:FireClient(player, "무기 교체는 스폰 지점에서만 가능해요", Color3.fromRGB(255, 200, 90))
		return
	end
	e.WeaponId = w.Id
	e.Ink = Config.InkMax
	p.Equipped = w.Id
	DataService.Publish(player)
	player:SetAttribute("Weapon", w.Id)
	if e.Model then
		pcall(attachGun, e, e.Model)
		ItemService.OnSpawn(e)
	end
	Combatants.Sync(e)
	remotes.Notify:FireClient(player, "무기 교체: " .. w.Name .. " (" .. w.Class .. ")", Color3.fromRGB(140, 255, 200))
end

-- 이번 경기에 쓸 맵으로 모든 서비스를 전환
function MatchService.ApplyMap(info)
	arena = info
	MapBuilder.ApplyLighting(info.Lighting or "Day")
	PaintService.Init(info.Cells)
	BotService.SetCells(info.Cells)
	MissionService.SetMap(info)
	local v = ReplicatedStorage:FindFirstChild("ActiveCells")
	if v then
		v.Value = info.Cells
	end
end

function MatchService.SetNextMap(query)
	for i, m in ipairs(maps) do
		if tostring(query) == tostring(i) or m.Id == query or m.Name == query then
			nextMapIndex = i
			return m.Name
		end
	end
	nextMapIndex = nextMapIndex % #maps + 1
	return maps[nextMapIndex].Name
end

function MatchService.Init(remoteFolder, mapList, lobbyInfo)
	remotes = remoteFolder
	maps = mapList
	arena = maps[1]
	lobby = lobbyInfo
	MissionService.Init(arena, missionApi)
	BotService.SetCells(arena.Cells)
	BotService.SetGoalProvider(function(e)
		if S.Mode == "Flag" then
			local best, bestD = nil, math.huge
			local root = e.Model and e.Model:FindFirstChild("HumanoidRootPart")
			for _, f in ipairs(S.Flags) do
				if f.Owner ~= e.TeamId and root then
					local d = (f.Position - root.Position).Magnitude
					if d < bestD then
						best, bestD = f.Position, d
					end
				end
			end
			return best
		end
		if S.Mission and S.Mission.Pos then
			return S.Mission.Pos
		end
		return nil
	end)

	remotes.Queue.OnServerEvent:Connect(function(player, a, b)
		if a == "map" then
			setHostMap(player, b)
		elseif a == "startNow" then
			startNow(player)
		elseif a == "leaveMatch" then
			MatchService.LeaveMatch(player)
		elseif a == nil or type(a) == "string" then
			setQueue(player, a, false)
		end
	end)
	remotes.SwitchWeapon.OnServerEvent:Connect(switchWeapon)
	for _, ent in ipairs(lobby.QueuePadList) do
		local id, side = ent.Queue, ent.Side
		ent.Pad.Touched:Connect(function(hit)
			local pl = Players:GetPlayerFromCharacter(hit.Parent)
			if not pl or pl:GetAttribute("InMatch") then
				return
			end
			local want = side > 0 and side or nil
			if pl:GetAttribute("Queue") == id and pl:GetAttribute("QueueSide") == want then
				return
			end
			setQueue(pl, id, true, want)
			if pl:GetAttribute("Queue") == id then
				local zone = side == 1 and " A존" or side == 2 and " B존" or ""
				remotes.Notify:FireClient(pl, "대기열 참가: " .. id .. zone .. " — 발판에서 내려오면 취소돼요", Color3.fromRGB(255, 255, 255))
			end
		end)
	end
	-- 발판을 벗어나면 대기 취소
	task.spawn(function()
		while true do
			task.wait(0.3)
			for _, pl in ipairs(Players:GetPlayers()) do
				local qid = pl:GetAttribute("Queue")
				if qid and not pl:GetAttribute("InMatch") and os.clock() - (joinAt[pl] or 0) > Config.PadLeaveGrace then
					local pad = padOf(qid, pl:GetAttribute("QueueSide"))
					local char = pl.Character
					local r = char and char:FindFirstChild("HumanoidRootPart")
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if pad and r and hum and hum.Health > 0 then
						local d = r.Position - pad.Position
						local radius = math.max(pad.Size.Y, pad.Size.Z) / 2 + 0.8
						local onPad = Vector3.new(d.X, 0, d.Z).Magnitude <= radius and d.Y > -2 and d.Y < 9
						if not onPad then
							setQueue(pl, nil)
							remotes.Notify:FireClient(pl, "발판을 벗어나 대기가 취소됐어요", Color3.fromRGB(255, 180, 120))
						end
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(pl)
		joinAt[pl] = nil
		local e = Combatants.FromPlayer(pl)
		if e then
			e.Alive = false
			Combatants.Remove(e)
		end
	end)
end

function MatchService.Run()
	task.spawn(function()
		while true do
			broadcast()
			task.wait(0.5)
		end
	end)

	-- 바닥 색 처리: 적 색 노출 파티클(전원) + 봇 이동속도(플레이어는 클라이언트가 처리)
	task.spawn(function()
		while true do
			if S.Phase == "Playing" then
				for _, e in ipairs(Combatants.All()) do
					if e.Alive and e.Model then
						local r = e.Model:FindFirstChild("HumanoidRootPart")
						local h = e.Model:FindFirstChildOfClass("Humanoid")
						local o = r and PaintService.OwnerBelow(r.Position) or 0
						local fa = r and r:FindFirstChild("FeetAttachment")
						local pe = fa and fa:FindFirstChild("EnemyInkReveal")
						if pe then
							local onEnemy = o ~= 0 and o ~= e.OwnerId
							pe.Enabled = onEnemy
							if onEnemy then
								pe.Color = ColorSequence.new(MatchService.ColorOf(o))
							end
						end
						if e.Player then
							local can = canSwitch(e)
							if e.Player:GetAttribute("SpawnZone") ~= can then
								e.Player:SetAttribute("SpawnZone", can)
							end
						end
						if e.IsBot and r and h then
							if o == e.OwnerId then
								h.WalkSpeed = Config.WalkSpeedOwn
							elseif o ~= 0 then
								h.WalkSpeed = Config.WalkSpeedEnemy
							else
								h.WalkSpeed = Config.WalkSpeed
							end
						end
					end
				end
			end
			task.wait(0.25)
		end
	end)

	task.spawn(function()
		while true do
			-- 1) 로비 대기
			S.Phase = "Lobby"
			local q = nil
			while not q do
				task.wait(1)
				q = pickQueue()
			end
			-- 2) 카운트다운
			S.Phase = "Countdown"
			S.QueueId = q.Id
			S.EndsAt = now() + Config.LobbyCountdown
			local aborted = false
			local lastSec = nil
			while now() < S.EndsAt do
				task.wait(0.25)
				local sec = math.ceil(S.EndsAt - now())
				if sec ~= lastSec and sec <= 3 and sec >= 1 then
					lastSec = sec
					for _, pl in ipairs(Players:GetPlayers()) do
						if pl:GetAttribute("Queue") == q.Id then
							remotes.FX:FireClient(pl, "Cue", { Name = "countdown_tick" })
						end
					end
				end
				if queueCounts()[q.Id] == 0 then
					aborted = true
					break
				end
			end
			if not aborted and startMatch(q) then
				-- 3) 경기
				local last = os.clock()
				while S.Phase == "Playing" do
					task.wait(0.25)
					local dt = os.clock() - last
					last = os.clock()
					local left = S.EndsAt - now()
					if not S.FinalSplash and left <= Config.FinalSplashTime then
						S.FinalSplash = true
						PaintService.SetRadiusMultiplier(Config.FinalSplashMul)
						announce("파이널 스플래시! 페인트 범위 1.5배", Color3.fromRGB(255, 220, 60))
						remotes.FX:FireAllClients("Cue", { Name = "final_splash", Volume = 0.8 })
					end
					if S.Mode == "Flag" then
						flagTick(dt)
						for _, f in ipairs(S.Flags) do
							if f.Owner ~= 0 then
								S.FlagScore[f.Owner] = (S.FlagScore[f.Owner] or 0) + Config.Flag.PointsPerSecond * dt
							end
						end
						for _, v in pairs(S.FlagScore) do
							if v >= Config.Flag.WinScore then
								left = 0
							end
						end
					end
					-- 낙사 판정 (스카이 루프탑 등 낭떠러지 맵)
					if arena.KillY then
						for _, e in ipairs(Combatants.All()) do
							if e.Alive and e.Model then
								local r = e.Model:FindFirstChild("HumanoidRootPart")
								local h = e.Model:FindFirstChildOfClass("Humanoid")
								if r and h and h.Health > 0 and r.Position.Y < arena.KillY then
									if os.clock() - e.LastDamaged > 6 then
										e.LastAttacker = nil
									end
									h.Health = 0
								end
							end
						end
					end
					local anyHuman = false
					for _, e in ipairs(Combatants.All()) do
						if not e.IsBot then
							anyHuman = true
						end
					end
					if left <= 0 or not anyHuman then
						endMatch()
					end
				end
			else
				S.QueueId = nil
			end
		end
	end)
end

function MatchService.GetPhase()
	return S.Phase
end

-- 관리자 패널용
function MatchService.SetTimeLeft(seconds)
	if S.Phase == "Playing" or S.Phase == "Countdown" then
		S.EndsAt = now() + math.max(0, seconds)
		return true
	end
	return false
end

function MatchService.GetState()
	return S
end

Combatants.Painted:Connect(function(e)
	if e.Player then
		Telemetry.Funnel(e.Player, "FirstPaint")
	end
end)
Combatants.Killed:Connect(function(killer)
	if killer and killer.Player then
		Telemetry.Funnel(killer.Player, "FirstKill")
	end
end)

return MatchService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">MissionService</string><ProtectedString name="Source"><![CDATA[-- 경기 중 제한시간 랜덤 미션
-- 새 미션 추가: MISSIONS 테이블에 { Id, Name, Desc, Duration, Bonus, Begin, Finish } 하나 추가
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Combatants = require(script.Parent.Combatants)
local PaintService = require(script.Parent.PaintService)

local MissionService = {}

local api = nil      -- MatchService가 넘겨주는 함수 묶음
local info = nil     -- 맵 정보
local running = false
local current = nil
local generation = 0

local function maxKey(t)
	local best, bestV, tie = nil, 0, false
	for k, v in pairs(t) do
		if v > bestV then
			best, bestV, tie = k, v, false
		elseif v == bestV and v > 0 then
			tie = true
		end
	end
	if tie then
		return nil
	end
	return best
end

local function randomSpot()
	return info.MissionSpots[math.random(1, #info.MissionSpots)]
end

local function marker(position, radius, color)
	local p = Instance.new("Part")
	p.Name = "MissionZone"
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.ForceField
	p.Color = color
	p.Size = Vector3.new(14, radius * 2, radius * 2)
	p.CFrame = CFrame.new(position + Vector3.new(0, 6, 0)) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = workspace:FindFirstChild("FX") or workspace
	return p
end

local MISSIONS = {
	{
		Id = "Hotspot", Name = "핫스팟 점령", Duration = 25, Bonus = 4,
		Desc = "빛나는 구역을 가장 많이 칠하라!",
		Begin = function(ctx)
			ctx.Pos = randomSpot()
			ctx.Radius = 12
			ctx.Part = marker(ctx.Pos, ctx.Radius, Color3.fromRGB(255, 230, 80))
		end,
		Finish = function(ctx)
			if ctx.Part then
				ctx.Part:Destroy()
			end
			return maxKey(PaintService.CountInRadius(ctx.Pos + Vector3.new(0, 1, 0), ctx.Radius))
		end,
	},
	{
		Id = "GoldenCan", Name = "골든 캔", Duration = 20, Bonus = 3,
		Desc = "황금 페인트통을 먼저 주워라!",
		Begin = function(ctx)
			ctx.Pos = randomSpot()
			local can = Instance.new("Part")
			can.Name = "GoldenCan"
			can.Shape = Enum.PartType.Cylinder
			can.Size = Vector3.new(3, 2.4, 2.4)
			can.Anchored = true
			can.CanCollide = false
			can.Material = Enum.Material.Neon
			can.Color = Color3.fromRGB(255, 200, 40)
			can.CFrame = CFrame.new(ctx.Pos + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
			local light = Instance.new("PointLight")
			light.Color = can.Color
			light.Range = 16
			light.Brightness = 3
			light.Parent = can
			can.Parent = workspace:FindFirstChild("FX") or workspace
			ctx.Part = can
			ctx.Winner = nil
			can.Touched:Connect(function(hit)
				if ctx.Winner then
					return
				end
				local e = Combatants.FromPart(hit)
				if e and e.Alive then
					ctx.Winner = e.OwnerId
					ctx.Taker = e
					PaintService.PaintAt(ctx.Pos, 16, e.OwnerId, e)
					can:Destroy()
					api.EndMissionEarly(ctx)
				end
			end)
		end,
		Finish = function(ctx)
			if ctx.Part and ctx.Part.Parent then
				ctx.Part:Destroy()
			end
			return ctx.Winner
		end,
	},
	{
		Id = "Hunt", Name = "스플래시 헌트", Duration = 25, Bonus = 3,
		Desc = "먼저 3킬을 달성하라!",
		Begin = function(ctx)
			ctx.Kills = {}
			ctx.Conn = Combatants.Killed:Connect(function(killer)
				if killer and not ctx.Winner then
					ctx.Kills[killer.OwnerId] = (ctx.Kills[killer.OwnerId] or 0) + 1
					if ctx.Kills[killer.OwnerId] >= 3 then
						ctx.Winner = killer.OwnerId
						api.EndMissionEarly(ctx)
					end
				end
			end)
		end,
		Finish = function(ctx)
			ctx.Conn.Disconnect()
			return ctx.Winner
		end,
	},
	{
		Id = "PaintRush", Name = "페인트 러시", Duration = 20, Bonus = 3,
		Desc = "20초 동안 가장 많이 칠하라!",
		Begin = function(ctx)
			ctx.Cells = {}
			ctx.Conn = Combatants.Painted:Connect(function(e, n)
				ctx.Cells[e.OwnerId] = (ctx.Cells[e.OwnerId] or 0) + n
			end)
		end,
		Finish = function(ctx)
			ctx.Conn.Disconnect()
			return maxKey(ctx.Cells)
		end,
	},
	{
		Id = "Headhunter", Name = "헤드헌터", Duration = 25, Bonus = 2,
		Desc = "헤드샷으로 먼저 처치하라!",
		Begin = function(ctx)
			ctx.Conn = Combatants.Killed:Connect(function(killer, victim, headshot)
				if killer and headshot and not ctx.Winner then
					ctx.Winner = killer.OwnerId
					ctx.Taker = killer
					api.EndMissionEarly(ctx)
				end
			end)
		end,
		Finish = function(ctx)
			ctx.Conn.Disconnect()
			return ctx.Winner
		end,
	},
}
MissionService.List = MISSIONS

local function finish(ctx)
	if ctx.Done then
		return
	end
	ctx.Done = true
	local ok, winner = pcall(ctx.Def.Finish, ctx)
	if not ok then
		warn("[SplashFront] mission error:", winner)
		winner = nil
	end
	if current == ctx then
		current = nil
	end
	api.SetMission(nil)
	if running and winner then
		api.Cue("mission_result", winner)
		api.AddBonus(winner, ctx.Def.Bonus)
		api.RewardOwner(winner, Config.Rewards.Mission)
		if api.RewardItems then
			api.RewardItems(winner)
		end
		if ctx.Taker then
			ctx.Taker.MissionWins = ctx.Taker.MissionWins + 1
		end
		api.Announce(string.format("%s 성공! %s +%d", ctx.Def.Name, api.OwnerName(winner), ctx.Def.Bonus), api.ColorOf(winner))
	elseif running then
		api.Cue("mission_fail")
		api.Announce(ctx.Def.Name .. " — 아무도 달성하지 못했어요", Color3.fromRGB(200, 200, 200))
	end
end

function MissionService.SetMap(mapInfo)
	info = mapInfo
end

function MissionService.Init(mapInfo, matchApi)
	info = mapInfo
	api = matchApi
	matchApi.EndMissionEarly = function(ctx)
		task.defer(finish, ctx)
	end
end

function MissionService.Start()
	running = true
	generation = generation + 1
	local myGen = generation
	task.spawn(function()
		task.wait(Config.MissionFirstDelay)
		local last = nil
		while running and myGen == generation do
			local def
			repeat
				def = MISSIONS[math.random(1, #MISSIONS)]
			until def ~= last or #MISSIONS == 1
			last = def
			local ctx = { Def = def }
			current = ctx
			local ok, err = pcall(def.Begin, ctx)
			if not ok then
				warn("[SplashFront] mission begin error:", err)
			end
			api.SetMission({
				Name = def.Name, Desc = def.Desc, Bonus = def.Bonus,
				EndsAt = workspace:GetServerTimeNow() + def.Duration, Pos = ctx.Pos,
			})
			api.Cue("mission_start")
			local t = 0
			while t < def.Duration and not ctx.Done and running do
				task.wait(0.25)
				t = t + 0.25
			end
			finish(ctx)
			task.wait(Config.MissionInterval - def.Duration)
		end
	end)
end

function MissionService.Stop()
	running = false
	generation = generation + 1
	if current then
		finish(current)
	end
	current = nil
end

return MissionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">ModelService</string><ProtectedString name="Source"><![CDATA[-- 업로드된 Blender 모델(AssetIds.Models)을 서버 시작 때 불러와 ReplicatedStorage.SplashModels에 둠
-- Studio 3D 가져오기로 직접 넣은 모델이 이미 SplashModels에 있으면 그대로 씀
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AssetIds = require(ReplicatedStorage.Shared.AssetIds)

local ModelService = {}

local function hasPart(m)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			return true
		end
	end
	return false
end

function ModelService.Load()
	local folder = ReplicatedStorage:FindFirstChild("SplashModels")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "SplashModels"
		folder.Parent = ReplicatedStorage
	end
	local loaded = 0
	for name, id in pairs(AssetIds.Models) do
		if id ~= 0 and not folder:FindFirstChild(name) then
			local ok, asset = pcall(function()
				return InsertService:LoadAsset(id)
			end)
			if ok and asset then
				-- LoadAsset은 Model 안에 업로드된 모델을 한 겹 더 감싸서 줌
				local model = asset:FindFirstChildWhichIsA("Model") or asset
				if hasPart(model) then
					model.Name = name
					model.Parent = folder
					loaded = loaded + 1
				end
				if model ~= asset then
					asset:Destroy()
				end
			else
				warn("[SplashFront] 모델 불러오기 실패:", name, id, asset)
			end
		end
	end
	print("[SplashFront] 모델", loaded, "개 로드 (없는 모델은 내장 대체 모델 사용)")
end

return ModelService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">PaintService</string><ProtectedString name="Source"><![CDATA[-- 페인트 셀 관리: 칠하기, 면적 집계, 발밑 색 조회
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Combatants = require(script.Parent.Combatants)

local PaintService = {}

local cellsFolder = nil
local palette = {}      -- ownerId -> Color3
local counts = {}       -- ownerId -> 셀 수
local totalCells = 0
local radiusMul = 1
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
local downRay = RaycastParams.new()
downRay.FilterType = Enum.RaycastFilterType.Include

function PaintService.Init(folder)
	cellsFolder = folder
	overlap.FilterDescendantsInstances = { folder }
	downRay.FilterDescendantsInstances = { folder }
	totalCells = #folder:GetChildren()
	PaintService.Reset()
end

function PaintService.SetPalette(map)
	palette = map
end

function PaintService.SetRadiusMultiplier(m)
	radiusMul = m
end

function PaintService.Reset()
	counts = {}
	if not cellsFolder then
		return
	end
	for _, c in ipairs(cellsFolder:GetChildren()) do
		c:SetAttribute("Owner", 0)
		c.Color = Config.NeutralColor
		c.Material = Enum.Material.SmoothPlastic
	end
end

local function setOwner(cell, ownerId, material)
	local prev = cell:GetAttribute("Owner") or 0
	if prev == ownerId then
		return false
	end
	if prev ~= 0 then
		counts[prev] = (counts[prev] or 1) - 1
	end
	counts[ownerId] = (counts[ownerId] or 0) + 1
	cell:SetAttribute("Owner", ownerId)
	cell.Color = palette[ownerId] or Config.NeutralColor
	cell.Material = material or Enum.Material.Glass -- 기본: 젖은 페인트 느낌 / 페인트 패턴 장착 시 해당 재질
	return true
end

-- position 주변 radius 안의 셀을 ownerId로 칠함. 새로 칠한 셀 수를 돌려줌
function PaintService.PaintAt(position, radius, ownerId, painterEntity)
	if not cellsFolder or ownerId == nil or ownerId == 0 then
		return 0
	end
	local r = radius * radiusMul
	local parts = workspace:GetPartBoundsInRadius(position, r, overlap)
	local changed = 0
	local material = painterEntity and painterEntity.PatternMaterial or nil
	for _, cell in ipairs(parts) do
		-- 높이 차이가 큰 셀(다른 층)은 제외
		if math.abs(cell.Position.Y - position.Y) <= math.max(3, r * 0.6) then
			if setOwner(cell, ownerId, material) then
				changed = changed + 1
			end
		end
	end
	if changed > 0 and painterEntity then
		painterEntity.Cells = painterEntity.Cells + changed
		painterEntity.Special = painterEntity.Special + changed
		Combatants.Painted:Fire(painterEntity, changed)
	end
	return changed
end

-- 지점 아래로 레이를 쏴 가장 가까운 바닥 셀을 찾아 칠함 (탄도 경로 칠하기용)
function PaintService.PaintBelow(position, radius, ownerId, painterEntity)
	local hit = workspace:Raycast(position, Vector3.new(0, -12, 0), downRay)
	if hit then
		return PaintService.PaintAt(hit.Position, radius, ownerId, painterEntity)
	end
	return 0
end

-- 발밑 셀의 주인 (없으면 0)
function PaintService.OwnerBelow(position)
	if not cellsFolder then
		return 0
	end
	local hit = workspace:Raycast(position, Vector3.new(0, -6, 0), downRay)
	if hit then
		return hit.Instance:GetAttribute("Owner") or 0
	end
	return 0
end

function PaintService.CountInRadius(position, radius)
	local result = {}
	local parts = workspace:GetPartBoundsInRadius(position, radius, overlap)
	for _, cell in ipairs(parts) do
		local o = cell:GetAttribute("Owner") or 0
		if o ~= 0 then
			result[o] = (result[o] or 0) + 1
		end
	end
	return result
end

function PaintService.GetCounts()
	return counts
end

function PaintService.GetTotal()
	return totalCells
end

-- ownerId -> 0~100 (%)
function PaintService.GetCoverage()
	local out = {}
	for owner, n in pairs(counts) do
		out[owner] = (totalCells > 0) and (n / totalCells * 100) or 0
	end
	return out
end

return PaintService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">QuestService</string><ProtectedString name="Source"><![CDATA[-- 일일·주간 퀘스트: 한국 시간 자정(일일)·월요일 0시(주간)에 바뀜. 같은 날엔 모든 플레이어가 같은 퀘스트
-- 진행도는 프로필(p.Quests)에 저장, 달성하면 자동으로 코인·경험치 지급
-- 클라이언트에는 속성 "Quests"(JSON)로 보냄
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local QuestService = {}

local remotes = nil
local KST = 9 * 3600

local function dayKey()
	return math.floor((os.time() + KST) / 86400)
end
local function weekKey()
	-- 1970-01-01은 목요일 → +3일 하면 월요일 시작 주
	return math.floor((os.time() + KST + 3 * 86400) / (7 * 86400))
end
local function secondsLeft(period)
	local t = os.time() + KST
	if period == "Daily" then
		return 86400 - (t % 86400)
	end
	local w = 7 * 86400
	return w - ((t + 3 * 86400) % w)
end

-- 기간 키를 씨앗으로 퀘스트 N개를 고름 (모두 같은 결과)
local function pick(period, key)
	local pool = Config.Quests[period]
	local idx = {}
	for i = 1, #pool do
		idx[i] = i
	end
	local rng = Random.new(key * 7919 + (period == "Daily" and 1 or 2))
	for i = #idx, 2, -1 do
		local j = rng:NextInteger(1, i)
		idx[i], idx[j] = idx[j], idx[i]
	end
	local out = {}
	for i = 1, math.min(Config.Quests.PerPeriod, #idx) do
		table.insert(out, pool[idx[i]])
	end
	return out
end

local function ensure(p)
	p.Quests = type(p.Quests) == "table" and p.Quests or {}
	local q = p.Quests
	for _, period in ipairs({ "Daily", "Weekly" }) do
		local key = (period == "Daily") and dayKey() or weekKey()
		local cur = q[period]
		if type(cur) ~= "table" or cur.Key ~= key then
			local list = {}
			for _, def in ipairs(pick(period, key)) do
				table.insert(list, { Id = def.Id, P = 0, Done = false })
			end
			q[period] = { Key = key, List = list }
		end
	end
	return q
end

local function defOf(period, id)
	for _, d in ipairs(Config.Quests[period]) do
		if d.Id == id then
			return d
		end
	end
	return nil
end

function QuestService.Publish(player)
	local p = DataService.Get(player)
	if not p then
		return
	end
	local q = ensure(p)
	local view = {}
	for _, period in ipairs({ "Daily", "Weekly" }) do
		for _, it in ipairs(q[period].List) do
			local d = defOf(period, it.Id)
			if d then
				table.insert(view, { Period = period, Name = d.Name, P = math.min(it.P, d.Goal), Goal = d.Goal, Reward = d.Reward, Done = it.Done,
					Left = secondsLeft(period) })
			end
		end
	end
	player:SetAttribute("Quests", HttpService:JSONEncode(view))
end

-- 통계 stat을 n만큼 올림 (달성 시 보상)
function QuestService.Add(player, stat, n)
	if not player or not player.Parent or (n or 0) <= 0 then
		return
	end
	local p = DataService.Get(player)
	if not p then
		return
	end
	local q = ensure(p)
	local changed = false
	for _, period in ipairs({ "Daily", "Weekly" }) do
		for _, it in ipairs(q[period].List) do
			local d = defOf(period, it.Id)
			if d and d.Stat == stat and not it.Done then
				it.P = it.P + n
				changed = true
				if it.P >= d.Goal then
					it.Done = true
					DataService.AddCoins(player, d.Reward)
					DataService.AddXP(player, Config.XP.Quest)
					if remotes then
						remotes.Notify:FireClient(player, string.format("[%s] %s 완료! +%d 코인", period == "Daily" and "일일" or "주간", d.Name, d.Reward),
							Color3.fromRGB(120, 255, 170))
					end
				end
			end
		end
	end
	if changed then
		QuestService.Publish(player)
	end
end

function QuestService.Init(remoteFolder)
	remotes = remoteFolder
	-- 날짜가 바뀌면 새 퀘스트로 (1분마다 확인)
	task.spawn(function()
		while true do
			for _, pl in ipairs(Players:GetPlayers()) do
				QuestService.Publish(pl)
			end
			task.wait(60)
		end
	end)
end

return QuestService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">RankService</string><ProtectedString name="Source"><![CDATA[-- 시즌 레이팅 + 글로벌 리더보드(OrderedDataStore)
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local RankService = {}

local ordered = nil
local meta = nil -- userId -> { n = 이름, w = 승수, r = 레이팅 } (TOP 50 창에 승수 표시용)
pcall(function()
	ordered = DataStoreService:GetOrderedDataStore("SplashFront_Rating_" .. Config.DataVersion .. "_" .. Config.Season)
	meta = DataStoreService:GetDataStore("SplashFront_RankMeta_" .. Config.DataVersion .. "_" .. Config.Season)
end)

local cache = { At = -1e9, Rows = nil }
local CACHE_SECONDS = 90

-- 경기가 끝날 때마다 이름·승수·레이팅을 기록
function RankService.RecordMeta(player)
	local p = DataService.Get(player)
	if not p or not meta then
		return
	end
	task.spawn(function()
		pcall(function()
			meta:SetAsync("u" .. player.UserId, { n = player.DisplayName, w = p.Wins or 0, r = p.Rating })
		end)
	end)
end

local function serverRows()
	local list = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local r = pl:GetAttribute("Rating") or Config.Rating.Start
		table.insert(list, { UserId = pl.UserId, Name = pl.DisplayName, Rating = r, Tier = Config.GetTier(r).Name, Wins = pl:GetAttribute("Wins") or 0 })
	end
	table.sort(list, function(a, b)
		return a.Rating > b.Rating
	end)
	for i, row in ipairs(list) do
		row.Rank = i
	end
	return list
end

-- 상위 count명 (기본 50). DataStore를 못 쓰면 현재 서버 플레이어로 대신
function RankService.GetTop(count)
	count = math.clamp(count or 50, 1, 100)
	if cache.Rows and os.clock() - cache.At < CACHE_SECONDS then
		return cache.Rows, cache.Global
	end
	local rows = nil
	if ordered then
		pcall(function()
			local entries = ordered:GetSortedAsync(false, count):GetCurrentPage()
			local out = {}
			local pending = #entries
			for i, entry in ipairs(entries) do
				local userId = tonumber(string.sub(entry.key, 2)) or 0
				out[i] = { Rank = i, UserId = userId, Name = "?", Rating = entry.value, Tier = Config.GetTier(entry.value).Name, Wins = 0 }
				task.spawn(function()
					local ok, m = pcall(function()
						return meta and meta:GetAsync(entry.key)
					end)
					if ok and type(m) == "table" then
						out[i].Name = m.n or out[i].Name
						out[i].Wins = m.w or 0
					else
						pcall(function()
							out[i].Name = Players:GetNameFromUserIdAsync(userId)
						end)
					end
					pending = pending - 1
				end)
			end
			local t0 = os.clock()
			while pending > 0 and os.clock() - t0 < 8 do
				task.wait(0.1)
			end
			if #out > 0 then
				rows = out
			end
		end)
	end
	local global = rows ~= nil
	rows = rows or serverRows()
	cache = { At = os.clock(), Rows = rows, Global = global }
	return rows, global
end

function RankService.Init(remotes)
	remotes.Leaderboard.OnServerInvoke = function(player)
		local rows, global = RankService.GetTop(50)
		return { Rows = rows, Global = global, Season = Config.Season }
	end
end

-- performance: 0~1 (팀 내 기여 순위). 반환: 레이팅 변화량
function RankService.Apply(player, won, performance)
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	local delta = won and Config.Rating.Win or Config.Rating.Lose
	delta = delta + math.floor(Config.Rating.PerformanceMax * (performance or 0) + 0.5)
	p.Rating = math.max(0, p.Rating + delta)
	DataService.Publish(player)
	if ordered then
		task.spawn(function()
			pcall(function()
				ordered:SetAsync("u" .. player.UserId, p.Rating)
			end)
		end)
	end
	return delta
end

function RankService.StartBoard(textLabel)
	task.spawn(function()
		while true do
			local lines = { "  시즌 " .. Config.Season .. " 랭킹 TOP 10", "" }
			local ok = false
			if ordered then
				ok = pcall(function()
					local pages = ordered:GetSortedAsync(false, 10)
					local entries = pages:GetCurrentPage()
					for i, entry in ipairs(entries) do
						local userId = tonumber(string.sub(entry.key, 2))
						local name = "?"
						pcall(function()
							name = Players:GetNameFromUserIdAsync(userId)
						end)
						local tier = Config.GetTier(entry.value).Name
						table.insert(lines, string.format("  %2d. %s  %d (%s)", i, name, entry.value, tier))
					end
				end)
			end
			if not ok then
				-- DataStore를 쓸 수 없을 때(스튜디오 등)는 현재 서버 플레이어로 표시
				local list = {}
				for _, pl in ipairs(Players:GetPlayers()) do
					table.insert(list, { pl.Name, pl:GetAttribute("Rating") or Config.Rating.Start })
				end
				table.sort(list, function(a, b)
					return a[2] > b[2]
				end)
				for i, row in ipairs(list) do
					if i > 10 then
						break
					end
					table.insert(lines, string.format("  %2d. %s  %d (%s)", i, row[1], row[2], Config.GetTier(row[2]).Name))
				end
				table.insert(lines, "")
				table.insert(lines, "  (서버 내 순위 · 글로벌 랭킹은 게시 후 표시)")
			end
			textLabel.Text = table.concat(lines, "\n")
			task.wait(60)
		end
	end)
end

return RankService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- 무기 상점(게임 코인) + 로벅스 결제 처리
local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Weapons = require(ReplicatedStorage.Shared.Weapons)
local DataService = require(script.Parent.DataService)
local CrateService = require(script.Parent.CrateService)
local Telemetry = require(script.Parent.TelemetryService)

local ShopService = {}

local function handle(player, action, weaponId)
	if (action == "buy" or action == "buyCosmetic") and not DataService.IsSafe(player) then
		return { ok = false, msg = "저장 데이터를 불러오지 못해 지금은 구매할 수 없어요. 다시 접속해 주세요" }
	end
	if action == "crateTest" then
		return CrateService.TestOpen(player)
	elseif action == "equipCosmetic" then
		return CrateService.Equip(player, weaponId)
	elseif action == "buyCosmetic" then
		-- 포인트(코인)로 외형 직접 구매
		local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
		local item = Cosmetics.ById[weaponId]
		local p = DataService.Get(player)
		local price = item and Config.SkinPrices[item.Rarity]
		if not item or not p or not price then
			return { ok = false, msg = "알 수 없는 아이템" }
		end
		p.Cosmetics = p.Cosmetics or {}
		if p.Cosmetics[item.Id] then
			return { ok = false, msg = "이미 보유 중" }
		end
		if p.Coins < price then
			return { ok = false, msg = "코인이 부족해요 (" .. (price - p.Coins) .. " 부족)" }
		end
		p.Coins = p.Coins - price
		p.Cosmetics[item.Id] = true
		DataService.Publish(player)
		DataService.Save(player)
		Telemetry.Economy(player, false, price, p.Coins, "Shop", "Cosmetic_" .. item.Id)
		return { ok = true, msg = item.Name .. " 구매 완료! 컬렉션에서 장착하세요" }
	end
	local p = DataService.Get(player)
	local w = Weapons.ById[weaponId]
	if not p or not w then
		return { ok = false, msg = "알 수 없는 무기" }
	end
	if player:GetAttribute("InMatch") then
		return { ok = false, msg = "경기 중에는 변경할 수 없어요" }
	end
	if action == "buy" then
		if p.Owned[w.Id] then
			return { ok = false, msg = "이미 보유 중" }
		end
		if p.Coins < w.Price then
			return { ok = false, msg = "코인이 부족해요 (" .. (w.Price - p.Coins) .. " 부족)" }
		end
		p.Coins = p.Coins - w.Price
		p.Owned[w.Id] = true
		p.Equipped = w.Id
		DataService.Publish(player)
		DataService.Save(player)
		Telemetry.Economy(player, false, w.Price, p.Coins, "Shop", "Weapon_" .. w.Id)
		return { ok = true, msg = w.Name .. " 구매 완료!" }
	elseif action == "equip" then
		if not p.Owned[w.Id] then
			return { ok = false, msg = "먼저 구매하세요" }
		end
		p.Equipped = w.Id
		DataService.Publish(player)
		return { ok = true, msg = w.Name .. " 장착" }
	end
	return { ok = false, msg = "잘못된 요청" }
end

function ShopService.Init(remotes)
	remotes.Shop.OnServerInvoke = handle
	CrateService.Init(remotes)

	-- 코인 팩 / 크로마 크레이트 (개발자 상품)
	-- PurchaseId를 DataStore에 기록해 서버 재시도·재접속 시 중복 지급을 막음
	local purchaseStore = nil
	pcall(function()
		purchaseStore = DataStoreService:GetDataStore("SplashFront_Purchases_" .. Config.DataVersion)
	end)

	local function grant(player, productId)
		if productId == Config.Monetization.CrateProductId and productId ~= 0 then
			return CrateService.Open(player) ~= nil
		end
		local coins = Config.Monetization.CoinProducts[productId]
		local p = DataService.Get(player)
		if not coins or not p then
			return false
		end
		p.Coins = p.Coins + coins
		DataService.Publish(player)
		DataService.Save(player)
		Telemetry.Economy(player, true, coins, p.Coins, "IAP", "CoinPack_" .. tostring(productId))
		return true
	end

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		-- 데이터를 못 불러온 상태면 지급을 미룸 (로벅스 구매품이 저장 안 되는 일이 없게, 다음 접속 때 다시 처리됨)
		if not player or not DataService.Get(player) or not DataService.IsSafe(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local key = "p_" .. tostring(receipt.PurchaseId)
		if purchaseStore then
			local ok, done = pcall(function()
				return purchaseStore:GetAsync(key)
			end)
			if not ok then
				return Enum.ProductPurchaseDecision.NotProcessedYet
			end
			if done then
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		if not grant(player, receipt.ProductId) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if purchaseStore then
			pcall(function()
				purchaseStore:SetAsync(key, { u = receipt.PlayerId, p = receipt.ProductId, t = os.time() })
			end)
		end
		Telemetry.Custom(player, "Purchase", receipt.CurrencySpent or 0, tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passId == Config.Monetization.VipGamePassId then
			player:SetAttribute("Vip", true)
		end
	end)
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[-- 아주 작은 이벤트 시그널 (서버 모듈 간 통신용)
local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	table.insert(self._handlers, fn)
	local handlers = self._handlers
	return {
		Disconnect = function()
			for i, h in ipairs(handlers) do
				if h == fn then
					table.remove(handlers, i)
					break
				end
			end
		end,
	}
end

function Signal:Fire(...)
	for _, h in ipairs(self._handlers) do
		task.spawn(h, ...)
	end
end

return Signal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">TelemetryService</string><ProtectedString name="Source"><![CDATA[-- 클로즈 테스트 지표 수집
-- 1) Roblox AnalyticsService: 온보딩 퍼널 / 경제 / 커스텀 이벤트 → Creator Hub > 분석 에서 확인
-- 2) 무기별 밸런스 통계 (자체 DataStore) → 관리자 패널 "밸런스 리포트"
-- 3) 게임 내 피드백 (자체 DataStore) → 관리자 패널 "피드백 보기"
local AnalyticsService = game:GetService("AnalyticsService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Weapons = require(ReplicatedStorage.Shared.Weapons)

local Telemetry = {}

local balanceStore, feedbackStore
pcall(function()
	balanceStore = DataStoreService:GetDataStore("SplashFront_Balance_" .. Config.DataVersion)
	feedbackStore = DataStoreService:GetDataStore("SplashFront_Feedback_" .. Config.DataVersion)
end)

local funnelDone = {}   -- player -> { [step] = true }
local joinTime = {}
local lastFeedback = {}

-- 내부 메모리 집계 (DataStore를 못 쓸 때 리포트용)
local localBalance = {}

local function fields(a, b, c)
	local f = {}
	pcall(function()
		if a then
			f[Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = tostring(a)
		end
		if b then
			f[Enum.AnalyticsCustomFieldKeys.CustomField02.Name] = tostring(b)
		end
		if c then
			f[Enum.AnalyticsCustomFieldKeys.CustomField03.Name] = tostring(c)
		end
	end)
	return f
end

------------------------------------------------------------------------
-- AnalyticsService 래퍼 (실패해도 게임에 영향 없음)
------------------------------------------------------------------------
-- 온보딩 퍼널 단계 (세션당 1회)
Telemetry.Steps = {
	Joined = { 1, "입장" },
	Queued = { 2, "대기열 참가" },
	MatchStarted = { 3, "첫 경기 시작" },
	FirstPaint = { 4, "첫 페인트" },
	FirstKill = { 5, "첫 처치" },
	MatchFinished = { 6, "첫 경기 완료" },
	SecondMatch = { 7, "두 번째 경기 시작" },
	OpenedShop = { 8, "상점 열기" },
}

function Telemetry.Funnel(player, key)
	local step = Telemetry.Steps[key]
	if not step or not player then
		return
	end
	funnelDone[player] = funnelDone[player] or {}
	if funnelDone[player][key] then
		return
	end
	funnelDone[player][key] = true
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step[1], step[2])
	end)
end

function Telemetry.Economy(player, isSource, amount, endingBalance, transactionType, sku)
	pcall(function()
		AnalyticsService:LogEconomyEvent(player,
			isSource and Enum.AnalyticsEconomyFlowType.Source or Enum.AnalyticsEconomyFlowType.Sink,
			"Coins", amount, endingBalance, transactionType, sku)
	end)
end

function Telemetry.Custom(player, name, value, a, b, c)
	pcall(function()
		AnalyticsService:LogCustomEvent(player, name, value or 1, fields(a, b, c))
	end)
end

------------------------------------------------------------------------
-- 무기 밸런스 통계
------------------------------------------------------------------------
local STAT_KEYS = { "Matches", "Wins", "Kills", "Deaths", "Shots", "Hits", "Headshots", "Cells", "Seconds" }

-- rows: { {WeaponId, Won, Kills, Deaths, Shots, Hits, Headshots, Cells, Seconds}, ... } (사람 플레이어만)
function Telemetry.RecordMatch(rows)
	local agg = {}
	for _, r in ipairs(rows) do
		local a = agg[r.WeaponId]
		if not a then
			a = {}
			for _, k in ipairs(STAT_KEYS) do
				a[k] = 0
			end
			agg[r.WeaponId] = a
		end
		a.Matches = a.Matches + 1
		a.Wins = a.Wins + (r.Won and 1 or 0)
		for _, k in ipairs({ "Kills", "Deaths", "Shots", "Hits", "Headshots", "Cells", "Seconds" }) do
			a[k] = a[k] + (r[k] or 0)
		end
	end
	for weaponId, a in pairs(agg) do
		local mem = localBalance[weaponId] or {}
		for _, k in ipairs(STAT_KEYS) do
			mem[k] = (mem[k] or 0) + a[k]
		end
		localBalance[weaponId] = mem
		if balanceStore then
			task.spawn(function()
				pcall(function()
					balanceStore:UpdateAsync("w_" .. weaponId, function(old)
						old = type(old) == "table" and old or {}
						for _, k in ipairs(STAT_KEYS) do
							old[k] = (old[k] or 0) + a[k]
						end
						return old
					end)
				end)
			end)
		end
	end
end

function Telemetry.BalanceReport()
	local lines = { string.format("%-10s %5s %6s %6s %6s %7s %7s", "무기", "판수", "승률", "K/D", "명중률", "헤드%", "셀/분") }
	for _, w in ipairs(Weapons.List) do
		local s = nil
		if balanceStore then
			pcall(function()
				s = balanceStore:GetAsync("w_" .. w.Id)
			end)
		end
		s = s or localBalance[w.Id]
		if s and (s.Matches or 0) > 0 then
			local kd = (s.Kills or 0) / math.max(1, s.Deaths or 0)
			local acc = (s.Hits or 0) / math.max(1, s.Shots or 0) * 100
			local head = (s.Headshots or 0) / math.max(1, s.Hits or 0) * 100
			local cpm = (s.Cells or 0) / math.max(1, (s.Seconds or 0) / 60)
			table.insert(lines, string.format("%-10s %5d %5.0f%% %6.2f %5.0f%% %6.0f%% %7.0f", w.Id, s.Matches,
				(s.Wins or 0) / s.Matches * 100, kd, acc, head, cpm))
		else
			table.insert(lines, string.format("%-10s %5d  (데이터 없음)", w.Id, 0))
		end
	end
	table.insert(lines, "")
	table.insert(lines, "판단 기준(예시): 승률 45~55%, K/D 0.8~1.25 밖이면 조정 후보")
	return table.concat(lines, "\n")
end

------------------------------------------------------------------------
-- 피드백
------------------------------------------------------------------------
local CATEGORIES = { Bug = "버그", Balance = "밸런스", Fun = "재미", Other = "기타" }

function Telemetry.SubmitFeedback(player, rating, category, text)
	if type(rating) ~= "number" or rating < 1 or rating > 5 then
		return { ok = false, msg = "별점을 골라주세요" }
	end
	if not CATEGORIES[category] then
		category = "Other"
	end
	if type(text) ~= "string" then
		text = ""
	end
	text = string.sub(text, 1, 500)
	local now = os.time()
	if lastFeedback[player] and now - lastFeedback[player] < Config.CBT.FeedbackCooldown then
		return { ok = false, msg = "잠시 후 다시 보내주세요" }
	end
	lastFeedback[player] = now
	local entry = {
		t = now, u = player.UserId, n = player.Name, r = math.floor(rating), c = category, m = text,
		b = Config.Build, phase = player:GetAttribute("InMatch") and "match" or "lobby",
	}
	Telemetry.Custom(player, "Feedback", entry.r, category, Config.Build)
	print(string.format("[SplashFront][피드백] %s *%d [%s] %s", player.Name, entry.r, CATEGORIES[category], text))
	if feedbackStore then
		local key = "day_" .. os.date("!%Y%m%d", now)
		task.spawn(function()
			pcall(function()
				feedbackStore:UpdateAsync(key, function(old)
					old = type(old) == "table" and old or {}
					table.insert(old, entry)
					while #old > 300 do
						table.remove(old, 1)
					end
					return old
				end)
			end)
		end)
	end
	return { ok = true, msg = "피드백 고마워요! 테스트에 큰 도움이 됩니다" }
end

function Telemetry.FeedbackList()
	local list = {}
	if feedbackStore then
		for d = 0, 1 do
			local key = "day_" .. os.date("!%Y%m%d", os.time() - d * 86400)
			pcall(function()
				local v = feedbackStore:GetAsync(key)
				if type(v) == "table" then
					for _, e in ipairs(v) do
						table.insert(list, e)
					end
				end
			end)
		end
	end
	table.sort(list, function(a, b)
		return a.t > b.t
	end)
	local lines = {}
	local sum, n = 0, 0
	for _, e in ipairs(list) do
		sum = sum + e.r
		n = n + 1
	end
	if n == 0 then
		return "최근 2일 피드백 없음 (DataStore가 꺼져 있으면 서버 출력창에만 기록됩니다)"
	end
	table.insert(lines, string.format("최근 2일 피드백 %d건 · 평균 *%.1f", n, sum / n))
	for i, e in ipairs(list) do
		if i > 20 then
			break
		end
		table.insert(lines, string.format("%s  *%d [%s] %s: %s", os.date("!%m/%d %H:%M", e.t + 9 * 3600), e.r,
			CATEGORIES[e.c] or e.c, e.n, e.m))
	end
	return table.concat(lines, "\n")
end

------------------------------------------------------------------------
function Telemetry.Init(remotes)
	remotes.Feedback.OnServerInvoke = function(player, rating, category, text)
		return Telemetry.SubmitFeedback(player, rating, category, text)
	end
	remotes.Telemetry.OnServerEvent:Connect(function(player, key)
		-- 클라이언트에서 오는 건 상점 열기 같은 UI 단계만 허용
		if key == "OpenedShop" then
			Telemetry.Funnel(player, key)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		joinTime[player] = os.clock()
		Telemetry.Funnel(player, "Joined")
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		joinTime[p] = os.clock()
	end
	Players.PlayerRemoving:Connect(function(player)
		if joinTime[player] then
			Telemetry.Custom(player, "SessionMinutes", math.floor((os.clock() - joinTime[player]) / 60 + 0.5), Config.Build)
		end
		joinTime[player] = nil
		funnelDone[player] = nil
		lastFeedback[player] = nil
	end)
end

return Telemetry
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX43"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX42"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">CBTPanel</string><ProtectedString name="Source"><![CDATA[-- 클로즈 테스트 UI: 피드백 창(모든 테스터) + 관리자 패널(F2, 관리자만)
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local UI = require(script.Parent:WaitForChild("UIKit"))

local player = Players.LocalPlayer
local CBT = {}

local remotes, HUD
local gui, feedbackFrame, adminFrame, reportBox, feedbackBtn
local rating = 0
local modalHandler = function() end
local category = "Fun"

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function corner(p, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, p)
end

local function button(parent, text, color, props)
	local b = make("TextButton", { Text = text, BackgroundColor3 = color or Color3.fromRGB(60, 60, 80), TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold, TextSize = 14, AutoButtonColor = true }, parent)
	corner(b, 8)
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	return b
end

local function label(parent, props)
	local t = make("TextLabel", { BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left, Text = "" }, parent)
	for k, v in pairs(props) do
		t[k] = v
	end
	return t
end

------------------------------------------------------------------------
-- 피드백 창
------------------------------------------------------------------------
local starButtons = {}
local catButtons = {}

local function refreshFeedback()
	for i, b in ipairs(starButtons) do
		b.TextColor3 = (i <= rating) and Color3.fromRGB(255, 210, 40) or Color3.fromRGB(90, 90, 110)
	end
	for id, b in pairs(catButtons) do
		b.BackgroundColor3 = (id == category) and Color3.fromRGB(255, 46, 170) or Color3.fromRGB(60, 60, 80)
	end
end

function CBT.OpenFeedback()
	feedbackFrame.Visible = true
	modalHandler(true)
	refreshFeedback()
end

local function buildFeedback()
	feedbackFrame = make("Frame", { Size = UDim2.fromOffset(460, 330), Position = UDim2.new(0.5, -230, 0.5, -165), BackgroundColor3 = Color3.fromRGB(20, 20, 30),
		Visible = false, ZIndex = 30 }, gui)
	corner(feedbackFrame, 14)
	make("UIStroke", { Thickness = 2, Color = Color3.fromRGB(0, 214, 200) }, feedbackFrame)
	label(feedbackFrame, { Text = "테스트 피드백", TextSize = 22, Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(18, 12), Size = UDim2.new(1, -36, 0, 30), ZIndex = 31 })
	label(feedbackFrame, { Text = "이번 판 어땠나요?", Position = UDim2.fromOffset(18, 48), Size = UDim2.new(1, -36, 0, 20), ZIndex = 31,
		TextColor3 = Color3.fromRGB(190, 190, 210), Font = Enum.Font.Gotham })
	for i = 1, 5 do
		local b = make("TextButton", { Text = tostring(i), TextSize = 30, Font = Enum.Font.GothamBlack, BackgroundTransparency = 1,
			Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(14 + (i - 1) * 42, 70), ZIndex = 31 }, feedbackFrame)
		b.MouseButton1Click:Connect(function()
			rating = i
			refreshFeedback()
		end)
		starButtons[i] = b
	end
	local cats = { { "Bug", "버그" }, { "Balance", "밸런스" }, { "Fun", "재미" }, { "Other", "기타" } }
	for i, c in ipairs(cats) do
		local b = button(feedbackFrame, c[2], nil, { Size = UDim2.fromOffset(96, 30), Position = UDim2.fromOffset(18 + (i - 1) * 106, 118), ZIndex = 31 })
		b.MouseButton1Click:Connect(function()
			category = c[1]
			refreshFeedback()
		end)
		catButtons[c[1]] = b
	end
	local box = make("TextBox", { Size = UDim2.new(1, -36, 0, 100), Position = UDim2.fromOffset(18, 158), BackgroundColor3 = Color3.fromRGB(36, 36, 50),
		TextColor3 = Color3.new(1, 1, 1), PlaceholderText = "자유롭게 적어주세요 (버그는 어디서·무엇을 하다가 생겼는지)", Text = "",
		ClearTextOnFocus = false, MultiLine = true, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, Font = Enum.Font.Gotham, TextSize = 14, ZIndex = 31 }, feedbackFrame)
	corner(box, 8)
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), PaddingRight = UDim.new(0, 8) }, box)
	local send = button(feedbackFrame, "보내기", Color3.fromRGB(0, 170, 160), { Size = UDim2.fromOffset(140, 38), Position = UDim2.new(1, -158, 1, -52), ZIndex = 31 })
	UI.CloseButton(feedbackFrame, function()
		feedbackFrame.Visible = false
		modalHandler(adminFrame ~= nil and adminFrame.Visible)
	end, 36).ZIndex = 35
	send.MouseButton1Click:Connect(function()
		if rating == 0 then
			HUD.Banner("별점을 먼저 골라주세요", Color3.fromRGB(255, 200, 80))
			return
		end
		local ok, res = pcall(function()
			return remotes.Feedback:InvokeServer(rating, category, box.Text)
		end)
		if ok and res then
			HUD.Banner(res.msg, res.ok and Color3.fromRGB(120, 255, 160) or Color3.fromRGB(255, 120, 120))
			if res.ok then
				box.Text = ""
				rating = 0
				feedbackFrame.Visible = false
				modalHandler(adminFrame ~= nil and adminFrame.Visible)
			end
		end
	end)
end

------------------------------------------------------------------------
-- 관리자 패널
------------------------------------------------------------------------
local function admin(action, arg)
	local ok, res = pcall(function()
		return remotes.Admin:InvokeServer(action, arg)
	end)
	if ok and res then
		local text = tostring(res.msg)
		if string.find(text, "\n") then
			reportBox.Text = text
		else
			HUD.Banner(text, res.ok and Color3.fromRGB(120, 255, 160) or Color3.fromRGB(255, 120, 120))
		end
	end
end

local function buildAdmin()
	adminFrame = make("Frame", { Size = UDim2.fromOffset(560, 470), Position = UDim2.new(0.5, -280, 0.5, -235), BackgroundColor3 = Color3.fromRGB(16, 16, 24),
		BackgroundTransparency = 0.05, Visible = false, ZIndex = 40 }, gui)
	corner(adminFrame, 12)
	make("UIStroke", { Thickness = 2, Color = Color3.fromRGB(255, 196, 0) }, adminFrame)
	local dev = player:GetAttribute("DevTools") == true
	label(adminFrame, { Text = (dev and "개발자 패널 (F2) · 빌드 " or "운영자 패널 (F2) · 빌드 ") .. Config.Build, TextSize = 18, Font = Enum.Font.GothamBlack,
		Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -80, 0, 26), ZIndex = 41 })
	UI.CloseButton(adminFrame, function()
		CBT.ToggleAdmin()
	end, 32).ZIndex = 45
	local argBox = make("TextBox", { Size = UDim2.fromOffset(120, 30), Position = UDim2.fromOffset(14, 40), BackgroundColor3 = Color3.fromRGB(36, 36, 50),
		TextColor3 = Color3.new(1, 1, 1), PlaceholderText = "숫자 입력", Text = "", Font = Enum.Font.Code, TextSize = 15, ZIndex = 41 }, adminFrame)
	corner(argBox, 6)
	label(adminFrame, { Text = "<- 시간/코인/개봉 수/레이팅 값", Position = UDim2.fromOffset(142, 40), Size = UDim2.fromOffset(300, 30), ZIndex = 41,
		TextSize = 13, Font = Enum.Font.Gotham, TextColor3 = Color3.fromRGB(170, 170, 190) })
	local cmds = {
		{ "time", "남은 시간 설정" }, { "endMatch", "경기 즉시 종료" }, { "coins", "코인 지급" }, { "unlockAll", "무기 전부 해금" },
		{ "crate", "무료 크레이트 개봉" }, { "special", "스페셜 100%" }, { "bots", "봇 채우기 토글" }, { "fastMissions", "빠른 미션 토글" },
		{ "rankedBots", "봇 랭크반영 토글" }, { "rating", "레이팅 설정" }, { "resetProfile", "내 데이터 초기화" },
		{ "nextMap", "다음 맵 변경" }, { "balance", "밸런스 리포트" }, { "feedback", "피드백 보기" },
	}
	local shown = {}
	for _, c in ipairs(cmds) do
		if dev or Config.OpsCommands[c[1]] then
			table.insert(shown, c)
		end
	end
	if not dev then
		argBox.PlaceholderText = "맵 번호"
	end
	for i, c in ipairs(shown) do
		local col = (i - 1) % 4
		local row = math.floor((i - 1) / 4)
		local color = (c[1] == "balance" or c[1] == "feedback") and Color3.fromRGB(0, 140, 130)
			or (c[1] == "resetProfile" or c[1] == "endMatch") and Color3.fromRGB(150, 50, 70) or nil
		local b = button(adminFrame, c[2], color, { Size = UDim2.fromOffset(128, 32), Position = UDim2.fromOffset(14 + col * 134, 80 + row * 38), ZIndex = 41,
			TextSize = 13 })
		b.MouseButton1Click:Connect(function()
			admin(c[1], argBox.Text ~= "" and argBox.Text or nil)
		end)
	end
	reportBox = make("TextLabel", { Size = UDim2.new(1, -28, 0, 220), Position = UDim2.fromOffset(14, 236), BackgroundColor3 = Color3.fromRGB(28, 28, 40),
		TextColor3 = Color3.fromRGB(220, 230, 240), Font = Enum.Font.Code, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Text = "밸런스 리포트 / 피드백 결과가 여기 표시됩니다", ZIndex = 41 }, adminFrame)
	corner(reportBox, 6)
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingTop = UDim.new(0, 6) }, reportBox)
end

function CBT.ToggleAdmin()
	if not player:GetAttribute("IsAdmin") or not adminFrame then
		return
	end
	adminFrame.Visible = not adminFrame.Visible
	modalHandler(adminFrame.Visible or feedbackFrame.Visible)
end

-- 창이 열리면 1인칭 마우스 잠금을 풀기 위해 WeaponController에 알림
function CBT.SetModalHandler(fn)
	modalHandler = fn
end

function CBT.Init(remoteFolder, hud)
	remotes = remoteFolder
	HUD = hud
	gui = make("ScreenGui", { Name = "SplashCBT", ResetOnSpawn = false, DisplayOrder = 20, ZIndexBehavior = Enum.ZIndexBehavior.Sibling },
		player:WaitForChild("PlayerGui"))
	buildFeedback()
	-- 서버가 DevTools 속성을 넣을 때까지 잠깐 대기 (정식 서버면 운영 명령만 표시)
	task.spawn(function()
		local t0 = os.clock()
		while player:GetAttribute("DevTools") == nil and os.clock() - t0 < 5 do
			task.wait(0.1)
		end
		buildAdmin()
	end)

	-- 항상 보이는 피드백 버튼 (로비 + 결과 화면)
	-- 0.5: 왼쪽 아래 피드백 버튼 제거 (채팅창 자리). 피드백은 F4 또는 결과 화면 안내로
	feedbackBtn = nil
	label(gui, { Text = (Config.CBT.Enabled and "CLOSED BETA · " or "SPLASH FRONT v") .. Config.Build, Position = UDim2.new(1, -220, 0, 2), Size = UDim2.fromOffset(204, 20), TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Color3.fromRGB(200, 200, 220), Font = Enum.Font.GothamBold })

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.F2 then
			CBT.ToggleAdmin()
		elseif input.KeyCode == Enum.KeyCode.F4 and Config.CBT.Enabled then
			CBT.OpenFeedback()
		end
	end)

end

-- 결과 화면이 뜰 때 피드백 유도
function CBT.OnResults()
	if not Config.CBT.Enabled then
		return
	end
	HUD.Banner("이번 판 어땠나요? 피드백 [F4]", Color3.fromRGB(0, 214, 200))
end

return CBT
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">CharacterPose</string><ProtectedString name="Source"><![CDATA[-- 캐릭터 자세 (클라이언트): 경기 중인 모든 캐릭터(플레이어·봇)
--  · 조준: 총을 앞으로 겨누고 상체·머리·팔이 조준 각도(AimPitch)를 나눠서 따라감
--  · 달리기: 상체를 숙이고 총을 비스듬히 내려 듦 · 걷기: 몸을 낮추고 조심스럽게 · 앉기: 무릎을 굽힌 자세 (움직이면 종종걸음)
--  · 사격 반동: 팔이 위로 튀었다가 돌아옴
-- 애니메이션 에셋 없이 Motor6D.Transform을 Roblox 기본 애니메이션 다음 단계에서 덮어씀
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local Pose = {}

local kicks = setmetatable({}, { __mode = "k" })  -- model -> 반동 각도(도)
local cache = setmetatable({}, { __mode = "k" })  -- model -> 관절
local smooth = setmetatable({}, { __mode = "k" }) -- model -> { Pitch, Run, Crouch, Walk }
local localStance = "Normal"

function Pose.Kick(model, recoil)
	if model then
		kicks[model] = math.min(28, (kicks[model] or 0) + 7 + (recoil or 1) * 2.5)
	end
end

function Pose.SetLocalStance(s)
	localStance = s or "Normal"
end

local function find(model, partName, jointName)
	local p = model:FindFirstChild(partName)
	return p and p:FindFirstChild(jointName)
end

local function jointsOf(model)
	local j = cache[model]
	if j and j.RS and j.RS.Parent then
		return j
	end
	j = {
		RS = find(model, "RightUpperArm", "RightShoulder"), LS = find(model, "LeftUpperArm", "LeftShoulder"),
		RE = find(model, "RightLowerArm", "RightElbow"), LE = find(model, "LeftLowerArm", "LeftElbow"),
		RW = find(model, "RightHand", "RightWrist"), LW = find(model, "LeftHand", "LeftWrist"),
		Waist = find(model, "UpperTorso", "Waist"), Neck = find(model, "Head", "Neck"),
		LH = find(model, "LeftUpperLeg", "LeftHip"), RH = find(model, "RightUpperLeg", "RightHip"),
		LK = find(model, "LeftLowerLeg", "LeftKnee"), RK = find(model, "RightLowerLeg", "RightKnee"),
		LA = find(model, "LeftFoot", "LeftAnkle"), RA = find(model, "RightFoot", "RightAnkle"),
	}
	if not j.RS then
		j.R6 = true
		j.RS = find(model, "Torso", "Right Shoulder")
		j.LS = find(model, "Torso", "Left Shoulder")
	end
	cache[model] = j
	return j
end

local function armed(model)
	if not model or not model:FindFirstChild("SF_Gun") then
		return false
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	return hum and hum.Health > 0
end

local function rad(d)
	return math.rad(d)
end

local function pose(model, pitchDeg, stance, dt)
	local j = jointsOf(model)
	if not j.RS then
		return
	end
	local sm = smooth[model]
	if not sm then
		sm = { Pitch = pitchDeg, Run = 0, Crouch = 0, Walk = 0, T = 0 }
		smooth[model] = sm
	end
	local k = 1 - math.exp(-12 * dt)
	sm.Pitch = sm.Pitch + (pitchDeg - sm.Pitch) * k
	sm.Run = sm.Run + (((stance == "Run") and 1 or 0) - sm.Run) * k
	sm.Crouch = sm.Crouch + (((stance == "Crouch") and 1 or 0) - sm.Crouch) * k
	sm.Walk = sm.Walk + (((stance == "Walk") and 1 or 0) - sm.Walk) * k
	local kick = kicks[model] or 0
	if kick > 0.05 then
		kicks[model] = kick * math.exp(-14 * dt)
	end
	local p = sm.Pitch
	local run, crouch, walk = sm.Run, sm.Crouch, sm.Walk

	if j.R6 then
		local raise = rad(90 + p * 0.8 + kick - run * 45)
		j.RS.Transform = CFrame.Angles(0, 0, raise)
		if j.LS then
			j.LS.Transform = CFrame.Angles(0, 0, -raise) * CFrame.Angles(rad(30), 0, 0)
		end
		return
	end

	-- 상체·머리가 조준 각도의 일부를 맡음 (달리기는 앞으로 숙임, 걷기는 살짝 웅크림)
	if j.Waist then
		j.Waist.Transform = CFrame.Angles(rad(p * 0.3 - run * 14 - walk * 6 - crouch * 8), 0, 0)
	end
	if j.Neck then
		j.Neck.Transform = CFrame.Angles(rad(p * 0.35 + run * 10 + crouch * 6), 0, 0)
	end

	-- 팔: 조준 자세 ↔ 달리기 들기 자세
	local armPitch = 90 + p * 0.35 + kick
	local runDown = run * 48
	j.RS.Transform = CFrame.Angles(0, rad(8 + run * 22), 0) * CFrame.Angles(rad(armPitch - runDown), 0, 0)
	if j.RE then
		j.RE.Transform = CFrame.Angles(rad(run * 25), 0, 0)
	end
	if j.RW then
		j.RW.Transform = CFrame.new()
	end
	if j.LS then
		j.LS.Transform = CFrame.Angles(0, rad(-42 + run * 10), 0) * CFrame.Angles(rad(armPitch - 6 - runDown), 0, 0)
	end
	if j.LE then
		j.LE.Transform = CFrame.Angles(rad(18 + run * 20), 0, 0)
	end
	if j.LW then
		j.LW.Transform = CFrame.new()
	end

	-- 앉기: 무릎을 굽힘 (움직이면 좌우 번갈아 종종걸음). 기본 걷기 다리 동작 위에 섞음
	if crouch > 0.02 then
		local root = model:FindFirstChild("HumanoidRootPart")
		local v = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude or 0
		sm.T = sm.T + dt * (v > 1 and 7 or 0)
		local step = (v > 1) and math.sin(sm.T) * 14 or 0
		for _, side in ipairs({ { j.LH, j.LK, j.LA, 1 }, { j.RH, j.RK, j.RA, -1 } }) do
			local hip, knee, ankle, sgn = side[1], side[2], side[3], side[4]
			if hip and knee then
				local h = (70 + step * sgn) * crouch
				hip.Transform = hip.Transform:Lerp(CFrame.Angles(rad(h), 0, 0), crouch)
				knee.Transform = knee.Transform:Lerp(CFrame.Angles(rad(-105 * crouch), 0, 0), crouch)
				if ankle then
					ankle.Transform = ankle.Transform:Lerp(CFrame.Angles(rad(35 * crouch), 0, 0), crouch)
				end
			end
		end
	end
end

function Pose.Init()
	local signal = RunService.PreSimulation or RunService.Stepped
	signal:Connect(function(a, b)
		local dt = (type(b) == "number") and b or a -- Stepped(time, dt) / PreSimulation(dt)
		local cam = workspace.CurrentCamera
		local myPitch = 0
		if cam then
			myPitch = math.deg(math.asin(math.clamp(cam.CFrame.LookVector.Y, -1, 1)))
		end
		for _, pl in ipairs(Players:GetPlayers()) do
			local c = pl.Character
			if c and pl:GetAttribute("InMatch") and armed(c) then
				if pl == player then
					pose(c, math.clamp(myPitch, -70, 70), localStance, dt)
				else
					pose(c, pl:GetAttribute("AimPitch") or 0, pl:GetAttribute("Stance") or "Normal", dt)
				end
			end
		end
		local bots = workspace:FindFirstChild("Bots")
		if bots then
			for _, m in ipairs(bots:GetChildren()) do
				if armed(m) then
					pose(m, m:GetAttribute("AimPitch") or 0, "Normal", dt)
				end
			end
		end
	end)
end

return Pose
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX31"><Properties><string name="Name">Client</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- SPLASH FRONT 클라이언트 진입점
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")

local HUD = require(script.Parent:WaitForChild("HUD"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local WeaponController = require(script.Parent:WaitForChild("WeaponController"))
local LobbyUI = require(script.Parent:WaitForChild("LobbyUI"))
local CBTPanel = require(script.Parent:WaitForChild("CBTPanel"))
local MapInteract = require(script.Parent:WaitForChild("MapInteract"))
local SoundBank = require(script.Parent:WaitForChild("SoundBank"))
local MusicPlayer = require(script.Parent:WaitForChild("MusicPlayer"))
local CharacterPose = require(script.Parent:WaitForChild("CharacterPose"))
local PaintVisual = require(script.Parent:WaitForChild("PaintVisual"))
local ItemClient = require(script.Parent:WaitForChild("ItemClient"))
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")

-- 채팅창은 왼쪽 아래, 기본 가방(1~0 단축키)은 끔 → 숫자키는 무기 교체용
task.spawn(function()
	local cfg = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration") or TextChatService:WaitForChild("ChatWindowConfiguration", 10)
	if cfg then
		cfg.HorizontalAlignment = Enum.HorizontalAlignment.Left
		cfg.VerticalAlignment = Enum.VerticalAlignment.Bottom
	end
	for _ = 1, 10 do
		if pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end) then
			break
		end
		task.wait(1)
	end
end)

HUD.Build()
-- 전체 UI 글꼴을 SF 이탤릭으로 (이후 만들어지는 창·킬피드·결과 화면 포함)
require(script.Parent:WaitForChild("UIKit")).AutoStyle(player:WaitForChild("PlayerGui"))
LobbyUI.Init(remotes, HUD)
WeaponController.Init(remotes, HUD, Effects)
CBTPanel.Init(remotes, HUD)
MapInteract.Init(Effects)
-- 창(상점·랭킹·크레이트·피드백·관리자)이 하나라도 열려 있으면 마우스 커서를 풀어 줌
local openWindows = {}
local function modal(source, on)
	openWindows[source] = on and true or nil
	WeaponController.SetUIMode(next(openWindows) ~= nil)
end
CBTPanel.SetModalHandler(function(on)
	modal("cbt", on)
end)
LobbyUI.SetModalHandler(function(on)
	modal("lobby", on)
end)
HUD.SetLeaveHandler(function(on)
	modal("leave", on)
end, function()
	remotes.Queue:FireServer("leaveMatch")
end)
CharacterPose.Init()
PaintVisual.Init()
ItemClient.Init(remotes, HUD)
HUD.UpdateQuests()
LobbyUI.UpdateQuests()

-- 저장 데이터 경고 (불러오기 실패 시)
local function dataWarn()
	local w = player:GetAttribute("DataWarning")
	if w then
		HUD.Banner(w, Color3.fromRGB(255, 140, 120))
	end
end
player:GetAttributeChangedSignal("DataWarning"):Connect(dataWarn)
task.delay(3, dataWarn)

-- 레벨 업 축하
player:GetAttributeChangedSignal("LevelUp"):Connect(function()
	local v = player:GetAttribute("LevelUp") or ""
	local lv, coins = string.match(v, "^(%d+):(%d+)")
	if lv then
		HUD.Banner(string.format("레벨 %s 달성!  +%s 코인", lv, coins), Color3.fromRGB(255, 210, 80))
		SoundBank.Play("crate_epic", nil, 0.6)
	end
end)
MusicPlayer.Init()

-- 스페셜 충전 완료 / 부활
local lastSpecial = 0
player:GetAttributeChangedSignal("Special"):Connect(function()
	local v = player:GetAttribute("Special") or 0
	if v >= 1 and lastSpecial < 1 then
		SoundBank.Play("special_ready", nil, 0.6)
	end
	lastSpecial = v
end)
player.CharacterAdded:Connect(function()
	if player:GetAttribute("InMatch") then
		SoundBank.Play("respawn", nil, 0.5)
	end
end)

player:GetAttributeChangedSignal("InMatch"):Connect(function()
	if player:GetAttribute("InMatch") and player:GetAttribute("FirstMatch") then
		HUD.ShowTips()
	end
end)

remotes.State.OnClientEvent:Connect(function(s)
	HUD.OnState(s)
	LobbyUI.OnState(s)
	MusicPlayer.OnState(s)
end)

remotes.Results.OnClientEvent:Connect(function(r)
	-- 이번 판에 참가한 사람만 결과창을 봄 (중간에 나간 사람·로비 사람은 제외)
	local joined = false
	for _, row in ipairs(r.Rows) do
		if row.Player == player then
			joined = true
		end
	end
	if not joined then
		return
	end
	HUD.ShowResults(r)
	CBTPanel.OnResults()
	for _, row in ipairs(r.Rows) do
		if row.Player == player then
			MusicPlayer.PlayResult(row.Won)
		end
	end
end)

remotes.Notify.OnClientEvent:Connect(function(msg, color)
	HUD.Banner(msg, color)
end)

remotes.FX.OnClientEvent:Connect(function(kind, data)
	Effects.OnFX(kind, data)
	if kind == "Kill" then
		HUD.KillFeed(data)
		if data.VictimPlayer == player then
			SoundBank.Play("splashed", nil, 0.8)
		end
	elseif kind == "Elim" then
		HUD.Elim(data)
	elseif kind == "Cue" then
		-- 서버가 알려주는 상황: 미션·깃발은 우리 팀이면 성공음, 아니면 실패음
		local mine = player:GetAttribute("OwnerId")
		local name = data.Name
		if name == "mission_result" then
			name = (data.Owner == mine) and "mission_success" or "mission_fail"
		elseif name == "flag" then
			name = (data.Owner == mine) and "flag_captured" or "flag_lost"
		end
		SoundBank.Play(name, data.Pos, data.Volume or 0.7)
	end
end)

remotes.HitConfirm.OnClientEvent:Connect(function(d)
	HUD.Hitmarker(d.Head, d.Kill)
	if d.Pos then
		Effects.DamageNumber(d.Pos + Vector3.new(0, 1, 0), d.Damage, d.Head, d.Kill)
	end
	SoundBank.Play(d.Head and "hit_head" or "hit", nil, d.Head and 0.8 or 0.6)
	if d.Kill then
		SoundBank.Play("kill", nil, 0.8)
	end
end)

remotes.Damaged.OnClientEvent:Connect(function(fromPos, amount, color)
	HUD.DamageFlash(color or Color3.fromRGB(255, 60, 60)) -- 기획서 4장: 화면 가장자리 적 색 비네트
	HUD.ScreenSplat(color, amount)
	Effects.Shake(math.clamp(amount / 80, 0.05, 0.35))
	SoundBank.Play("hurt", nil, 0.5)
end)

remotes.CrateResult.OnClientEvent:Connect(function(res)
	LobbyUI.ShowCrate(res)
end)

print("[SplashFront] 클라이언트 준비 — B: 상점, F4: 피드백, F2: 관리자, 경기 중 좌클릭 발사 / 우클릭 조준 / Q 스페셜 / C 앉기 / V 1·3인칭 / 스폰에서 1~6·T 무기 교체")
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- 시각/청각 효과: 트레이서, 착탄 스플래시, 크로마 봄, 처치 이펙트, 데미지 숫자
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local SoundBank = require(script.Parent:WaitForChild("SoundBank"))
local CharacterPose = require(script.Parent:WaitForChild("CharacterPose"))
local PaintVisual = require(script.Parent:WaitForChild("PaintVisual"))


local player = Players.LocalPlayer
local Effects = {}
function Effects.WallSplat(inst, pos, normal, color)
	PaintVisual.WallSplat(inst, pos, normal, color)
end

local function folder()
	local f = workspace:FindFirstChild("ClientFX")
	if not f then
		f = Instance.new("Folder")
		f.Name = "ClientFX"
		f.Parent = workspace
	end
	return f
end

local function fxPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = folder()
	return p
end

function Effects.Sound(id, position, volume, pitch)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.5
	s.PlaybackSpeed = pitch or 1
	if position then
		local a = fxPart({ Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1, Position = position })
		s.Parent = a
		s:Play()
		Debris:AddItem(a, 2)
	else
		s.Parent = workspace.CurrentCamera
		s:Play()
		Debris:AddItem(s, 2)
	end
end

function Effects.Tracer(from, to, color, width)
	local dist = (to - from).Magnitude
	if dist < 0.5 then
		return
	end
	local p = fxPart({
		Size = Vector3.new(width or 0.18, width or 0.18, dist), Color = color,
		CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -dist / 2), Transparency = 0.1,
	})
	TweenService:Create(p, TweenInfo.new(0.12), { Transparency = 1, Size = Vector3.new(0.02, 0.02, dist) }):Play()
	Debris:AddItem(p, 0.2)
	Effects.Splash(to, color, 1)
end

-- 파티클 한 번 터뜨리기 (잉크 방울은 포물선으로 떨어지고, 연기는 퍼지며 사라짐)
local function burst(pos, color, count, speed, size, life, gravity, lightEmission, transparency)
	local holder = fxPart({ Size = Vector3.one * 0.1, Position = pos, Transparency = 1 })
	local att = Instance.new("Attachment")
	att.Parent = holder
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = lightEmission or 0.15
	pe.LightInfluence = 0.6
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 0.3) })
	pe.Transparency = transparency or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.8, 0.1),
		NumberSequenceKeypoint.new(1, 1) })
	pe.Lifetime = NumberRange.new(life * 0.6, life)
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, -(gravity or 0), 0)
	pe.Drag = 2
	pe.Rate = 0
	pe.Parent = att
	pe:Emit(count)
	Debris:AddItem(holder, life + 0.1)
end
Effects.Burst = burst

function Effects.Splash(pos, color, scale)
	scale = scale or 1
	-- 잉크 방울 + 옅은 물보라
	burst(pos, color, math.floor(10 * scale), 16 * scale, 0.32 * scale, 0.55, 45)
	burst(pos, color:Lerp(Color3.new(1, 1, 1), 0.35), math.floor(4 * scale), 4, 1.4 * scale, 0.35, 0, 0.1,
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }))
	local blob = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.6 * scale, Color = color, Position = pos })
	TweenService:Create(blob, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.one * 2.4 * scale, Transparency = 1 }):Play()
	Debris:AddItem(blob, 0.3)
	for _ = 1, math.floor(3 * scale) do
		local drop = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.35, Color = color, Position = pos })
		local off = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5) * 4 * scale
		TweenService:Create(drop, TweenInfo.new(0.3), { Position = pos + off, Transparency = 1 }):Play()
		Debris:AddItem(drop, 0.35)
	end
end

function Effects.Muzzle(cf, color)
	local p = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.5, Color = color, CFrame = cf })
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 8
	light.Brightness = 4
	light.Parent = p
	TweenService:Create(p, TweenInfo.new(0.06), { Size = Vector3.one * 1.1, Transparency = 1 }):Play()
	Debris:AddItem(p, 0.08)
	-- 십자 섬광 + 옅은 총구 연기
	for _, rot in ipairs({ 0, 90 }) do
		local f = fxPart({ Size = Vector3.new(0.08, 1.2, 0.08), Color = Color3.fromRGB(255, 240, 200), Material = Enum.Material.Neon,
			CFrame = cf * CFrame.Angles(0, 0, math.rad(rot + math.random(-20, 20))) })
		TweenService:Create(f, TweenInfo.new(0.05), { Transparency = 1, Size = Vector3.new(0.02, 1.8, 0.02) }):Play()
		Debris:AddItem(f, 0.07)
	end
	if math.random() < 0.5 then
		burst(cf.Position, Color3.fromRGB(190, 190, 195), 2, 2, 0.6, 0.6, -2, 0,
			NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 1) }))
	end
end

function Effects.Bomb(from, to, color, radius)
	local ball = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 1.6, Color = color, Position = from })
	local t0 = os.clock()
	local dur = 0.7
	local conn
	conn = game:GetService("RunService").RenderStepped:Connect(function()
		local a = math.min(1, (os.clock() - t0) / dur)
		local p = from:Lerp(to, a) + Vector3.new(0, math.sin(a * math.pi) * 10, 0)
		ball.Position = p
		if a >= 1 then
			conn:Disconnect()
			ball:Destroy()
			local ring = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 2, 2), Color = color,
				CFrame = CFrame.new(to + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
			TweenService:Create(ring, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = Vector3.new(0.3, radius * 2, radius * 2), Transparency = 1 }):Play()
			Debris:AddItem(ring, 0.4)
			Effects.Splash(to + Vector3.new(0, 1, 0), color, 4)
			local cam = workspace.CurrentCamera
			if cam and (cam.CFrame.Position - to).Magnitude < radius * 2.5 then
				Effects.Shake(0.5)
			end
		end
	end)
end

-- 처치 이펙트 (크로마 크레이트 아이템)
function Effects.KillEffect(kind, pos, color)
	if not pos then
		return
	end
	if kind == "Confetti" then
		for _ = 1, 24 do
			local c = Color3.fromHSV(math.random(), 0.8, 1)
			local p = fxPart({ Size = Vector3.new(0.4, 0.05, 0.25), Color = c, Position = pos })
			local off = Vector3.new(math.random() - 0.5, math.random() * 1.2, math.random() - 0.5) * 10
			TweenService:Create(p, TweenInfo.new(0.9, Enum.EasingStyle.Quad), { Position = pos + off,
				Orientation = Vector3.new(math.random(0, 360), math.random(0, 360), 0), Transparency = 1 }):Play()
			Debris:AddItem(p, 1)
		end
	elseif kind == "Smoke" then
		for i = 1, 6 do
			local p = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 2, Color = color, Material = Enum.Material.SmoothPlastic,
				Transparency = 0.3, Position = pos + Vector3.new(math.random() - 0.5, i * 0.4, math.random() - 0.5) * 2 })
			TweenService:Create(p, TweenInfo.new(1.4), { Size = Vector3.one * 7, Transparency = 1, Position = p.Position + Vector3.new(0, 4, 0) }):Play()
			Debris:AddItem(p, 1.5)
		end
	elseif kind == "Starburst" then
		for i = 1, 12 do
			local a = i / 12 * math.pi * 2
			local p = fxPart({ Size = Vector3.new(0.3, 0.3, 3), Color = color, CFrame = CFrame.lookAt(pos, pos + Vector3.new(math.cos(a), 0.4, math.sin(a))) })
			TweenService:Create(p, TweenInfo.new(0.5), { CFrame = p.CFrame * CFrame.new(0, 0, -6), Transparency = 1 }):Play()
			Debris:AddItem(p, 0.55)
		end
		Effects.Splash(pos, Color3.new(1, 1, 1), 2)
	elseif kind == "Rainbow" then
		for i = 1, 7 do
			local c = Color3.fromHSV(i / 7, 0.9, 1)
			local ring = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1, 1), Color = c,
				CFrame = CFrame.new(pos + Vector3.new(0, i * 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
			TweenService:Create(ring, TweenInfo.new(0.6 + i * 0.05, Enum.EasingStyle.Quad),
				{ Size = Vector3.new(0.3, 10 + i * 2, 10 + i * 2), Transparency = 1 }):Play()
			Debris:AddItem(ring, 1)
		end
	else
		Effects.Splash(pos, color, 3)
	end
end

function Effects.DamageNumber(pos, amount, head, killed)
	local a = fxPart({ Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1, Position = pos })
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(80, 40)
	bb.AlwaysOnTop = true
	bb.Adornee = a
	bb.Parent = a
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = tostring(amount)
	t.TextColor3 = killed and Color3.fromRGB(255, 70, 70) or (head and Color3.fromRGB(255, 215, 40) or Color3.new(1, 1, 1))
	t.TextStrokeTransparency = 0.2
	t.Parent = bb
	TweenService:Create(a, TweenInfo.new(0.6), { Position = pos + Vector3.new(math.random() - 0.5, 2.5, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(a, 0.7)
end

-- 카메라 흔들림 (WeaponController가 매 프레임 Effects.ShakeOffset()을 적용)
local shake = 0
function Effects.Shake(amount)
	shake = math.max(shake, amount)
end
function Effects.ShakeOffset(dt)
	if shake <= 0.001 then
		shake = 0
		return CFrame.new()
	end
	local s = shake
	shake = shake * math.exp(-12 * dt)
	return CFrame.Angles(math.rad((math.random() - 0.5) * s * 1.6), math.rad((math.random() - 0.5) * s * 1.6), 0)
end

-- 투척물 (스페셜 크로마 봄 · 연막탄): 서버와 같은 초기값으로 포물선을 그리다 ProjEnd에서 터짐
local projs = {}
local ModelKit = require(ReplicatedStorage.Shared.ModelKit)
local function startProj(d)
	local visual
	if d.Kind == "Smoke" then
		visual = ModelKit.Item("Smoke")
		for _, p in ipairs(visual:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Anchored = true
			end
		end
		visual.Parent = folder()
	else
		visual = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 1.7, Color = d.Color, Position = d.From })
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.5, 0)
		a0.Parent = visual
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.5, 0)
		a1.Parent = visual
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1 = a0, a1
		trail.Color = ColorSequence.new(d.Color)
		trail.LightEmission = 0.8
		trail.Lifetime = 0.25
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = visual
		local l = Instance.new("PointLight")
		l.Color = d.Color
		l.Range = 10
		l.Brightness = 3
		l.Parent = visual
	end
	local t0 = os.clock()
	local rec = { Visual = visual }
	projs[d.Id] = rec
	rec.Conn = game:GetService("RunService").RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > (Config.Throw.MaxTime + 0.5) then
			rec.Conn:Disconnect()
			visual:Destroy()
			projs[d.Id] = nil
			return
		end
		local pos = d.From + d.Vel * t + d.G * (0.5 * t * t)
		local cf = CFrame.new(pos) * CFrame.Angles(t * 9, t * 5, 0)
		if visual:IsA("Model") then
			visual:PivotTo(cf)
		else
			visual.CFrame = cf
		end
	end)
	SoundBank.Play("special_throw", d.From, 0.7)
end

local function endProj(d)
	local rec = projs[d.Id]
	if rec then
		rec.Conn:Disconnect()
		rec.Visual:Destroy()
		projs[d.Id] = nil
	end
	local pos = d.Pos
	if d.Kind == "Smoke" then
		SoundBank.Play("land", pos, 0.8)
		Effects.Splash(pos, Color3.fromRGB(230, 232, 240), 3)
		return
	end
	local radius = d.Radius or Config.SpecialRadius
	local ring = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 2, 2), Color = d.Color,
		CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	TweenService:Create(ring, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = Vector3.new(0.3, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.4)
	local ball = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 2, Color = d.Color, Position = pos })
	TweenService:Create(ball, TweenInfo.new(0.3, Enum.EasingStyle.Quad), { Size = Vector3.one * radius * 1.4, Transparency = 1 }):Play()
	Debris:AddItem(ball, 0.35)
	Effects.Splash(pos + Vector3.new(0, 1, 0), d.Color, 4)
	SoundBank.Play("special_boom", pos, 1)
	local cam = workspace.CurrentCamera
	if cam and (cam.CFrame.Position - pos).Magnitude < radius * 2.5 then
		Effects.Shake(0.4)
	end
end

-- 서버 FX 이벤트 처리
function Effects.OnFX(kind, d)
	if kind == "Tracer" then
		if d.Shooter == player then
			return -- 내 사격은 즉시 로컬로 그렸음
		end
		local from = d.From
		if d.Model then
			-- 손에 든 총의 총구에서 나가도록 + 발사 반동 자세
			CharacterPose.Kick(d.Model, 1.5)
			local gun = d.Model:FindFirstChild("SF_Gun")
			local muzzle = nil
			if gun then
				for _, p in ipairs(gun:GetDescendants()) do
					if p:IsA("BasePart") and p:GetAttribute("Kind") == "Muzzle" then
						muzzle = p
					end
				end
			end
			local hand = muzzle or d.Model:FindFirstChild("RightHand")
			if hand then
				from = hand.Position
			end
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { d.Model, folder(), workspace:FindFirstChild("PaintLayer") }
		for _, to in ipairs(d.To) do
			Effects.Tracer(from, to, d.Color, (d.Golden and 0.6) or (d.Weapon == "Sniper" and 0.35) or 0.18)
			-- 다른 사람 총알도 벽에 맞은 자리에 페인트 자국
			local dir = to - d.From
			if dir.Magnitude > 0.5 then
				local hit = workspace:Raycast(d.From, dir + dir.Unit * 0.6, params)
				if hit then
					PaintVisual.WallSplat(hit.Instance, hit.Position, hit.Normal, d.Color)
				end
			end
		end
		SoundBank.Play("fire_" .. string.lower(d.Weapon or "pistol"), d.From, 0.55)
	elseif kind == "Proj" then
		startProj(d)
	elseif kind == "ProjEnd" then
		endProj(d)
	elseif kind == "Bomb" then
		Effects.Bomb(d.From, d.To, d.Color, d.Radius)
		SoundBank.Play("special_throw", d.From, 0.7)
		task.delay(0.7, function()
			SoundBank.Play("special_boom", d.To, 1)
		end)
	elseif kind == "Kill" then
		if d.Pos then
			Effects.KillEffect(d.Effect, d.Pos, d.KillerColor or d.VictimColor)
		end
	end
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- 경기 HUD: 타이머·점수바·미션·조준선·히트마커·잉크·스페셜·체력·킬피드·결과
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Weapons = require(ReplicatedStorage.Shared.Weapons)
local ModelKit = require(ReplicatedStorage.Shared.ModelKit)
local UI = require(script.Parent:WaitForChild("UIKit"))

local player = Players.LocalPlayer
local HUD = {}

local gui, top, timerLbl, modeLbl, barHolder, missionFrame, missionLbl, missionTimer
local cross = {}
local hitmarker, inkBar, inkFill, specialFill, specialLbl, healthFill, healthLbl
local feed, banner, vignette, splashed, results, scope, weaponLbl, flagLbl, inkLbl, switchBar
local sightDot, sightHolo, scopeZoomLbl, itemBar, itemSlots, buffLbl, toast
local portraits, questBox, streakFrame, streakLbl, elimGui, elimFrame, rewardList, xpFill, xpLbl, levelLbl, inkPips, inkNum
local weaponCard, itemCard, myStreak = nil, nil, 0
local thumbCache = {}
local boardSig = ""
local HttpService = game:GetService("HttpService")
local TextChatService = game:GetService("TextChatService")
local DARKP = Color3.fromRGB(14, 12, 24)
local leaveConfirm, moveLbl
local MOVE_ICON = { ["일반"] = "일반", ["달리기"] = "달리기", ["걷기"] = "걷기", ["앉기"] = "앉기" }
local MOVE_COLOR = { ["일반"] = Color3.fromRGB(230, 230, 240), ["달리기"] = Color3.fromRGB(255, 200, 80), ["걷기"] = Color3.fromRGB(140, 220, 255),
	["앉기"] = Color3.fromRGB(170, 255, 170) }
local keyChips = {}
local STANCE_OF = { ["달리기"] = "Run", ["걷기"] = "Walk", ["앉기"] = "Crouch" }
function HUD.SetMove(mode)
	local active = STANCE_OF[mode]
	for st, c in pairs(keyChips) do
		local on = (st == active)
		c.Chip.BackgroundColor3 = on and Color3.fromRGB(255, 200, 50) or DARKP
		c.Chip.BackgroundTransparency = on and 0.05 or 0.35
		c.Label.TextColor3 = on and Color3.fromRGB(30, 20, 0) or Color3.new(1, 1, 1)
	end
end

-- 경기에서 나오면 즉시 경기 화면을 닫음 (서버 상태 방송을 기다리지 않음)
function HUD.ForceHide()
	if gui then
		gui.Enabled = false
	end
	if results then
		results.Visible = false
	end
	if leaveConfirm then
		leaveConfirm.Visible = false
	end
end
local leaveModal = function() end
local leaveConfirmFn = function() end

function HUD.SetLeaveHandler(onModal, onConfirm)
	leaveModal = onModal
	leaveConfirmFn = onConfirm
end

function HUD.AskLeave()
	if not leaveConfirm or not player:GetAttribute("InMatch") then
		return
	end
	leaveConfirm.Visible = not leaveConfirm.Visible
	leaveModal(leaveConfirm.Visible)
end
local ITEM_DEF = {}
for _, it in ipairs(Config.Items) do
	ITEM_DEF[it.Id] = it
end
local state = nil

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function corner(parent, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, parent)
end

local function text(parent, props)
	local t = make("TextLabel", {
		BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBlack,
		TextScaled = true, TextStrokeTransparency = 0.5, Text = "",
	}, parent)
	for k, v in pairs(props) do
		t[k] = v
	end
	return t
end

function HUD.Build()
	gui = make("ScreenGui", { Name = "SplashHUD", ResetOnSpawn = false, IgnoreGuiInset = true, Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))

	-- 상단 가운데: 모래시계 타이머 · 모드 · (팀전) 점수 막대 · TOP 5 초상화
	top = make("Frame", { Size = UDim2.new(0, 600, 0, 196), Position = UDim2.new(0.5, -300, 0, 6), BackgroundTransparency = 1 }, gui)
	local pill = make("Frame", { Size = UDim2.fromOffset(190, 46), Position = UDim2.new(0.5, -95, 0, 0), BackgroundColor3 = DARKP, BackgroundTransparency = 0.2 }, top)
	corner(pill, 23)
	make("UIStroke", { Thickness = 2, Color = Color3.new(1, 1, 1), Transparency = 0.75 }, pill)
	UI.Icon(pill, "hourglass", "", { Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(12, 6) })
	timerLbl = text(pill, { Size = UDim2.new(1, -60, 1, -8), Position = UDim2.fromOffset(50, 4), Text = "5:00", Font = Enum.Font.FredokaOne,
		TextXAlignment = Enum.TextXAlignment.Left, TextStrokeTransparency = 0.6 })
	modeLbl = text(top, { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0, 48), Font = Enum.Font.GothamBold,
		TextColor3 = Color3.fromRGB(240, 240, 250), TextStrokeTransparency = 0.4 })
	barHolder = make("Frame", { Size = UDim2.new(0, 420, 0, 16), Position = UDim2.new(0.5, -210, 0, 70),
		BackgroundColor3 = DARKP, BackgroundTransparency = 0.25, ClipsDescendants = true }, top)
	corner(barHolder, 8)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder }, barHolder)
	portraits = make("Frame", { Size = UDim2.new(1, 0, 0, 100), Position = UDim2.new(0, 0, 0, 92), BackgroundTransparency = 1 }, top)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, portraits)
	flagLbl = text(gui, { Size = UDim2.new(0, 460, 0, 22), Position = UDim2.new(0.5, -230, 0, 202), Font = Enum.Font.GothamBold })

	-- 오른쪽 위: 로비로 나가기 [L] + 확인 창
	local leaveBtn = make("TextButton", { Size = UDim2.fromOffset(120, 36), Position = UDim2.new(1, -136, 0, 12), BackgroundColor3 = DARKP, BackgroundTransparency = 0.2,
		Text = "", AutoButtonColor = true }, gui)
	corner(leaveBtn, 18)
	text(leaveBtn, { Size = UDim2.new(1, -16, 1, -10), Position = UDim2.fromOffset(8, 5), Text = "로비  [L]", Font = Enum.Font.GothamBlack, TextStrokeTransparency = 1 })
	leaveBtn.MouseButton1Click:Connect(function()
		if not player:GetAttribute("InMatch") then
			return
		end
		HUD.AskLeave()
	end)
	leaveConfirm = make("Frame", { Size = UDim2.fromOffset(420, 170), Position = UDim2.new(0.5, -210, 0.4, -85), BackgroundColor3 = Color3.fromRGB(20, 18, 34),
		Visible = false, ZIndex = 60 }, gui)
	corner(leaveConfirm, 16)
	make("UIStroke", { Thickness = 3, Color = Color3.fromRGB(255, 90, 120) }, leaveConfirm)
	text(leaveConfirm, { Size = UDim2.new(1, -40, 0, 34), Position = UDim2.fromOffset(20, 16), Text = "로비로 나갈까요?", ZIndex = 61 })
	text(leaveConfirm, { Size = UDim2.new(1, -40, 0, 22), Position = UDim2.fromOffset(20, 54), Text = "지금 나가면 이번 판 보상·레이팅은 받지 못해요", TextScaled = false,
		TextSize = 16, Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(200, 200, 220), ZIndex = 61 })
	for i, o in ipairs({ { "나가기", Color3.fromRGB(230, 60, 100), true }, { "계속하기", Color3.fromRGB(60, 58, 86), false } }) do
		local b = make("TextButton", { Size = UDim2.fromOffset(170, 48), Position = UDim2.new(0, 30 + (i - 1) * 190, 1, -66), BackgroundColor3 = o[2], Text = o[1],
			TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBlack, TextSize = 20, ZIndex = 61 }, leaveConfirm)
		corner(b, 10)
		b.MouseButton1Click:Connect(function()
			leaveConfirm.Visible = false
			leaveModal(false)
			if o[3] then
				leaveConfirmFn()
				HUD.ForceHide() -- 서버 응답 전에 경기 화면부터 닫음
			end
		end)
	end
	game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.L and player:GetAttribute("InMatch") then
			HUD.AskLeave()
		end
	end)

	-- 왼쪽 위: 일일·주간 퀘스트 카드
	questBox = make("Frame", { Size = UDim2.fromOffset(380, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.fromOffset(16, 56), BackgroundTransparency = 1 }, gui)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, questBox)

	-- 왼쪽: 연속 처치 불꽃
	streakFrame = make("Frame", { Size = UDim2.fromOffset(120, 120), Position = UDim2.new(0, 20, 0.62, 0), BackgroundTransparency = 1, Visible = false }, gui)
	UI.Icon(streakFrame, "flame", "", { Size = UDim2.fromScale(1, 1) })
	streakLbl = text(streakFrame, { Size = UDim2.new(1, 0, 0.46, 0), Position = UDim2.new(0, 0, 0.5, 0), Text = "x2", Font = Enum.Font.FredokaOne,
		TextStrokeTransparency = 1 })
	make("UIStroke", { Thickness = 4, Color = Color3.fromRGB(150, 20, 40) }, streakLbl)

	-- 왼쪽 아래: 조작키 안내
	-- 작은 칩 5개 (지금 이동 상태 칩은 노랗게 켜짐 → 따로 상태 글자를 두지 않음)
	local keys = make("Frame", { Size = UDim2.new(0, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.X, Position = UDim2.new(0, 12, 1, -10),
		AnchorPoint = Vector2.new(0, 1), BackgroundTransparency = 1 }, gui)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, keys)
	keyChips = {}
	for i, k in ipairs({ { "Shift", "달리기", "Run" }, { "Z", "걷기", "Walk" }, { "C", "앉기", "Crouch" }, { "F", "아이템" }, { "V", "시점" } }) do
		local kw = (#k[1] > 1) and 32 or 18
		local chip = make("Frame", { Size = UDim2.fromOffset(42 + kw, 24), BackgroundColor3 = DARKP, BackgroundTransparency = 0.35, LayoutOrder = i }, keys)
		corner(chip, 6)
		local key = make("Frame", { Size = UDim2.fromOffset(kw, 18), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.fromRGB(240, 240, 248) }, chip)
		corner(key, 4)
		text(key, { Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), Text = k[1], TextColor3 = Color3.fromRGB(20, 20, 30), TextStrokeTransparency = 1,
			Font = Enum.Font.GothamBlack })
		local lbl = text(chip, { Size = UDim2.new(1, -(kw + 8), 1, -8), Position = UDim2.fromOffset(kw + 6, 4), Text = k[2], TextXAlignment = Enum.TextXAlignment.Left,
			Font = Enum.Font.GothamBold, TextStrokeTransparency = 1 })
		if k[3] then
			keyChips[k[3]] = { Chip = chip, Label = lbl }
		end
	end

	-- 미션
	missionFrame = make("Frame", { Size = UDim2.new(0, 480, 0, 72), Position = UDim2.new(0.5, -240, 0, 228),
		BackgroundColor3 = Color3.fromRGB(255, 196, 40), BackgroundTransparency = 0.1, Visible = false }, gui)
	corner(missionFrame, 10)
	-- 두 줄: 1줄 미션 이름·보너스(굵게), 2줄 설명 → 잘리지 않음
	missionLbl = text(missionFrame, { Size = UDim2.new(1, -78, 1, -10), Position = UDim2.new(0, 12, 0, 5), TextColor3 = Color3.fromRGB(30, 20, 0),
		TextStrokeTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, RichText = true, LineHeight = 1.05 })
	missionTimer = text(missionFrame, { Size = UDim2.new(0, 56, 1, -8), Position = UDim2.new(1, -62, 0, 4), TextColor3 = Color3.fromRGB(30, 20, 0),
		TextStrokeTransparency = 1 })

	-- 조준선
	for i = 1, 4 do
		cross[i] = make("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5) }, gui)
		make("UIStroke", { Thickness = 1, Color = Color3.new(0, 0, 0), Transparency = 0.4 }, cross[i])
	end
	make("Frame", { Size = UDim2.fromOffset(3, 3), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Name = "Dot" }, gui)
	hitmarker = make("Frame", { Size = UDim2.fromOffset(28, 28), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1, Visible = false }, gui)
	for i = 1, 4 do
		local f = make("Frame", { Size = UDim2.fromOffset(10, 3), AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0,
			BackgroundColor3 = Color3.new(1, 1, 1), Rotation = 45 + 90 * i }, hitmarker)
		local a = math.rad(45 + 90 * i)
		f.Position = UDim2.new(0.5, math.cos(a) * 10, 0.5, math.sin(a) * 10)
	end


	-- 하단 가운데: 체력 + 레벨 경험치 막대
	local hb = make("Frame", { Size = UDim2.fromOffset(300, 12), Position = UDim2.new(0.5, -150, 1, -72), BackgroundColor3 = DARKP, BackgroundTransparency = 0.25 }, gui)
	corner(hb, 6)
	healthFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(90, 255, 140), BorderSizePixel = 0 }, hb)
	corner(healthFill, 6)
	healthLbl = text(gui, { Size = UDim2.fromOffset(60, 22), Position = UDim2.new(0.5, -216, 1, -78), Text = "100", Font = Enum.Font.FredokaOne,
		TextXAlignment = Enum.TextXAlignment.Right })
	local xb = make("Frame", { Size = UDim2.fromOffset(470, 28), Position = UDim2.new(0.5, -235, 1, -48), BackgroundColor3 = DARKP, BackgroundTransparency = 0.15 }, gui)
	corner(xb, 14)
	make("UIStroke", { Thickness = 2, Color = Color3.fromRGB(255, 190, 80), Transparency = 0.3 }, xb)
	xpFill = make("Frame", { Size = UDim2.fromScale(0.3, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, xb)
	corner(xpFill, 14)
	make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 150, 40), Color3.fromRGB(255, 210, 90)) }, xpFill)
	levelLbl = text(xb, { Size = UDim2.new(0.4, 0, 1, -8), Position = UDim2.fromOffset(14, 4), Text = "레벨 1", TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamBlack, TextStrokeTransparency = 0.5, ZIndex = 2 })
	xpLbl = text(xb, { Size = UDim2.new(0.45, 0, 1, -10), Position = UDim2.new(0.55, -46, 0, 5), Text = "0 / 100 XP", TextXAlignment = Enum.TextXAlignment.Right,
		Font = Enum.Font.GothamBold, TextStrokeTransparency = 0.5, ZIndex = 2 })
	UI.Icon(xb, "chest", "", { Size = UDim2.fromOffset(44, 44), Position = UDim2.new(1, -30, 0.5, -22), ZIndex = 3 })

	-- 오른쪽 아래: 잉크(탄) 칸 + 숫자, 슬롯 카드 [1 무기] [Q 스페셜] [F 아이템]
	local ammo = make("Frame", { Size = UDim2.fromOffset(250, 36), Position = UDim2.new(1, -16, 1, -98), AnchorPoint = Vector2.new(1, 1), BackgroundTransparency = 1 }, gui)
	inkPips = {}
	for i = 1, 10 do
		local pip = make("Frame", { Size = UDim2.fromOffset(10, 20), Position = UDim2.fromOffset((i - 1) * 13, 10), BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0 }, ammo)
		corner(pip, 4)
		make("UIStroke", { Thickness = 1.5, Color = DARKP, Transparency = 0.2 }, pip)
		inkPips[i] = pip
	end
	inkNum = text(ammo, { Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, -110, 0, 0), Text = "100", Font = Enum.Font.FredokaOne,
		TextXAlignment = Enum.TextXAlignment.Right, RichText = true })
	-- 작게(무기 116 + 스페셜·아이템 88) → 가운데 경험치 막대와 겹치지 않음
	local slots = make("Frame", { Size = UDim2.fromOffset(310, 74), Position = UDim2.new(1, -16, 1, -16), AnchorPoint = Vector2.new(1, 1), BackgroundTransparency = 1 }, gui)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder }, slots)
	local function card(order, key, wide)
		local c = make("Frame", { Size = UDim2.fromOffset(wide and 116 or 88, 74), BackgroundColor3 = Color3.fromRGB(28, 26, 44), BackgroundTransparency = 0.12,
			LayoutOrder = order }, slots)
		corner(c, 12)
		make("UIStroke", { Thickness = 2, Color = Color3.fromRGB(230, 230, 245), Transparency = 0.6 }, c)
		make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 170, 190)), Rotation = 90 }, c)
		local badge = make("Frame", { Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(4, 4), BackgroundColor3 = Color3.fromRGB(240, 240, 248), ZIndex = 3 }, c)
		corner(badge, 6)
		text(badge, { Size = UDim2.fromScale(1, 1), Text = key, TextColor3 = DARKP, TextStrokeTransparency = 1, Font = Enum.Font.GothamBlack, ZIndex = 4 })
		local pic = make("Frame", { Size = UDim2.new(1, -10, 1, -24), Position = UDim2.fromOffset(5, 4), BackgroundTransparency = 1 }, c)
		local name = text(c, { Size = UDim2.new(1, -10, 0, 15), Position = UDim2.new(0, 5, 1, -18), Text = "", Font = Enum.Font.GothamBlack,
			TextStrokeTransparency = 0.5, ZIndex = 3 })
		return c, pic, name
	end
	local wc, wpic, wname = card(1, "1", true)
	weaponCard = { Frame = wc, Pic = wpic, Name = wname }
	weaponLbl = wname
	local sc, spic, sname = card(2, "Q")
	UI.Icon(spic, "bomb", "", { Size = UDim2.fromScale(1, 1) })
	local sb = make("Frame", { Size = UDim2.new(1, -12, 0, 5), Position = UDim2.new(0, 6, 1, -22), BackgroundColor3 = DARKP, ZIndex = 3 }, sc)
	corner(sb, 3)
	specialFill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(255, 220, 60), BorderSizePixel = 0, ZIndex = 3 }, sb)
	corner(specialFill, 3)
	specialLbl = sname
	local ic, ipic, iname = card(3, "F")
	itemCard = { Frame = ic, Pic = ipic, Name = iname }

	-- 킬피드
	feed = make("Frame", { Size = UDim2.new(0, 470, 0, 260), Position = UDim2.new(1, -486, 0, 56), BackgroundTransparency = 1 }, gui)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 4) }, feed)

	-- 배너 / 처치 / 피격
	local notifyGui = make("ScreenGui", { Name = "SplashNotify", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 10 }, player.PlayerGui)
	banner = text(notifyGui, { Size = UDim2.new(0, 700, 0, 40), Position = UDim2.new(0.5, -350, 0.28, 0), TextTransparency = 1, TextStrokeTransparency = 1 })
	splashed = text(gui, { Size = UDim2.new(0, 500, 0, 60), Position = UDim2.new(0.5, -250, 0.62, 0), Text = "",
		TextTransparency = 1, TextStrokeTransparency = 1 })
	-- 처치 배너: [멀티킬 칩] / 제거됨 / 💀 상대 이름 + 보상 줄
	elimGui = notifyGui
	elimFrame = make("Frame", { Size = UDim2.fromOffset(520, 130), Position = UDim2.new(0.5, -260, 0.6, 0), BackgroundTransparency = 1, Visible = false }, notifyGui)
	rewardList = make("Frame", { Size = UDim2.fromOffset(520, 80), Position = UDim2.new(0.5, -260, 0.6, 134), BackgroundTransparency = 1 }, notifyGui)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 2) }, rewardList)
	vignette = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 0 }, gui)
	local grad = make("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.25, 1), NumberSequenceKeypoint.new(0.75, 1), NumberSequenceKeypoint.new(1, 0.2) }) }, vignette)
	grad.Name = "Grad"

	-- 저격 조준경
	-- 스코프: 화면 높이만 한 정사각 스코프 이미지(가운데 투명 원) + 좌우 검은 띠. 이미지가 아직 없으면 얇은 십자선만
	scope = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 5 }, gui)
	local sq = make("Frame", { Size = UDim2.fromScale(1, 1), SizeConstraint = Enum.SizeConstraint.RelativeYY, Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 5 }, scope)
	make("Frame", { Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(-1, 0, 0, 0), BackgroundColor3 = Color3.fromRGB(6, 6, 10), BorderSizePixel = 0, ZIndex = 5 }, sq)
	make("Frame", { Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.fromRGB(6, 6, 10), BorderSizePixel = 0, ZIndex = 5 }, sq)
	local scopeImg = UI.Icon(sq, "scope", "", { Size = UDim2.fromScale(1, 1), ZIndex = 5 })
	local fallback = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 6 }, sq)
	make("Frame", { Size = UDim2.new(0.9, 0, 0, 2), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0, ZIndex = 6 }, fallback)
	make("Frame", { Size = UDim2.new(0, 2, 0.9, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0, ZIndex = 6 }, fallback)
	local ringF = make("Frame", { Size = UDim2.fromScale(0.94, 0.94), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1, ZIndex = 6 }, fallback)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, ringF)
	make("UIStroke", { Thickness = 4, Color = Color3.new(0, 0, 0) }, ringF)
	local rd = make("Frame", { Size = UDim2.fromOffset(6, 6), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(255, 40, 60), BorderSizePixel = 0, ZIndex = 7 }, fallback)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, rd)
	local imgs = ReplicatedStorage:FindFirstChild("Images")
	local function scopeRefresh()
		fallback.Visible = not (imgs and imgs:GetAttribute("icon_scope"))
	end
	scopeRefresh()
	if imgs then
		imgs:GetAttributeChangedSignal("icon_scope"):Connect(scopeRefresh)
	end
	local ring = sq
	scopeZoomLbl = text(scope, { Size = UDim2.fromOffset(120, 30), Position = UDim2.new(0.5, 60, 0.5, 60), Text = "", Font = Enum.Font.GothamBlack, ZIndex = 8,
		TextColor3 = Color3.fromRGB(255, 220, 80), TextXAlignment = Enum.TextXAlignment.Left })

	-- 레드닷(점) / 홀로(원 + 점) 조준점: 우클릭 조준 시
	sightDot = make("Frame", { Size = UDim2.fromOffset(7, 7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(255, 40, 60), BorderSizePixel = 0, Visible = false, ZIndex = 4 }, gui)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, sightDot)
	make("UIStroke", { Thickness = 2, Color = Color3.fromRGB(255, 120, 130), Transparency = 0.5 }, sightDot)
	sightHolo = make("Frame", { Size = UDim2.fromOffset(46, 46), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1, Visible = false, ZIndex = 4 }, gui)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, sightHolo)
	make("UIStroke", { Thickness = 2, Color = Color3.fromRGB(255, 60, 80), Transparency = 0.15 }, sightHolo)

	itemSlots = {}
	buffLbl = text(gui, { Size = UDim2.new(0, 700, 0, 22), Position = UDim2.new(0.5, -350, 1, -100), Text = "", Font = Enum.Font.GothamBlack,
		RichText = true })

	-- 스폰 지점 무기 교체 바 (1~6 / T)
	switchBar = make("Frame", { Size = UDim2.new(0, 0, 0, 54), AutomaticSize = Enum.AutomaticSize.X, Position = UDim2.new(0.5, 0, 1, -160),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(10, 10, 16), BackgroundTransparency = 0.2, Visible = false }, gui)
	corner(switchBar, 12)
	make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 7), PaddingBottom = UDim.new(0, 7) }, switchBar)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center }, switchBar)

	-- 결과창
	results = make("Frame", { Size = UDim2.new(0, 1000, 0, 580), Position = UDim2.new(0.5, -500, 0.5, -290),
		BackgroundColor3 = Color3.fromRGB(18, 18, 26), BackgroundTransparency = 0.05, Visible = false, ZIndex = 10 }, gui)
	corner(results, 16)
	make("UIStroke", { Thickness = 2, Color = Color3.fromRGB(255, 255, 255), Transparency = 0.7 }, results)
end

local function fmtTime(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

for _, a in ipairs({ "SpawnZone", "Owned", "Weapon", "InMatch" }) do
	player:GetAttributeChangedSignal(a):Connect(function()
		HUD.UpdateSwitch()
	end)
end

function HUD.OnState(s)
	state = s
	local inMatch = player:GetAttribute("InMatch") == true
	gui.Enabled = inMatch
	if not inMatch then
		return
	end
	modeLbl.Text = (s.ModeName or "") .. " · " .. (s.MapName or "")
	HUD.RenderBoard(s.Board or {})
	-- 점수바
	for _, c in ipairs(barHolder:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local total = 0
	for _, t in ipairs(s.Teams) do
		total = total + math.max(0, t.Score)
	end
	for i, t in ipairs(s.Teams) do
		local share = (total > 0) and (t.Score / total) or (1 / math.max(1, #s.Teams))
		local f = make("Frame", { Size = UDim2.new(share, 0, 1, 0), BackgroundColor3 = t.Color, BorderSizePixel = 0, LayoutOrder = i }, barHolder)
		if share > 0.12 then
			local label = (s.Mode == "Flag") and string.format("%s %.0f", t.Name, t.Score)
				or string.format("%.0f점 · 페인트 %.0f%%", t.Score, t.Coverage or 0)
			text(f, { Size = UDim2.fromScale(1, 1), Text = label, Font = Enum.Font.GothamBold })
		end
	end
	-- 깃발
	if s.Mode == "Flag" and s.Flags then
		local parts = {}
		for _, f in ipairs(s.Flags) do
			local who = "중립"
			for _, t in ipairs(s.Teams) do
				if t.OwnerId == f.Owner then
					who = t.Name
				end
			end
			local p = (f.Progress > 0) and string.format(" (%d%%)", math.floor(f.Progress * 100)) or ""
			table.insert(parts, f.Name .. ": " .. who .. p)
		end
		flagLbl.Text = table.concat(parts, "   ")
	else
		flagLbl.Text = ""
	end
	-- 미션
	if s.Mission then
		missionFrame.Visible = true
		missionLbl.Text = string.format("<b>미션! %s  (+%s)</b>\n%s", s.Mission.Name, tostring(s.Mission.Bonus), s.Mission.Desc)
	else
		missionFrame.Visible = false
	end
	timerLbl.TextColor3 = s.FinalSplash and Color3.fromRGB(255, 220, 60) or Color3.new(1, 1, 1)
end

-- 매 프레임 갱신 (WeaponController에서 호출)
function HUD.Update(spreadPx, weaponId, sight, zoomText)
	local scoped = sight == "Scope"
	if not gui.Enabled then
		return
	end
	if state then
		timerLbl.Text = fmtTime(state.EndsAt - workspace:GetServerTimeNow())
		if state.Mission then
			missionTimer.Text = tostring(math.max(0, math.ceil(state.Mission.EndsAt - workspace:GetServerTimeNow())))
		end
	end
	local gap = 6 + spreadPx
	local len = 9
	cross[1].Size = UDim2.fromOffset(2, len)
	cross[1].Position = UDim2.new(0.5, 0, 0.5, -gap - len / 2)
	cross[2].Size = UDim2.fromOffset(2, len)
	cross[2].Position = UDim2.new(0.5, 0, 0.5, gap + len / 2)
	cross[3].Size = UDim2.fromOffset(len, 2)
	cross[3].Position = UDim2.new(0.5, -gap - len / 2, 0.5, 0)
	cross[4].Size = UDim2.fromOffset(len, 2)
	cross[4].Position = UDim2.new(0.5, gap + len / 2, 0.5, 0)
	for i = 1, 4 do
		cross[i].Visible = sight == nil
	end
	scope.Visible = scoped
	scopeZoomLbl.Text = zoomText or ""
	sightDot.Visible = sight == "Dot" or sight == "Holo"
	sightHolo.Visible = sight == "Holo"
	-- 효과 남은 시간
	local now = workspace:GetServerTimeNow()
	local parts = {}
	local ju, su, zu = player:GetAttribute("JetpackUntil"), player:GetAttribute("ShieldUntil"), player:GetAttribute("ZoomUntil")
	if ju and ju > now then
		table.insert(parts, string.format('<font color="#FFB050"> 제트팩 %d초 (Space)</font>', math.ceil(ju - now)))
	end
	if su and su > now then
		table.insert(parts, string.format('<font color="#70C8FF"> 무적 %d초</font>', math.ceil(su - now)))
	end
	if zu and zu > now then
		table.insert(parts, string.format('<font color="#90FF90"> %d배 줌 %d초</font>', player:GetAttribute("ZoomBuff") or 1, math.ceil(zu - now)))
	end
	if player:GetAttribute("Golden") then
		table.insert(parts, '<font color="#FFD040"> 황금총 장전 — 다음 1발 즉사</font>')
	end
	buffLbl.Text = table.concat(parts, "   ")

	local color = player:GetAttribute("TeamColor") or Color3.new(1, 1, 1)
	local ink = math.clamp((player:GetAttribute("Ink") or 100) / Config.InkMax, 0, 1)
	local low = ink < 0.15
	for i, pip in ipairs(inkPips) do
		local on = ink >= (i - 0.5) / 10
		pip.BackgroundColor3 = on and (low and Color3.fromRGB(255, 70, 70) or color) or Color3.fromRGB(60, 58, 80)
		pip.BackgroundTransparency = on and 0 or 0.4
	end
	inkNum.Text = string.format('%d<font size="20">%%</font>', math.floor(ink * 100))
	inkNum.TextColor3 = low and Color3.fromRGB(255, 120, 120) or Color3.new(1, 1, 1)
	local sp = player:GetAttribute("Special") or 0
	specialFill.Size = UDim2.fromScale(math.clamp(sp, 0, 1), 1)
	specialLbl.Text = sp >= 1 and "준비 완료!" or string.format("크로마 봄 %d%%", math.floor(sp * 100))
	specialLbl.TextColor3 = sp >= 1 and Color3.fromRGB(255, 225, 80) or Color3.new(1, 1, 1)
	local w = Weapons.Get(weaponId)
	weaponLbl.Text = player:GetAttribute("Golden") and "황금총" or w.Class
	-- 경험치
	local lv, xp, need = player:GetAttribute("Level") or 1, player:GetAttribute("XP") or 0, player:GetAttribute("XPNeed") or 100
	levelLbl.Text = "레벨 " .. lv
	xpLbl.Text = string.format("%d / %d XP", xp, need)
	xpFill.Size = UDim2.fromScale(math.clamp(xp / math.max(1, need), 0.04, 1), 1)

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		local hp = hum.Health / math.max(1, hum.MaxHealth)
		healthFill.Size = UDim2.fromScale(math.clamp(hp, 0, 1), 1)
		healthFill.BackgroundColor3 = hp < 0.35 and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(90, 255, 140)
		healthLbl.Text = tostring(math.ceil(hum.Health))
	end
end

function HUD.Hitmarker(head, killed)
	hitmarker.Visible = true
	local c = killed and Color3.fromRGB(255, 60, 60) or (head and Color3.fromRGB(255, 210, 40) or Color3.new(1, 1, 1))
	for _, f in ipairs(hitmarker:GetChildren()) do
		f.BackgroundColor3 = c
	end
	hitmarker.Size = UDim2.fromOffset(40, 40)
	TweenService:Create(hitmarker, TweenInfo.new(0.12), { Size = UDim2.fromOffset(26, 26) }):Play()
	local token = {}
	HUD._hitToken = token
	task.delay(0.18, function()
		if HUD._hitToken == token then
			hitmarker.Visible = false
		end
	end)
	if killed then
		splashed.TextColor3 = player:GetAttribute("TeamColor") or Color3.new(1, 1, 1)
		splashed.TextTransparency = 0
		splashed.TextStrokeTransparency = 0.3
		splashed.Size = UDim2.new(0, 620, 0, 76)
		TweenService:Create(splashed, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Size = UDim2.new(0, 500, 0, 60) }):Play()
		task.delay(0.9, function()
			TweenService:Create(splashed, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end)
	end
end

-- 맞으면 화면 가장자리에 공격자 색 잉크가 튀었다 흘러내리며 사라짐 (레퍼런스 3번)
local splatCount = 0
function HUD.ScreenSplat(color, amount)
	local imgs = ReplicatedStorage:FindFirstChild("Images")
	local url = imgs and imgs:GetAttribute("icon_splat")
	if not url or not gui or splatCount > 8 then
		return
	end
	local n = math.clamp(math.floor((amount or 20) / 25) + 1, 1, 3)
	for _ = 1, n do
		splatCount = splatCount + 1
		local size = math.random(140, 260)
		-- 가운데(조준점)는 피해서 가장자리 쪽에
		local x = (math.random() < 0.5) and math.random(2, 28) / 100 or math.random(72, 98) / 100
		local y = math.random(8, 85) / 100
		local img = make("ImageLabel", { Image = url, ImageColor3 = color or Color3.fromRGB(255, 60, 60), BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromOffset(size * 0.6, size * 0.6),
			Rotation = math.random(-40, 40), ImageTransparency = 0.12, ZIndex = 0 }, gui)
		TweenService:Create(img, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(size, size) }):Play()
		task.delay(0.5, function()
			local t = TweenService:Create(img, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ ImageTransparency = 1, Position = UDim2.fromScale(x, y + 0.06) })
			t:Play()
			t.Completed:Connect(function()
				img:Destroy()
				splatCount = splatCount - 1
			end)
		end)
	end
end

function HUD.DamageFlash(color)
	vignette.BackgroundColor3 = color or Color3.fromRGB(255, 40, 40)
	vignette.BackgroundTransparency = 0.25
	TweenService:Create(vignette, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
end

function HUD.Banner(msg, color)
	banner.Text = msg
	banner.TextColor3 = color or Color3.new(1, 1, 1)
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0.4
	local token = {}
	HUD._bannerToken = token
	task.delay(2.6, function()
		if HUD._bannerToken == token then
			TweenService:Create(banner, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

-- 킬피드 (오른쪽 위): [🔥연속] [처치자] [총 아이콘] [피해자] 칩
local function chip(parent, txt, bg, fg, w, order)
	local c = make("Frame", { Size = UDim2.fromOffset(w, 30), BackgroundColor3 = bg, LayoutOrder = order }, parent)
	corner(c, 8)
	text(c, { Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4), Text = txt, Font = Enum.Font.GothamBlack, TextColor3 = fg or Color3.new(1, 1, 1),
		TextStrokeTransparency = 1, TextTruncate = Enum.TextTruncate.AtEnd })
	return c
end

function HUD.KillFeed(d)
	local row = make("Frame", { Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, LayoutOrder = -math.floor(os.clock() * 100) }, feed)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 4),
		VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, row)
	if d.Killer then
		if (d.KillerStreak or 0) >= 2 then
			local sc = chip(row, "    x" .. d.KillerStreak, Color3.fromRGB(255, 200, 40), Color3.fromRGB(120, 20, 10), 64, 1)
			UI.Icon(sc, "flame", "", { Size = UDim2.fromOffset(24, 24), Position = UDim2.fromOffset(4, 3), ZIndex = 3 })
		end
		local kc = chip(row, d.Killer, d.KillerColor or Color3.fromRGB(80, 80, 100), Color3.new(1, 1, 1), 140, 2)
		make("UIStroke", { Thickness = 1.5, Color = Color3.new(1, 1, 1), Transparency = (d.KillerPlayer == player) and 0 or 1 }, kc)
		local gun = make("Frame", { Size = UDim2.fromOffset(70, 30), BackgroundColor3 = Color3.fromRGB(245, 245, 250), LayoutOrder = 3 }, row)
		corner(gun, 8)
		if d.WeaponId then
			UI.GunImage(gun, d.WeaponId, Color3.fromRGB(60, 60, 70))
		end
		if d.Head then
			UI.Icon(gun, "target", "", { Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, -18, 0, 0), ZIndex = 3 })
		end
	end
	local vc = chip(row, d.Victim, Color3.fromRGB(40, 38, 58), d.VictimColor, 140, 4)
	make("UIStroke", { Thickness = 2, Color = d.VictimColor or Color3.new(1, 1, 1) }, vc)
	local kids = {}
	for _, c in ipairs(feed:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(kids, c)
		end
	end
	table.sort(kids, function(a, b)
		return a.LayoutOrder > b.LayoutOrder
	end)
	if #kids > 6 then
		kids[1]:Destroy()
	end
	task.delay(7, function()
		if row.Parent then
			row:Destroy()
		end
	end)
	if d.VictimPlayer == player then
		myStreak = 0
		streakFrame.Visible = false
		HUD.DeathCard(d)
	end
end

-- 내가 당했을 때: [처치자 이름] + 총 그림(텍스트 대신 3D 이미지) + 헤드샷 표시 + 부활 카운트다운
local deathCard = nil
function HUD.DeathCard(d)
	if deathCard then
		deathCard:Destroy()
	end
	local parent = elimGui or gui
	local c = make("Frame", { Size = UDim2.fromOffset(400, 150), Position = UDim2.new(0.5, -200, 0.26, 0), BackgroundColor3 = DARKP, BackgroundTransparency = 0.1 }, parent)
	deathCard = c
	corner(c, 16)
	make("UIStroke", { Thickness = 3, Color = d.KillerColor or Color3.fromRGB(255, 80, 110) }, c)
	UI.Icon(c, "skull", "", { Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(16, 7) })
	text(c, { Size = UDim2.new(1, -60, 0, 26), Position = UDim2.fromOffset(50, 8), Text = "스플래시 당했다!", Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.fromRGB(255, 120, 150), TextXAlignment = Enum.TextXAlignment.Left })
	local who = make("Frame", { Size = UDim2.fromOffset(170, 36), Position = UDim2.fromOffset(16, 46), BackgroundColor3 = d.KillerColor or Color3.fromRGB(90, 90, 110) }, c)
	corner(who, 10)
	text(who, { Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4), Text = d.Killer or "낙사", Font = Enum.Font.GothamBlack, TextStrokeTransparency = 0.6,
		TextTruncate = Enum.TextTruncate.AtEnd })
	local pic = make("Frame", { Size = UDim2.fromOffset(190, 80), Position = UDim2.fromOffset(196, 40), BackgroundColor3 = Color3.fromRGB(240, 240, 248) }, c)
	corner(pic, 12)
	make("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 192, 210)), Rotation = 90 }, pic)
	if d.WeaponId then
		UI.GunImage(pic, d.WeaponId, d.KillerColor or Color3.fromRGB(60, 60, 70))
	else
		text(pic, { Size = UDim2.fromScale(1, 1), Text = "", TextStrokeTransparency = 1 })
	end
	if d.Head then
		local hb = make("Frame", { Size = UDim2.fromOffset(84, 26), Position = UDim2.new(1, -90, 0, 4), BackgroundColor3 = Color3.fromRGB(255, 200, 40), ZIndex = 3 }, pic)
		corner(hb, 8)
		UI.Icon(hb, "target", "", { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(4, 3), ZIndex = 4 })
		text(hb, { Size = UDim2.new(1, -30, 1, -6), Position = UDim2.fromOffset(26, 3), Text = "헤드샷", TextColor3 = Color3.fromRGB(60, 30, 0),
			TextStrokeTransparency = 1, Font = Enum.Font.GothamBlack, ZIndex = 4 })
	end
	local cd = text(c, { Size = UDim2.fromOffset(170, 30), Position = UDim2.fromOffset(16, 90), Text = "", Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(210, 210, 230) })
	task.spawn(function()
		for t = Config.RespawnTime, 1, -1 do
			if not c.Parent then
				return
			end
			cd.Text = t .. "초 후 부활"
			task.wait(1)
		end
		if c.Parent then
			c:Destroy()
		end
	end)
end

-- 내가 처치했을 때: 화면 가운데 '제거됨' 배너 + 보상 줄 + 연속 처치 불꽃
local MULTI = { [2] = "더블 킬", [3] = "트리플 킬", [4] = "쿼드 킬", [5] = "펜타 킬" }
function HUD.Elim(d)
	myStreak = d.Streak or (myStreak + 1)
	for _, c in ipairs(elimFrame:GetChildren()) do
		c:Destroy()
	end
	elimFrame.Visible = true
	local y = 0
	local m = (d.Multi or 1) >= 2 and (MULTI[math.min(d.Multi, 5)] or (d.Multi .. "연속 킬")) or nil
	if m then
		local mc = make("Frame", { Size = UDim2.fromOffset(110, 28), Position = UDim2.new(0.5, -55, 0, 0), BackgroundColor3 = Color3.fromRGB(255, 70, 120) }, elimFrame)
		corner(mc, 8)
		text(mc, { Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), Text = m, TextStrokeTransparency = 1, Font = Enum.Font.GothamBlack })
		y = 32
	end
	local big = text(elimFrame, { Size = UDim2.new(1, 0, 0, 58), Position = UDim2.fromOffset(0, y), Text = "제거됨", Font = Enum.Font.FredokaOne,
		TextStrokeTransparency = 1 })
	make("UIStroke", { Thickness = 4, Color = Color3.fromRGB(230, 40, 110) }, big)
	for _, side in ipairs({ -1, 1 }) do
		text(elimFrame, { Size = UDim2.fromOffset(70, 44), Position = UDim2.new(0.5, side * 150 - 35, 0, y + 8), Text = "///", Font = Enum.Font.GothamBlack,
			TextColor3 = Color3.fromRGB(255, 70, 120), TextStrokeTransparency = 1 })
	end
	text(elimFrame, { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, y + 60), Text = "" .. tostring(d.Victim), Font = Enum.Font.GothamBlack,
		TextColor3 = d.VictimColor or Color3.fromRGB(255, 120, 160), TextStrokeTransparency = 0.6 })
	local scale = make("UIScale", { Scale = 1.35 }, elimFrame)
	TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local token = {}
	HUD._elimToken = token
	task.delay(2.2, function()
		if HUD._elimToken == token then
			elimFrame.Visible = false
		end
	end)
	-- 보상 줄
	local line = make("Frame", { Size = UDim2.new(0, 0, 0, 26), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
		LayoutOrder = -math.floor(os.clock() * 100) }, rewardList)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder }, line)
	UI.Icon(line, d.Head and "target" or "skull", d.Head and "" or "", { Size = UDim2.fromOffset(24, 24), LayoutOrder = 1 })
	local lt = text(line, { Size = UDim2.new(0, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.X, Text = string.format("%s%s 제거", d.Head and "헤드샷! " or "",
		tostring(d.Victim)), Font = Enum.Font.GothamBlack, TextScaled = false, TextSize = 19, LayoutOrder = 2 })
	UI.Icon(line, "coin", "", { Size = UDim2.fromOffset(22, 22), LayoutOrder = 3 })
	text(line, { Size = UDim2.new(0, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.X, Text = string.format("+%d  ·  +%d XP", d.Coins or 0, d.XP or 0),
		Font = Enum.Font.GothamBlack, TextScaled = false, TextSize = 19, TextColor3 = Color3.fromRGB(255, 220, 90), LayoutOrder = 4 })
	task.delay(3, function()
		if line.Parent then
			line:Destroy()
		end
	end)
	local n = 0
	for _, c in ipairs(rewardList:GetChildren()) do
		if c:IsA("Frame") then
			n = n + 1
		end
	end
	if n > 3 then
		local oldest, ol = nil, math.huge
		for _, c in ipairs(rewardList:GetChildren()) do
			if c:IsA("Frame") and -c.LayoutOrder < ol then
				oldest, ol = c, -c.LayoutOrder
			end
		end
		if oldest then
			oldest:Destroy()
		end
	end
	-- 연속 처치 불꽃
	streakFrame.Visible = myStreak >= 2
	streakLbl.Text = "x" .. myStreak
	if myStreak >= 2 then
		local sc = streakFrame:FindFirstChildOfClass("UIScale") or make("UIScale", {}, streakFrame)
		sc.Scale = 1.4
		TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
end

-- 상단 TOP 5 초상화 (플레이어는 Roblox 얼굴 사진, 봇은 팀 색 카드)
local function thumb(userId, img)
	if thumbCache[userId] then
		img.Image = thumbCache[userId]
		return
	end
	task.spawn(function()
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		end)
		if ok and url then
			thumbCache[userId] = url
			if img.Parent then
				img.Image = url
			end
		end
	end)
end

function HUD.RenderBoard(board)
	local sig = ""
	for _, b in ipairs(board) do
		sig = sig .. b.Name .. b.Kills .. (b.Streak or 0) .. tostring(b.OwnerId)
	end
	if sig == boardSig then
		return
	end
	boardSig = sig
	for _, c in ipairs(portraits:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, b in ipairs(board) do
		local cardF = make("Frame", { Size = UDim2.fromOffset(72, 100), BackgroundTransparency = 1, LayoutOrder = i }, portraits)
		text(cardF, { Size = UDim2.new(1, 0, 0, 26), Text = tostring(b.Kills), Font = Enum.Font.FredokaOne })
		local pic = make("Frame", { Size = UDim2.fromOffset(68, 68), Position = UDim2.fromOffset(2, 28), BackgroundColor3 = b.Color }, cardF)
		corner(pic, 10)
		make("UIStroke", { Thickness = 3, Color = (i == 1) and Color3.fromRGB(255, 210, 60) or Color3.new(1, 1, 1) }, pic)
		make("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 170)), Rotation = 90 }, pic)
		if b.UserId then
			local img = make("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Crop }, pic)
			corner(img, 10)
			thumb(b.UserId, img)
		else
			text(pic, { Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.15, 0.1), Text = string.upper(string.sub(b.Name, 1, 1)),
				Font = Enum.Font.FredokaOne })
			text(pic, { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -16), Text = "BOT", Font = Enum.Font.GothamBlack, TextStrokeTransparency = 0.4 })
		end
		text(cardF, { Size = UDim2.fromOffset(34, 22), Position = UDim2.new(1, -30, 1, -20), Text = "#" .. i, Font = Enum.Font.FredokaOne, ZIndex = 3,
			TextColor3 = (i == 1) and Color3.fromRGB(255, 220, 80) or Color3.new(1, 1, 1) })
		if i == 1 then
			UI.Icon(cardF, "crown", "", { Size = UDim2.fromOffset(32, 30), Position = UDim2.fromOffset(-10, 12), ZIndex = 3, Rotation = -20 })
		end
		if (b.Streak or 0) >= 3 then
			UI.Icon(cardF, "flame", "", { Size = UDim2.fromOffset(20, 20), Position = UDim2.new(0, -6, 1, -22), ZIndex = 3 })
			text(cardF, { Size = UDim2.fromOffset(24, 20), Position = UDim2.new(0, 12, 1, -22), Text = tostring(b.Streak), ZIndex = 3, Font = Enum.Font.GothamBlack })
		end
	end
end

-- 왼쪽 위 퀘스트 카드 (미완료 우선 3개)
function HUD.UpdateQuests()
	if not questBox then
		return
	end
	local ok, list = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute("Quests") or "[]")
	end)
	if not ok or type(list) ~= "table" then
		return
	end
	table.sort(list, function(a, b)
		if a.Done ~= b.Done then
			return not a.Done
		end
		if a.Period ~= b.Period then
			return a.Period == "Daily"
		end
		return (a.P / math.max(1, a.Goal)) > (b.P / math.max(1, b.Goal))
	end)
	for _, c in ipairs(questBox:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i = 1, math.min(3, #list) do
		local q = list[i]
		local cardF = make("Frame", { Size = UDim2.fromOffset(380, 58), BackgroundColor3 = DARKP, BackgroundTransparency = 0.2, LayoutOrder = i }, questBox)
		corner(cardF, 10)
		UI.Icon(cardF, q.Done and "check" or "quest", q.Done and "" or "", { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(8, 9) })
		text(cardF, { Size = UDim2.new(1, -170, 0, 20), Position = UDim2.fromOffset(54, 8), Text = string.format("[%s] %s", q.Period == "Daily" and "일일" or "주간", q.Name),
			Font = Enum.Font.GothamBlack, TextScaled = false, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextStrokeTransparency = 1 })
		text(cardF, { Size = UDim2.fromOffset(100, 18), Position = UDim2.new(1, -184, 0, 9), Text = string.format("%d / %d", q.P, q.Goal), TextScaled = false,
			TextSize = 14, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right, TextStrokeTransparency = 1 })
		local bar = make("Frame", { Size = UDim2.new(1, -150, 0, 7), Position = UDim2.fromOffset(54, 36), BackgroundColor3 = Color3.fromRGB(60, 58, 82) }, cardF)
		corner(bar, 4)
		local fill = make("Frame", { Size = UDim2.fromScale(math.clamp(q.P / math.max(1, q.Goal), 0, 1), 1),
			BackgroundColor3 = q.Done and Color3.fromRGB(120, 255, 170) or Color3.fromRGB(80, 210, 255), BorderSizePixel = 0 }, bar)
		corner(fill, 4)
		UI.Icon(cardF, "coin", "", { Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -90, 0.5, -12) })
		text(cardF, { Size = UDim2.fromOffset(56, 26), Position = UDim2.new(1, -62, 0.5, -13), Text = "+" .. q.Reward, Font = Enum.Font.GothamBlack,
			TextColor3 = Color3.fromRGB(255, 220, 90), TextXAlignment = Enum.TextXAlignment.Left })
	end
end
player:GetAttributeChangedSignal("Quests"):Connect(function()
	HUD.UpdateQuests()
end)

-- 무기 카드 그림 (무기·스킨·황금총이 바뀔 때)
function HUD.RefreshWeaponCard()
	if not weaponCard then
		return
	end
	for _, c in ipairs(weaponCard.Pic:GetChildren()) do
		c:Destroy()
	end
	local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
	if player:GetAttribute("Golden") then
		UI.ModelImage(weaponCard.Pic, ModelKit.Item("Golden"), UDim2.fromScale(1, 1))
	else
		UI.GunImage(weaponCard.Pic, player:GetAttribute("Weapon") or "Pistol", player:GetAttribute("TeamColor"), Cosmetics.ById[player:GetAttribute("Skin") or ""])
	end
end
for _, a in ipairs({ "Weapon", "Skin", "Golden", "TeamColor" }) do
	player:GetAttributeChangedSignal(a):Connect(function()
		HUD.RefreshWeaponCard()
	end)
end
-- 경기 중엔 채팅창을 왼쪽 가운데로 (왼쪽 아래는 조작키 안내), 로비에선 왼쪽 아래
player:GetAttributeChangedSignal("InMatch"):Connect(function()
	local cfg = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
	if cfg then
		cfg.VerticalAlignment = player:GetAttribute("InMatch") and Enum.VerticalAlignment.Center or Enum.VerticalAlignment.Bottom
	end
	if not player:GetAttribute("InMatch") then
		if leaveConfirm and leaveConfirm.Visible then
			leaveModal(false)
		end
		HUD.ForceHide()
	end
	if player:GetAttribute("InMatch") then
		myStreak = 0
		if streakFrame then
			streakFrame.Visible = false
		end
		HUD.RefreshWeaponCard()
		HUD.UpdateQuests()
	end
end)

-- 첫 경기 안내 (온보딩)
local TIPS = {
	"바닥을 우리 색으로 칠하세요 — 칠한 면적이 곧 점수!",
	"우리 색 위에서는 빨라지고 잉크가 빨리 차요. 적 색 위에서는 느려져요",
	"상자 뒤에서 C로 앉으면 숨을 수 있어요 · 우클릭 조준",
	"V 키로 1인칭 <-> 3인칭(어깨 시점) 전환",
	"많이 칠하면 스페셜이 차요 — Q로 크로마 봄 투척!",
	"노란 미션이 뜨면 팀 보너스 기회! 마지막 30초는 페인트 1.5배",
}
function HUD.ShowTips()
	local card = make("Frame", { Size = UDim2.new(0, 560, 0, 46), Position = UDim2.new(0.5, -280, 1, -150), BackgroundColor3 = Color3.fromRGB(10, 10, 16),
		BackgroundTransparency = 0.2 }, gui)
	corner(card, 12)
	make("UIStroke", { Thickness = 2, Color = player:GetAttribute("TeamColor") or Color3.new(1, 1, 1) }, card)
	local t = text(card, { Size = UDim2.new(1, -24, 1, -12), Position = UDim2.new(0, 12, 0, 6), Font = Enum.Font.GothamBold, TextStrokeTransparency = 1 })
	task.spawn(function()
		task.wait(1.5)
		for _, tip in ipairs(TIPS) do
			if not card.Parent or not player:GetAttribute("InMatch") then
				break
			end
			t.Text = tip
			task.wait(5)
		end
		card:Destroy()
	end)
end

-- 결과창: 팀 vs 상대 (각 팀 안에서 점수 → 처치 → 데스 적은 순). 솔로는 한 표
local RCOLS = { { "#", 34 }, { "플레이어", 160 }, { "처치", 52 }, { "데스", 52 }, { "점수", 70 }, { "코인", 56 }, { "레이팅", 58 } }
local function resultRow(parent, y, values, color, bold, width)
	local x = 0
	local scale = width / 482
	for i, c in ipairs(RCOLS) do
		local w = c[2] * scale
		local t = text(parent, { Size = UDim2.fromOffset(w - 4, 24), Position = UDim2.fromOffset(x + 2, y), Text = values[i], TextScaled = false, TextSize = 16,
			Font = bold and Enum.Font.GothamBlack or Enum.Font.GothamBold, TextColor3 = color or Color3.new(1, 1, 1), TextStrokeTransparency = 0.7, ZIndex = 12,
			TextXAlignment = (i == 2) and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
		x = x + w
	end
end

local function sortRows(list)
	table.sort(list, function(a, b)
		if (a.Score or 0) ~= (b.Score or 0) then
			return (a.Score or 0) > (b.Score or 0)
		end
		if a.Kills ~= b.Kills then
			return a.Kills > b.Kills
		end
		return a.Deaths < b.Deaths
	end)
	return list
end

local function teamTable(parent, x, width, title, color, scoreText, rows)
	local box = make("Frame", { Size = UDim2.new(0, width, 1, -150), Position = UDim2.fromOffset(x, 112), BackgroundColor3 = Color3.fromRGB(28, 26, 42),
		ZIndex = 11 }, parent)
	corner(box, 12)
	make("UIStroke", { Color = color, Thickness = 2 }, box)
	local head = make("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = color, ZIndex = 11 }, box)
	corner(head, 12)
	text(head, { Size = UDim2.new(0.68, -12, 1, -8), Position = UDim2.fromOffset(12, 4), Text = title, TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(16, 14, 24), TextStrokeTransparency = 1, ZIndex = 12 })
	text(head, { Size = UDim2.new(0.32, -12, 1, -8), Position = UDim2.new(0.68, 0, 0, 4), Text = scoreText, TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Color3.fromRGB(16, 14, 24), TextStrokeTransparency = 1, ZIndex = 12 })
	resultRow(box, 48, { "#", "플레이어", "처치", "데스", "점수", "코인", "레이팅" }, Color3.fromRGB(170, 170, 195), false, width)
	make("Frame", { Size = UDim2.new(1, -16, 0, 1), Position = UDim2.fromOffset(8, 75), BackgroundColor3 = Color3.fromRGB(80, 78, 110), BorderSizePixel = 0,
		ZIndex = 12 }, box)
	for i, row in ipairs(rows) do
		if i > 10 then
			break
		end
		local y = 52 + i * 30
		if row.Player == player then
			local hl = make("Frame", { Size = UDim2.new(1, -8, 0, 28), Position = UDim2.fromOffset(4, y - 2), BackgroundColor3 = color, BackgroundTransparency = 0.6,
				ZIndex = 11 }, box)
			corner(hl, 6)
		end
		local rating = row.RatingDelta and string.format("%+d", row.RatingDelta) or "-"
		local name = (i == 1 and "MVP " or "") .. row.Name .. (row.IsBot and " (봇)" or "")
		resultRow(box, y, { tostring(i), name, tostring(row.Kills), tostring(row.Deaths), tostring(row.Score or row.Cells), tostring(row.Coins), rating },
			(row.Player == player) and Color3.new(1, 1, 1) or Color3.fromRGB(225, 225, 240), row.Player == player, width)
	end
end

function HUD.ShowResults(r)
	for _, c in ipairs(results:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	results.Visible = true
	gui.Enabled = true
	local head = r.WinnerName and (r.WinnerName .. " 승리!") or "무승부!"
	local mine = player:GetAttribute("OwnerId")
	local won = false
	for _, row in ipairs(r.Rows) do
		if row.Player == player then
			won = row.Won
		end
	end
	text(results, { Size = UDim2.new(1, -40, 0, 50), Position = UDim2.new(0, 20, 0, 14), Text = head,
		TextColor3 = r.WinnerColor or Color3.new(1, 1, 1), ZIndex = 11 })
	text(results, { Size = UDim2.new(1, -40, 0, 26), Position = UDim2.new(0, 20, 0, 66), Text = won and "VICTORY" or "다음 판엔 이길 수 있어요!",
		Font = Enum.Font.GothamBold, TextColor3 = won and Color3.fromRGB(255, 215, 60) or Color3.fromRGB(200, 200, 220), ZIndex = 11 })
	local unit = (r.Mode == "Flag") and "점" or "%"
	if r.Mode == "Solo" then
		local t = r.Teams[1]
		teamTable(results, 20, 960, "솔로 순위", Color3.fromRGB(255, 200, 60), t and string.format("1위 %.1f%s", t.Score, unit) or "", sortRows(r.Rows))
	else
		-- 왼쪽 = 우리 팀, 오른쪽 = 상대 팀
		local teams = {}
		for _, t in ipairs(r.Teams) do
			table.insert(teams, t)
		end
		table.sort(teams, function(a, b)
			return (a.OwnerId == mine) and b.OwnerId ~= mine
		end)
		for i, t in ipairs(teams) do
			if i > 2 then
				break
			end
			local rows = {}
			for _, row in ipairs(r.Rows) do
				if row.OwnerId == t.OwnerId then
					table.insert(rows, row)
				end
			end
			local title = (i == 1 and mine == t.OwnerId) and ("우리 팀 · " .. t.Name) or ((mine and i == 2) and ("상대 팀 · " .. t.Name) or t.Name)
			local st = (r.Mode == "Flag") and string.format("%.0f점", t.Score)
				or string.format("%.1f점 (페인트 %.1f%% · 처치 %d)", t.Score, t.Coverage or 0, t.Kills or 0)
			teamTable(results, 20 + (i - 1) * 490, 470, title, t.Color, st, sortRows(rows))
		end
		text(results, { Size = UDim2.fromOffset(40, 40), Position = UDim2.new(0.5, -20, 0, 112), Text = "VS", ZIndex = 13, TextColor3 = Color3.fromRGB(255, 255, 255) })
	end
	text(results, { Size = UDim2.new(1, -40, 0, 20), Position = UDim2.new(0, 20, 1, -32), Font = Enum.Font.Gotham, ZIndex = 11, TextScaled = false, TextSize = 15,
		TextColor3 = Color3.fromRGB(160, 160, 180), Text = (r.Ranked and "랭크전 · " or "일반전 · 레이팅 변동 없음 · ") .. (r.Mode == "Flag" and "깃발 점수로 승패" or "승패 = 페인트 면적 80% + 처치·미션 20%") .. " · 개인 점수 = 칠한 셀 + 처치×30" })
	task.delay(Config.ResultsTime, function()
		results.Visible = false
	end)
end

-- 스폰 지점 무기 교체 바 갱신 (SpawnZone · Owned · Weapon 속성이 바뀔 때)
function HUD.UpdateSwitch()
	if not switchBar then
		return
	end
	local show = player:GetAttribute("InMatch") and player:GetAttribute("SpawnZone")
	switchBar.Visible = show == true
	if not show then
		return
	end
	for _, c in ipairs(switchBar:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	text(switchBar, { Size = UDim2.fromOffset(150, 40), Text = "무기 교체", Font = Enum.Font.GothamBlack, LayoutOrder = 0, TextScaled = false, TextSize = 18 })
	local ownedStr = "," .. (player:GetAttribute("Owned") or "") .. ","
	local cur = player:GetAttribute("Weapon")
	local k = 0
	for i, w in ipairs(Weapons.List) do
		if string.find(ownedStr, "," .. w.Id .. ",", 1, true) and ModelKit.HasStoreModel(w.Id) and k < 9 then
			k = k + 1
			local on = (w.Id == cur)
			local chip = make("Frame", { Size = UDim2.fromOffset(112, 40), BackgroundColor3 = on and (player:GetAttribute("TeamColor") or Color3.new(1, 1, 1))
				or Color3.fromRGB(44, 42, 62), LayoutOrder = i }, switchBar)
			corner(chip, 8)
			text(chip, { Size = UDim2.new(1, -8, 1, -6), Position = UDim2.fromOffset(4, 3), Text = string.format("[%d] %s", k, w.StoreModel and w.Name or w.Class), TextScaled = false,
				TextSize = 16, Font = Enum.Font.GothamBold, TextColor3 = on and Color3.fromRGB(16, 14, 24) or Color3.new(1, 1, 1), TextStrokeTransparency = 1 })
		end
	end
	text(switchBar, { Size = UDim2.fromOffset(70, 40), Text = "T 다음", Font = Enum.Font.GothamBold, LayoutOrder = 99, TextScaled = false, TextSize = 15,
		TextColor3 = Color3.fromRGB(200, 200, 220) })
end

-- 아이템 카드 [F]: 맨 앞 아이템 그림 + 이름 + 남은 개수 (G로 순서 바꾸기)
function HUD.UpdateItems()
	if not itemCard then
		return
	end
	local list = {}
	for x in string.gmatch(player:GetAttribute("Items") or "", "[^,]+") do
		table.insert(list, x)
	end
	for _, c in ipairs(itemCard.Pic:GetChildren()) do
		c:Destroy()
	end
	local id = list[1]
	if id then
		UI.ModelImage(itemCard.Pic, ModelKit.Item(id, player:GetAttribute("TeamColor")), UDim2.fromScale(1, 1), math.rad(35))
		itemCard.Name.Text = ((ITEM_DEF[id] and ITEM_DEF[id].Name) or id) .. ((#list > 1) and ("  +" .. (#list - 1)) or "")
		itemCard.Name.TextColor3 = Color3.fromRGB(255, 225, 100)
	else
		text(itemCard.Pic, { Size = UDim2.fromScale(1, 1), Text = "", TextTransparency = 0.6, TextStrokeTransparency = 1 })
		itemCard.Name.Text = "미션 보상"
		itemCard.Name.TextColor3 = Color3.fromRGB(170, 170, 190)
	end
end

-- 새 아이템 획득 카드 (화면 가운데 아래, 2.5초)
function HUD.ItemToast(id)
	local def = ITEM_DEF[id]
	if not def then
		return
	end
	if toast then
		toast:Destroy()
	end
	local notifyGui = player.PlayerGui:FindFirstChild("SplashNotify")
	toast = make("Frame", { Size = UDim2.fromOffset(380, 110), Position = UDim2.new(0.5, -190, 0.68, 0), BackgroundColor3 = Color3.fromRGB(20, 16, 34),
		BackgroundTransparency = 0.05 }, notifyGui)
	corner(toast, 16)
	make("UIStroke", { Thickness = 3, Color = Color3.fromRGB(255, 210, 70) }, toast)
	local pic = make("Frame", { Size = UDim2.fromOffset(94, 94), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = Color3.fromRGB(50, 44, 80) }, toast)
	corner(pic, 12)
	UI.ModelImage(pic, ModelKit.Item(id, player:GetAttribute("TeamColor")), UDim2.fromScale(1, 1), math.rad(35))
	text(toast, { Size = UDim2.new(1, -120, 0, 34), Position = UDim2.fromOffset(112, 12), Text = "획득! " .. def.Name, TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 220, 80) })
	text(toast, { Size = UDim2.new(1, -120, 0, 44), Position = UDim2.fromOffset(112, 50), Text = def.Desc, TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = false, TextSize = 14, TextWrapped = true, Font = Enum.Font.GothamBold, TextStrokeTransparency = 1 })
	local me = toast
	me.Size = UDim2.fromOffset(40, 110)
	TweenService:Create(me, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(380, 110) }):Play()
	task.delay(2.6, function()
		if me.Parent then
			me:Destroy()
		end
	end)
end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">ItemClient</string><ProtectedString name="Source"><![CDATA[-- 미션 보상 아이템 (클라이언트): F 사용 · G 순서 바꾸기 · 제트팩 추진(Space) · 연막탄 조준점
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local SoundBank = require(script.Parent:WaitForChild("SoundBank"))

local player = Players.LocalPlayer
local ItemClient = {}

local remotes, HUD
local lastJetSound = 0

local function aimPoint()
	local cam = workspace.CurrentCamera
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, workspace:FindFirstChild("ClientFX"), workspace:FindFirstChild("PaintLayer") }
	local hit = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 75, params)
	return hit and hit.Position or (cam.CFrame.Position + cam.CFrame.LookVector * 75)
end

local function items()
	local s = player:GetAttribute("Items") or ""
	local out = {}
	for x in string.gmatch(s, "[^,]+") do
		table.insert(out, x)
	end
	return out
end

local function useItem()
	if not player:GetAttribute("InMatch") then
		return
	end
	local list = items()
	if #list == 0 then
		HUD.Banner("아이템이 없어요 — 미션을 성공하면 받아요", Color3.fromRGB(200, 200, 220))
		return
	end
	remotes.UseItem:FireServer("use", aimPoint())
	SoundBank.Play("ui_buy", nil, 0.5)
end

local function onAction(name, state)
	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end
	if name == "SF_UseItem" then
		useItem()
	elseif name == "SF_CycleItem" then
		remotes.UseItem:FireServer("cycle")
	end
	return Enum.ContextActionResult.Sink
end

function ItemClient.Init(remoteFolder, hud)
	remotes = remoteFolder
	HUD = hud
	local function bind()
		if player:GetAttribute("InMatch") then
			ContextActionService:BindAction("SF_UseItem", onAction, true, Enum.KeyCode.F, Enum.KeyCode.ButtonX)
			ContextActionService:BindAction("SF_CycleItem", onAction, false, Enum.KeyCode.G, Enum.KeyCode.DPadRight)
			ContextActionService:SetTitle("SF_UseItem", "아이템")
			ContextActionService:SetPosition("SF_UseItem", UDim2.new(1, -170, 1, -300))
		else
			ContextActionService:UnbindAction("SF_UseItem")
			ContextActionService:UnbindAction("SF_CycleItem")
		end
	end
	player:GetAttributeChangedSignal("InMatch"):Connect(bind)
	bind()

	-- 새 아이템 획득 연출
	player:GetAttributeChangedSignal("LastItem"):Connect(function()
		local v = player:GetAttribute("LastItem")
		local id = v and string.match(v, "^(%w+):")
		if id then
			HUD.ItemToast(id)
		end
	end)
	for _, a in ipairs({ "Items", "JetpackUntil", "ShieldUntil", "ZoomBuff", "Golden" }) do
		player:GetAttributeChangedSignal(a):Connect(function()
			HUD.UpdateItems()
		end)
	end

	-- 제트팩: 효과 시간 동안 Space(모바일은 점프 버튼)를 누르고 있으면 상승
	RunService.Heartbeat:Connect(function(dt)
		local untilT = player:GetAttribute("JetpackUntil")
		if not untilT or workspace:GetServerTimeNow() > untilT then
			return
		end
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum or hum.Health <= 0 then
			return
		end
		local thrusting = UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA)
			or (UserInputService.TouchEnabled and hum.Jump)
		if thrusting then
			local v = root.AssemblyLinearVelocity
			local up = math.min(v.Y + (workspace.Gravity + Config.JetpackThrust) * dt, Config.JetpackMaxRise)
			root.AssemblyLinearVelocity = Vector3.new(v.X, up, v.Z)
			if hum:GetState() ~= Enum.HumanoidStateType.Freefall and hum:GetState() ~= Enum.HumanoidStateType.Jumping then
				hum:ChangeState(Enum.HumanoidStateType.Freefall)
			end
			if os.clock() - lastJetSound > 0.35 then
				lastJetSound = os.clock()
				SoundBank.Play("zipline_ride", root.Position, 0.35, 1.6)
			end
		end
	end)
	HUD.UpdateItems()
end

return ItemClient
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">LobbyUI</string><ProtectedString name="Source"><![CDATA[-- 로비 UI: 프로필 · 접속자 목록(왼쪽) · 매치 참가(오른쪽 아래) · 상점 · 랭킹 TOP 50 · 크레이트 개봉 연출
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")
local ModelKit = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("ModelKit"))
local PolicyService = game:GetService("PolicyService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Weapons = require(ReplicatedStorage.Shared.Weapons)
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
local SoundBank = require(script.Parent:WaitForChild("SoundBank"))
local UI = require(script.Parent:WaitForChild("UIKit"))

local player = Players.LocalPlayer
local Lobby = {}
local C = UI.Colors
local make, corner, label, button = UI.make, UI.corner, UI.label, UI.button

local remotes, HUD
local gui, profileLbl, matchFrame, matchBody, statusLbl, shop, pages, tabButtons, reveal, board, boardList, peopleList, questPanel, questList
local HttpService = game:GetService("HttpService")
local lastState = nil
local matchSig, peopleSig = "", ""
local randomItemsRestricted = false
local modalHandler = function() end

local TIER_COLOR = {
	["브론즈"] = Color3.fromRGB(205, 127, 50), ["실버"] = Color3.fromRGB(200, 205, 215), ["골드"] = Color3.fromRGB(255, 205, 60),
	["플래티넘"] = Color3.fromRGB(90, 230, 210), ["다이아몬드"] = Color3.fromRGB(110, 170, 255), ["크로마 마스터"] = Color3.fromRGB(255, 80, 200),
}

local function owned(attr, id)
	local s = player:GetAttribute(attr) or ""
	for x in string.gmatch(s, "[^,]+") do
		if x == id then
			return true
		end
	end
	return false
end

local function shopCall(action, id)
	local ok, res = pcall(function()
		return remotes.Shop:InvokeServer(action, id)
	end)
	if ok and res then
		HUD.Banner(res.msg, res.ok and Color3.fromRGB(120, 255, 160) or Color3.fromRGB(255, 120, 120))
		SoundBank.Play(res.ok and (action == "buy" and "ui_buy" or "ui_click") or "ui_error", nil, 0.6)
	end
	return ok and res
end

local function clear(page)
	for _, c in ipairs(page:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

local function updateModal()
	modalHandler((shop and shop.Visible) or (board and board.Visible) or (reveal and reveal.Visible) or (questPanel and questPanel.Visible) or false)
end

------------------------------------------------------------------------
-- 상점 페이지
------------------------------------------------------------------------
local function buildWeapons(page)
	clear(page)
	local coins = player:GetAttribute("Coins") or 0
	local equipped = player:GetAttribute("Weapon")
	for i, w in ipairs(Weapons.List) do
		if ModelKit.HasStoreModel(w.Id) then -- 상점 총 모델이 없으면 표시 안 함
		local row = make("Frame", { Size = UDim2.new(1, -10, 0, 112), BackgroundColor3 = C.Panel, LayoutOrder = i }, page)
		corner(row, 14)
		if equipped == w.Id then
			UI.stroke(row, C.Cyan, 2)
		end
		local img = make("Frame", { Size = UDim2.fromOffset(170, 96), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = C.Panel2 }, row)
		corner(img, 12)
		UI.gradient(img, Color3.fromRGB(70, 66, 110), Color3.fromRGB(34, 32, 54), 90)
		UI.GunImage(img, w.Id, C.Cyan, Cosmetics.ById[player:GetAttribute("Skin") or ""])
		label(row, { Text = w.Name, Font = Enum.Font.GothamBlack, TextSize = 26, Position = UDim2.fromOffset(194, 10), Size = UDim2.new(1, -380, 0, 30) })
		label(row, { Text = w.Class, TextSize = 18, TextColor3 = C.Gold, Position = UDim2.fromOffset(194, 42), Size = UDim2.new(1, -380, 0, 22) })
		label(row, { Text = string.format("피해 %s · 연사 %.2f초 · 사거리 %d · 페인트 %s", w.Pellets > 1 and (w.Damage .. "×" .. w.Pellets) or tostring(w.Damage),
			w.FireInterval, w.Range, tostring(w.PaintRadius)), Position = UDim2.fromOffset(194, 70), Size = UDim2.new(1, -380, 0, 22),
			TextSize = 17, TextColor3 = C.Sub, Font = Enum.Font.GothamMedium })
		local isOwned = owned("Owned", w.Id)
		local text, color
		if equipped == w.Id then
			text, color = "장착 중", C.Dim
		elseif isOwned then
			text, color = "장착", C.Green
		else
			text = string.format("%d", w.Price)
			color = coins >= w.Price and C.Pink or Color3.fromRGB(90, 60, 80)
		end
		local b = button(row, text, color, { Size = UDim2.fromOffset(160, 52), Position = UDim2.new(1, -176, 0.5, -26), TextSize = 22 })
		b.MouseButton1Click:Connect(function()
			if equipped == w.Id then
				return
			end
			shopCall(isOwned and "equip" or "buy", w.Id)
			task.wait(0.2)
			buildWeapons(page)
		end)
		end
	end
end

local function buildCrate(page)
	clear(page)
	local top = make("Frame", { Size = UDim2.new(1, -10, 0, 150), BackgroundColor3 = C.Panel, LayoutOrder = 1 }, page)
	corner(top, 14)
	UI.gradient(top, Color3.fromRGB(90, 50, 140), Color3.fromRGB(30, 28, 48), 0)
	label(top, { Text = "크로마 크레이트", TextSize = 30, Font = Enum.Font.FredokaOne, Position = UDim2.fromOffset(18, 12), Size = UDim2.new(0.62, 0, 0, 36) })
	label(top, { Text = "무기 스킨 · 페인트 패턴 · 처치 이펙트 중 1개 (외형 전용, 능력치 변화 없음)", TextSize = 17, Font = Enum.Font.GothamMedium,
		TextColor3 = C.Sub, Position = UDim2.fromOffset(18, 54), Size = UDim2.new(0.64, 0, 0, 22), TextWrapped = true })
	local pity = player:GetAttribute("CratePity") or 0
	label(top, { Text = string.format("천장 %d / %d — %d회 안에 레전더리 확정", pity, Cosmetics.PityCount, Cosmetics.PityCount - pity), TextSize = 17,
		TextColor3 = C.Gold, Position = UDim2.fromOffset(18, 84), Size = UDim2.new(0.64, 0, 0, 22) })
	if randomItemsRestricted then
		label(top, { Text = "이 계정/지역에서는 유료 랜덤 상자를 이용할 수 없어요.", TextColor3 = Color3.fromRGB(255, 140, 140), TextSize = 17,
			Position = UDim2.fromOffset(18, 114), Size = UDim2.new(0.9, 0, 0, 22) })
	else
		local buy = button(top, Cosmetics.CratePrice .. " R$  개봉", Color3.fromRGB(255, 190, 40),
			{ Size = UDim2.fromOffset(210, 56), Position = UDim2.new(1, -226, 0, 16), TextColor3 = Color3.fromRGB(40, 20, 0), TextSize = 24 })
		buy.MouseButton1Click:Connect(function()
			local id = Config.Monetization.CrateProductId
			if id == 0 then
				HUD.Banner("Config.Monetization.CrateProductId에 개발자 상품 ID를 넣어주세요", Color3.fromRGB(255, 200, 80))
				return
			end
			MarketplaceService:PromptProductPurchase(player, id)
		end)
		if RunService:IsStudio() then
			local test = button(top, "Studio 테스트 개봉", C.Dim, { Size = UDim2.fromOffset(210, 42), Position = UDim2.new(1, -226, 0, 84), TextSize = 17 })
			test.MouseButton1Click:Connect(function()
				shopCall("crateTest")
			end)
		end
	end

	-- 확률 공개표 (아이템 이미지 카드)
	local order = 2
	for _, r in ipairs(Cosmetics.Rarities) do
		local head = make("Frame", { Size = UDim2.new(1, -10, 0, 40), BackgroundColor3 = r.Color, LayoutOrder = order }, page)
		corner(head, 10)
		label(head, { Text = string.format("%s  %d%%   (중복 시 %d 코인 환급)", r.Name, r.Chance, r.Refund), Font = Enum.Font.GothamBlack, TextSize = 20,
			Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0), TextColor3 = Color3.fromRGB(15, 15, 20) })
		order = order + 1
		local grid = make("Frame", { Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order }, page)
		make("UIGridLayout", { CellSize = UDim2.fromOffset(176, 176), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		order = order + 1
		for _, item in ipairs(Cosmetics.ByRarity[r.Id]) do
			local kindName = (item.Kind == "Skin" and "무기 스킨") or (item.Kind == "Pattern" and "페인트 패턴") or "처치 이펙트"
			local have = owned("OwnedCosmetics", item.Id)
			local card = make("Frame", { BackgroundColor3 = C.Panel }, grid)
			corner(card, 12)
			UI.stroke(card, r.Color, 2, have and 0 or 0.5)
			local pic = make("Frame", { Size = UDim2.new(1, -16, 0, 96), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = C.Panel2 }, card)
			corner(pic, 10)
			UI.gradient(pic, r.Color:Lerp(Color3.new(0, 0, 0), 0.55), Color3.fromRGB(26, 24, 40), 90)
			UI.ItemImage(pic, item)
			label(card, { Text = item.Name, TextSize = 18, Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(10, 108), Size = UDim2.new(1, -20, 0, 22),
				TextTruncate = Enum.TextTruncate.AtEnd })
			label(card, { Text = kindName .. (have and "  · 보유" or ""), TextSize = 15, TextColor3 = have and Color3.fromRGB(140, 255, 170) or C.Sub,
				Position = UDim2.fromOffset(10, 130), Size = UDim2.new(1, -20, 0, 18) })
			label(card, { Text = string.format("%.2f%%", Cosmetics.ItemChance(item)), TextSize = 15, Font = Enum.Font.Code, TextColor3 = r.Color,
				Position = UDim2.fromOffset(10, 150), Size = UDim2.new(1, -20, 0, 18) })
		end
	end
end

local function buildCollection(page)
	clear(page)
	local slots = { Skin = "Skin", Pattern = "Pattern", Effect = "KillEffect" }
	local kinds = { { "Skin", "무기 스킨" }, { "Pattern", "페인트 패턴" }, { "Effect", "처치 이펙트" } }
	local order = 1
	local any = false
	-- 보유 무기 (상점에서 산 총은 계속 남아 있고 여기서 바로 장착)
	label(page, { Text = "보유 무기", TextSize = 24, Font = Enum.Font.GothamBlack, Size = UDim2.new(1, -10, 0, 34), LayoutOrder = order })
	order = order + 1
	local wgrid = make("Frame", { Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order }, page)
	make("UIGridLayout", { CellSize = UDim2.fromOffset(190, 150), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, wgrid)
	order = order + 1
	local equippedW = player:GetAttribute("Weapon")
	for i, w in ipairs(Weapons.List) do
		if owned("Owned", w.Id) then
			local cardF = make("Frame", { BackgroundColor3 = C.Panel, LayoutOrder = i }, wgrid)
			corner(cardF, 12)
			UI.stroke(cardF, (equippedW == w.Id) and C.Cyan or C.Dim, 2, (equippedW == w.Id) and 0 or 0.5)
			local pic = make("Frame", { Size = UDim2.new(1, -16, 0, 70), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = C.Panel2 }, cardF)
			corner(pic, 10)
			UI.GunImage(pic, w.Id, C.Cyan, Cosmetics.ById[player:GetAttribute("Skin") or ""])
			label(cardF, { Text = w.Name, TextSize = 16, Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(10, 80), Size = UDim2.new(1, -20, 0, 20),
				TextTruncate = Enum.TextTruncate.AtEnd })
			local b = button(cardF, (equippedW == w.Id) and "장착 중" or "장착", (equippedW == w.Id) and C.Dim or C.Green,
				{ Size = UDim2.new(1, -16, 0, 36), Position = UDim2.new(0, 8, 1, -42), TextSize = 17 })
			b.MouseButton1Click:Connect(function()
				if equippedW ~= w.Id then
					shopCall("equip", w.Id)
					task.wait(0.2)
					buildCollection(page)
				end
			end)
		end
	end
	for _, k in ipairs(kinds) do
		label(page, { Text = k[2], TextSize = 24, Font = Enum.Font.GothamBlack, Size = UDim2.new(1, -10, 0, 34), LayoutOrder = order })
		order = order + 1
		for _, item in ipairs(Cosmetics.Items) do
			if item.Kind == k[1] and owned("OwnedCosmetics", item.Id) then
				any = true
				local r = Cosmetics.Rarity(item.Rarity)
				local equipped = player:GetAttribute(slots[item.Kind]) == item.Id
				local row = make("Frame", { Size = UDim2.new(1, -10, 0, 76), BackgroundColor3 = C.Panel, LayoutOrder = order }, page)
				corner(row, 12)
				UI.stroke(row, r.Color, 2, equipped and 0 or 0.6)
				local pic = make("Frame", { Size = UDim2.fromOffset(100, 60), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = C.Panel2 }, row)
				corner(pic, 10)
				UI.ItemImage(pic, item)
				label(row, { Text = item.Name, TextSize = 22, Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(122, 10), Size = UDim2.new(1, -280, 0, 28) })
				label(row, { Text = r.Name, TextSize = 17, TextColor3 = r.Color, Position = UDim2.fromOffset(122, 40), Size = UDim2.new(1, -280, 0, 22) })
				local b = button(row, equipped and "해제" or "장착", equipped and C.Dim or C.Green,
					{ Size = UDim2.fromOffset(130, 46), Position = UDim2.new(1, -146, 0.5, -23), TextSize = 20 })
				b.MouseButton1Click:Connect(function()
					shopCall("equipCosmetic", item.Id)
					task.wait(0.2)
					buildCollection(page)
				end)
				order = order + 1
			end
		end
	end
	if not any then
		label(page, { Text = "아직 보유한 외형이 없어요. 크로마 크레이트에서 얻을 수 있어요!", Size = UDim2.new(1, -10, 0, 40), LayoutOrder = 99,
			TextSize = 19, TextColor3 = C.Sub })
	end
end

-- 포인트(코인)로 사는 스킨: 크레이트 아이템을 등급별 가격으로 바로 구매
local function buildSkins(page)
	clear(page)
	local coins = player:GetAttribute("Coins") or 0
	label(page, { Text = string.format("보유 코인 %d  —  일일·주간 미션으로 모아서 원하는 스킨을 바로 구매하세요", coins), TextSize = 18, TextColor3 = C.Gold,
		Size = UDim2.new(1, -10, 0, 30), LayoutOrder = 0, TextWrapped = true })
	local order = 1
	for _, r in ipairs(Cosmetics.Rarities) do
		local price = Config.SkinPrices[r.Id]
		local head = make("Frame", { Size = UDim2.new(1, -10, 0, 40), BackgroundColor3 = r.Color, LayoutOrder = order }, page)
		corner(head, 10)
		label(head, { Text = string.format("%s  ·  %d", r.Name, price), Font = Enum.Font.GothamBlack, TextSize = 20, Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -28, 1, 0), TextColor3 = Color3.fromRGB(15, 15, 20) })
		order = order + 1
		local grid = make("Frame", { Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order }, page)
		make("UIGridLayout", { CellSize = UDim2.fromOffset(190, 220), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		order = order + 1
		for _, item in ipairs(Cosmetics.ByRarity[r.Id]) do
			local have = owned("OwnedCosmetics", item.Id)
			local kindName = (item.Kind == "Skin" and "무기 스킨") or (item.Kind == "Pattern" and "페인트 패턴") or "처치 이펙트"
			local cardF = make("Frame", { BackgroundColor3 = C.Panel }, grid)
			corner(cardF, 12)
			UI.stroke(cardF, r.Color, 2, have and 0 or 0.4)
			local pic = make("Frame", { Size = UDim2.new(1, -16, 0, 100), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = C.Panel2 }, cardF)
			corner(pic, 10)
			UI.gradient(pic, r.Color:Lerp(Color3.new(0, 0, 0), 0.5), Color3.fromRGB(26, 24, 40), 90)
			UI.ItemImage(pic, item)
			label(cardF, { Text = item.Name, TextSize = 18, Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(10, 112), Size = UDim2.new(1, -20, 0, 22),
				TextTruncate = Enum.TextTruncate.AtEnd })
			label(cardF, { Text = kindName, TextSize = 15, TextColor3 = C.Sub, Position = UDim2.fromOffset(10, 136), Size = UDim2.new(1, -20, 0, 18) })
			local can = coins >= price
			local b = button(cardF, have and "보유" or (price .. " 코인"), have and C.Dim or (can and C.Green or Color3.fromRGB(90, 60, 80)),
				{ Size = UDim2.new(1, -16, 0, 42), Position = UDim2.new(0, 8, 1, -50), TextSize = 19 })
			b.MouseButton1Click:Connect(function()
				if have then
					return
				end
				shopCall("buyCosmetic", item.Id)
				task.wait(0.25)
				buildSkins(page)
			end)
		end
	end
end

-- 로벅스 충전: VIP 게임패스 + 코인 팩 (가격은 Roblox에서 실시간으로 읽음)
local priceCache = {}
local function robuxPrice(id, infoType)
	local key = tostring(infoType) .. id
	if priceCache[key] then
		return priceCache[key]
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(id, infoType)
	end)
	local p = ok and info and info.PriceInRobux or nil
	priceCache[key] = p
	return p
end

local function buildRobux(page)
	clear(page)
	label(page, { Text = "로벅스로 VIP와 코인을 충전할 수 있어요 · 코인은 스킨 상점·무기 구매에 사용", TextSize = 18, TextColor3 = C.Sub,
		Size = UDim2.new(1, -10, 0, 28), LayoutOrder = 0 })
	local grid = make("Frame", { Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1 }, page)
	make("UIGridLayout", { CellSize = UDim2.fromOffset(190, 250), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	local M = Config.Monetization
	local items = {
		{ Kind = "Pass", Id = M.VipGamePassId, Title = "VIP", Sub = "코인 획득 1.25배 (영구)", Icon = "crown", Color = Color3.fromRGB(255, 180, 40) },
	}
	local packs = {}
	for id, coins in pairs(M.CoinProducts or {}) do
		table.insert(packs, { Id = id, Coins = coins })
	end
	table.sort(packs, function(a, b)
		return a.Coins < b.Coins
	end)
	for _, pk in ipairs(packs) do
		table.insert(items, { Kind = "Product", Id = pk.Id, Title = string.format("코인 %d", pk.Coins), Sub = (pk.Coins >= 3000 and "50% 보너스")
			or (pk.Coins >= 1200 and "20% 보너스") or "기본 팩", Icon = "coin", Color = C.Cyan })
	end
	for i, it in ipairs(items) do
		if it.Id and it.Id ~= 0 then
			local owned = it.Kind == "Pass" and player:GetAttribute("Vip")
			local cardF = make("Frame", { BackgroundColor3 = C.Panel, LayoutOrder = i }, grid)
			corner(cardF, 14)
			UI.stroke(cardF, it.Color, 2, 0.2)
			local pic = make("Frame", { Size = UDim2.new(1, -16, 0, 110), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = C.Panel2 }, cardF)
			corner(pic, 12)
			UI.gradient(pic, it.Color:Lerp(Color3.new(0, 0, 0), 0.35), Color3.fromRGB(26, 24, 40), 90)
			UI.Icon(pic, it.Icon, "", { Size = UDim2.fromOffset(88, 88), Position = UDim2.new(0.5, -44, 0.5, -44) })
			label(cardF, { Text = it.Title, TextSize = 22, Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(10, 124), Size = UDim2.new(1, -20, 0, 28),
				TextXAlignment = Enum.TextXAlignment.Center })
			label(cardF, { Text = it.Sub, TextSize = 15, TextColor3 = C.Sub, Position = UDim2.fromOffset(10, 154), Size = UDim2.new(1, -20, 0, 20),
				TextXAlignment = Enum.TextXAlignment.Center })
			local b = button(cardF, owned and "보유 중" or "...", owned and C.Dim or Color3.fromRGB(0, 176, 111),
				{ Size = UDim2.new(1, -16, 0, 46), Position = UDim2.new(0, 8, 1, -54), TextSize = 20 })
			if not owned then
				task.spawn(function()
					local price = robuxPrice(it.Id, it.Kind == "Pass" and Enum.InfoType.GamePass or Enum.InfoType.Product)
					if b.Parent then
						b.Text = price and (price .. " R$") or "구매"
					end
				end)
			end
			b.MouseButton1Click:Connect(function()
				if owned then
					return
				end
				if it.Kind == "Pass" then
					MarketplaceService:PromptGamePassPurchase(player, it.Id)
				else
					MarketplaceService:PromptProductPurchase(player, it.Id)
				end
			end)
		end
	end
end

local builders = { Weapons = buildWeapons, Skins = buildSkins, Crate = buildCrate, Collection = buildCollection, Robux = buildRobux }
local currentTab = "Weapons"

local function showTab(name)
	currentTab = name
	for n, p in pairs(pages) do
		p.Visible = (n == name)
	end
	for n, b in pairs(tabButtons) do
		b.BackgroundColor3 = (n == name) and C.Pink or C.Panel2
	end
	builders[name](pages[name])
end

local function toggleShop(force)
	local on = force
	if on == nil then
		on = not shop.Visible
	end
	if player:GetAttribute("InMatch") then
		on = false
	end
	shop.Visible = on
	if on then
		board.Visible = false
		questPanel.Visible = false
		remotes.Telemetry:FireServer("OpenedShop")
		showTab(currentTab)
	end
	updateModal()
end

------------------------------------------------------------------------
-- 일일·주간 미션 창
------------------------------------------------------------------------
local function fmtLeft(sec)
	sec = math.max(0, math.floor(sec or 0))
	local d = math.floor(sec / 86400)
	local h = math.floor((sec % 86400) / 3600)
	local m = math.floor((sec % 3600) / 60)
	if d > 0 then
		return string.format("%d일 %d시간", d, h)
	end
	return string.format("%d시간 %d분", h, m)
end

function Lobby.UpdateQuests()
	if not questList then
		return
	end
	local ok, list = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute("Quests") or "[]")
	end)
	if not ok or type(list) ~= "table" then
		return
	end
	clear(questList)
	local order = 0
	for _, period in ipairs({ "Daily", "Weekly" }) do
		local left = nil
		for _, q in ipairs(list) do
			if q.Period == period then
				left = q.Left
			end
		end
		order = order + 1
		label(questList, { Text = string.format("%s  ·  초기화까지 %s", period == "Daily" and "일일 미션" or "주간 미션", fmtLeft(left)), TextSize = 21,
			Font = Enum.Font.GothamBlack, Size = UDim2.new(1, -10, 0, 32), LayoutOrder = order })
		for _, q in ipairs(list) do
			if q.Period == period then
				order = order + 1
				local row = make("Frame", { Size = UDim2.new(1, -10, 0, 70), BackgroundColor3 = q.Done and Color3.fromRGB(34, 60, 50) or C.Panel, LayoutOrder = order }, questList)
				corner(row, 12)
				UI.stroke(row, q.Done and Color3.fromRGB(120, 255, 170) or C.Dim, 2, 0.3)
				UI.Icon(row, q.Done and "check" or "quest", "", { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(12, 15) })
				label(row, { Text = q.Name, TextSize = 20, Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(62, 10), Size = UDim2.new(1, -230, 0, 24) })
				local bar = make("Frame", { Size = UDim2.new(1, -230, 0, 10), Position = UDim2.fromOffset(62, 44), BackgroundColor3 = C.Dim }, row)
				corner(bar, 5)
				local fill = make("Frame", { Size = UDim2.fromScale(math.clamp(q.P / math.max(1, q.Goal), 0, 1), 1), BorderSizePixel = 0,
					BackgroundColor3 = q.Done and Color3.fromRGB(120, 255, 170) or C.Cyan }, bar)
				corner(fill, 5)
				label(row, { Text = string.format("%d / %d", q.P, q.Goal), TextSize = 16, TextColor3 = C.Sub, Position = UDim2.new(1, -164, 0, 10),
					Size = UDim2.fromOffset(70, 22), TextXAlignment = Enum.TextXAlignment.Right })
				label(row, { Text = (q.Done and "받음 " or "") .. "+" .. q.Reward .. " 코인", TextSize = 19, Font = Enum.Font.GothamBlack, TextColor3 = C.Gold,
					Position = UDim2.new(1, -150, 0, 34), Size = UDim2.fromOffset(136, 26), TextXAlignment = Enum.TextXAlignment.Right })
			end
		end
	end
end

local function openQuests()
	if player:GetAttribute("InMatch") then
		return
	end
	shop.Visible = false
	board.Visible = false
	questPanel.Visible = true
	Lobby.UpdateQuests()
	updateModal()
end

------------------------------------------------------------------------
-- 랭킹 TOP 50
------------------------------------------------------------------------
local COLS = { { "순위", 70 }, { "이름", 250 }, { "등급", 150 }, { "Rating", 110 }, { "승리", 90 } }
local function rowCells(parent, values, color, font, size)
	local x = 16
	for i, col in ipairs(COLS) do
		label(parent, { Text = values[i], Position = UDim2.fromOffset(x, 0), Size = UDim2.new(0, col[2] - 8, 1, 0), TextSize = size or 18,
			Font = font or Enum.Font.GothamBold, TextColor3 = (type(color) == "table" and color[i]) or color or C.Text,
			TextXAlignment = (i == 2) and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
		x = x + col[2]
	end
end

local function openBoard()
	if player:GetAttribute("InMatch") then
		return
	end
	shop.Visible = false
	questPanel.Visible = false
	board.Visible = true
	updateModal()
	clear(boardList)
	label(boardList, { Text = "불러오는 중...", Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.Sub })
	task.spawn(function()
		local ok, res = pcall(function()
			return remotes.Leaderboard:InvokeServer()
		end)
		clear(boardList)
		if not ok or not res then
			label(boardList, { Text = "랭킹을 불러오지 못했어요", Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center })
			return
		end
		for i, r in ipairs(res.Rows) do
			if i > 50 then
				break
			end
			local mine = r.UserId == player.UserId
			local row = make("Frame", { Size = UDim2.new(1, -8, 0, 40), BackgroundColor3 = mine and Color3.fromRGB(80, 40, 90) or ((i % 2 == 0) and C.Panel or C.Panel2),
				LayoutOrder = i }, boardList)
			corner(row, 8)
			if mine then
				UI.stroke(row, C.Pink, 2)
			end
			local medal = tostring(i)
			local tierColor = TIER_COLOR[r.Tier] or C.Text
			rowCells(row, { medal, r.Name, r.Tier, tostring(r.Rating), tostring(r.Wins or 0) }, { C.Gold, C.Text, tierColor, C.Cyan, C.Text })
		end
		if #res.Rows == 0 then
			label(boardList, { Text = "아직 랭크 기록이 없어요 — 랭크전에 참가해 보세요!", Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center })
		end
		if not res.Global then
			label(boardList, { Text = "(현재 서버 기준 · 게임을 게시하면 전체 랭킹이 표시돼요)", Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 999, TextSize = 15,
				TextColor3 = C.Sub, TextXAlignment = Enum.TextXAlignment.Center })
		end
	end)
end

------------------------------------------------------------------------
-- 크레이트 개봉 연출: 흔들림 → 등급 빛 폭발 → 회전하는 빛줄기 + 아이템 카드
------------------------------------------------------------------------
function Lobby.ShowCrate(res)
	reveal.Visible = true
	updateModal()
	clear(reveal)
	local item = Cosmetics.ById[res.ItemId] or { Kind = res.Kind, Name = res.Name }
	local box = make("Frame", { Size = UDim2.fromOffset(150, 150), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(70, 60, 110) }, reveal)
	corner(box, 22)
	UI.stroke(box, Color3.new(1, 1, 1), 4)
	UI.label(box, { Text = "?", TextScaled = true, Font = Enum.Font.FredokaOne, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	SoundBank.Play("crate_shake", nil, 0.7)
	for i = 1, 8 do
		box.Rotation = (i % 2 == 0) and 9 or -9
		task.wait(0.07)
	end
	box:Destroy()

	-- 빛줄기
	local rays = make("Frame", { Size = UDim2.fromOffset(900, 900), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1 }, reveal)
	for k = 0, 11 do
		local ray = make("Frame", { Size = UDim2.new(0, 70, 0.5, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 1),
			BackgroundColor3 = res.Color, BorderSizePixel = 0, Rotation = k * 30 }, rays)
		make("UIGradient", { Transparency = NumberSequence.new(1, 0.55), Rotation = 90 }, ray)
	end
	local spin
	spin = RunService.RenderStepped:Connect(function(dt)
		if not rays.Parent then
			spin:Disconnect()
			return
		end
		rays.Rotation = rays.Rotation + dt * 25
	end)
	SoundBank.Play("crate_" .. string.lower(res.Rarity), nil, 0.8)

	local card = make("Frame", { Size = UDim2.fromOffset(40, 50), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.Bg }, reveal)
	corner(card, 20)
	UI.stroke(card, res.Color, 5)
	TweenService:Create(card, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(340, 420) }):Play()
	local band = make("Frame", { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = res.Color }, card)
	corner(band, 20)
	make("Frame", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20), BackgroundColor3 = res.Color, BorderSizePixel = 0 }, band)
	label(band, { Text = res.RarityName .. "!", Font = Enum.Font.FredokaOne, TextScaled = true, Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5),
		TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(20, 16, 30) })
	local pic = make("Frame", { Size = UDim2.new(1, -32, 0, 200), Position = UDim2.fromOffset(16, 66), BackgroundColor3 = C.Panel2 }, card)
	corner(pic, 14)
	UI.gradient(pic, res.Color:Lerp(Color3.new(0, 0, 0), 0.4), Color3.fromRGB(20, 18, 32), 90)
	UI.ItemImage(pic, item)
	local kindName = (res.Kind == "Skin" and "무기 스킨") or (res.Kind == "Pattern" and "페인트 패턴") or "처치 이펙트"
	label(card, { Text = res.Name, Font = Enum.Font.GothamBlack, TextSize = 28, Position = UDim2.fromOffset(16, 276), Size = UDim2.new(1, -32, 0, 34),
		TextXAlignment = Enum.TextXAlignment.Center })
	local sub = kindName
	if res.Duplicate then
		sub = sub .. "  ·  중복 -> " .. res.Refund .. " 코인 환급"
	end
	if res.Pitied then
		sub = sub .. "  ·  천장 확정"
	end
	label(card, { Text = sub, TextSize = 17, TextColor3 = C.Sub, Position = UDim2.fromOffset(16, 312), Size = UDim2.new(1, -32, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true })
	local ok = button(card, "확인", C.Pink, { Size = UDim2.fromOffset(200, 52), Position = UDim2.new(0.5, -100, 1, -68), TextSize = 24 })
	ok.MouseButton1Click:Connect(function()
		reveal.Visible = false
		clear(reveal)
		updateModal()
		if shop.Visible then
			showTab(currentTab)
		end
	end)
end

------------------------------------------------------------------------
-- 매치 참가 (오른쪽 아래): 대기 중인 배틀만 목록 + 새 배틀 시작 + 방장 맵 선택
------------------------------------------------------------------------
local function queueTitle(q)
	local mode = Config.Modes[q.Mode]
	return (q.Mode == "Solo") and "솔로 페인트 로얄 8인" or string.format("%s %dvs%d", mode.Name, q.TeamSize, q.TeamSize)
end

local function rebuildMatch()
	local s = lastState
	local mine = player:GetAttribute("Queue")
	local counts = (s and s.QueueCounts) or {}
	local info = (s and s.QueueInfo) or {}
	local mySide = player:GetAttribute("QueueSide")
	local sig = tostring(mine) .. tostring(mySide) .. "|" .. (s and s.Phase or "")
	for _, q in ipairs(Config.Queues) do
		local qi = info[q.Id] or {}
		local sd = qi.Sides or {}
		sig = sig .. q.Id .. (counts[q.Id] or 0) .. tostring(qi.Host) .. tostring(qi.Map) .. tostring(sd[1]) .. tostring(sd[2])
	end
	if sig == matchSig then
		return
	end
	matchSig = sig
	clear(matchBody)
	local order = 0
	local function nextOrder()
		order = order + 1
		return order
	end

	label(matchBody, { Text = "대기 중인 배틀", TextSize = 17, TextColor3 = C.Sub, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = nextOrder() })
	local any = false
	for _, q in ipairs(Config.Queues) do
		local n = counts[q.Id] or 0
		if n > 0 or mine == q.Id then
			any = true
			local qi = info[q.Id] or {}
			local joined = mine == q.Id
			local b = button(matchBody, "", joined and C.Pink or C.Panel2, { Size = UDim2.new(1, 0, 0, 62), LayoutOrder = nextOrder(), Text = "" })
			label(b, { Text = queueTitle(q) .. (q.Ranked and "  [랭크]" or ""), Font = Enum.Font.GothamBlack, TextSize = 20, Position = UDim2.fromOffset(14, 6),
				Size = UDim2.new(1, -160, 0, 26) })
			label(b, { Text = string.format("%s  ·  %s", qi.Host or "-", qi.Map or "-"), TextSize = 15, TextColor3 = joined and Color3.new(1, 1, 1) or C.Sub,
				Position = UDim2.fromOffset(14, 34), Size = UDim2.new(1, -160, 0, 20), TextTruncate = Enum.TextTruncate.AtEnd })
			local sd = qi.Sides
			local countText = sd and string.format("A %d/%d · B %d/%d", sd[1] or 0, q.TeamSize, sd[2] or 0, q.TeamSize) or string.format("%d명 대기", n)
			label(b, { Text = countText, TextSize = 17, TextColor3 = C.Gold, Position = UDim2.new(1, -150, 0, 6), Size = UDim2.fromOffset(136, 24),
				TextXAlignment = Enum.TextXAlignment.Right })
			-- 대기 취소는 발판에서 내려오면 됨 (나가기 버튼 없음)
			local status = joined and ((mySide == 1 and "A존 대기 중") or (mySide == 2 and "B존 대기 중") or "대기 중") or "참가 >"
			label(b, { Text = status, TextSize = 16, Font = Enum.Font.GothamBlack, Position = UDim2.new(1, -150, 0, 34),
				Size = UDim2.fromOffset(136, 20), TextXAlignment = Enum.TextXAlignment.Right })
			if not joined then
				b.MouseButton1Click:Connect(function()
					remotes.Queue:FireServer(q.Id)
				end)
			end
		end
	end
	if not any then
		label(matchBody, { Text = "지금 대기 중인 배틀이 없어요 — 아래에서 새로 시작하세요", TextSize = 16, TextColor3 = C.Sub, TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 40), LayoutOrder = nextOrder() })
	end

	-- 방장 맵 선택
	if mine then
		local qi = info[mine] or {}
		if qi.HostId == player.UserId and s and s.Maps then
			label(matchBody, { Text = "방장 — 맵을 고르세요", TextSize = 17, TextColor3 = C.Gold, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = nextOrder() })
			local row = make("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, matchBody)
			make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, row)
			local opts = { { nil, "순환" }, { "random", "랜덤" } }
			for _, m in ipairs(s.Maps) do
				table.insert(opts, { m.Id, m.Name })
			end
			local w = 1 / #opts
			for _, o in ipairs(opts) do
				local sel = (qi.MapId == o[1])
				local mb = button(row, o[2], sel and C.Cyan or C.Panel2, { Size = UDim2.new(w, -6, 1, 0), TextSize = 15, TextWrapped = true })
				mb.MouseButton1Click:Connect(function()
					remotes.Queue:FireServer("map", o[1])
				end)
			end
			-- 정원이 다 모이면 카운트다운 없이 바로 시작
			local n = counts[mine] or 0
			if qi.Full then
				local go = button(matchBody, "> 바로 시작 (정원 " .. n .. "/" .. tostring(qi.Capacity) .. ")", C.Pink,
					{ Size = UDim2.new(1, 0, 0, 46), LayoutOrder = nextOrder(), TextSize = 19 })
				go.MouseButton1Click:Connect(function()
					remotes.Queue:FireServer("startNow")
				end)
			else
				label(matchBody, { Text = string.format("정원 %d / %d — 모두 모이면 '바로 시작' 버튼이 생겨요 (빈자리는 봇)", n, qi.Capacity or 0), TextSize = 15,
					TextColor3 = C.Sub, TextWrapped = true, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = nextOrder() })
			end
		end
	end

	label(matchBody, { Text = "새 배틀 시작", TextSize = 17, TextColor3 = C.Sub, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = nextOrder() })
	local grid = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextOrder() }, matchBody)
	make("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 44), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	for i, q in ipairs(Config.Queues) do
		local qb = button(grid, queueTitle(q), (mine == q.Id) and C.Pink or C.Panel, { TextSize = 15, LayoutOrder = i, TextWrapped = true })
		UI.stroke(qb, C.Dim, 1, 0.3)
		qb.MouseButton1Click:Connect(function()
			remotes.Queue:FireServer(q.Id)
		end)
	end
end

local function refreshStatus()
	local s = lastState
	local mine = player:GetAttribute("Queue")
	if not s then
		statusLbl.Text = ""
	elseif s.Phase == "Countdown" then
		local qi = s.QueueInfo and s.QueueInfo[s.QueueId] or {}
		statusLbl.Text = string.format("%s 시작까지 %d초 · 맵 %s", s.QueueId or "", math.max(0, math.ceil(s.EndsAt - workspace:GetServerTimeNow())), qi.Map or "")
	elseif s.Phase == "Playing" or s.Phase == "Results" then
		statusLbl.Text = "다른 경기 진행 중 — 대기하면 다음 판에 참가해요"
	else
		statusLbl.Text = mine and "참가자를 기다리는 중... 발판에서 내려오면 취소" or "발판을 밟거나 아래에서 배틀을 고르세요"
	end
end

------------------------------------------------------------------------
-- 접속자 목록 (왼쪽)
------------------------------------------------------------------------
local function rebuildPeople()
	local list = Players:GetPlayers()
	table.sort(list, function(a, b)
		return (a:GetAttribute("Rating") or 0) > (b:GetAttribute("Rating") or 0)
	end)
	local sig = ""
	for _, pl in ipairs(list) do
		sig = sig .. pl.UserId .. tostring(pl:GetAttribute("Rating")) .. tostring(pl:GetAttribute("Queue")) .. tostring(pl:GetAttribute("InMatch"))
	end
	if sig == peopleSig then
		return
	end
	peopleSig = sig
	clear(peopleList)
	peopleList.Parent:FindFirstChild("Title").Text = string.format("접속자 %d명", #list)
	for i, pl in ipairs(list) do
		local tier = pl:GetAttribute("Tier") or "브론즈"
		local status, sc
		if pl:GetAttribute("InMatch") then
			status, sc = "경기 중", Color3.fromRGB(255, 120, 120)
		elseif pl:GetAttribute("Queue") then
			status, sc = "대기 " .. tostring(pl:GetAttribute("Queue")), C.Gold
		else
			status, sc = "로비", Color3.fromRGB(140, 230, 170)
		end
		local row = make("Frame", { Size = UDim2.new(1, -6, 0, 46), BackgroundColor3 = (pl == player) and Color3.fromRGB(70, 40, 84) or C.Panel, LayoutOrder = i },
			peopleList)
		corner(row, 8)
		make("Frame", { Size = UDim2.new(0, 5, 1, -12), Position = UDim2.fromOffset(6, 6), BackgroundColor3 = TIER_COLOR[tier] or C.Text, BorderSizePixel = 0 }, row)
		label(row, { Text = pl.DisplayName, TextSize = 17, Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(18, 3), Size = UDim2.new(1, -110, 0, 22),
			TextTruncate = Enum.TextTruncate.AtEnd })
		label(row, { Text = string.format("%s · %d", tier, pl:GetAttribute("Rating") or Config.Rating.Start), TextSize = 14, TextColor3 = TIER_COLOR[tier] or C.Sub,
			Position = UDim2.fromOffset(18, 24), Size = UDim2.new(1, -110, 0, 18) })
		label(row, { Text = status, TextSize = 14, TextColor3 = sc, Position = UDim2.new(1, -100, 0, 0), Size = UDim2.new(0, 92, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Right })
	end
end

local function refreshProfile()
	local vip = player:GetAttribute("Vip") and "  ·  VIP" or ""
	local tier = player:GetAttribute("Tier") or "브론즈"
	profileLbl.Text = string.format('<font size="22"><b>%s</b></font>%s  <font color="#FFC850">Lv.%d</font>\n %d 코인\n <font color="#%s">%s</font>  %d  ·  %d승',
		player.DisplayName, vip, player:GetAttribute("Level") or 1, player:GetAttribute("Coins") or 0, (TIER_COLOR[tier] or C.Text):ToHex(), tier,
		player:GetAttribute("Rating") or Config.Rating.Start, player:GetAttribute("Wins") or 0)
end

function Lobby.OnState(s)
	lastState = s
	local inMatch = player:GetAttribute("InMatch") == true
	gui.Enabled = not inMatch
	if inMatch and (shop.Visible or board.Visible or questPanel.Visible) then
		shop.Visible = false
		board.Visible = false
		questPanel.Visible = false
		updateModal()
	end
	rebuildMatch()
	refreshStatus()
end

function Lobby.SetModalHandler(fn)
	modalHandler = fn
end

function Lobby.Init(remoteFolder, hud)
	remotes = remoteFolder
	HUD = hud
	task.spawn(function()
		pcall(function()
			local info = PolicyService:GetPolicyInfoForPlayerAsync(player)
			randomItemsRestricted = info.ArePaidRandomItemsRestricted
		end)
	end)

	gui = make("ScreenGui", { Name = "SplashLobby", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling },
		player:WaitForChild("PlayerGui"))

	-- 프로필 (왼쪽 위)
	local card = make("Frame", { Size = UDim2.fromOffset(300, 104), Position = UDim2.fromOffset(16, 16), BackgroundColor3 = C.Bg, BackgroundTransparency = 0.1 }, gui)
	corner(card, 14)
	UI.stroke(card, C.Pink, 2, 0.3)
	profileLbl = label(card, { Size = UDim2.new(1, -28, 1, -14), Position = UDim2.fromOffset(14, 7), TextYAlignment = Enum.TextYAlignment.Top, TextSize = 18,
		RichText = true })

	-- 아래 가운데 액션 독: [배틀 시작] [매치 선택] + 아이콘 타일 (무기·미션·상점·랭킹)
	local dock = make("Frame", { Name = "Dock", Size = UDim2.fromOffset(470, 178), Position = UDim2.new(0.5, 0, 1, -14), AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1 }, gui)
	local function bigButton(textStr, c1, c2, x)
		local b = button(dock, textStr, c1, { Size = UDim2.fromOffset(226, 58), Position = UDim2.fromOffset(x, 0), TextSize = 26 })
		UI.gradient(b, c1, c2, 90)
		UI.stroke(b, Color3.new(1, 1, 1), 2, 0.35)
		make("UIStroke", { Color = Color3.fromRGB(10, 10, 20), Thickness = 2, Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, b)
		b:SetAttribute("SFItalic", true)
		return b
	end
	local battleBtn = bigButton("배틀 시작", Color3.fromRGB(235, 70, 255), Color3.fromRGB(150, 40, 220), 4)
	local playBtn = bigButton("매치 선택", Color3.fromRGB(40, 235, 120), Color3.fromRGB(10, 170, 90), 240)
	battleBtn.MouseButton1Click:Connect(function()
		-- 빠른 참가: 자리가 남은 대기 중 팀전 → 없으면 3vs3
		local st = lastState or {}
		local counts = st.QueueCounts or {}
		local info = st.QueueInfo or {}
		local pick, best = nil, -1
		for _, q in ipairs(Config.Queues) do
			local n = counts[q.Id] or 0
			local qi = info[q.Id] or {}
			if q.Mode == "Turf" and n > best and not qi.Full then
				pick, best = q.Id, n
			end
		end
		if best <= 0 then
			pick = "3v3"
		end
		remotes.Queue:FireServer(pick)
	end)
	playBtn.MouseButton1Click:Connect(function()
		if matchFrame then
			matchFrame.Visible = not matchFrame.Visible
		end
	end)
	local tiles = {
		{ "무기", "target", function()
			currentTab = "Weapons"
			toggleShop(true)
		end, Color3.fromRGB(0, 200, 255) },
		{ "미션", "quest", function()
			openQuests()
		end, Color3.fromRGB(40, 235, 120) },
		{ "상점", "chest", function()
			currentTab = "Crate"
			toggleShop(true)
		end, Color3.fromRGB(255, 60, 200) },
		{ "랭킹", "trophy", function()
			openBoard()
		end, Color3.fromRGB(255, 200, 40) },
	}
	for i, t in ipairs(tiles) do
		local tile = make("TextButton", { Size = UDim2.fromOffset(104, 104), Position = UDim2.fromOffset(4 + (i - 1) * 118, 70), BackgroundColor3 = C.Bg,
			BackgroundTransparency = 0.15, Text = "", AutoButtonColor = false }, dock)
		corner(tile, 14)
		UI.stroke(tile, t[4], 2, 0.25)
		UI.gradient(tile, Color3.fromRGB(40, 50, 84), Color3.fromRGB(14, 18, 34), 90)
		UI.Icon(tile, t[2], "", { Size = UDim2.fromOffset(62, 62), Position = UDim2.new(0.5, -31, 0, 8) })
		local tl = label(tile, { Text = t[1], TextSize = 20, Font = Enum.Font.GothamBlack, Position = UDim2.new(0, 0, 1, -32), Size = UDim2.new(1, 0, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.4 })
		tl:SetAttribute("SFItalic", true)
		local sc = make("UIScale", { Scale = 1 }, tile)
		tile.MouseEnter:Connect(function()
			TweenService:Create(sc, TweenInfo.new(0.1), { Scale = 1.07 }):Play()
		end)
		tile.MouseLeave:Connect(function()
			TweenService:Create(sc, TweenInfo.new(0.1), { Scale = 1 }):Play()
		end)
		tile.MouseButton1Click:Connect(function()
			SoundBank.Play("ui_click", nil, 0.4)
			t[3]()
		end)
	end

	-- 접속자 목록 (왼쪽, 채팅창 위)
	local people = make("Frame", { Size = UDim2.new(0, 300, 1, -414), Position = UDim2.fromOffset(16, 128), BackgroundColor3 = C.Bg, BackgroundTransparency = 0.15 }, gui)
	corner(people, 14)
	make("UISizeConstraint", { MinSize = Vector2.new(300, 120) }, people)
	label(people, { Name = "Title", Text = "접속자", TextSize = 19, Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 0, 28) })
	peopleList = make("ScrollingFrame", { Size = UDim2.new(1, -16, 1, -44), Position = UDim2.fromOffset(8, 38), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 5, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, people)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5) }, peopleList)

	-- 매치 참가 (오른쪽 아래)
	-- 매치 패널: 오른쪽 가운데 (아래 가운데는 액션 독)
	matchFrame = make("Frame", { Size = UDim2.fromOffset(420, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(1, -16, 0.5, 20),
		AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = C.Bg, BackgroundTransparency = 0.08 }, gui)
	corner(matchFrame, 16)
	UI.stroke(matchFrame, C.Cyan, 2, 0.3)
	make("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 14), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }, matchFrame)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, matchFrame)
	label(matchFrame, { Text = "매치 참가", TextSize = 26, Font = Enum.Font.FredokaOne, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 1 })
	statusLbl = label(matchFrame, { Size = UDim2.new(1, 0, 0, 22), TextSize = 16, TextWrapped = true, TextColor3 = Color3.fromRGB(255, 220, 100), LayoutOrder = 2 })
	matchBody = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3 }, matchFrame)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, matchBody)

	-- 상점 창
	shop = UI.Panel(gui, "SPLASH SHOP", UDim2.fromOffset(860, 660), C.Pink)
	shop.Visible = false
	shop.ZIndex = 5
	UI.CloseButton(shop, function()
		toggleShop(false)
	end, 44)
	tabButtons = {}
	pages = {}
	local tabs = { { "Weapons", "무기" }, { "Skins", "스킨 상점" }, { "Crate", "크레이트" }, { "Collection", "컬렉션" }, { "Robux", "충전 · VIP" } }
	for i, t in ipairs(tabs) do
		local b = button(shop, t[2], C.Panel2, { Size = UDim2.fromOffset(156, 48), Position = UDim2.fromOffset(20 + (i - 1) * 164, 76), TextSize = 19 })
		b.MouseButton1Click:Connect(function()
			showTab(t[1])
		end)
		tabButtons[t[1]] = b
		local page = make("ScrollingFrame", { Size = UDim2.new(1, -32, 1, -150), Position = UDim2.fromOffset(16, 138), BackgroundTransparency = 1,
			ScrollBarThickness = 8, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, BorderSizePixel = 0 }, shop)
		make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }, page)
		pages[t[1]] = page
	end

	-- 랭킹 창
	board = UI.Panel(gui, "시즌 " .. Config.Season .. " 랭킹 TOP 50", UDim2.fromOffset(720, 660), Color3.fromRGB(230, 160, 20))
	board.Visible = false
	UI.CloseButton(board, function()
		board.Visible = false
		updateModal()
	end, 44)
	local header = make("Frame", { Size = UDim2.new(1, -32, 0, 36), Position = UDim2.fromOffset(16, 76), BackgroundColor3 = C.Panel2 }, board)
	corner(header, 8)
	rowCells(header, { "순위", "이름", "등급", "Rating", "승리" }, C.Sub, Enum.Font.GothamBlack, 17)
	boardList = make("ScrollingFrame", { Size = UDim2.new(1, -32, 1, -136), Position = UDim2.fromOffset(16, 120), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 8, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, board)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, boardList)

	-- 미션 창
	questPanel = UI.Panel(gui, "일일 · 주간 미션", UDim2.fromOffset(720, 640), C.Green)
	questPanel.Visible = false
	UI.CloseButton(questPanel, function()
		questPanel.Visible = false
		updateModal()
	end, 44)
	label(questPanel, { Text = "미션을 달성하면 코인이 자동으로 들어와요 · 코인으로 스킨 상점에서 원하는 스킨을 구매", TextSize = 16, TextColor3 = C.Sub,
		Position = UDim2.fromOffset(20, 72), Size = UDim2.new(1, -40, 0, 22) })
	questList = make("ScrollingFrame", { Size = UDim2.new(1, -32, 1, -120), Position = UDim2.fromOffset(16, 104), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 8, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, questPanel)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, questList)

	reveal = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 4, 14), BackgroundTransparency = 0.25, Visible = false, ZIndex = 20 }, gui)

	-- 로비 상점 부스(E) · 랭킹 보드 클릭
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt.Name == "SF_ShopPrompt" then
			toggleShop(true)
		end
	end)
	task.spawn(function()
		local lobbyFolder = workspace:WaitForChild("Lobby", 30)
		local lb = lobbyFolder and lobbyFolder:WaitForChild("Leaderboard", 30)
		local cd = lb and lb:WaitForChild("OpenBoard", 30)
		if cd then
			cd.MouseClick:Connect(function(who)
				if who == player then
					openBoard()
				end
			end)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.B then
			toggleShop()
		elseif input.KeyCode == Enum.KeyCode.Escape and (shop.Visible or board.Visible or questPanel.Visible) then
			shop.Visible = false
			board.Visible = false
			questPanel.Visible = false
			updateModal()
		end
	end)
	player:GetAttributeChangedSignal("Quests"):Connect(function()
		if questPanel.Visible then
			Lobby.UpdateQuests()
		end
	end)
	player:GetAttributeChangedSignal("QueueSide"):Connect(function()
		matchSig = nil
		rebuildMatch()
	end)
	player:GetAttributeChangedSignal("Vip"):Connect(function()
		if shop.Visible and currentTab == "Robux" then
			showTab("Robux")
		end
	end)
	for _, attr in ipairs({ "Coins", "Rating", "Tier", "Wins", "Vip", "Level" }) do
		player:GetAttributeChangedSignal(attr):Connect(refreshProfile)
	end
	player:GetAttributeChangedSignal("Queue"):Connect(function()
		rebuildMatch()
		refreshStatus()
	end)
	refreshProfile()
	rebuildMatch()
	task.spawn(function()
		while true do
			if gui.Enabled then
				refreshStatus()
				rebuildPeople()
			end
			task.wait(0.5)
		end
	end)
end

return Lobby
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">MapInteract</string><ProtectedString name="Source"><![CDATA[-- 맵 장치(클라이언트): 점프패드 발사, 집라인 탑승
-- 캐릭터 물리는 클라이언트 소유라서 플레이어 이동은 여기서 처리 (봇은 서버 MapBuilder가 처리)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local SoundBank = require(script.Parent:WaitForChild("SoundBank"))

local player = Players.LocalPlayer
local MapInteract = {}

local Effects
local lastPad = 0
local riding = nil -- { From, To, T, Len }
local rideSound = nil
local ZIP_SPEED = 48
local HANG = 3.5

local function rootAndHum()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

local function checkPads()
	if os.clock() - lastPad < 0.8 then
		return
	end
	local root, hum = rootAndHum()
	if not root or not hum or hum.Health <= 0 then
		return
	end
	for _, pad in ipairs(CollectionService:GetTagged("SF_JumpPad")) do
		local localPos = pad.CFrame:PointToObjectSpace(root.Position)
		if math.abs(localPos.X) < pad.Size.X / 2 + 0.5 and math.abs(localPos.Z) < pad.Size.Z / 2 + 0.5 and localPos.Y > 0 and localPos.Y < 5 then
			local launch = pad:GetAttribute("Launch")
			if launch then
				lastPad = os.clock()
				root.AssemblyLinearVelocity = launch
				hum:ChangeState(Enum.HumanoidStateType.Freefall)
				Effects.Splash(pad.Position + Vector3.new(0, 1, 0), pad.Color, 3)
				SoundBank.Play("jump_pad", nil, 0.8)
				return
			end
		end
	end
end

local function stopRide(jumpOff)
	if not riding then
		return
	end
	local root, hum = rootAndHum()
	local dir = (riding.To - riding.From).Unit
	riding = nil
	if rideSound then
		rideSound:Destroy()
		rideSound = nil
	end
	SoundBank.Play("land", nil, 0.5)
	if root then
		root.AssemblyLinearVelocity = dir * ZIP_SPEED * 0.6 + Vector3.new(0, jumpOff and 30 or 0, 0)
	end
	if hum then
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end
end

local function startRide(pole)
	local from, to = pole:GetAttribute("ZipFrom"), pole:GetAttribute("ZipTo")
	local root, hum = rootAndHum()
	if not from or not to or not root or not hum or hum.Health <= 0 or riding then
		return
	end
	riding = { From = from, To = to, T = 0, Len = (to - from).Magnitude }
	hum.PlatformStand = true
	SoundBank.Play("zipline_start", nil, 0.7)
	rideSound = SoundBank.Play("zipline_ride", nil, 0.45, 1, true)
end

local function updateRide(dt)
	if not riding then
		return
	end
	local root, hum = rootAndHum()
	if not root or not hum or hum.Health <= 0 then
		riding = nil
		if rideSound then
			rideSound:Destroy()
			rideSound = nil
		end
		return
	end
	riding.T = riding.T + (ZIP_SPEED * dt) / riding.Len
	if riding.T >= 1 then
		stopRide(false)
		return
	end
	local p = riding.From:Lerp(riding.To, riding.T) - Vector3.new(0, HANG, 0)
	-- 위치만 강제하고 회전은 그대로 → 1인칭으로 주변을 보며 공중에서 사격 가능
	root.CFrame = CFrame.new(p) * root.CFrame.Rotation
	root.AssemblyLinearVelocity = (riding.To - riding.From).Unit * ZIP_SPEED
end

-- 로비 진열대 총 회전 (Spin 속성 = 초당 각도). 서버는 그대로 두고 화면에서만 돌림
local spinners = {}
local function addSpinner(m)
	if m:IsA("Model") and m:GetAttribute("Spin") and not spinners[m] then
		spinners[m] = { Base = m:GetPivot(), Speed = m:GetAttribute("Spin"), T = math.random() * 10 }
	end
end
local function startSpinners()
	local lobby = workspace:WaitForChild("Lobby", 30)
	if not lobby then
		return
	end
	for _, d in ipairs(lobby:GetDescendants()) do
		addSpinner(d)
	end
	lobby.DescendantAdded:Connect(addSpinner)
	RunService.RenderStepped:Connect(function(dt)
		for m, sp in pairs(spinners) do
			if not m.Parent then
				spinners[m] = nil
			else
				sp.T = sp.T + dt
				m:PivotTo(sp.Base * CFrame.new(0, math.sin(sp.T * 1.6) * 0.35, 0) * CFrame.Angles(0, math.rad(sp.Speed * sp.T), 0))
			end
		end
	end)
end

function MapInteract.Init(effects)
	Effects = effects
	task.spawn(startSpinners)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player then
			return
		end
		local pole = prompt.Parent
		if pole and CollectionService:HasTag(pole, "SF_Zipline") then
			startRide(pole)
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and riding and (input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA) then
			stopRide(true) -- 스페이스로 중간에 뛰어내리기
		end
	end)
	player.CharacterAdded:Connect(function()
		riding = nil
		if rideSound then
			rideSound:Destroy()
			rideSound = nil
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		updateRide(dt)
		if not riding then
			checkPads()
		end
	end)
end

function MapInteract.IsRiding()
	return riding ~= nil
end

return MapInteract
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">MusicPlayer</string><ProtectedString name="Source"><![CDATA[-- 맵별 배경음악: 로비 → lobby, 크로마 스퀘어 → chroma, 스카이 루프탑 → sky, 결과 → victory/defeat 징글
-- 파이널 스플래시(마지막 30초)에는 템포를 올림. 음원 ID는 AssetIds.Music (업로드 전이면 무음)
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local AssetIds = require(ReplicatedStorage.Shared.AssetIds)

local player = Players.LocalPlayer
local MusicPlayer = {}

local MAP_TRACK = { ChromaSquare = "chroma", SkyRooftop = "sky" }
local loop, jingle
local current = nil
local jinglePlaying = false

local function idOf(track)
	local id = AssetIds.Music[track]
	if id and id ~= 0 then
		return "rbxassetid://" .. id
	end
	return nil
end

local function setTrack(track)
	if track == current then
		return
	end
	current = track
	local id = track and idOf(track)
	if not id then
		loop:Stop()
		return
	end
	-- 짧게 줄였다가 새 곡으로
	TweenService:Create(loop, TweenInfo.new(0.4), { Volume = 0 }):Play()
	task.delay(0.4, function()
		if current ~= track then
			return
		end
		loop.SoundId = id
		loop.TimePosition = 0
		loop:Play()
		TweenService:Create(loop, TweenInfo.new(0.6), { Volume = Config.Music.Volume }):Play()
	end)
end

function MusicPlayer.Init()
	loop = Instance.new("Sound")
	loop.Name = "SplashMusic"
	loop.Looped = true
	loop.Volume = Config.Music.Volume
	loop.Parent = SoundService
	jingle = Instance.new("Sound")
	jingle.Name = "SplashJingle"
	jingle.Volume = Config.Music.Volume + 0.2
	jingle.Parent = SoundService
	jingle.Ended:Connect(function()
		jinglePlaying = false
	end)
end

function MusicPlayer.OnState(s)
	if jinglePlaying then
		return
	end
	local inMatch = player:GetAttribute("InMatch") == true
	if inMatch and (s.Phase == "Playing" or s.Phase == "Results") then
		setTrack(MAP_TRACK[s.MapId] or "chroma")
	else
		setTrack("lobby")
	end
	loop.PlaybackSpeed = (inMatch and s.FinalSplash and s.Phase == "Playing") and Config.Music.FinalSplashSpeed or 1
end

-- 결과 화면: 승리/패배 징글 (음악은 잠깐 멈춤)
function MusicPlayer.PlayResult(won)
	local id = idOf(won and "victory" or "defeat")
	if not id then
		return
	end
	loop:Stop()
	current = nil
	jinglePlaying = true
	jingle.SoundId = id
	jingle:Play()
	task.delay(20, function()
		jinglePlaying = false
	end)
end

return MusicPlayer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">PaintVisual</string><ProtectedString name="Source"><![CDATA[-- 바닥 페인트 연출 (클라이언트 전용)
-- 서버의 바닥 셀(4스터드 격자)은 점수·이동속도 판정용으로 그대로 두고 화면에서는 숨김.
-- 대신 셀마다 셀보다 큰 둥근 페인트 방울을 무작위로 겹쳐 깔아 스플래툰처럼 번진 모양을 만들고,
-- 칠해질 때 '촥' 하고 퍼지는 애니메이션 + 주변 물방울을 뿌림
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Config = require(ReplicatedStorage.Shared.Config)

local PV = {}

local CELL = Config.CellSize
local NEUTRAL = Config.NeutralColor
local layer = nil
local conns = {}
local visuals = {}      -- cell -> { Blob, Drops = {} }
local pending = {}      -- cell -> true (같은 프레임의 색·주인 변경을 한 번에 처리)
local rng = Random.new()
local GROW = TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local DROP = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function disc(pos, d, color, material)
	local p = Instance.new("Part")
	p.Name = "Paint"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(0.05, d, d)
	p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	p.Color = color
	p.Material = material
	p.Reflectance = (material == Enum.Material.SmoothPlastic) and 0.12 or 0
	p.Parent = layer
	return p
end

local function paintMaterial(cell)
	-- 기본 '젖은 페인트'(Glass)는 바닥 위에서 투명해 보이므로 반짝이는 플라스틱으로, 패턴 재질은 그대로
	local m = cell.Material
	if m == Enum.Material.Glass then
		return Enum.Material.SmoothPlastic
	end
	return m
end

local function clearCell(cell)
	local v = visuals[cell]
	if v then
		v.Blob:Destroy()
		for _, d in ipairs(v.Drops) do
			d:Destroy()
		end
		visuals[cell] = nil
	end
end

local function paintCell(cell, animate)
	pending[cell] = nil
	if not cell.Parent then
		clearCell(cell)
		return
	end
	local owner = cell:GetAttribute("Owner") or 0
	if owner == 0 or cell.Color == NEUTRAL then
		clearCell(cell)
		return
	end
	local color, mat = cell.Color, paintMaterial(cell)
	local top = cell.Position + Vector3.new(0, cell.Size.Y / 2 + 0.02, 0)
	local v = visuals[cell]
	if not v then
		-- 셀보다 큰 원(1.4~1.9배)을 조금씩 어긋나게 → 이웃 방울과 겹쳐 둥글게 번진 경계
		local d = CELL * rng:NextNumber(1.4, 1.9)
		local jitter = Vector3.new(rng:NextNumber(-0.7, 0.7), rng:NextNumber(0, 0.03), rng:NextNumber(-0.7, 0.7))
		local blob = disc(top + jitter, animate and 0.4 or d, color, mat)
		v = { Blob = blob, Size = d, Drops = {} }
		visuals[cell] = v
		if animate then
			TweenService:Create(blob, GROW, { Size = Vector3.new(0.05, d, d) }):Play()
		end
		-- 가장자리에 흩뿌린 물방울
		if rng:NextNumber() < 0.35 then
			for _ = 1, rng:NextInteger(1, 2) do
				local a = rng:NextNumber() * math.pi * 2
				local r = CELL * rng:NextNumber(0.9, 1.5)
				local dd = rng:NextNumber(0.5, 1.3)
				local pos = top + Vector3.new(math.cos(a) * r, rng:NextNumber(0, 0.03), math.sin(a) * r)
				local drop = disc(animate and top or pos, dd, color, mat)
				if animate then
					drop.Size = Vector3.new(0.05, 0.2, 0.2)
					TweenService:Create(drop, DROP, { CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Size = Vector3.new(0.05, dd, dd) }):Play()
				end
				table.insert(v.Drops, drop)
			end
		end
	else
		-- 다른 색이 덮어 칠함: 색을 바꾸고 살짝 '퐁' 튀게
		v.Blob.Color = color
		v.Blob.Material = mat
		for _, d in ipairs(v.Drops) do
			d.Color = color
			d.Material = mat
		end
		if animate then
			local s = v.Size
			v.Blob.Size = Vector3.new(0.05, s * 0.6, s * 0.6)
			TweenService:Create(v.Blob, GROW, { Size = Vector3.new(0.05, s, s) }):Play()
		end
	end
end

local function queue(cell)
	if pending[cell] then
		return
	end
	pending[cell] = true
	task.defer(paintCell, cell, true)
end

local function bind(folder)
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	conns = {}
	for cell in pairs(visuals) do
		clearCell(cell)
	end
	if not folder then
		return
	end
	for _, cell in ipairs(folder:GetChildren()) do
		if cell:IsA("BasePart") then
			table.insert(conns, cell:GetAttributeChangedSignal("Owner"):Connect(function()
				queue(cell)
			end))
			table.insert(conns, cell:GetPropertyChangedSignal("Color"):Connect(function()
				queue(cell)
			end))
			if (cell:GetAttribute("Owner") or 0) ~= 0 then
				paintCell(cell, false)
			end
		end
	end
end

------------------------------------------------------------------------
-- 벽·엄폐물 페인트 자국: 총알이 벽·상자·컨테이너에 맞으면 둥근 자국 + 흘러내린 방울
-- (바닥 셀이 없는 곳에도 색이 묻어 맵 전체가 칠해지는 느낌. 판정·점수와는 무관)
------------------------------------------------------------------------
local walls = {}
local MAX_WALL = 900
local function isCharacter(inst)
	local m = inst:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") then
			return true
		end
		m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model")
	end
	return false
end

function PV.WallSplat(inst, pos, normal, color)
	if not layer or not inst or not inst:IsA("BasePart") or inst.Name == "Cell" or inst.Transparency > 0.8 then
		return
	end
	local lobby = workspace:FindFirstChild("Lobby")
	if (lobby and inst:IsDescendantOf(lobby)) or isCharacter(inst) then
		return
	end
	local active = ReplicatedStorage:FindFirstChild("ActiveCells")
	local mapRoot = active and active.Value and active.Value.Parent
	if mapRoot and not inst:IsDescendantOf(mapRoot) then
		return
	end
	local n = normal.Unit
	local up = (math.abs(n.Y) < 0.95) and Vector3.yAxis or Vector3.xAxis
	local vy = (up - n * up:Dot(n)).Unit
	local vz = n:Cross(vy)
	local d = rng:NextNumber(1.6, 3.2)
	local cf = CFrame.fromMatrix(pos + n * (0.03 + rng:NextNumber(0, 0.02)), n, vy, vz)
	local splat = disc(Vector3.zero, 0.3, color, Enum.Material.SmoothPlastic)
	splat.CFrame = cf
	TweenService:Create(splat, GROW, { Size = Vector3.new(0.05, d, d) }):Play()
	table.insert(walls, splat)
	-- 세로 벽이면 아래로 흘러내린 방울 1~2개
	if math.abs(n.Y) < 0.4 then
		for k = 1, rng:NextInteger(1, 2) do
			local dd = rng:NextNumber(0.4, 0.9)
			local drop = disc(Vector3.zero, dd, color, Enum.Material.SmoothPlastic)
			drop.CFrame = cf * CFrame.new(0.01, -(d * 0.45 + k * dd * 0.9), rng:NextNumber(-d * 0.25, d * 0.25))
			table.insert(walls, drop)
		end
	end
	while #walls > MAX_WALL do
		local old = table.remove(walls, 1)
		old:Destroy()
	end
end

local function clearWalls()
	for _, p in ipairs(walls) do
		p:Destroy()
	end
	walls = {}
end

function PV.Init()
	layer = Instance.new("Folder")
	layer.Name = "PaintLayer"
	layer.Parent = workspace
	local active = ReplicatedStorage:WaitForChild("ActiveCells")
	active.Changed:Connect(function()
		clearWalls()
		bind(active.Value)
	end)
	game:GetService("Players").LocalPlayer:GetAttributeChangedSignal("InMatch"):Connect(clearWalls)
	bind(active.Value)
end

return PV
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">SoundBank</string><ProtectedString name="Source"><![CDATA[-- 상황별 효과음 재생
-- 업로드 후: 효과음 37개가 든 아틀라스 1개(AssetIds.SfxAtlas)에서 PlaybackRegion으로 해당 구간만 재생
-- 업로드 전: Studio 기본음으로 대체
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AssetIds = require(ReplicatedStorage.Shared.AssetIds)

local SoundBank = {}

local PING = "rbxasset://sounds/electronicpingshort.wav"
local WATER = "rbxasset://sounds/impact_water.mp3"
local SWOOSH = "rbxasset://sounds/swoosh.wav"
local FALLBACK = {
	fire_pistol = { PING, 1.1 }, fire_rifle = { PING, 1.0 }, fire_smg = { PING, 1.3 }, fire_shotgun = { PING, 0.7 },
	fire_sniper = { PING, 0.55 }, fire_launcher = { PING, 0.5 }, low_ink = { PING, 2.0 },
	hit = { WATER, 1.1 }, hit_head = { WATER, 1.4 }, kill = { SWOOSH, 1.0 }, hurt = { WATER, 0.8 }, splashed = { SWOOSH, 0.8 },
	paint_land = { WATER, 1.2 }, jump_pad = { SWOOSH, 1.5 }, zipline_start = { PING, 0.8 }, respawn = { SWOOSH, 1.2 },
	special_throw = { SWOOSH, 1.0 }, special_boom = { WATER, 0.6 },
}

local function container(position)
	if not position then
		return SoundService, nil
	end
	local folder = workspace:FindFirstChild("ClientFX")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "ClientFX"
		folder.Parent = workspace
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(0.1, 0.1, 0.1)
	p.Position = position
	p.Parent = folder
	return p, p
end

-- name: atlas 이름(fire_rifle, hit_head …), position: 3D 위치(없으면 2D), volume 0~1, pitch 배속
function SoundBank.Play(name, position, volume, pitch, looped)
	local region = AssetIds.SfxRegions[name]
	local s = Instance.new("Sound")
	s.Volume = volume or 0.6
	s.PlaybackSpeed = pitch or 1
	local length = 2
	if AssetIds.SfxAtlas ~= 0 and region then
		s.SoundId = "rbxassetid://" .. AssetIds.SfxAtlas
		s.PlaybackRegionsEnabled = true
		s.PlaybackRegion = NumberRange.new(region[1], region[2])
		if looped then
			s.LoopRegion = NumberRange.new(region[1], region[2])
		end
		length = region[2] - region[1]
	else
		local fb = FALLBACK[name]
		if not fb then
			return nil
		end
		s.SoundId = fb[1]
		s.PlaybackSpeed = (pitch or 1) * fb[2]
	end
	s.Looped = looped == true
	s.RollOffMaxDistance = 160
	local parent, part = container(position)
	s.Parent = parent
	s:Play()
	if not looped then
		Debris:AddItem(part or s, length / s.PlaybackSpeed + 0.3)
	end
	return s
end

return SoundBank
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[-- 공용 UI 스타일: 패널·버튼·닫기 버튼·아이템 이미지(3D 미리보기)
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ModelKit = require(ReplicatedStorage.Shared.ModelKit)
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
local SoundBank = require(script.Parent:WaitForChild("SoundBank"))

local UI = {}

-- SF 톤: 짙은 남색 강철 + 네온 포인트 (로비 격납고와 같은 색)
UI.Colors = {
	Bg = Color3.fromRGB(12, 16, 30),
	Panel = Color3.fromRGB(22, 28, 50),
	Panel2 = Color3.fromRGB(34, 42, 72),
	Pink = Color3.fromRGB(255, 46, 170),
	Cyan = Color3.fromRGB(0, 200, 255),
	Gold = Color3.fromRGB(255, 200, 50),
	Green = Color3.fromRGB(0, 190, 150),
	Text = Color3.fromRGB(245, 245, 255),
	Sub = Color3.fromRGB(180, 178, 205),
	Dim = Color3.fromRGB(62, 74, 108),
	Neon = Color3.fromRGB(240, 255, 40),
}

-- 글꼴: 제목·버튼·숫자는 두꺼운 이탤릭 (하이퍼 FPS 느낌), 본문은 Gotham Bold
UI.Fonts = {
	Heavy = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic),
	Black = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Black, Enum.FontStyle.Italic),
}
local ITALIC_FONTS = { [Enum.Font.GothamBlack] = true, [Enum.Font.FredokaOne] = true, [Enum.Font.LuckiestGuy] = true }
local C = UI.Colors

function UI.make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local make = UI.make

function UI.corner(p, r)
	return make("UICorner", { CornerRadius = UDim.new(0, r or 10) }, p)
end

function UI.stroke(p, color, thick, transp)
	return make("UIStroke", { Color = color or Color3.new(1, 1, 1), Thickness = thick or 2, Transparency = transp or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
end

function UI.gradient(p, c1, c2, rot)
	return make("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 90 }, p)
end

function UI.label(parent, props)
	local t = make("TextLabel", { BackgroundTransparency = 1, TextColor3 = C.Text, Font = Enum.Font.GothamBold,
		TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Text = "" }, parent)
	for k, v in pairs(props or {}) do
		t[k] = v
	end
	return t
end

-- 둥근 버튼 (마우스를 올리면 살짝 커짐)
function UI.button(parent, text, color, props)
	local b = make("TextButton", { Text = text, BackgroundColor3 = color or C.Pink, TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBlack, TextSize = 18, AutoButtonColor = true }, parent)
	UI.corner(b, 10)
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	local scale = make("UIScale", { Scale = 1 }, b)
	b.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.08), { Scale = 1.04 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.08), { Scale = 1 }):Play()
	end)
	b.MouseButton1Click:Connect(function()
		SoundBank.Play("ui_click", nil, 0.4)
	end)
	return b
end

-- 닫기 버튼: 둥근 빨강-분홍 그라데이션 + 흰 X, 마우스를 올리면 회전
function UI.CloseButton(parent, onClose, size)
	size = size or 40
	local b = make("TextButton", { Size = UDim2.fromOffset(size, size), Position = UDim2.new(1, -size - 12, 0, 12), AnchorPoint = Vector2.new(0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1), Text = "", AutoButtonColor = false, ZIndex = 50 }, parent)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, b)
	UI.gradient(b, Color3.fromRGB(255, 80, 110), Color3.fromRGB(220, 30, 140), 45)
	UI.stroke(b, Color3.new(1, 1, 1), 2, 0.2)
	for _, rot in ipairs({ 45, -45 }) do
		make("Frame", { Size = UDim2.new(0.5, 0, 0, 4), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Rotation = rot, ZIndex = 51 }, b)
	end
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.15), { Rotation = 90 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.15), { Rotation = 0 }):Play()
	end)
	b.MouseButton1Click:Connect(function()
		SoundBank.Play("ui_click", nil, 0.4)
		if onClose then
			onClose()
		end
	end)
	return b
end

-- 제목 띠가 있는 패널 (SF: 남색 강철 판 + 네온 테두리 + 사선 줄무늬 제목 띠)
function UI.Panel(parent, title, size, accent)
	accent = accent or C.Pink
	local f = make("Frame", { Size = size, Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = C.Bg }, parent)
	UI.corner(f, 14)
	UI.stroke(f, accent, 2, 0.05)
	UI.gradient(f, Color3.fromRGB(26, 34, 60), Color3.fromRGB(10, 13, 26), 90)
	local head = make("Frame", { Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = accent, BorderSizePixel = 0, ClipsDescendants = true }, f)
	UI.corner(head, 14)
	make("Frame", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20), BackgroundColor3 = accent, BorderSizePixel = 0 }, head)
	UI.gradient(head, Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 175), 90)
	-- 사선 줄무늬 장식
	for k = 0, 6 do
		make("Frame", { Size = UDim2.fromOffset(14, 140), Position = UDim2.new(1, -60 - k * 26, 0, -30), Rotation = 28, BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.82, BorderSizePixel = 0 }, head)
	end
	-- 제목 아래 얇은 네온 선
	make("Frame", { Size = UDim2.new(1, -28, 0, 2), Position = UDim2.fromOffset(14, 66), BackgroundColor3 = C.Neon, BackgroundTransparency = 0.3,
		BorderSizePixel = 0 }, f)
	UI.label(head, { Text = title, FontFace = UI.Fonts.Black, TextSize = 32, Position = UDim2.fromOffset(22, 0), Size = UDim2.new(1, -90, 1, 0),
		TextStrokeTransparency = 0.5 })
	return f, head
end

-- 화면 전체 글꼴 정리: GothamBlack·FredokaOne(이전 카툰 글꼴)과 SFItalic 표시가 붙은 글자를 두꺼운 이탤릭으로
local function styleText(o)
	if not (o:IsA("TextLabel") or o:IsA("TextButton")) then
		return
	end
	if o:GetAttribute("SFItalic") or ITALIC_FONTS[o.Font] then
		o.FontFace = UI.Fonts.Heavy
	end
end
function UI.AutoStyle(root)
	for _, d in ipairs(root:GetDescendants()) do
		styleText(d)
	end
	root.DescendantAdded:Connect(function(d)
		-- 만든 직후 속성을 채우는 코드가 있으니 한 박자 뒤에 적용
		task.defer(styleText, d)
	end)
end

------------------------------------------------------------------------
-- 커스텀 아이콘 (업로드한 이미지). 아직 없으면 이모지로 보였다가 이미지가 준비되면 바뀜
------------------------------------------------------------------------
local images = ReplicatedStorage:WaitForChild("Images", 10)
function UI.Icon(parent, name, emoji, props)
	local holder = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(32, 32) }, parent)
	for k, v in pairs(props or {}) do
		holder[k] = v
	end
	local img = make("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit, Visible = false,
		ZIndex = holder.ZIndex }, holder)
	local txt = make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = emoji or "", TextScaled = true,
		Font = Enum.Font.GothamBlack, TextColor3 = Color3.new(1, 1, 1), ZIndex = holder.ZIndex }, holder)
	local function refresh()
		local url = images and images:GetAttribute("icon_" .. name)
		img.Image = url or ""
		img.Visible = url ~= nil
		txt.Visible = url == nil
	end
	refresh()
	if images then
		images:GetAttributeChangedSignal("icon_" .. name):Connect(refresh)
	end
	return holder
end

------------------------------------------------------------------------
-- 아이템 이미지: 총은 3D 미리보기(ViewportFrame), 패턴은 재질 견본, 이펙트는 아이콘
------------------------------------------------------------------------
local function viewportModel(parent, model, size, rotY)
	local vp = make("ViewportFrame", { Size = size or UDim2.fromScale(1, 1), BackgroundTransparency = 1, LightColor = Color3.new(1, 1, 1),
		Ambient = Color3.fromRGB(160, 160, 180), LightDirection = Vector3.new(-1, -1, -0.5) }, parent)
	local world = make("WorldModel", {}, vp)
	model:PivotTo(CFrame.Angles(0, rotY or math.rad(90), 0))
	model.Parent = world
	local cf, sz = model:GetBoundingBox()
	local cam = make("Camera", { FieldOfView = 30 }, vp)
	local dist = sz.Magnitude * 1.9
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, sz.Magnitude * 0.18, dist), cf.Position)
	vp.CurrentCamera = cam
	return vp
end

function UI.ModelImage(parent, model, size, rotY)
	return viewportModel(parent, model, size, rotY)
end

function UI.GunImage(parent, weaponId, accent, skin, size)
	local model = ModelKit.Gun(weaponId, accent or C.Cyan, skin, skin and Cosmetics.MaterialOf(skin.Material) or nil)
	return viewportModel(parent, model, size, math.rad(90))
end

function UI.ItemImage(parent, item, size)
	if item.Kind == "Skin" then
		return UI.GunImage(parent, "Rifle", Color3.fromRGB(255, 255, 255), item, size)
	end
	local holder = make("Frame", { Size = size or UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, parent)
	if item.Kind == "Pattern" then
		-- 재질 견본: 작은 바닥 셀 3×3을 3D로
		local m = Instance.new("Model")
		local cols = { C.Pink, C.Cyan, C.Gold }
		for x = -1, 1 do
			for z = -1, 1 do
				local p = Instance.new("Part")
				p.Anchored = true
				p.Size = Vector3.new(0.95, 0.2, 0.95)
				p.Position = Vector3.new(x, 0, z)
				p.Color = cols[((x + z) % 3) + 1]
				p.Material = Cosmetics.MaterialOf(item.Material) or Enum.Material.SmoothPlastic
				p.Parent = m
			end
		end
		local vp = viewportModel(holder, m, UDim2.fromScale(1, 1), 0)
		vp.CurrentCamera.CFrame = CFrame.lookAt(Vector3.new(0, 3.2, 2.4), Vector3.zero)
	else
		-- 처치 이펙트: 가운데 빛나는 구 + 사방으로 튀는 색 구슬
		local m = Instance.new("Model")
		local palette = (item.Effect == "Rainbow") and { Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 170, 40), Color3.fromRGB(255, 230, 60),
			Color3.fromRGB(80, 220, 90), Color3.fromRGB(60, 140, 255), Color3.fromRGB(170, 80, 255) }
			or (item.Effect == "Smoke") and { Color3.fromRGB(220, 222, 230), Color3.fromRGB(180, 184, 196) }
			or { C.Pink, C.Cyan, C.Gold }
		local core = Instance.new("Part")
		core.Shape = Enum.PartType.Ball
		core.Anchored = true
		core.Size = Vector3.one * ((item.Effect == "Smoke") and 1.6 or 0.9)
		core.Material = (item.Effect == "Smoke") and Enum.Material.SmoothPlastic or Enum.Material.Neon
		core.Color = palette[1]
		core.Parent = m
		for k = 1, 10 do
			local a = k / 10 * math.pi * 2
			local b = Instance.new("Part")
			b.Shape = Enum.PartType.Ball
			b.Anchored = true
			local r = (k % 2 == 0) and 1.5 or 1.05
			b.Size = Vector3.one * ((k % 2 == 0) and 0.35 or 0.5)
			b.Position = Vector3.new(math.cos(a) * r, math.sin(a) * r, 0)
			b.Color = palette[(k % #palette) + 1]
			b.Material = (item.Effect == "Smoke") and Enum.Material.SmoothPlastic or Enum.Material.Neon
			b.Parent = m
		end
		local vp = viewportModel(holder, m, UDim2.fromScale(1, 1), 0)
		vp.CurrentCamera.CFrame = CFrame.lookAt(Vector3.new(0, 0, 6), Vector3.zero)
	end
	return holder
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">WeaponController</string><ProtectedString name="Source"><![CDATA[-- 1인칭 사격 컨트롤: 뷰모델, 반동·탄퍼짐, 조준(ADS/스코프), 스페셜, 앉기, 바닥 색에 따른 이동속도
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Weapons = require(ReplicatedStorage.Shared.Weapons)
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
local ModelKit = require(ReplicatedStorage.Shared.ModelKit)
local SoundBank = require(script.Parent:WaitForChild("SoundBank"))
local CharacterPose = require(script.Parent:WaitForChild("CharacterPose"))

local player = Players.LocalPlayer
local WC = {}

local remotes, HUD, Effects
local enabled = false
local firing = false
local firedThisPress = false
local aiming = false
local crouched = false
local running = false      -- Shift 누르는 동안
local walking = false      -- Z로 켜고 끔
local runBlockedUntil = 0  -- 쏜 직후 잠깐은 달리기 속도 안 붙음
local touchRun = false     -- 모바일 달리기 버튼
local lastFire = 0
local spreadExtra = 0
local localInk = Config.InkMax
local viewmodel = nil
local kick = 0           -- 화면 반동(도)
local vmKick = 0         -- 뷰모델 반동
local baseHip = nil
local speedTimer = 0
local cellsFolder = nil
local uiMode = false
local thirdPerson = false -- V 키로 1인칭 ↔ 3인칭(어깨 시점) 전환
local modalGui = nil      -- 창이 열려 있는 동안 마우스를 풀어 주는 투명 버튼
local TP_ZOOM = 8         -- 3인칭 카메라 거리
local TP_OFFSET = Vector3.new(2.8, 1.5, 0) -- 어깨 너머: 캐릭터가 화면 왼쪽 아래로 비켜서 조준점을 가리지 않음

-- 3인칭이 실제로 적용 중인지 (3인칭에서도 우클릭 조준 중에는 1인칭 조준경으로 전환)
local function tpActive()
	return thirdPerson and not aiming
end

local function camera()
	return workspace.CurrentCamera
end

local function weapon()
	return Weapons.Get(player:GetAttribute("Weapon"))
end

local function teamColor()
	return player:GetAttribute("TeamColor") or Color3.new(1, 1, 1)
end

local function humanoid()
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

------------------------------------------------------------------------
-- 뷰모델
------------------------------------------------------------------------
local vmMuzzle = nil      -- 총구 표식 파트 (Blender 모델의 _Muzzle 또는 대체 모델)
local vmLength = 1.5

-- 조준 배율: 총마다 ZoomFov, 3배·6배 스코프 아이템이 있으면 더 크게. 반환: 시야각, 조준점 모양, 배율 글자
local function zoomInfo(w)
	local fov = w.ZoomFov or 56
	local buff = player:GetAttribute("ZoomBuff")
	local untilT = player:GetAttribute("ZoomUntil")
	if buff and untilT and untilT > workspace:GetServerTimeNow() then
		fov = math.min(fov, 70 / buff)
	else
		buff = nil
	end
	local sight = (w.Scope or buff) and "Scope" or (w.Sight or "Dot")
	local mag = 70 / fov
	local txt = (sight == "Scope") and string.format("%.1fx", mag) or nil
	return fov, sight, txt
end
WC.ZoomInfo = zoomInfo
local goldenSpent = false

-- 1인칭 총 모형은 1인칭일 때만, 스코프로 볼 때는 숨김
function WC.UpdateViewmodelParent()
	if not viewmodel then
		return
	end
	local w = weapon()
	local _, sight = zoomInfo(w)
	local show = enabled and not tpActive() and not (aiming and sight == "Scope")
	viewmodel.Parent = show and camera() or nil
end

local function buildViewmodel()
	if viewmodel then
		viewmodel:Destroy()
	end
	local w = weapon()
	local skin = Cosmetics.ById[player:GetAttribute("Skin") or ""]
	local m, muzzle = ModelKit.Gun(w.Id, teamColor(), skin, skin and Cosmetics.MaterialOf(skin.Material) or nil)
	m.Name = "Viewmodel"
	m:PivotTo(CFrame.new())
	local _, size = m:GetBoundingBox()
	vmLength = math.max(size.Z, 0.8)
	vmMuzzle = muzzle
	-- 카툰 외곽선 (셀 셰이딩 느낌)
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 1
	hl.OutlineColor = Color3.fromRGB(18, 16, 28)
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = m
	if player:GetAttribute("Golden") then
		ModelKit.SetGolden(m, true)
	end
	viewmodel = m
	WC.UpdateViewmodelParent()
end

local vm = { Aim = 0, Run = 0, Crouch = 0, Phase = 0, SwayX = 0, SwayY = 0, Land = 0, LastLook = nil }
local currentStance = "Normal"
local lastPoseSent, lastPitchSent, lastStanceSent = 0, 999, ""

local function placeViewmodel(dt)
	if not viewmodel then
		return
	end
	local w = weapon()
	local cam = camera()
	local scoped = aiming and w.Scope
	for _, p in ipairs(viewmodel:GetDescendants()) do
		if p:IsA("BasePart") and p:GetAttribute("Kind") ~= "Anchor" and p:GetAttribute("Kind") ~= "Muzzle" then
			p.LocalTransparencyModifier = scoped and 1 or 0
		end
	end
	-- Anchor(손잡이) 기준 위치: 오른쪽 아래(허리 사격) / 화면 가운데(조준)
	local hipOffset = CFrame.new(0.85, -0.95, -1.25)
	local adsOffset = CFrame.new(0, -0.8, -1.0) -- 조준점 아래로 내려 표적이 가리지 않게
	local hum = humanoid()
	local speed = (hum and hum.RootPart) and Vector3.new(hum.RootPart.AssemblyLinearVelocity.X, 0, hum.RootPart.AssemblyLinearVelocity.Z).Magnitude or 0
	local k = 1 - math.exp(-12 * dt)
	vm.Aim = vm.Aim + ((aiming and 1 or 0) - vm.Aim) * k
	vm.Run = vm.Run + ((currentStance == "Run" and 1 or 0) - vm.Run) * k
	vm.Crouch = vm.Crouch + ((crouched and 1 or 0) - vm.Crouch) * k
	-- 걷는 속도에 맞춘 흔들림 (조준 중엔 거의 없음)
	vm.Phase = vm.Phase + dt * (4 + speed * 0.45)
	local amp = math.clamp(speed / 16, 0, 1.6) * (0.045 + vm.Run * 0.05) * (1 - vm.Aim * 0.85)
	local bob = CFrame.new(math.sin(vm.Phase) * amp, -math.abs(math.cos(vm.Phase)) * amp * 0.9, 0) * CFrame.Angles(0, 0, math.sin(vm.Phase) * amp * 0.6)
	-- 화면을 돌리면 총이 살짝 늦게 따라옴 (무게감)
	local look = cam.CFrame.LookVector
	if vm.LastLook then
		local d = cam.CFrame:VectorToObjectSpace(vm.LastLook)
		vm.SwayX = vm.SwayX + (math.clamp(d.X * 3, -0.12, 0.12) - vm.SwayX) * k
		vm.SwayY = vm.SwayY + (math.clamp(d.Y * 3, -0.12, 0.12) - vm.SwayY) * k
	end
	vm.LastLook = look
	local sway = CFrame.new(vm.SwayX * (1 - vm.Aim * 0.7), vm.SwayY * (1 - vm.Aim * 0.7), 0) * CFrame.Angles(vm.SwayY * 0.6, vm.SwayX * 0.8, 0)
	-- 달리기: 총을 비스듬히 내려 듦 / 앉기: 살짝 낮게 / 착지: 툭 내려앉음
	local runPose = CFrame.new(0.25 * vm.Run, -0.3 * vm.Run - 0.06 * vm.Crouch - vm.Land, 0.1 * vm.Run)
		* CFrame.Angles(math.rad(-18) * vm.Run, math.rad(38) * vm.Run, math.rad(12) * vm.Run)
	vm.Land = vm.Land * math.exp(-10 * dt)
	vmKick = vmKick * math.exp(-14 * dt)
	local base = hipOffset:Lerp(adsOffset, vm.Aim)
	local cf = cam.CFrame * base * runPose * sway * bob * CFrame.new(0, 0, vmKick * 0.12) * CFrame.Angles(math.rad(vmKick * 3), 0, 0)
	viewmodel:PivotTo(cf)
end

local function muzzleCFrame()
	if tpActive() then
		local g = player.Character and player.Character:FindFirstChild("SF_Gun")
		if g then
			for _, p in ipairs(g:GetDescendants()) do
				if p:IsA("BasePart") and p:GetAttribute("Kind") == "Muzzle" then
					return p.CFrame
				end
			end
			return g:GetPivot()
		end
	end
	if vmMuzzle and vmMuzzle.Parent then
		return vmMuzzle.CFrame
	end
	return camera().CFrame
end

------------------------------------------------------------------------
-- 사격
------------------------------------------------------------------------
local function coneDir(dir, degrees)
	if degrees <= 0 then
		return dir
	end
	local r = math.rad(degrees)
	local a = math.random() * math.pi * 2
	local m = math.sqrt(math.random()) * r
	return (CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(math.cos(a) * m, math.sin(a) * m, 0)).LookVector
end

local function currentSpread(w)
	local s = w.Spread + spreadExtra
	if w.HipSpread and not aiming then
		s = w.HipSpread
	end
	if aiming then
		s = s * 0.5
	end
	local hum = humanoid()
	local moving = hum and hum.MoveDirection.Magnitude > 0.1
	if moving and not crouched then
		if running and not aiming then
			s = s + 1.4
		elseif not walking then
			s = s + 0.6
		end
	end
	if walking then
		s = s * 0.7
	end
	if crouched then
		s = s * 0.8
	end
	return s
end

local function fire()
	local w = weapon()
	local now = os.clock()
	if now - lastFire < w.FireInterval then
		return
	end
	local golden = player:GetAttribute("Golden") == true and not goldenSpent
	if not golden and localInk < w.InkCost then
		if now - lastFire > 0.35 then
			lastFire = now
			SoundBank.Play("low_ink", nil, 0.6)
			HUD.Banner("잉크 부족! 우리 색 위에서 빠르게 충전돼요", Color3.fromRGB(255, 120, 120))
		end
		return
	end
	local hum = humanoid()
	if not hum or hum.Health <= 0 then
		return
	end
	lastFire = now
	runBlockedUntil = now + 0.4
	if golden then
		goldenSpent = true
	else
		localInk = localInk - w.InkCost
	end

	local cam = camera()
	local origin = cam.CFrame.Position
	local look = cam.CFrame.LookVector
	local spread = golden and 0 or currentSpread(w)
	local range = golden and Config.GoldenRange or w.Range
	local pellets = golden and 1 or w.Pellets
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, viewmodel, workspace:FindFirstChild("ClientFX"), workspace:FindFirstChild("FX") }
	if tpActive() then
		-- 3인칭: 조준점이 가리키는 곳을 먼저 찾고, 실제 총알은 머리에서 그쪽으로
		local head = player.Character and player.Character:FindFirstChild("Head")
		if head then
			local aimHit = workspace:Raycast(origin, look * w.Range, params)
			local aimPoint = aimHit and aimHit.Position or (origin + look * w.Range)
			origin = head.Position
			local d = aimPoint - origin
			if d.Magnitude > 0.5 then
				look = d.Unit
			end
		end
	end
	local dirs = {}
	local color = golden and Color3.fromRGB(255, 205, 40) or teamColor()
	local muzzle = muzzleCFrame().Position
	local claims = {}
	for i = 1, pellets do
		local d = coneDir(look, spread)
		dirs[i] = d
		local hit = workspace:Raycast(origin, d * range, params)
		local to = hit and hit.Position or (origin + d * range)
		Effects.Tracer(muzzle, to, color, golden and 0.6 or (w.Id == "Sniper" and 0.3 or 0.16))
		if hit then
			Effects.WallSplat(hit.Instance, hit.Position, hit.Normal, color)
		end
		-- 내 화면에서 캐릭터를 맞혔으면 서버에 알림 (서버가 위치·시야를 검증해 인정)
		if hit then
			local model = hit.Instance:FindFirstAncestorOfClass("Model")
			while model and not model:FindFirstChildOfClass("Humanoid") do
				model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model")
			end
			if model then
				claims[i] = { Part = hit.Instance, Pos = hit.Position }
			end
		end
	end
	remotes.Fire:FireServer(w.Id, origin, dirs, claims)

	Effects.Muzzle(muzzleCFrame(), color)
	SoundBank.Play("fire_" .. string.lower(w.Id), nil, 0.55, 0.96 + math.random() * 0.08)
	-- 화면 반동은 작게(복귀 포함), 손맛은 총 모형 반동으로
	kick = math.min(kick + w.Recoil * 0.35, 4)
	vmKick = vmKick + math.min(1.5, w.Recoil * 0.4)
	CharacterPose.Kick(player.Character, w.Recoil)
	spreadExtra = math.min(w.SpreadMax, spreadExtra + w.SpreadGrow)
	Effects.Shake(w.Recoil * 0.02)
end

local function special()
	if (player:GetAttribute("Special") or 0) < 1 then
		HUD.Banner("스페셜 게이지가 부족해요 — 더 칠하세요!", Color3.fromRGB(255, 220, 80))
		return
	end
	local cam = camera()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, viewmodel, workspace:FindFirstChild("ClientFX") }
	local hit = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 70, params)
	local target = hit and hit.Position or (cam.CFrame.Position + cam.CFrame.LookVector * 70)
	remotes.Special:FireServer(target)
end

local applyViewRef = nil
local function setAim(on)
	aiming = on
	local w = weapon()
	local fov = 70
	if on then
		fov = zoomInfo(w)
	end
	TweenService:Create(camera(), TweenInfo.new(0.12), { FieldOfView = fov }):Play()
	-- 확대한 만큼 감도를 낮춰 정밀 조준
	UserInputService.MouseDeltaSensitivity = on and math.clamp(fov / 70, 0.15, 1) or 1
	if thirdPerson and applyViewRef then
		applyViewRef() -- 3인칭 ↔ 1인칭 조준 전환
	end
	WC.UpdateViewmodelParent()
end

local function setCrouch(on)
	local hum = humanoid()
	if not hum then
		return
	end
	if baseHip == nil then
		baseHip = hum.HipHeight
	end
	crouched = on
	hum.HipHeight = on and math.max(0.4, baseHip - 1.1) or baseHip
end

------------------------------------------------------------------------
-- 바닥 색 → 이동 속도
------------------------------------------------------------------------
local function updateSpeed()
	local hum = humanoid()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hum or not root then
		return
	end
	local active = ReplicatedStorage:FindFirstChild("ActiveCells")
	cellsFolder = active and active.Value
	if not cellsFolder then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { cellsFolder }
	local hit = workspace:Raycast(root.Position, Vector3.new(0, -6, 0), params)
	local owner = hit and hit.Instance:GetAttribute("Owner") or 0
	local mine = player:GetAttribute("OwnerId")
	local speed = Config.WalkSpeed
	if owner ~= 0 and owner == mine then
		speed = Config.WalkSpeedOwn
	elseif owner ~= 0 then
		speed = Config.WalkSpeedEnemy
	end
	-- Shift를 누르고 있으면 달리기 (입력 이벤트를 놓쳐도 키 상태로 한 번 더 확인)
	running = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL3) or touchRun
	local mode = "일반"
	if crouched then
		speed = speed * Config.CrouchSpeedMul
		mode = "앉기"
	elseif running and not aiming and os.clock() > runBlockedUntil and hum.MoveDirection.Magnitude > 0.1 then
		speed = speed * Config.RunSpeedMul
		mode = "달리기"
	elseif walking then
		speed = speed * Config.WalkSpeedMul
		mode = "걷기"
	end
	if aiming then
		speed = speed * 0.75
	end
	hum.WalkSpeed = speed
	if HUD and HUD.SetMove then
		HUD.SetMove(mode)
	end
	currentStance = (mode == "앉기" and "Crouch") or (mode == "달리기" and "Run") or (mode == "걷기" and "Walk") or "Normal"
	CharacterPose.SetLocalStance(currentStance)
end

------------------------------------------------------------------------
-- 켜기 / 끄기
------------------------------------------------------------------------
local bindAll, unbindAll

local function setModal(on)
	if not modalGui then
		modalGui = Instance.new("ScreenGui")
		modalGui.Name = "SF_Modal"
		modalGui.ResetOnSpawn = false
		modalGui.DisplayOrder = -10
		local b = Instance.new("TextButton")
		b.Name = "Modal"
		b.Size = UDim2.fromOffset(1, 1)
		b.BackgroundTransparency = 1
		b.Text = ""
		b.Modal = true -- 1인칭에서도 마우스 커서를 풀어 줌 (Roblox 공식 방법)
		b.Parent = modalGui
		modalGui.Parent = player:WaitForChild("PlayerGui")
	end
	modalGui.Enabled = on
end

-- 카메라를 강제로 바깥으로 빼서 1인칭 잠금을 확실히 풀기
local function zoomOut(dist)
	player.CameraMinZoomDistance = dist
	player.CameraMaxZoomDistance = math.max(dist, 20)
	task.delay(0.15, function()
		if not enabled or uiMode then
			player.CameraMinZoomDistance = 0.5
			player.CameraMaxZoomDistance = 40
		end
	end)
end

-- 현재 상태(1인칭/3인칭/창 열림)에 맞게 카메라 적용
local function applyView()
	local hum = humanoid()
	if not enabled then
		return
	end
	if uiMode then
		player.CameraMode = Enum.CameraMode.Classic
		UserInputService.MouseIconEnabled = true
		setModal(true)
		return
	end
	setModal(false)
	if tpActive() then
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMaxZoomDistance = TP_ZOOM
		player.CameraMinZoomDistance = TP_ZOOM
		if hum then
			hum.CameraOffset = TP_OFFSET
			hum.AutoRotate = false
		end
	else
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 40
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		if hum then
			hum.CameraOffset = Vector3.zero
			hum.AutoRotate = true
		end
	end
	UserInputService.MouseIconEnabled = false
	WC.UpdateViewmodelParent()
end

applyViewRef = applyView

function WC.ToggleView()
	thirdPerson = not thirdPerson
	applyView()
	if HUD and HUD.Banner then
		HUD.Banner(thirdPerson and "3인칭 시점 [V]" or "1인칭 시점 [V]", Color3.fromRGB(200, 220, 255))
	end
end

local function enable()
	if enabled then
		return
	end
	enabled = true
	localInk = player:GetAttribute("Ink") or Config.InkMax
	buildViewmodel()
	if uiMode then
		WC.SetUIMode(true)
	else
		applyView()
		bindAll()
	end
end

local function disable()
	enabled = false
	firing = false
	unbindAll()
	setAim(false)
	setCrouch(false)
	player.CameraMode = Enum.CameraMode.Classic
	UserInputService.MouseIconEnabled = true
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	setModal(uiMode)
	zoomOut(12) -- 로비에서는 3인칭 + 마우스 자유
	if viewmodel then
		viewmodel:Destroy()
		viewmodel = nil
	end
	local hum = humanoid()
	if hum then
		hum.WalkSpeed = Config.WalkSpeed
		hum.CameraOffset = Vector3.zero
		hum.AutoRotate = true
	end
end

local function onAction(name, inputState)
	if not enabled then
		return Enum.ContextActionResult.Pass
	end
	local began = inputState == Enum.UserInputState.Begin
	if name == "SF_Fire" then
		firing = began
		if began then
			firedThisPress = false
		end
	elseif name == "SF_Aim" then
		setAim(began)
	elseif name == "SF_Special" and began then
		special()
	elseif name == "SF_Crouch" and began then
		setCrouch(not crouched)
		if crouched then
			running = false
		end
	elseif name == "SF_Run" then
		touchRun = (inputState == Enum.UserInputState.Begin) and UserInputService.TouchEnabled
		running = (inputState == Enum.UserInputState.Begin)
		if running and crouched then
			setCrouch(false)
		end
		updateSpeed()
	elseif name == "SF_Walk" and began then
		walking = not walking
		HUD.Banner(walking and "걷기 (조용히 · 정밀 사격) [Z]" or "일반 이동", Color3.fromRGB(200, 220, 255))
		updateSpeed()
	elseif name == "SF_View" and began then
		WC.ToggleView()
	end
	return Enum.ContextActionResult.Sink
end

bindAll = function()
	ContextActionService:BindAction("SF_Fire", onAction, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
	ContextActionService:BindAction("SF_Aim", onAction, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
	ContextActionService:BindAction("SF_Special", onAction, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonY)
	ContextActionService:BindAction("SF_Crouch", onAction, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)
	ContextActionService:BindAction("SF_Run", onAction, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	ContextActionService:BindAction("SF_Walk", onAction, false, Enum.KeyCode.Z)
	ContextActionService:SetTitle("SF_Run", "달리기")
	ContextActionService:SetPosition("SF_Run", UDim2.new(1, -170, 1, -220))
	ContextActionService:BindAction("SF_View", onAction, true, Enum.KeyCode.V, Enum.KeyCode.DPadUp)
	ContextActionService:SetTitle("SF_Fire", "발사")
	ContextActionService:SetTitle("SF_Aim", "조준")
	ContextActionService:SetTitle("SF_Special", "스페셜")
	ContextActionService:SetTitle("SF_Crouch", "앉기")
	ContextActionService:SetPosition("SF_Fire", UDim2.new(1, -150, 1, -150))
	ContextActionService:SetPosition("SF_Aim", UDim2.new(1, -230, 1, -110))
	ContextActionService:SetPosition("SF_Special", UDim2.new(1, -230, 1, -190))
	ContextActionService:SetPosition("SF_Crouch", UDim2.new(1, -90, 1, -220))
	ContextActionService:SetTitle("SF_View", "시점")
	ContextActionService:SetPosition("SF_View", UDim2.new(1, -90, 1, -300))
end

unbindAll = function()
	running = false
	for _, n in ipairs({ "SF_Fire", "SF_Aim", "SF_Special", "SF_Crouch", "SF_View", "SF_Run", "SF_Walk" }) do
		ContextActionService:UnbindAction(n)
	end
end

-- 피드백/관리자 창이 열려 있는 동안 1인칭 잠금 해제
function WC.SetUIMode(on)
	uiMode = on
	if not enabled then
		-- 로비: 카메라는 이미 3인칭, 커서만 확실히 풀어 줌
		setModal(on)
		if on then
			zoomOut(12)
		end
		return
	end
	if on then
		firing = false
		setAim(false)
		unbindAll()
		applyView()
	else
		applyView()
		bindAll()
	end
end

function WC.Init(remoteFolder, hud, effects)
	remotes = remoteFolder
	HUD = hud
	Effects = effects

	player:GetAttributeChangedSignal("InMatch"):Connect(function()
		if player:GetAttribute("InMatch") then
			enable()
		else
			disable()
		end
	end)
	player:GetAttributeChangedSignal("Ink"):Connect(function()
		localInk = player:GetAttribute("Ink") or localInk
	end)
	player:GetAttributeChangedSignal("Golden"):Connect(function()
		if player:GetAttribute("Golden") then
			goldenSpent = false
			HUD.Banner("황금총 장전! 다음 1발은 맞으면 즉사", Color3.fromRGB(255, 210, 60))
		end
		if enabled then
			buildViewmodel()
		end
	end)
	player:GetAttributeChangedSignal("ZoomBuff"):Connect(function()
		if aiming then
			setAim(true)
		end
	end)
	player:GetAttributeChangedSignal("Skin"):Connect(function()
		if enabled then
			buildViewmodel()
		end
	end)
	-- 무기가 바뀌면(스폰 지점 교체) 1인칭 총 모형·잉크 갱신
	player:GetAttributeChangedSignal("Weapon"):Connect(function()
		if enabled then
			setAim(false)
			spreadExtra = 0
			localInk = Config.InkMax
			buildViewmodel()
			SoundBank.Play("ui_buy", nil, 0.5)
		end
	end)
	-- 스폰 지점 무기 교체: 숫자 1~6 = 무기 목록 순서, T = 다음 보유 무기
	-- 숫자 = 보유 무기 순서 (교체 바의 [번호]와 같음)
	local NUM = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six,
		Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine }
	local function ownedList()
		local s = "," .. (player:GetAttribute("Owned") or "") .. ","
		local out = {}
		for _, w in ipairs(Weapons.List) do
			if string.find(s, "," .. w.Id .. ",", 1, true) and ModelKit.HasStoreModel(w.Id) then
				table.insert(out, w.Id)
			end
		end
		return out
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not enabled or uiMode then
			return
		end
		local target = nil
		for i, k in ipairs(NUM) do
			if input.KeyCode == k then
				target = ownedList()[i]
			end
		end
		if input.KeyCode == Enum.KeyCode.T then
			local list = ownedList()
			local cur = player:GetAttribute("Weapon")
			for i, id in ipairs(list) do
				if id == cur then
					target = list[(i % #list) + 1]
				end
			end
			target = target or list[1]
		end
		if not target or target == player:GetAttribute("Weapon") then
			return
		end
		if not player:GetAttribute("SpawnZone") then
			HUD.Banner("무기 교체는 스폰 지점에서만 가능해요 (부활 직후 " .. Config.WeaponSwitchGrace .. "초)", Color3.fromRGB(255, 200, 90))
			return
		end
		remotes.SwitchWeapon:FireServer(target)
	end)
	player.CharacterAdded:Connect(function(char)
		baseHip = nil
		crouched = false
		aiming = false
		if enabled then
			task.defer(function()
				buildViewmodel()
				applyView()
			end)
		end
		local hum = char:WaitForChild("Humanoid")
		hum.StateChanged:Connect(function(_, new)
			if new == Enum.HumanoidStateType.Landed then
				vm.Land = 0.18 -- 착지할 때 총이 툭 내려앉음
			end
		end)
		hum.Died:Connect(function()
			firing = false
			setAim(false)
		end)
	end)

	-- 카메라 반동: 기본 카메라 갱신 직후에 덧붙임
	RunService:BindToRenderStep("SF_Mouse", Enum.RenderPriority.Camera.Value + 2, function()
		if uiMode then
			-- 창이 열려 있으면 어떤 시점이든 커서 자유
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
			return
		end
		if not enabled then
			return
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if tpActive() and root then
			-- 어깨 시점: 몸이 카메라가 보는 방향을 따라 돎
			local look = camera().CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0.01 then
				root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
			end
		end
		-- 1인칭: 내 헬멧·가방·손에 든 총이 화면을 가리지 않게 숨김
		if char then
			local hide = tpActive() and 0 or 1
			for _, n in ipairs({ "SF_Helmet", "SF_Backpack", "SF_Gun", "SF_Armor", "SF_Jetpack" }) do
				local g = char:FindFirstChild(n)
				if g then
					for _, p in ipairs(g:GetDescendants()) do
						if p:IsA("BasePart") then
							p.LocalTransparencyModifier = hide
						end
					end
				end
			end
		end
	end)

	-- 카메라 반동: 기본 카메라는 매 프레임 '지난 프레임 카메라 방향'에서 출발하므로
	-- 반동을 통째로 매번 더하면 계속 쌓여 하늘로 솟구침(0.5 버그). 지난 프레임에 더한 만큼 빼고 새 값만 적용
	local lastOffset = CFrame.new()
	RunService:BindToRenderStep("SF_Recoil", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local cam = camera()
		if not enabled or uiMode then
			lastOffset = CFrame.new()
			kick = 0
			return
		end
		kick = kick * math.exp(-14 * dt) -- 빠르게 원위치 (조준점 복귀)
		local offset = CFrame.Angles(math.rad(kick), 0, 0) * Effects.ShakeOffset(dt)
		cam.CFrame = cam.CFrame * lastOffset:Inverse() * offset
		lastOffset = offset
	end)

	RunService.RenderStepped:Connect(function(dt)
		if not enabled then
			return
		end
		local w = weapon()
		if firing then
			if w.Auto or not firedThisPress then
				local before = lastFire
				fire()
				if lastFire ~= before then
					firedThisPress = true
				end
			end
		end
		if os.clock() - lastFire > 0.15 then
			spreadExtra = math.max(0, spreadExtra - dt * 8)
		end
		placeViewmodel(dt)
		-- 달릴 때 시야가 살짝 넓어져 속도감 (조준 중엔 조준 배율 유지)
		if not aiming then
			local cam = camera()
			local target = (currentStance == "Run") and 78 or 70
			cam.FieldOfView = cam.FieldOfView + (target - cam.FieldOfView) * (1 - math.exp(-8 * dt))
		end
		-- 내 조준 각도·자세를 다른 사람에게 공유 (상체가 조준 방향을 따라 움직이게)
		local t = os.clock()
		if t - lastPoseSent > 0.12 and remotes:FindFirstChild("Pose") then
			local pitch = math.deg(math.asin(math.clamp(camera().CFrame.LookVector.Y, -1, 1)))
			if math.abs(pitch - lastPitchSent) >= 2 or currentStance ~= lastStanceSent then
				lastPoseSent, lastPitchSent, lastStanceSent = t, pitch, currentStance
				remotes.Pose:FireServer(pitch, currentStance)
			end
		end
		speedTimer = speedTimer + dt
		if speedTimer > 0.1 then
			speedTimer = 0
			updateSpeed()
		end
		local _, sight, ztxt = zoomInfo(w)
		HUD.Update(currentSpread(w) * 7, w.Id, aiming and sight or nil, aiming and ztxt or nil)
	end)
end

return WC
]]></ProtectedString></Properties></Item></Item></Item></roblox>